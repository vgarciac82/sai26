<?xml version="1.0" encoding="UTF-8"?>
<Ayuda>
	<titulo>Mantenimiento del Tipo de Comprobante para el CFDI</titulo>
	<anchoWin>715</anchoWin>
	<altoWin>600</altoWin>
	<altoAreaCaptura>100</altoAreaCaptura>
	<tabla>M_tCFDI_Cat_TipoComprobante</tabla>
	<maxRegistros>1000</maxRegistros>
	<regresaDatos>No</regresaDatos>
	<ColSort>0</ColSort>

	<borraRegistro>Si</borraRegistro>
	<CambiaRegistro>Si</CambiaRegistro>
	
	
	<grid>		
		<columna campo="cTipoComprobante"		control=""	dependencia="No"	limpiaOnKeypress=""		header="Tipo comprobante"	rowCol="1,1" 	ancho="5"	maxlen="5"	 tipo="string"	visible="Si"	clase=""/>
		<columna campo="cDescripcion"			control=""	dependencia="No"	limpiaOnKeypress=""		header="Descripción"		rowCol="1,2" 	ancho="50"	maxlen="50" tipo="string"	visible="Si"	clase=""/>
		<columna campo="nValorMaximo"			control=""	dependencia="No"	limpiaOnKeypress=""		header="Valor maximo"		rowCol="1,3" 	ancho="20"	maxlen="20"	 tipo="integer"	visible="Si"	clase=""/>
		<columna campo="fFechaInicioVigencia"	control=""	dependencia="No"	limpiaOnKeypress=""		header="Inicio Vigencia"	rowCol="2,1" 	ancho="15"	maxlen="15"	 tipo="date"	visible="Si"	clase=""/>
		<columna campo="fFechaFinVigencia"		control=""	dependencia="No"	limpiaOnKeypress=""		header="Fin Vigencia"		rowCol="2,1" 	ancho="15"	maxlen="15"	 tipo="date"	visible="Si"	clase=""/>
	</grid>  
	
	<insertaRegistro>
		<campo field="cTipoComprobante"		control="txtGridCol0"	llave="Si"	identity="No"	requerido="Clave de la Cartera es un dato requerido."	requeridoFocus="txtGridCol0"	tipo="string" />
		<campo field="cDescripcion"			control="txtGridCol1"	llave="No"	identity="No"	requerido="Descripción es un dato requerido."			requeridoFocus="txtGridCol1"	tipo="string" />
		<campo field="nValorMaximo"			control="txtGridCol2"	llave="No"	identity="No"	requerido="Valor maximo es un dato requerido."			requeridoFocus="txtGridCol2"	tipo="integer" />		
		<campo field="fFechaInicioVigencia"	control="txtGridCol3"	llave="No"	identity="No"	requerido="Inicio de vigencia es un dato requerido."	requeridoFocus="txtGridCol3"	tipo="date" />
		<campo field="fFechaFinVigencia"	control="txtGridCol4"	llave="No"	identity="No"	requerido=""											requeridoFocus="txtGridCol4"	tipo="date" />		
	</insertaRegistro>
	
</Ayuda>
