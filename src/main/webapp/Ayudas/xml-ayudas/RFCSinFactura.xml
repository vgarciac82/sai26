<?xml version="1.0" encoding="UTF-8"?>
<!-- RFC de beneficiarios a quienes se les puede realizar pago sin facturas. -->
<Ayuda>
	<titulo>Excepcion Beneficiarios RG sin CFDI</titulo>
	<anchoWin>715</anchoWin>
	<altoWin>600</altoWin>
	<altoAreaCaptura>150</altoAreaCaptura>
	<tabla>RFCPagoSinFacturaPermitido</tabla>
	<maxRegistros>100</maxRegistros>
	<regresaDatos>No</regresaDatos>
	<ColSort>1</ColSort>
	
	<borraRegistro>Si</borraRegistro>
	<CambiaRegistro>Si</CambiaRegistro>
	
	<grid>
		<columna campo="cRFC"				control="cRFC"				dependencia="No"	ctrlsDependientes=""	limpiaOnKeypress=""	header="RFC"				ancho="20"	maxlen="20"		tipo="string"	visible="Si"	clase=""/>
