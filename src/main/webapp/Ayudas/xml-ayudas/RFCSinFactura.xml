	</grid>
	
	<insertaRegistro>
		<campo field="cRFC"					control="txtGridcRFC"				llave="Si"	identity="No"	requerido="El RFC del proveedor es un dato requerido"				requeridoFocus="txtGridcRFC"				tipo="string" />
		<campo field="cTipoPago"			control="txtGridcTipoPago"			llave="Si"	identity="No" 	requerido="El Tipo de pago es un dato requerido"					requeridoFocus="txtGridcTipoPago"			tipo="string" />
		<campo field="lImpuestoForzoso"		control="txtGridlImpuestoForzoso"	llave="No"	identity="No" 	requerido="La bandera de forzoso es un dato requerido"				requeridoFocus="txtGridlImpuestoForzoso"	tipo="numero" />
