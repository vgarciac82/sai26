		<campo field="ID_TIPO_PROCEDENCIA"	control="txtGrididtp"			llave="No"	identity="No" 	requerido="El Tipo de Procedencia es un dato requerido."	requeridoFocus="txtGridtp_descripcion"		tipo="numero" />
		<campo field="PRO_ABREVIATURA" 		control="txtGridCol1"			llave="No"	identity="No" 	requerido=""												requeridoFocus=""							tipo="string" />
