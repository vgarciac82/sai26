<?xml version="1.0"?>
<!-- Ayuda Remitente Externo -->
<Ayuda>
	<titulo>Mantenimiento de formas de pago CFDI</titulo>
	<anchoWin>715</anchoWin>
	<altoWin>600</altoWin>
	<altoAreaCaptura>200</altoAreaCaptura>
