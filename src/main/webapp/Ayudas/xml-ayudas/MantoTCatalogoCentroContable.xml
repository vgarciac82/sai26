	<insertaRegistro>
		<campo field="cCentroContable" control="txtGridCol0" llave="Si"
			identity="No" requerido="Clave de Centro Contable es un dato requerido."
			requeridoFocus="txtGridCol0" tipo="string" />
		<campo field="cDescripcion" control="txtGridCol1" llave="Si"
			identity="No" requerido=""
