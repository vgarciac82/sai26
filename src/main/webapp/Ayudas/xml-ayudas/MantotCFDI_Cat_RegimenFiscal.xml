<?xml version="1.0" encoding="UTF-8"?>
<Ayuda>
	<titulo>Mantenimiento del Regimen Fiscal para el CFDI</titulo>
	<anchoWin>715</anchoWin>
	<altoWin>600</altoWin>
	<altoAreaCaptura>200</altoAreaCaptura>
	<tabla>M_tCFDI_Cat_RegimenFiscal</tabla>
	<maxRegistros>1000</maxRegistros>
	<regresaDatos>No</regresaDatos>
	<ColSort>0</ColSort>

	<borraRegistro>Si</borraRegistro>
	<CambiaRegistro>Si</CambiaRegistro>
	
	
	<grid>		
		<columna campo="cRegimenFiscal"			control=""	dependencia="No"	limpiaOnKeypress=""		header="Regimen Fiscal"		rowCol="1,1" 	ancho="11"	maxlen="11"	 tipo="string"	visible="Si"	clase=""/>
		<columna campo="cDescripcion"			control=""	dependencia="No"	limpiaOnKeypress=""		header="Descripción"		rowCol="1,2" 	ancho="100"	maxlen="100" tipo="string"	visible="Si"	clase=""/>
		<columna campo="cAplicaPFisica"			control=""	dependencia="No"	limpiaOnKeypress=""		header="Persona Fisica"		rowCol="2,1" 	ancho="10"	maxlen="10"	 tipo="string"	visible="Si"	clase=""/>
		<columna campo="cAplicaPMoral"			control=""	dependencia="No"	limpiaOnKeypress=""		header="Persona Moral"		rowCol="2,2" 	ancho="10"	maxlen="10"	 tipo="string"	visible="Si"	clase=""/>
		<columna campo="fFechaInicioVigencia"	control=""	dependencia="No"	limpiaOnKeypress=""		header="Inicio Vigencia"	rowCol="3,1" 	ancho="15"	maxlen="15"	 tipo="date"	visible="Si"	clase=""/>
		<columna campo="fFechaFinVigencia"		control=""	dependencia="No"	limpiaOnKeypress=""		header="Fin Vigencia"		rowCol="3,2" 	ancho="15"	maxlen="15"	 tipo="date"	visible="Si"	clase=""/>
	</grid>  
	
	<insertaRegistro>
		<campo field="cRegimenFiscal"		control="txtGridCol0"	llave="Si"	identity="No"	requerido="Regimen fiscal es un dato requerido."		requeridoFocus="txtGridCol0"	tipo="string" />
		<campo field="cDescripcion"			control="txtGridCol1"	llave="No"	identity="No"	requerido="Descripción es un dato requerido."			requeridoFocus="txtGridCol1"	tipo="string" />
		<campo field="cAplicaPFisica"		control="txtGridCol2"	llave="No"	identity="No"	requerido="Aplica pesona fisica es un dato requerido."	requeridoFocus="txtGridCol2"	tipo="string" />
		<campo field="cAplicaPMoral"		control="txtGridCol3"	llave="No"	identity="No"	requerido="Aplica pesona moral es un dato requerido."	requeridoFocus="txtGridCol3"	tipo="string" />
		<campo field="fFechaInicioVigencia"	control="txtGridCol4"	llave="No"	identity="No"	requerido="Inicio de vigencia es un dato requerido."	requeridoFocus="txtGridCol4"	tipo="date" />
		<campo field="fFechaFinVigencia"	control="txtGridCol5"	llave="No"	identity="No"	requerido=""											requeridoFocus="txtGridCol5"	tipo="date" />		
	</insertaRegistro>
	
</Ayuda>
