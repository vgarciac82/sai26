	<grid>
			<columna campo="sp.cIdSubPartida" 		control="cIdSubPartida"				dependencia="No"	ctrlsDependientes=""	limpiaOnKeypress=""			header="*Partida"							rowCol="1,1"	ancho="5"		maxlen="5"		tipo="string"	visible="Si"	clase="AyudaSyC autoCompletaSyC"/>
			<columna campo="sp.cSubPartida"			control="cSubPartida"				dependencia="No"	ctrlsDependientes=""	limpiaOnKeypress=""			header="*Descripción"						rowCol="2,1"	ancho="150"		maxlen="2000"	tipo="string"	visible="Si"	clase="AyudaSyC autoCompletaSyC"/>
			<columna campo="c.cCapitulo"			control="cCapitulo"					dependencia="No"	ctrlsDependientes=""	limpiaOnKeypress=""			header="*Capitulo(2000,3000,5000)"			rowCol="3,1"	ancho="150"		maxlen="1000"	tipo="string"	visible="Si"	clase="AyudaSyC autoCompletaSyC"/>
