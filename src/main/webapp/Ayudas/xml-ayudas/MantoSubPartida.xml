	<insertaRegistro>
		<campo field="cIdSubPartida"		control="txtGridcIdSubPartida"			llave="Si"	identity="No"	requerido="El campo Partida es requerido."					requeridoFocus="txtGridcIdSubPartida"			tipo="string" />
		<campo field="cSubPartida"			control="txtGridcSubPartida"			llave="No"	identity="No"	requerido="El campo Descripción es requerido."				requeridoFocus="txtGridcSubPartida"			tipo="string" />						
		<!--<campo field="cSubPartidaCorto"		control="txtGridcSubPartidaCorto"		llave="No"	identity="No"	requerido="El campo Descripcion Corta es requerido."		requeridoFocus="cSubPartidaCorto"			tipo="string" />-->
		<campo field="lRestaPresupuesto"	control="txtGridRestaPresupuesto"		llave="No"	identity="No"	requerido="El campo Resta del Presupuesto es requerido."	requeridoFocus="txtGridRestaPresupuesto"			tipo="string" />									
	</insertaRegistro>

