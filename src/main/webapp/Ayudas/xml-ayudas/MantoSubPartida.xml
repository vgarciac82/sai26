			<columna campo="sp.lRestaPresupuesto"	control="RestaPresupuesto"			dependencia="No"	ctrlsDependientes=""	limpiaOnKeypress=""			header="*Resta del Presupuesto(0,1)"		rowCol="5,1"	ancho="1"	maxlen="1"		tipo="string"	visible="Si"	clase=""/>								
