<?xml version="1.0"?>
<!-- Ayuda Procedencias - desde la pantalla de Remitente Externo -->
<Ayuda>
	<titulo>Mantenimiento Catálogo de Procedencias</titulo>
	<anchoWin>715</anchoWin>
	<altoWin>600</altoWin>
	<altoAreaCaptura>160</altoAreaCaptura>
	<tabla>M_CAT_PROCEDENCIA</tabla>
	<maxRegistros>1000</maxRegistros>
	<regresaDatos>No</regresaDatos>
	<ColSort>1</ColSort>

 	<borraRegistro>Si</borraRegistro>
	<CambiaRegistro>Si</CambiaRegistro>
	 
	<grid>
		<columna campo="P.PRO_DESCRIPCION"		control=""	                    dependencia="No"	limpiaOnKeypress=""	  					header="Procedencia"		    rowCol="1,1" 	ancho="100"	maxlen="100"	tipo="string"	visible="Si"	clase=""/>
		<columna campo="TP.TP_DESCRIPCION"		control="MantoTpDescripcion"	dependencia="No"	limpiaOnKeypress="txtGridMantoIdTp,"	header="Tipo Procedencia"		rowCol="2,1" 	ancho="50"	maxlen="100"	tipo="string"	visible="Si"	clase="AyudaSyC"/>
		<columna campo="P.PRO_ABREVIATURA"		control=""	                    dependencia="No"	limpiaOnKeypress=""	  					header="Abreviatura"		    rowCol="3,1" 	ancho="20"	maxlen="20"		tipo="string"	visible="Si"	clase=""/>
		<columna campo="P.ID_PROCEDENCIA"		control=""	                    dependencia="No"	limpiaOnKeypress=""	  					header="Clave"					rowCol="3,2" 	ancho="6"	maxlen="6"		tipo="numero"	visible="No"	clase="Protegido"/>
		<columna campo="P.ID_TIPO_PROCEDENCIA"	control="MantoIdTp"	            dependencia="No"	limpiaOnKeypress=""	  					header="ID Tipo Procedencia"	rowCol="3,3" 	ancho="6"	maxlen="6"		tipo="numero"	visible="No"	clase="Protegido"/>
	</grid> 
	
	<insertaRegistro>
		<campo field="ID_PROCEDENCIA"		control="txtGridCol3"	    llave="Si"	identity="Si"	requerido=""														requeridoFocus=""	 			tipo="numero" />
		<campo field="PRO_DESCRIPCION"		control="txtGridCol0"	    llave="No"	identity="No"	requerido="La procedencia es un dato requerido."					requeridoFocus="txtGridCol0"	tipo="string" />		
		<campo field="ID_TIPO_PROCEDENCIA"	control="txtGridMantoIdTp"	llave="No"	identity="No"	requerido="El tipo de procedencia es un dato requerido."			requeridoFocus="txtGridCol1"	tipo="string" />
		<campo field="PRO_ABREVIATURA"		control="txtGridCol2"	    llave="No"	identity="No"	requerido=""														requeridoFocus=""				tipo="string" />
	</insertaRegistro>
</Ayuda>