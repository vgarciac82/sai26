<?xml version="1.0"?>
<!-- Ayuda Remitente Externo -->
<Ayuda>
	<titulo>Mantenimiento de relación Usuario Grupos</titulo>
	<anchoWin>715</anchoWin>
	<altoWin>600</altoWin>
	<altoAreaCaptura>200</altoAreaCaptura>
	<tabla>M_CG_GRUPO_USUARIO</tabla>
	<maxRegistros>1000</maxRegistros>
	<regresaDatos>No</regresaDatos>
	<ColSort>0</ColSort>

	<borraRegistro>Si</borraRegistro>
	<CambiaRegistro>No</CambiaRegistro>
	
	
	<grid>		
		<columna campo="u_login"	control="MantoLoginSup"	dependencia="No"	limpiaOnKeypress=""		header="Usuario"	 	 ancho="32"		maxlen="32"  tipo="string"	visible="Si"	clase="AyudaSyC autoCompletaSyC"/>
		<columna campo="G_NOMBRE"	control="MantoGrupoUsuario"	dependencia="No"	limpiaOnKeypress=""		header="Nombre Grupo"	 ancho="100"	maxlen="100" tipo="string"	visible="Si"	clase="AyudaSyC autoCompletaSyC"/>
		<columna campo="EFISCAL"			control="aEjercicioFiscal"		dependencia="No"		ctrlsDependientes=""						limpiaOnKeypress="txtGridaEjercicioFiscal"	header="* Ejercicio Fiscal"		rowCol="11,1" 	ancho="15"		maxlen="12"		tipo="string"		visible="Si"	clase="AyudaSyC autoCompletaSyC" defaultValue="" anioDinamic="1"/>
	
	
	</grid>  
	
	<insertaRegistro>
		<campo field="u_login"	control="txtGridMantoLoginSup"	llave="Si"	identity="No"	requerido="El Usuario es un dato requerido."	requeridoFocus="txtGridMantoLoginSup"	tipo="string" />		
		<campo field="G_NOMBRE"	control="txtGridMantoGrupoUsuario"	llave="Si"	identity="No"	requerido="El Grupo es un dato requerido."		requeridoFocus="txtGridMantoGrupoUsuario"	tipo="string" />
		<campo field="EFISCAL"				control="txtGridaEjercicioFiscal"			llave="Si"	identity="No"	requerido="El Ejercicio Fiscal es Requerido"			requeridoFocus="txtGridaEjercicioFiscal"	tipo="string" />
	
	</insertaRegistro>
	
</Ayuda>