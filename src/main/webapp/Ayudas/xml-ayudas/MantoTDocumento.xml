	<insertaRegistro>
		<campo field="TD_ID"			control="txtGridCol0"	llave="Si"	identity="No"	requerido="La Clave es un dato requerido"				requeridoFocus="txtGridCol0"	tipo="numero" />
		<campo field="TD_DESCRIPCION"	control="txtGridCol1"	llave="No"	identity="No"	requerido="El Tipo de Documento es un dato requerido."	requeridoFocus="txtGridCol1"	tipo="string" />
