		<columna campo="fFechaInicioVigencia"	control=""	dependencia="No"	limpiaOnKeypress=""		header="Fecha Inicio"	 		ancho="15"	maxlen="15" 	tipo="date"		visible="Si"	clase=""/>
		<columna campo="fFechaFinVigencia"		control=""	dependencia="No"	limpiaOnKeypress=""		header="Fecha Fin"	 			ancho="15"	maxlen="15" 	tipo="date"		visible="Si"	clase=""/>
		<columna campo="cSimbolo"				control=""	dependencia="No"	limpiaOnKeypress=""		header="Simbolo"	 			ancho="32"	maxlen="32" 	tipo="string"	visible="Si"	clase=""/>
	</grid>  
	
	<insertaRegistro>
		<campo field="cClaveUnidad"			control="txtGridCol0"	llave="Si"	identity="No"	requerido="La clave de unidad es un dato requerido."		requeridoFocus="txtGridCol0"	tipo="string" />		
		<campo field="cNombreUnidad"		control="txtGridCol1"	llave="No"	identity="No"	requerido="El nombre de la unidad es un dato requerido."	requeridoFocus="txtGridCol1"	tipo="string" />
		<campo field="cDescripción"			control="txtGridCol2"	llave="No"	identity="No"	requerido=""												requeridoFocus="txtGridCol2"	tipo="string" />
		<campo field="fFechaInicioVigencia"	control="txtGridCol3"	llave="No"	identity="No"	requerido="Fecha inicio es un dato requerido."				requeridoFocus="txtGridCol3"	tipo="date" />
		<campo field="fFechaFinVigencia"	control="txtGridCol4"	llave="No"	identity="No"	requerido=""												requeridoFocus="txtGridCol4"	tipo="date" />
		<campo field="cSimbolo"				control="txtGridCol5"	llave="No"	identity="No"	requerido=""												requeridoFocus="txtGridCol5"	tipo="string" />
	</insertaRegistro>
	
