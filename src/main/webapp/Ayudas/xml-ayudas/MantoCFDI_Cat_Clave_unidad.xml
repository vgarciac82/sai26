<?xml version="1.0"?>
<!-- Ayuda Remitente Externo -->
<Ayuda>
	<titulo>Mantenimiento de Clave Unidad para CFDI</titulo>
	<anchoWin>715</anchoWin>
	<altoWin>600</altoWin>
	<altoAreaCaptura>200</altoAreaCaptura>
	<tabla>tCFDI_Cat_Clave_unidad</tabla>
	<maxRegistros>1000</maxRegistros>
	<regresaDatos>No</regresaDatos>
	<ColSort>0</ColSort>

	<borraRegistro>Si</borraRegistro>
	<CambiaRegistro>No</CambiaRegistro>
	
	
	<grid>		
		<columna campo="cClaveUnidad"			control=""	dependencia="No"	limpiaOnKeypress=""		header="Clave"	 	 			ancho="3"	maxlen="3"  	tipo="string"	visible="Si"	clase=""/>
		<columna campo="cNombreUnidad"			control=""	dependencia="No"	limpiaOnKeypress=""		header="Nombre Unidad"	 		ancho="128"	maxlen="128" 	tipo="string"	visible="Si"	clase=""/>
