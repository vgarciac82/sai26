html,body {
	height: 100%;
	margin: 0px;
	padding: 0; /* Opera */
	font-family: arial, helvetica, sans-serif;
}

body {
	background-color: #ffffff;
	scrollbar-3dlight-color: #f5f5f5;
	scrollbar-arrow-color: #34855d;
	scrollbar-base-color: #0c6d3d;
	scrollbar-darkshadow-color: #7cb096;
	scrollbar-face-color:#aaaaaa;
	scrollbar-highlight-color: #dcdcdc;
	scrollbar-shadow-color: #7cb096;
	scrollbar-track-color: #ffffff;
}

form {
	margin: 0px;
	padding: 0px;
	height: 100%;
	width: 100%;
	border: 0px;
}

table {
	font-family: "verdana, arial, helvetica, sans-serif";
	font-size: 10pt;
	background-color: #f0f0f0;
	border-color: #076a39;
	color: #026735;
}

th {
	font-family: "verdana, arial, helvetica, sans-serif";
	font-size: 10pt;
	color: #026735;
	text-transform: uppercase;
}

input.button {
	font-family: verdana, arial, helvetica, sans-serif;
	font-size: 8pt;
	color: #026735;
	text-transform: uppercase;
	font-weight: bold;
}

a:link {
	font-family: "verdana, arial, helvetica, sans-serif";
	color: #000000;
	text-decoration: none;
	font-size: 10pt;
	font-style: normal;
}

a:visited {
	font-family: "verdana, arial, helvetica, sans-serif";
	color: #AAAAAA;
	text-decoration: none;
	font-size: 10pt;
	font-style: normal;
}

a:hover {
	font-family: "verdana, arial, helvetica, sans-serif";
	color: #aaaaaa;
	text-decoration: none;
	font-size: 10pt;
	font-style: normal;
}

.top {
	border-left: none;
	border-right: 1px solid #cccccc;
	padding: 2px 3px 3px 4px;
	border-bottom: 1px solid #dddddd;
	text-transform: uppercase;
}

#paraBox {
	position: absolute;
	left: 140px;
	top: 120px;
	width: 600px;
	height: 366px;
	z-index: 2;
	visibility: hidden;
	border-color: #0c6d3d;
	border-style: solid;
	border-width: 1px;
}

#respOper {
	position: absolute;
	left: 14px;
	top: 30px;
	width: 800px;
	height: 366px;
	z-index: 2;
	visibility: hidden;
	border-color: #0c6d3d;
	border-style: solid;
	border-width: 1px;
}

img {
	border: 0px;
	margin: 0px;
	padding: 0px;
}

/*CSS DEL MENU*/
.menu {
	border: 0px;
	padding: 0px;
	margin 0px;
	height: 100%;
	width: 100%;
	background-color: #ffffff;
	position: relative;
	overflow: auto;
}
