	<parameter name="folioUltimo" class="java.lang.Integer"/>
	<queryString>
		<![CDATA[SELECT
		Folio, (aEjercicioFiscal + '/' + CAST(Folio AS VARCHAR)) AS cFolio, cDescripcionProyecto, cJustifSolicitud,
		(cDescripcionProyecto + ' , ' + cJustifSolicitud) AS JustificacionSolicitud,
		compJustificacion,
		cDocumentoHaplicado, aEjercicioFiscal,
		cRamo, cUnidadResponsable, cCentroContable,
		fCaptura, fAplicacion, fInicio, fFin, fCancelacion, U_Login,
		nTipoContrato, cTipoContrato, cFolioMASCP, cOficioDG,
		nSolicitud, cSolicitud, nEspecificacion, cEspecificacionContrato,
		nTipoMoneda, cTipoMoneda,
		mMontoMinimo, MontoMinimo, mMontoMaximo, MontoMaximo, mTotalContrato, TotalContrato, cantLetrasTotalContrato,
		cEstatus, cFundamentoMotivacion, cEspecificacion, cJustificacionEconomica, cJustificacionPlazo, cMotivoRechazo,
		sFirmanteEla, sPuestoEla, sFirmanteVoBo, sPuestoVoBo,
		sFirmanteAut, sPuestoAut, sFirmanteSol, sPuestoSol, FolioOrigen
        , (select mMontoTotalContrato from tContratosPlurianualEnc_Mod with (NOLOCK) where nFolioContratoPlurianual = $P!{folioUltimo}) montoOriginal
        , (select TotalContrato from vw_ContratosPlurianualEncabezadoMod with (NOLOCK) where Folio = $P!{folioUltimo}) totalOriginal
        , (select cantLetrasTotalContrato from vw_ContratosPlurianualEncabezadoMod with (NOLOCK) where Folio = $P!{folioUltimo}) cantLetraOriginal
	FROM vw_ContratosPlurianualEncabezadoMod WITH (NOLOCK)
	WHERE Folio = $P!{whereFolio}]]>
	</queryString>
