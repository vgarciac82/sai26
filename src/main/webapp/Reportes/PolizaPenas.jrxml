	<import value="net.sf.jasperreports.engine.data.*"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="whereFolio" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT penas.caNoContrarrecibo
		, 'PENASCONV' AS cTipoDocumento
		, fCreacion
		, det.caNoContrarrecibo AS ContrareciboOrigen
		, cTipopago
		, penas.cUnidadResponsable
		, (SELECT D_DESCRIPCION FROM dbo.tCatUnidadResponsable WHERE cUnidadResponsable = penas.cUnidadResponsable) AS cDescripcion
		, SUM(mImporteMasIva) AS mImporteMasIva
		, dbo.fnCantidadLetra(SUM(mImporteMasIva)) AS cantLetras
		, CAST(penas.nFolioPagoPenasConv AS INT) AS nFolioPagoPenasConv
		, RFC
		, (SELECT dNombre + ' ' + dApellidoPaterno + ' ' + dApellidoMaterno FROM dbo.tBeneficiario WHERE dRFC = RFC) AS cnombre
		, cDescripcionPoliza
		, cEjercicio
		, 0.00 AS mimporteSancion
		, 0.00 AS mImporteDevolucion
		, 0.00 AS mAmortizacionAnticipo
		, 0.00 AS mImporteIVA
		, 0.00 AS mimporteRetencion
		, 0.00 AS mimporteBruto
		, SUM(mPenalizacion) AS mPenalizacion
		, sFirmanteVoBo
		, spuestoVoBo
		, sfirmanteAut
		, spuestoAut
	FROM dbo.tPagoPenasConvEncabezado AS penas
	INNER JOIN dbo.tPagoPenasConvDetalle AS det
	ON penas.nFolioPagoPenasConv = det.nFolioPagoPenasConv
where  $P!{whereFolio} and 1 = 1
	GROUP BY penas.caNoContrarrecibo, fCreacion, det.caNoContrarrecibo, cTipopago, penas.cUnidadResponsable, penas.nFolioPagoPenasConv, RFC
		, cDescripcionPoliza, cEjercicio, sFirmanteVoBo, spuestoVoBo, sfirmanteAut, spuestoAut]]>
	</queryString>
