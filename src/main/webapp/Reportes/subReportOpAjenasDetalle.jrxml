	<parameter name="whereFolio" class="java.lang.String">
		<defaultValueExpression><![CDATA["CR.caNoContrarrecibo = '10DD2015100001'"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[WITH CR AS (SELECT CR.caNoContrarrecibo caNoContrarrecibo,D.caNoContrarrecibo caNoContrarreciboDet,D.Ep,D.mTotal
FROM dbo.tOperAjenasDetalle D WITH (NOLOCK)
INNER JOIN dbo.tOperAjenasEncabezado CR WITH (NOLOCK)
ON CR.nFolioOperAjenas = D.nFolioOperAjenas
UNION
SELECT CR.caNoContrarrecibo,D.caNoContrarrecibo,D.Ep,D.mTotal
FROM dbo.tDisminucionDevDetalle D WITH (NOLOCK)
INNER JOIN dbo.tDisminucionDevEncabezado CR WITH (NOLOCK)
ON D.nFolioDisminucionDev = CR.nFolioDisminucionDev
)
SELECT * FROM CR
WHERE $P!{whereFolio} AND 1 = 1]]>
	</queryString>
	<field name="caNoContrarrecibo" class="java.lang.String"/>
	<field name="caNoContrarreciboDet" class="java.lang.String"/>
	<field name="Ep" class="java.lang.String"/>
	<field name="mTotal" class="java.math.BigDecimal"/>
