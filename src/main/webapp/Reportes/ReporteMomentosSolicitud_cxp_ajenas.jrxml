<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="ReporteMomentosSolicitud_cxp_ajenas"  pageWidth="180" pageHeight="80" columnWidth="180" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0">
	<property name="ireport.zoom" value="2.1435888100000025"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="CxP" class="java.lang.String">
		<defaultValueExpression><![CDATA[$F{AJENA}.toString()]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT DISTINCT (SELECT enc.caNoContrarrecibo FROM dbo.tOperAjenasEncabezado enc WITH (NOLOCK) WHERE enc.nFolioOperAjenas = det.nFolioOperAjenas) AS AJENA
, SUM(det.mTotal) AS MONTO
FROM dbo.tOperAjenasDetalle det
WHERE det.caNoContrarrecibo = $P{CxP}
AND (SELECT enc.cDocumentoHaplicado FROM dbo.tOperAjenasEncabezado enc WITH (NOLOCK) WHERE enc.nFolioOperAjenas = det.nFolioOperAjenas) = 'S'
GROUP BY det.nFolioOperAjenas

UNION

SELECT DISTINCT (SELECT enc.caNoContrarrecibo FROM dbo.tPagoPenasConvEncabezado enc WITH (NOLOCK) WHERE enc.nFolioPagoPenasConv = det.nFolioPagoPenasConv) AS AJENA
, SUM(det.mPenalizacion) AS MONTO
FROM dbo.tPagoPenasConvDetalle det
WHERE det.caNoContrarrecibo = $P{CxP}
AND (SELECT enc.cDocumentoHaplicado FROM dbo.tPagoPenasConvEncabezado enc WITH (NOLOCK) WHERE enc.nFolioPagoPenasConv = det.nFolioPagoPenasConv) = 'S'
GROUP BY det.nFolioPagoPenasConv]]>
	</queryString>
	<field name="AJENA" class="java.lang.String"/>
	<field name="MONTO" class="java.math.BigDecimal"/>
	<background>
		<band splitType="Stretch"/>
	</background>
	<columnHeader>
		<band height="12" splitType="Stretch">
			<staticText>
				<reportElement x="3" y="0" width="112" height="12"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font size="7" isBold="true"/>
				</textElement>
				<text><![CDATA[Operación Ajena / Penalización]]></text>
			</staticText>
			<staticText>
				<reportElement x="115" y="0" width="66" height="12"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font size="7" isBold="true"/>
				</textElement>
				<text><![CDATA[Importe]]></text>
			</staticText>
		</band>
	</columnHeader>
	<detail>
		<band height="11" splitType="Stretch">
			<textField pattern="¤ #,##0.00">
				<reportElement x="115" y="0" width="66" height="11"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font size="8"/>
				</textElement>
				<textFieldExpression class="java.math.BigDecimal"><![CDATA[$F{MONTO}]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true" pattern="" isBlankWhenNull="true">
				<reportElement x="3" y="0" width="112" height="11"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font size="8"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{AJENA}]]></textFieldExpression>
			</textField>
		</band>
	</detail>
</jasperReport>
