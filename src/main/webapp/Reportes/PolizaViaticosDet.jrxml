	<parameter name="idComision" class="java.lang.String"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT tAgenda.nIdComision, fInicio ,fFin ,
UPPER(pais.cPais) + ', ' +  estados.EDO_NOMBRE + ', '  + Municipio.MPO_NOMBRE Destino,
(CASE TAGENDA.nidPais WHEN  146 THEN 'Nacional' else 'Internacional' end ) tipo
, cMotivoComision, cActividades actividades, mCuotaPorDia
, cCveTipoMoneda cMoneda
, dias, mCuotaPorDia
, Importe  cuota,
mTipoCambio
from v_AgendaViaticos tAgenda
INNER JOIN tCatalogoPaises pais (NOLOCK)
ON pais.nIdPais = tAgenda.nidPais
INNER JOIN CAT_ESTADOS estados (NOLOCK)
ON estados.ID_ESTADO = tAgenda.nidEstado
INNER JOIN CAT_MUNICIPIO Municipio (NOLOCK)
ON Municipio.ID_MUNICIPIO = tAgenda.nidMunicipio
INNER JOIN tCatalogoTipoMoneda moneda (NOLOCK)
on tAgenda.cMoneda = moneda.id
WHERE NIDCOMISION = $P{idComision}]]>
	</queryString>
