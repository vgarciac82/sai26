	<parameter name="cEjercicio" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="cIdTipoSolicitud" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="cIdUnidadEjecutora" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="nIdConsecutivo" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="formato" class="java.lang.String"/>
	<queryString>
		<![CDATA[declare @cEjercicio char(4), @cIdUnidadEjecutora char(3), @nIdConsecutivo int, @cIdTipoSolicitud char(2),@montoNetoSolicitud money,@montoBrutoSolicitud money,@mMontoIVA money;
--set @cEjercicio = '2015';
--set @cIdUnidadEjecutora = 'A04';
--set @nIdConsecutivo = '5';
--set @cIdTipoSolicitud = 'RS';

set @cEjercicio = $P{cEjercicio};
set @cIdUnidadEjecutora = $P{cIdUnidadEjecutora};
set @nIdConsecutivo = $P{nIdConsecutivo};
set @cIdTipoSolicitud = $P{cIdTipoSolicitud};


--obtenemos monto total de la requisiscion
select @montoNetoSolicitud=sum(xx.montoneto),@montoBrutoSolicitud=sum(xx.montoBruto),@mMontoIVA=SUM(xx.montoIVA) from(
select  round(x.mMontoNeto,2)montoneto, x.montoBruto,round(x.montoIVA,2) montoIVA
	from(SELECT convert(money,  sum(round((nCantidad * mPrecioUnitario),2))) AS montoBruto,nPorcentajeIVA,sum(mMontoNeto) as mMontoNeto
				,convert(money,  sum(round((nCantidad * mPrecioUnitario*nPorcentajeIVA)/100,2))) as montoIVA
				from mSolicitudLineas WHERE cIdEstadoLinea<>'C' AND cEjercicio=@cEjercicio and cIdUnidadEjecutora=@cIdUnidadEjecutora
				and nIdConsecutivo=@nIdConsecutivo and cIdTipoSolicitud=@cIdTipoSolicitud  group by nPorcentajeIVA)x)xx


SELECT
	ms.cIdSolicitud,
	ms.cEjercicio,
	ms.cIdUnidadEjecutora,
	--mSolicitud
	UPPER('[' + tUE.cUnidadEjecutora + '] ' + tUE.D_DESCRIPCION) AS cUnidadEjecutora,
	'REQUISICIÓN ' + UPPER(tTS.cTipoSolicitud)+' ' + ms.cIdSolicitud AS cTipoSolicitud,
	'ESTADO: ' + UPPER(tES.cEstado) AS cEstado,
	'Descripción: ' + ms.cDescripcion AS cDescripcion,
	'Fecha de Elaboración: ' + CONVERT(varchar,ms.fCreacion,103) AS fCreacion,
	'Fecha Requerida: ' + CONVERT(varchar,ms.fRequerida,103) AS fRequerida,
	'Plazo: ' + convert(varchar,ms.nIdPlazo) + ' días naturales' AS nIdPlazo,
	'Plurianualidad: ' + ms.cPlurianualidad AS cplurianualidad,
	'Tipo de procedimiento: ' + tp.cCategoria AS nIdCategoria,
	'Anexos: ' + CONVERT(varchar,CASE WHEN ms.lAnexos = 0 THEN 'No' ELSE 'Si' END) AS lAnexos,

	case when ms.cIdAlmacen='.'
			then 'Lugar de Adquisición de los bienes o ejecución de los servicios: --NO APLICA--'
		WHEN ms.cIdAlmacen='..'
			then 'Lugar de Adquisición de los bienes o ejecución de los servicios: --SEGUN ANEXO--'
		ELSE 'Lugar de Adquisición de los bienes o ejecución de los servicios: ' + (ms.cIdAlmacen +' - '+ (select D_DESCRIPCION from v_unidadEjecutoraPadre where cUnidadResponsable=ms.cIdAlmacen))
	END AS cIdAlmacen,
	'Lugar de Entrega: ' + tAE.cAlmacen AS cIdAlmacenEntrega,

	'Tipo de garantía: ' + (select distinct cDescripcion from mCatalogoTipoGarantia where nIdTipoGarantia=ms.cTipoGarantia) AS cTipoGarantia,
	case when ms.mPorcentajeGarantia>0
	then 'Porcentaje de garantía: ' + convert(varchar,ms.mPorcentajeGarantia) + '%'
	else 'Porcentaje de garantía: ' + (select distinct cIdPorcentaje from mCatalogoTipoGarantia where nIdTipoGarantia=ms.cTipoGarantia and mPorcentaje=ms.mPorcentajeGarantia and nId=ms.nIdTipoGarantia)
	end AS mPorcentajeGarantia,

	'Importe Póliza de Responsabilidad civil: $' + convert(varchar, ms.mImportePoliza) AS mImportePoliza,
	'Periodo: ' + tM.cMes AS nIdPeriodo,
	'Partida: ' + tSP.cIdSubPartida AS cIdSubPartida,
	'Alcance: ' + convert(varchar,tAlc.cAlcance) AS nIdAlcance,
	'Observaciones: ' + ms.cObservaciones As cObservaciones,
	--'$' + ISNULL(CONVERT(varchar, mslMonto.montoNeto, 1),'0.00') AS montoNeto,
	--'$' + ISNULL(CONVERT(varchar, mslMonto.montoBruto, 1),'0.00') AS montoBruto,
	--'$' + ISNULL(CONVERT(varchar, mslMonto.montoNeto - mslMonto.montoBruto, 1),'0.00') AS cIVA,
	'$' + ISNULL(CONVERT(varchar,@montoNetoSolicitud , 1),'0.00') AS montoNeto,
	'$' + ISNULL(CONVERT(varchar, @montoBrutoSolicitud, 1),'0.00') AS montoBruto,
	--'$' + ISNULL(CONVERT(varchar, @montoNetoSolicitud - @montoBrutoSolicitud, 1),'0.00') AS cIVA,
	case when (@montoNetoSolicitud-@montoBrutoSolicitud)>0.5 then '$' + ISNULL(CONVERT(varchar, @montoNetoSolicitud - @montoBrutoSolicitud, 1),'0.00')
	else '$'+(convert(varchar, @mMontoIVA,1)) end cIVA,
	--mSolicitudFirmantes
	ISNULL(msf1.cPuesto, 'FIRMANTE NO AGREGADO') AS cPuesto1,
	ISNULL(msf1.cNombre, 'FIRMANTE NO AGREGADO') AS cNombre1,
	ISNULL(msf2.cPuesto, 'FIRMANTE NO AGREGADO') AS cPuesto2,
	ISNULL(msf2.cNombre, 'FIRMANTE NO AGREGADO') AS cNombre2,
	ISNULL(msf3.cPuesto, 'FIRMANTE NO AGREGADO') AS cPuesto3,
	ISNULL(msf3.cNombre, 'FIRMANTE NO AGREGADO') AS cNombre3,
	ISNULL(msf4.cPuesto, 'FIRMANTE NO AGREGADO') AS cPuesto4,
	ISNULL(msf4.cNombre, 'FIRMANTE NO AGREGADO') AS cNombre4,
	--mSolicitudLineas
	ISNULL(msl.cIdCABM, '') AS cIdCABM,
	ISNULL(convert(varchar,msl.nIdLineaSolicitud),'') AS nIdLineaSolicitud,
	--CASE WHEN CONVERT(varchar, ISNULL(msl.nIdLineaSolicitud, '')) = '0' THEN '' ELSE msl.nIdLineaSolicitud END AS nIdLineaSolicitud,
	ISNULL(msl.cDescripcion, '') AS cDescripcionLinea,
	ISNULL(msl.cDescripcionAdicional, '') AS cDescripcionLineaAdicional,
	ISNULL(convert(varchar,msl.nCantidad),'') AS nCantidad,
	--CASE WHEN msl.nCantidad = 0 OR msl.nCantidad = NULL THEN '' ELSE msl.nCantidad END AS nCantidad,
	ISNULL(msl.cUnidadMedida, '') AS cUnidadMedida,
	CASE WHEN msl.mPrecioUnitario <> '' THEN '$' ELSE '' END + ISNULL(CONVERT(varchar, msl.mPrecioUnitario, 1), '') AS mPrecioUnitario,
	CASE WHEN msl.mPrecioUnitario <> '' THEN '$' ELSE '' END + ISNULL(CONVERT(varchar, CONVERT(MONEY, msl.mMontoNeto ), 1), '') AS nTotal,
	isnull((select '$'+convert(varchar,SUM(monto),1) from
	(
		SELECT cIdSolicitud, ClaveSIAFF, ClaveInterna,
		MontoEnero as mes01, MontoFebrero as mes02, MontoMarzo as mes03,
		MontoAbril as mes04, MontoMayo as mes05, MontoJunio as mes06,
		MontoJulio as mes07, MontoAgosto as mes08, MontoSeptiembre as mes09,
		MontoOctubre as mes10, MontoNoviembre as mes11, MontoDiciembre as mes12
		FROM vPresupuestoSolicitudEP
		--WHERE cEjercicio = @cEjercicio AND cIdUnidadEjecutora = @cIdUnidadEjecutora AND cIdSolicitud = @cIdSolicitud
		)
	Main UNPIVOT (Monto FOR Meses IN (mes01, mes02, mes03, mes04, mes05, mes06,
	mes07, mes08, mes09, mes10, mes11, mes12) ) Mes	WHERE Monto > 0 and cIdSolicitud=ms.cIdSolicitud
	group by cIdSolicitud
	),0.00) as totalEp
	,'Requisición creada por: '+isnull((select U_NOMBRE from cg_usuario where U_LOGIN=ms.cIdUsuarioCreacion),'')UsuarioCreacion
from mSolicitud ms WITH (nolock) inner join
	tCatUnidadEjecutora tUE WITH (nolock) on
		ms.cIdUnidadEjecutora = tUE.cUnidadEjecutora
	inner join mCatalogoAlcance tAlc  WITH (nolock) on
		tAlc.nIdAlcance = ms.nIdAlcance
	inner join mCatalogoTipoSolicitud tTS WITH (nolock) on
		tTs.cIdTipoSolicitud = ms.cIdTipoSolicitud
	inner join mCatalogoEstadoSolicitud tES WITH (nolock) on
		tES.nIdEstado = ms.nIdEstado
	inner join mCatalogoCategoriaProcedimiento tP  WITH (nolock) on
		tP.nIdCategoria = ms.nIdCategoria
	--inner join mCatalogoAlmacen tA WITH (nolock) on
	--	tA.cIdAlmacen = ms.cIdAlmacen
	inner join mCatalogoAlmacen tAE  WITH (nolock) on
		tAE.cIdAlmacen = ms.cIdAlmacenEntrega
	inner join mCatalogoSubPartida tSP WITH (nolock) on
		tSp.cIdSubPartida = ms.cIdSubPartida
	inner join mCatalogoMes tM WITH (nolock) on
		tM.nIdPeriodo = ms.nIdPeriodo
	left outer join
		(select
		msf.cEjercicio,
		msf.cIdTipoSolicitud,
		msf.nIdConsecutivo,
		msf.cIdUnidadEjecutora,
		msf.cIdSolicitud,
		tf.cPuesto AS cPuesto,
		tf.cNombre + ' ' + tf.cPaterno + ' ' + tf.cMaterno AS cNombre
		FROM
		--EQUIJUNTAS
		mSolicitudFirmantes msf WITH (nolock),
		mCatalogoFirmantes tF WITH (nolock)
		WHERE
		msf.nIdFirmante = tF.nIdFirmante AND msf.cIdUnidadEjecutora = tf.cIdUnidadEjecutora
		AND msf.cEjercicio = @cEjercicio AND msf.cIdTipoSolicitud = @cIdTipoSolicitud AND msf.cIdUnidadEjecutora = @cIdUnidadEjecutora AND msf.nIdConsecutivo = @nIdConsecutivo AND msf.nNumeroFirmante = 1
	) AS msf1 on
	 msf1.cIdUnidadEjecutora=ms.cIdUnidadEjecutora
	 and msf1.nIdConsecutivo=ms.nIdConsecutivo
	 and msf1.cEjercicio=ms.cEjercicio
	 and msf1.cIdSolicitud=ms.cIdSolicitud
	left outer join
		(select
		msf.cEjercicio,
		msf.cIdTipoSolicitud,
		msf.nIdConsecutivo,
		msf.cIdUnidadEjecutora,
		msf.cIdSolicitud,
		tf.cPuesto AS cPuesto,
		tf.cNombre + ' ' + tf.cPaterno + ' ' + tf.cMaterno AS cNombre
		FROM
		--EQUIJUNTAS
		mSolicitudFirmantes msf WITH (nolock),
		mCatalogoFirmantes tF WITH (nolock)
		WHERE
		msf.nIdFirmante = tF.nIdFirmante AND msf.cIdUnidadEjecutora = tf.cIdUnidadEjecutora
		AND msf.cEjercicio = @cEjercicio AND msf.cIdTipoSolicitud = @cIdTipoSolicitud AND msf.cIdUnidadEjecutora = @cIdUnidadEjecutora AND msf.nIdConsecutivo = @nIdConsecutivo AND msf.nNumeroFirmante =2
	) AS msf2 on
	 msf2.cIdUnidadEjecutora=ms.cIdUnidadEjecutora
	 and msf2.nIdConsecutivo=ms.nIdConsecutivo
	 and msf2.cEjercicio=ms.cEjercicio
	 and msf2.cIdSolicitud=ms.cIdSolicitud
	 left outer join
		(select
		msf.cEjercicio,
		msf.cIdTipoSolicitud,
		msf.nIdConsecutivo,
		msf.cIdUnidadEjecutora,
		msf.cIdSolicitud,
		tf.cPuesto AS cPuesto,
		tf.cNombre + ' ' + tf.cPaterno + ' ' + tf.cMaterno AS cNombre
		FROM
		--EQUIJUNTAS
		mSolicitudFirmantes msf WITH (nolock),
		mCatalogoFirmantes tF WITH (nolock)
		WHERE
		msf.nIdFirmante = tF.nIdFirmante AND msf.cIdUnidadEjecutora = tf.cIdUnidadEjecutora
		AND msf.cEjercicio = @cEjercicio AND msf.cIdTipoSolicitud = @cIdTipoSolicitud AND msf.cIdUnidadEjecutora = @cIdUnidadEjecutora AND msf.nIdConsecutivo = @nIdConsecutivo AND msf.nNumeroFirmante = 3
	) AS msf3 on
	 msf3.cIdUnidadEjecutora=ms.cIdUnidadEjecutora
	 and msf3.nIdConsecutivo=ms.nIdConsecutivo
	 and msf3.cEjercicio=ms.cEjercicio
	 and msf3.cIdSolicitud=ms.cIdSolicitud



	  left outer join
		(select
		msf.cEjercicio,
		msf.cIdTipoSolicitud,
		msf.nIdConsecutivo,
		msf.cIdUnidadEjecutora,
		msf.cIdSolicitud,
		tf.cPuesto AS cPuesto,
		tf.cNombre + ' ' + tf.cPaterno + ' ' + tf.cMaterno AS cNombre
		FROM
		--EQUIJUNTAS
		mSolicitudFirmantes msf WITH (nolock),
		mCatalogoFirmantes tF WITH (nolock)
		WHERE
		msf.nIdFirmante = tF.nIdFirmante AND msf.cIdUnidadEjecutora = tf.cIdUnidadEjecutora
		AND msf.cEjercicio = @cEjercicio AND msf.cIdTipoSolicitud = @cIdTipoSolicitud AND msf.cIdUnidadEjecutora = @cIdUnidadEjecutora AND msf.nIdConsecutivo = @nIdConsecutivo AND msf.nNumeroFirmante = 4
	) AS msf4 on
	 msf4.cIdUnidadEjecutora=ms.cIdUnidadEjecutora
	 and msf4.nIdConsecutivo=ms.nIdConsecutivo
	 and msf4.cEjercicio=ms.cEjercicio
	 and msf4.cIdSolicitud=ms.cIdSolicitud

/*
	 left outer join (
	 SELECT cEjercicio, nIdConsecutivo, cIdUnidadEjecutora, cIdTipoSolicitud,
	-- CONVERT(MONEY, SUM(nCantidad * mPrecioUnitario)) AS montoBruto,
	  --CONVERT(MONEY, SUM(round(nCantidad * mPrecioUnitario * ( 1 + CONVERT(MONEY,nPorcentajeIVA) / 100),2))) AS montoNeto
	  from mSolicitudLineas msl WITH (nolock) WHERE cEjercicio = @cEjercicio AND nIdConsecutivo = @nIdConsecutivo
	  AND cIdTipoSolicitud = @cIdTipoSolicitud
	  AND cIdunidadEjecutora = @cIdUnidadEjecutora
	   GROUP BY cEjercicio, nIdConsecutivo, cIdUnidadEjecutora, cIdTipoSolicitud) AS mslMonto on



	    ms.cEjercicio=mslMonto.cEjercicio
	    and ms.nIdConsecutivo=mslMonto.nIdConsecutivo
	    and ms.cIdUnidadEjecutora=mslMonto.cIdUnidadEjecutora
	    and ms.cIdTipoSolicitud=mslMonto.cIdTipoSolicitud

	   */

	 left outer join (SELECT msl.*, tUM.cUnidadMedida FROM mSolicitudLineas msl WITH (nolock), mCatalogoCABM tCABM WITH (nolock), mCatalogoUnidadMedida tUM WITH (nolock) WHERE msl.cIdCABM = tCABM.cIdCABM AND tCABM.cIdUnidadMedida = tUM.cIdUnidadMedida
	 and msl.cIdSubPartida= tCABM.cIdSubPartida) AS msl ON
	    ms.cEjercicio=msl.cEjercicio
	    and ms.nIdConsecutivo=msl.nIdConsecutivo
	    and ms.cIdUnidadEjecutora=msl.cIdUnidadEjecutora
	    and ms.cIdTipoSolicitud=msl.cIdTipoSolicitud

WHERE ms.cEjercicio = @cEjercicio
AND ms.cIdTipoSolicitud = @cIdTipoSolicitud
AND ms.cIdUnidadEjecutora = @cIdUnidadEjecutora
AND ms.nIdConsecutivo = @nIdConsecutivo]]>
	</queryString>
	<field name="cIdSolicitud" class="java.lang.String"/>
	<field name="cEjercicio" class="java.lang.String"/>
	<field name="cIdUnidadEjecutora" class="java.lang.String"/>
	<field name="cUnidadEjecutora" class="java.lang.String"/>
	<field name="cTipoSolicitud" class="java.lang.String"/>
	<field name="cEstado" class="java.lang.String"/>
	<field name="cDescripcion" class="java.lang.String"/>
	<field name="fCreacion" class="java.lang.String"/>
	<field name="fRequerida" class="java.lang.String"/>
	<field name="nIdPlazo" class="java.lang.String"/>
	<field name="cplurianualidad" class="java.lang.String"/>
	<field name="nIdCategoria" class="java.lang.String"/>
	<field name="lAnexos" class="java.lang.String"/>
	<field name="cIdAlmacen" class="java.lang.String"/>
	<field name="cIdAlmacenEntrega" class="java.lang.String"/>
	<field name="cTipoGarantia" class="java.lang.String"/>
	<field name="mPorcentajeGarantia" class="java.lang.String"/>
	<field name="mImportePoliza" class="java.lang.String"/>
	<field name="nIdPeriodo" class="java.lang.String"/>
	<field name="cIdSubPartida" class="java.lang.String"/>
	<field name="nIdAlcance" class="java.lang.String"/>
	<field name="cObservaciones" class="java.lang.String"/>
	<field name="montoNeto" class="java.lang.String"/>
	<field name="montoBruto" class="java.lang.String"/>
	<field name="cIVA" class="java.lang.String"/>
	<field name="cPuesto1" class="java.lang.String"/>
	<field name="cNombre1" class="java.lang.String"/>
	<field name="cPuesto2" class="java.lang.String"/>
	<field name="cNombre2" class="java.lang.String"/>
	<field name="cPuesto3" class="java.lang.String"/>
	<field name="cNombre3" class="java.lang.String"/>
	<field name="cPuesto4" class="java.lang.String"/>
	<field name="cNombre4" class="java.lang.String"/>
	<field name="cIdCABM" class="java.lang.String"/>
	<field name="nIdLineaSolicitud" class="java.lang.String"/>
	<field name="cDescripcionLinea" class="java.lang.String"/>
	<field name="cDescripcionLineaAdicional" class="java.lang.String"/>
	<field name="nCantidad" class="java.lang.String"/>
	<field name="cUnidadMedida" class="java.lang.String"/>
	<field name="mPrecioUnitario" class="java.lang.String"/>
	<field name="nTotal" class="java.lang.String"/>
	<field name="totalEp" class="java.lang.String"/>
	<field name="UsuarioCreacion" class="java.lang.String"/>
	<variable name="cIdUnidadEjecutora_1" class="java.lang.Integer" resetType="Group" resetGroup="uni" calculation="Count">
		<variableExpression><![CDATA[$F{cIdUnidadEjecutora}]]></variableExpression>
	</variable>
	<group name="uni">
		<groupExpression><![CDATA[$F{cIdUnidadEjecutora}]]></groupExpression>
		<groupHeader>
			<band height="180">
				<staticText>
					<reportElement x="1" y="164" width="76" height="13"/>
					<textElement>
						<font fontName="Arial" size="8"/>
					</textElement>
					<text><![CDATA[CUCOP]]></text>
				</staticText>
				<line>
					<reportElement x="1" y="179" width="769" height="1"/>
				</line>
				<staticText>
					<reportElement x="77" y="164" width="41" height="13"/>
					<textElement>
						<font fontName="Arial" size="8"/>
					</textElement>
					<text><![CDATA[# Linea]]></text>
				</staticText>
				<staticText>
					<reportElement x="118" y="164" width="230" height="13"/>
					<textElement>
						<font fontName="Arial" size="8"/>
					</textElement>
					<text><![CDATA[Descripción]]></text>
				</staticText>
				<staticText>
					<reportElement x="504" y="164" width="58" height="13"/>
					<textElement>
						<font fontName="Arial" size="8"/>
					</textElement>
					<text><![CDATA[Cantidad]]></text>
				</staticText>
				<staticText>
					<reportElement x="562" y="164" width="43" height="13"/>
					<textElement>
						<font fontName="Arial" size="8"/>
					</textElement>
					<text><![CDATA[U.M.]]></text>
				</staticText>
				<staticText>
					<reportElement x="605" y="164" width="71" height="13"/>
					<textElement textAlignment="Right">
