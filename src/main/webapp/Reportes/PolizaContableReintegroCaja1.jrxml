	<field name="Debe" class="java.math.BigDecimal"/>
	<field name="Haber" class="java.math.BigDecimal"/>
	<variable name="porcIva" class="java.lang.String">
		<initialValueExpression><![CDATA[]]></initialValueExpression>
	</variable>
	<variable name="laEP" class="java.lang.String">
		<initialValueExpression><![CDATA["VARIAS"]]></initialValueExpression>
	</variable>
	<variable name="Debe_1" class="java.math.BigDecimal" resetType="Group" resetGroup="caNoContrarrecibo" calculation="Sum">
		<variableExpression><![CDATA[]]></variableExpression>
	</variable>
	<variable name="Haber_1" class="java.math.BigDecimal" resetType="Group" resetGroup="caNoContrarrecibo" calculation="Sum">
		<variableExpression><![CDATA[]]></variableExpression>
	</variable>
	<variable name="noPoliza" class="java.lang.String">
		<initialValueExpression><![CDATA[]]></initialValueExpression>
	</variable>
	<variable name="Debe_2" class="java.math.BigDecimal" resetType="Group" resetGroup="caNoContrarrecibo" calculation="Sum">
		<variableExpression><![CDATA[$F{Debe}]]></variableExpression>
	</variable>
	<variable name="Haber_2" class="java.math.BigDecimal" resetType="Group" resetGroup="caNoContrarrecibo" calculation="Sum">
