	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["C:\\Users\\ULISES\\Workspaces\\CONAFOR\\SAI_CNF\\WebContent\\Reportes"]]></defaultValueExpression>
	</parameter>
	<parameter name="whereFolio" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT encabezado.nFolioAnexo1,
       CASE
         WHEN encabezado.ccentrocontable = '10' THEN 'OFICINAS CENTRALES'
         ELSE 'GERENCIA ESTATAL'
       END                                      cDescripcion,
       encabezado.cunidadresponsable + ' - '
       + d_descripcion                          AS cUnidadResponsable,
       fCaptura faplicacion,
       canocontrarrecibo,
       ctipoanexo,
       cconcepto,
       encabezado.mimporte,
       dbo.Fncantidadletra(encabezado.mimporte) AS cantLetras,
       encabezado.cunidadresponsable,
       ''                                       RfcContrato,
       ''                                       NombreContrato,
       ''                                       cIdContrato,
       ep,
       detalle.mimporte                         ImporteDetalle,
       cmes,
       sfirmantevobo,
       spuestovobo,
       sfirmanteaut,
       spuestoaut,
       sFirmanteEla,
       sPuestoEla,
		CASE WHEN delegatorioAut.cNombreTitular IS NULL
			THEN ''
			ELSE ( delegatorioAut.cNombreTitular + ' ' + delegatorioAut.cApellidoPaternoTitular + ' ' + delegatorioAut.cApellidoMaternoTitular ) END
			AS sFirmanteDelegatorio,
		CASE WHEN delegatorioAut.cPuestoTitular IS NULL
			THEN ''
			ELSE delegatorioAut.cPuestoTitular END
			AS sPuestoFirmanteDelegatorio,
		CASE WHEN delegatorioAut.cNombreTitular IS NULL
			THEN ''
			ELSE	('Firma en suplencia de: ' + sfirmanteaut + ', con fundamento en el oficio: ' + delegatorioAut.cFolioOficio + ', de fecha: '
					+ CONVERT(varchar(10), CONVERT(date, delegatorioAut.dFechaOficio, 106), 103)) END
			AS Leyenda,
       CASE WHEN delegatorioVoBo.cNombreTitular IS NULL
			THEN ''
			ELSE ( delegatorioVoBo.cNombreTitular + ' ' + delegatorioVoBo.cApellidoPaternoTitular + ' ' + delegatorioVoBo.cApellidoMaternoTitular ) END
			AS sFirmanteDeleVoBo,
		CASE WHEN delegatorioVoBo.cPuestoTitular IS NULL
			THEN ''
			ELSE delegatorioVoBo.cPuestoTitular END
			AS sPuestoFirmanteDeleVoBo,
		CASE WHEN delegatorioVoBo.cNombreTitular IS NULL
			THEN ''
			ELSE	('Firma en suplencia de: ' + sfirmantevobo + ', con fundamento en el oficio: ' + delegatorioVoBo.cFolioOficio + ', de fecha: '
					+ CONVERT(varchar(10), CONVERT(date, delegatorioVoBo.dFechaOficio, 106), 103)) END
			AS LeyendaVoBo

FROM  	dbo.tanexo1encabezado encabezado WITH ( nolock )
	INNER JOIN dbo.tanexo1detalle detalle WITH ( nolock )
		ON encabezado.nFolioAnexo1 = detalle.nFolioAnexo1
	INNER JOIN dbo.tcatunidadresponsable UR
		ON encabezado.cunidadresponsable = UR.cunidadresponsable
	LEFT JOIN tPagoFirmanteDelagatorio delegatorioAut  WITH (NOLOCK)
		ON ( delegatorioAut.nFolioPago = encabezado.nFolioAnexo1 AND delegatorioAut.cTipoPago = 'ANEXO1' )
	LEFT JOIN tPagoFirmanteDelegatorioVoBo delegatorioVoBo  WITH (NOLOCK)
		ON ( delegatorioVoBo.nFolioPago = encabezado.nFolioAnexo1 AND delegatorioVoBo.cTipoPago = 'ANEXO1' )
WHERE  encabezado.caNoContrarrecibo = $P{whereFolio}]]>
	</queryString>
