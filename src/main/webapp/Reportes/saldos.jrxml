<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="saldos"  pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<property name="ireport.zoom" value="1.6105100000000068"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="96"/>
	<queryString>
		<![CDATA[SELECT 1 AS nFolioPoliza ---
	, 'SALDOS INICIALES' AS cDescripcionTipoPoliza---
	, 'Poliza de saldos iniciales' AS cDescripcionPoliza ---
	, SUBSTRING(dbo.tCuentas.nCuenta,1,5) AS cuenta ---
	, CASE SUBSTRING(dbo.tCuentas.nCuenta,7,5) WHEN '00000' THEN '' ELSE SUBSTRING(dbo.tCuentas.nCuenta,7,5) END AS subcuenta ---
	, CASE SUBSTRING(dbo.tCuentas.nCuenta,13,5) WHEN '00000' THEN '' ELSE SUBSTRING(dbo.tCuentas.nCuenta,13,5) END AS subscuenta ---
	, dCuenta AS nomCuenta ---
	, NombreSub AS nomSubCuenta ---
	, s.cSubCuenta AS nomSubSCuenta ---
	, '01/01/2015' AS fAplicacion ---
	, 'Consolidado' AS cDescripcion ---
	, CASE NaturalezaCuenta WHEN 'D' THEN mSaldoInicial ELSE 0 END mMovimientoC ---
	, CASE NaturalezaCuenta WHEN 'A' THEN mSaldoInicial ELSE 0 END mMovimientoA ---
	, (SELECT SUM(mSaldoInicial)/2 FROM dbo.tSaldosIniciales) AS mTotalCargo
	, (SELECT SUM(mSaldoInicial)/2 FROM dbo.tSaldosIniciales) AS mTotalAbono
FROM dbo.tSaldosIniciales AS s
JOIN dbo.tCuentas ON s.nCuenta = dbo.tCuentas.nCuenta
LEFT JOIN(
			SELECT DISTINCT dRFC AS IDSubCuenta, ISNULL(dRFC+' '+ ISNULL(dNombre,'')+' '+ISNULL(dApellidoPaterno,'')+' '+ISNULL(dApellidoMaterno,''),' ') AS NombreSub
			FROM tBeneficiario WITH(NOLOCK)
		UNION ALL
			SELECT DISTINCT cPartida AS IDSubCuenta,cPartida+' '+ dPartida AS NombreSub FROM tCatalogoPartida WITH(NOLOCK)
		UNION ALL
			SELECT DISTINCT strClabe AS IDSubCuenta, strClabe+' '+strNombreBeneficiario AS NombreSub FROM tUECuentasBancarias WITH(NOLOCK)
		--UNION ALL
		--	select DISTINCT dCuentaBancaria AS IDSubCuenta, dCuentaBancaria+' '+dRFC AS NombreSub FROM tBeneficiarioCuentasBancarias WITH(NOLOCK)
		UNION ALL
			select DISTINCT EP AS IDSubCuenta, EP AS NombreSub  FROM tCatalogoEP WITH(NOLOCK)
		UNION ALL
			SELECT DISTINCT sCodigoEntidad AS IDSubCuenta, sCodigoEntidad+' '+sbeneficiario AS NombreSub FROM dbo.tBeneficiarioCapituloMil WITH(NOLOCK)
		) AS subCuentas ON s.cSubCuenta = IDSubCuenta
ORDER BY SUBSTRING(dbo.tCuentas.nCuenta,1,5)]]>
	</queryString>
