				<textElement markup="styled">
					<font fontName="Arial" isBold="true" isStrikeThrough="false"/>
				</textElement>
				<text><![CDATA[Por lo tanto, el MCCG tiene como propósitos:]]></text>
			</staticText>
			<textField textAdjust="StretchHeight" isBlankWhenNull="true">
