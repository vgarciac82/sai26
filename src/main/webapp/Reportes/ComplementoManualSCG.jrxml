				<textElement markup="styled">
					<font fontName="Arial" isBold="false" isStrikeThrough="false"/>
				</textElement>
				<text><![CDATA[En virtud de lo anterior, la importancia del MCCG para el usuario general de los estados financieros radica en lo siguiente:]]></text>
