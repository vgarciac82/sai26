		<![CDATA[declare @Salida varchar(100);
EXECUTE sp_pMultiReporte_syc '', '''81101'',''81102'',''81103'',''81104'',''81105'',''81106'',''81107'',''81108'',''81109'',''81110'',''82101'',''82102'',''82103'',''82104'',''82105'',''82106'',''82107'',''82108''', 'cSubCuenta', 'aEjercicioFiscal_1', 'mSaldo12', 'CALENDARIZADO', 'EMULGADO', @Salida OUTPUT,'select replace(dCuenta,''_'','' '') dCuenta,  isnull(sum(ORIGINAL),0)+isnull(sum(MODIFICADO),0)+isnull(sum(AMPLIACION_AUTORIZADA),0)+isnull(sum(REDUCCION_AUTORIZADA),0)+isnull(sum(AMPLIACION_EN_TRAMITE),0)+isnull(sum(REDUCCION_EN_TRAMITE),0)+isnull(sum(REINTEGRO_EN_TRAMITE),0)+isnull(sum(RECTIFICACION),0)+isnull(sum(REDUCCION_SHCP_EN_TRAMITE),0)+isnull(sum(REDUCCION_SHCP_APLICADA),0)+isnull(sum(APARTADO),0)+isnull(sum(PRECOMPROMETIDO),0)+isnull(sum(COMPROMETIDO),0)+isnull(sum(DEVENGADO),0)+isnull(sum(EJERCIDO_NO_PAGADO),0)+isnull(sum(DISPONIBLE_NETO),0)+isnull(sum(DISPONIBLE_BRUTO),0)+isnull(sum(EJERCIDO_PAGADO),0) Monto from #tSaldosPresupuesto WITH (NOLOCK) where Usuario=''EMULGADO'' group by  dCuenta, aEjercicioFiscal_1 order by dCuenta;';
print (@Salida);]]>
