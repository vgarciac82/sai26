<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="rptActaFallo"  pageWidth="612" pageHeight="792" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<property name="ireport.zoom" value="1.3636363636363709"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="352"/>
	<parameter name="IdProcedimiento" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="DIR_REPORT" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["C:\\Users\\Faviola\\gestion_conagua_sif_pruebas\\WebContent\\Reportes\\"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
D_DESCRIPCION,
cDireccion,
CASE WHEN cPuesto1 IS NULL THEN '' ELSE cPuesto1 END AS cPuesto1,
CASE WHEN cFirmante1 IS NULL THEN '' ELSE cFirmante1 END AS cFirmante1,
CASE WHEN cPuesto2 IS NULL THEN '' ELSE cPuesto2 END AS cPuesto2,
CASE WHEN cFirmante2 IS NULL THEN '' ELSE cFirmante2 END AS cFirmante2
FROM (
SELECT
vUA.D_DESCRIPCION,
vUA.calle+' No. '+vUA.numExterior+(CASE WHEN rtrim(ltrim(vUA.numInterior))='' THEN '' ELSE CASE WHEN vUA.numInterior IS NULL THEN '' ELSE ' Int. '+vUA.numInterior END END)+' Col. '+vUA.colonia+', '+vUA.delegacionMunicipio+', '+CAST(vUA.codigoPostal AS VARCHAR)+', '+vUA.estado AS cDireccion,
(SELECT cf.cPuesto FROM mCatalogoFirmantes cf WITH(NOLOCK) INNER JOIN mFirmantesComparativa fc WITH(NOLOCK) ON cf.nIdFirmante=fc.nIdFirmante and fc.cIdUnidadEjecutora=cf.cIdUnidadEjecutora WHERE fc.cIdProcedimiento=$P{IdProcedimiento} AND fc.nNumeroFirmante=1) AS cPuesto1,
(SELECT cf.cNombre FROM mCatalogoFirmantes cf WITH(NOLOCK) INNER JOIN mFirmantesComparativa fc WITH(NOLOCK) ON cf.nIdFirmante=fc.nIdFirmante and fc.cIdUnidadEjecutora=cf.cIdUnidadEjecutora WHERE fc.cIdProcedimiento=$P{IdProcedimiento} AND fc.nNumeroFirmante=1) AS cFirmante1,
(SELECT cf.cPuesto FROM mCatalogoFirmantes cf WITH(NOLOCK) INNER JOIN mFirmantesComparativa fc WITH(NOLOCK) ON cf.nIdFirmante=fc.nIdFirmante and fc.cIdUnidadEjecutora=cf.cIdUnidadEjecutora WHERE fc.cIdProcedimiento=$P{IdProcedimiento} AND fc.nNumeroFirmante=2) AS cPuesto2,
(SELECT cf.cNombre FROM mCatalogoFirmantes cf WITH(NOLOCK) INNER JOIN mFirmantesComparativa fc WITH(NOLOCK) ON cf.nIdFirmante=fc.nIdFirmante and fc.cIdUnidadEjecutora=cf.cIdUnidadEjecutora WHERE fc.cIdProcedimiento=$P{IdProcedimiento} AND fc.nNumeroFirmante=2) AS cFirmante2
FROM mProcedimiento p WITH (NOLOCK) INNER JOIN v_mUnidadesAdministrativas vUA WITH (NOLOCK) ON p.cIdUnidadEjecutora=vUA.claveUnidadAdministrativa
WHERE  p.cIdProcedimiento  = $P{IdProcedimiento}) AS tab]]>
	</queryString>
	<field name="D_DESCRIPCION" class="java.lang.String"/>
	<field name="cDireccion" class="java.lang.String"/>
	<field name="cPuesto1" class="java.lang.String"/>
	<field name="cFirmante1" class="java.lang.String"/>
	<field name="cPuesto2" class="java.lang.String"/>
	<field name="cFirmante2" class="java.lang.String"/>
	<pageHeader>
		<band height="104">
			<textField>
				<reportElement x="0" y="48" width="353" height="15"/>
				<textElement>
					<font fontName="Arial" size="12" isBold="true"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{D_DESCRIPCION}]]></textFieldExpression>
			</textField>
			<image onErrorType="Blank">
				<reportElement x="1" y="0" width="150" height="42"/>
				<imageExpression class="java.lang.String"><![CDATA["C:\\logotipo-usuario.png"]]></imageExpression>
			</image>
			<staticText>
				<reportElement x="1" y="63" width="353" height="15"/>
				<textElement verticalAlignment="Middle">
					<font fontName="Arial" size="12" isBold="true"/>
				</textElement>
				<text><![CDATA[GERENCIA DE RECURSOS MATERIALES]]></text>
			</staticText>
		</band>
	</pageHeader>
	<detail>
		<band height="44">
			<subreport>
				<reportElement x="0" y="30" width="572" height="5"/>
				<subreportParameter name="cIdProcedimiento">
					<subreportParameterExpression><![CDATA[$P{IdProcedimiento}]]></subreportParameterExpression>
				</subreportParameter>
				<subreportParameter name="DIR_REPORT">
					<subreportParameterExpression><![CDATA[$P{DIR_REPORT}]]></subreportParameterExpression>
				</subreportParameter>
				<connectionExpression><![CDATA[$P{REPORT_CONNECTION}]]></connectionExpression>
				<subreportExpression class="java.lang.String"><![CDATA[$P{DIR_REPORT} + "\\FalloPunto_A.jasper"]]></subreportExpression>
			</subreport>
			<break>
				<reportElement x="0" y="36" width="100" height="1"/>
			</break>
			<staticText>
				<reportElement x="0" y="0" width="565" height="30"/>
				<textElement textAlignment="Justified">
					<font fontName="Arial" size="12" isBold="false"/>
				</textElement>
				<text><![CDATA[I. Las propuestas de las siguientes empresas fueron desechadas de conformidad a lo indicado en el punto 5.3 incisos a) y b) de la convocatoria de la licitación por los motivos que se indican a continuación:]]></text>
			</staticText>
		</band>
		<band height="42">
			<staticText>
				<reportElement x="0" y="0" width="565" height="30"/>
				<textElement textAlignment="Justified">
					<font fontName="Arial" size="12"/>
				</textElement>
				<text><![CDATA[II. De acuerdo a los criterios previstos en el procedimiento y con base en la evaluación técnica y económica realizada, a continuación se indican los licitantes cuyas proposiciones resultaron solventes:]]></text>
			</staticText>
			<subreport>
				<reportElement x="0" y="30" width="572" height="5"/>
				<subreportParameter name="cIdProcedimiento">
					<subreportParameterExpression><![CDATA[$P{IdProcedimiento}]]></subreportParameterExpression>
				</subreportParameter>
				<connectionExpression><![CDATA[$P{REPORT_CONNECTION}]]></connectionExpression>
				<subreportExpression class="java.lang.String"><![CDATA[$P{DIR_REPORT} + "\\FalloPunto_B.jasper"]]></subreportExpression>
			</subreport>
			<break>
				<reportElement x="0" y="35" width="100" height="1"/>
			</break>
		</band>
		<band height="69">
			<break>
				<reportElement x="0" y="62" width="100" height="1"/>
			</break>
			<staticText>
				<reportElement x="0" y="0" width="565" height="56"/>
				<textElement textAlignment="Justified">
					<font fontName="Arial" size="12" isBold="false"/>
				</textElement>
				<text><![CDATA[III. Los licitantes a quienes se adjudican los pedidos, por ser sus proposiciones las que cumplen con los requerimientos solicitados por la Comisión Nacional del Agua en las bases del procedimiento, asegurando al Estado las mejores condiciones disponibles en cuanto a precio, calidad, financiamiento, oportunidad y demás circunstancias pertinentes, al ser las propuestas solventes más bajas, son las siguientes:]]></text>
			</staticText>
			<subreport>
				<reportElement x="0" y="56" width="572" height="5"/>
				<subreportParameter name="DIR_REPORT">
					<subreportParameterExpression><![CDATA[$P{DIR_REPORT}]]></subreportParameterExpression>
				</subreportParameter>
				<subreportParameter name="cIdProcedimiento">
					<subreportParameterExpression><![CDATA[$P{IdProcedimiento}]]></subreportParameterExpression>
				</subreportParameter>
				<connectionExpression><![CDATA[$P{REPORT_CONNECTION}]]></connectionExpression>
				<subreportExpression class="java.lang.String"><![CDATA[$P{DIR_REPORT} + "\\FalloPunto_C.jasper"]]></subreportExpression>
			</subreport>
		</band>
		<band height="93">
			<staticText>
				<reportElement x="0" y="0" width="565" height="85"/>
				<textElement textAlignment="Justified">
					<font fontName="Arial" size="12"/>
				</textElement>
				<text><![CDATA[Con base en la evaluación técnica y una vez determinándose las ofertas que cumplieron con los requisitos y especificaciones solicitadas, a continuación se indican los lugares que ocuparon las ofertas de las empresas participantes que no resultaron con aceptación para la Comisión Nacional del Agua, por no corresponder a las solventes más bajas, considerando la evaluación de las dos propuestas, de conformidad con el artículo 36 de la Ley de Adquisiciones, Arrendamientos y Servicios del Sector Público y al punto 5.1 de la Convocatoria:]]></text>
			</staticText>
			<subreport>
				<reportElement x="0" y="85" width="572" height="5"/>
				<subreportParameter name="cIdProcedimiento">
					<subreportParameterExpression><![CDATA[$P{IdProcedimiento}]]></subreportParameterExpression>
				</subreportParameter>
				<connectionExpression><![CDATA[$P{REPORT_CONNECTION}]]></connectionExpression>
				<subreportExpression class="java.lang.String"><![CDATA[$P{DIR_REPORT} + "\\FalloPunto_D.jasper"]]></subreportExpression>
			</subreport>
			<break>
				<reportElement x="0" y="91" width="100" height="1"/>
			</break>
		</band>
		<band height="64">
			<staticText>
				<reportElement x="0" y="0" width="565" height="58"/>
				<textElement textAlignment="Justified">
					<font fontName="Arial" size="12"/>
				</textElement>
				<text><![CDATA[A continuación se indican los lugares de las proposiciones que, de conformidad con el artículo 36 de la Ley de Adquisiciones, Arrendamientos y Servicios del Sector Público y al punto 5.1 de la convocatoria no resultaron con aceptación para la Comisión Nacional del Agua, por no corresponder a alguna de las dos propuestas cuyo precio resultó ser el más bajo:]]></text>
			</staticText>
			<subreport>
				<reportElement x="0" y="58" width="572" height="5"/>
				<subreportParameter name="cIdProcedimiento">
					<subreportParameterExpression><![CDATA[$P{IdProcedimiento}]]></subreportParameterExpression>
				</subreportParameter>
				<connectionExpression><![CDATA[$P{REPORT_CONNECTION}]]></connectionExpression>
				<subreportExpression class="java.lang.String"><![CDATA[$P{DIR_REPORT} + "\\FalloPunto_E.jasper"]]></subreportExpression>
			</subreport>
		</band>
	</detail>
