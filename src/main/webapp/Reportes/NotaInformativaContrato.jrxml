<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="NotaInformativa" pageWidth="612" pageHeight="792" columnWidth="550" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="86527ea0-8035-4411-893e-f1665e15706e">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="sai_2025"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.report.description" value=""/>
	<parameter name="where2" class="java.lang.String"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="esIntegrada" class="java.lang.Integer"/>
	<parameter name="nombre" class="java.lang.String"/>
	<parameter name="puesto" class="java.lang.String"/>
	<queryString>
		<![CDATA[declare @compromiso varchar(20) =$P{where2} 
declare @contrato varchar(50) = (SELECT cIdContrato from tCompromisoEncabezado where caNoCompromiso = @compromiso )
declare @esIntegrada int = $P{esIntegrada} 


create table #CONTRATO  (
PARTIDA int,
TOTAL_ANUAL money,
cesCalendario varchar(1),
TIPO varchar(1),
cTipoContrato varchar(4),
cIdContrato varchar(100)
)

IF (@esIntegrada = 0)
BEGIN

INSERT INTO #CONTRATO
SELECT  PARTIDA, SUM(TOTAL_ANUAL) TOTAL_ANUAL
, cesCalendario 
, TIPO 
, cTipoContrato
,cIdContrato
FROM
 (
	SELECT SUBSTRING(EP,32,5) PARTIDA
	, SUM(DET.mImporte) TOTAL_ANUAL
	, comp.cesCalendario
	, case WHEN SUM(MIMPORTE) > 0 THEN 'A' ELSE 'R' END TIPO
	, cTipoContrato
	, comp.cIdContrato
	FROM tCompromisoEncabezado comp 
	INNER JOIN tCompromisoDetalle DET
	ON comp.nFolioCompromiso = DET.nFolioCompromiso
	WHERE caNoCompromiso =  @compromiso
	GROUP BY SUBSTRING(EP,32,5) , cMes, comp.cesCalendario, cTipoContrato, comp.cIdContrato
	 ) AS CONTRATO
	 GROUP BY PARTIDA, cesCalendario, TIPO, cTipoContrato, cIdContrato
END 
ELSE
BEGIN 

SET @contrato = ( SELECT top 1 cIdContrato FROM tCompromisoEncabezado C INNER JOIN tIntegraFoliosCompromiso I ON C.nFolioCompromiso = I.nFolioCompromiso AND I.caNoIntegradaComp = @compromiso )


INSERT INTO #CONTRATO
SELECT  PARTIDA, SUM(TOTAL_ANUAL) TOTAL_ANUAL
, cesCalendario
, TIPO
, cTipoContrato
,cIdContrato
FROM
 (
	SELECT SUBSTRING(EP,32,5) PARTIDA
	, SUM(DET.mImporte) TOTAL_ANUAL
	, comp.cesCalendario
	, case WHEN SUM(MIMPORTE) > 0 THEN 'A' ELSE 'R' END TIPO
	, cTipoContrato
	, comp.cIdContrato
	FROM tCompromisoEncabezado comp 
	INNER JOIN tCompromisoDetalle DET
	ON comp.nFolioCompromiso = DET.nFolioCompromiso
	INNER JOIN tIntegraFoliosCompromiso Integra
	on comp.nFolioCompromiso = Integra.nFolioCompromiso
	WHERE Integra.caNoIntegradaComp =  @compromiso
	GROUP BY SUBSTRING(EP,32,5) , cMes, comp.cesCalendario, cTipoContrato, comp.cIdContrato
	 ) AS CONTRATO
	 GROUP BY PARTIDA, cesCalendario, TIPO, cTipoContrato, cIdContrato
	  
END
	  

DECLARE @noConvenio varchar(200), @fInicioConv date, @fFinConv date 
select 
                @noConvenio = MIN(cNoConvenio),
                @fInicioConv = MIN(fInicio),
                @fFinConv = MAX(fTermino)
		
from 
(              select cont.cIdContratoDefinitivo,cont.nConsecutivoModificacion
                      ,cont.nEstado,cont.cNoConvenio,cContratoDefinitivo
                from mContratoModificado cont with(Nolock)
				UNION 
                select contCap4.cIdContratoDefinitivo,contCap4.nConsecutivoModificacion
                      ,contCap4.nEstatus nEstado,contCap4.cNoConvenio,cContratoDefinitivo
                from mContratoModificadoCap4 contCap4 with(Nolock)
)cont
inner join  pContratoDiversoConvenio conv with(Nolock)
on cont.cIdContratoDefinitivo=conv.cIdContrato
and cont.nConsecutivoModificacion=conv.nConsecutivoModificacion
and cont.cContratoDefinitivo=conv.cIdModificacion
where cont.nEstado=4
AND cont.cIdContratoDefinitivo LIKE  @contrato
group by cont.cIdContratoDefinitivo



declare @parrafo1 as varchar(max),@parrafo2 as varchar(max),@parrafoDisminucion as varchar(max), @parrafoConvenio as varchar(max),
		@proveedor varchar(1000), @vigencia varchar (100), @cnet varchar(100)

select @parrafo1 = 'Se solicita la autorización del contrato <b>' + cNoContratoCNET + '</b> correspondiente al concepto de <b>"' + DescripcionPedCont 
+ '"</b>, de la partida especifica  ' + REPLACE(partida, ';', ',') 
+ ' y adjudicado al proveedor con RFC: <b>'  + cidrfc
+ '</b> y Nombre: ' + razonsocial 
+ ' durante el presente ejercicio fiscal actual, por el monto de <b>' + importe + '</b> (' + cantidadLetra + ').' ,
 @parrafo2 = 'Se solicita la autorización del pedido <b>' + cNoContratoCNET + '</b> correspondiente al concepto de  <b>"' + DescripcionPedCont 
 + '"</b>, de la partida especifica  ' + REPLACE(partida, ';', ',') 
 + ' y adjudicado al proveedor con RFC: <b>'  + cidrfc 
 + '</b> y Nombre: ' + razonsocial 
 + ' durante el presente ejercicio fiscal actual, por el monto de <b>' + importe + '</b> (' + cantidadLetra + ').',
  @parrafoDisminucion = 'Se solicita la autorización del <b>DECREMENTO</b> del  ' +
  case when cTipoContrato = 'PD' THEN 'pedido ' ELSE 'contrato ' end
 + '<b>'+ cNoContratoCNET + '</b> derivado del concepto <b>"No se logró concretar la entrega del bien/servicio" </b>, de la partida especifica  ' + REPLACE(partida, ';', ',') 
 + ' y adjudicado al proveedor con RFC: <b>'  + cidrfc 
 + '</b> y Nombre: ' + razonsocial 
 + ' durante el presente ejercicio fiscal actual, por el monto de <b>' + importe + '</b> (' + cantidadLetra + ').',
@parrafoConvenio = 'Se solicita la autorización del <b>CONTRATO MODIFICATORIO</b> ' + @noConvenio + ' del contrato  <b>' + cNoContratoCNET 
+ '</b> correspondiente al concepto de <b>"' + DescripcionPedCont + '"</b>, de la partida especifica  ' + REPLACE(partida, ';', ',') 
+ ' y adjudicado al proveedor con RFC: <b>' + cidrfc 
+ '</b> y Nombre: ' + razonsocial 
+ ' durante el presente ejercicio fiscal actual, por el monto de <b>' + importe + '</b> (' + cantidadLetra + ')',
@proveedor = RazonSocial,
@cnet = cNoContratoCnet
from (

--SELECT [Contrato CNET] cNoContratoCNET, REPLACE([CONCEPTO DEL CONTRATO], '"', '') DescripcionPedCont, [Partida Presupuestal] partida, [Razón Social] razonsocial, [Fecha Inicio] fechainicio, [Fecha Fin] fechafin
--, cidrfc,  '$' + CONVERT(VARCHAR, CAST("Monto Neto máximo"  AS MONEY), 1)  importe,  dbo.fnCantidadLetra("Monto Neto máximo") cantidadLetra
--FROM [v_mMontoMaximoContratoPartPresupuestal] 
--WHERE  [Contrato SAI]  = @contrato
--UNION

select comp.cIdContrato cNoContratoCnet
, cConceptoContrato DescripcionPedCont
, isnull((select dbo.fn_mCadenaPartidasContrato(PD.cIdContrato)),'')partida
, ISNULL(BEN.dNombre, '') + ' ' + ISNULL(BEN.dApellidoPaterno, '') + ' '+ ISNULL(BEN.dApellidoMaterno, '') razonsocial
--,  CONVERT(varchar(10), fContratoIni, 103) fContratoIni,  CONVERT(varchar(10), fContratoFin, 103) fContratoFin
, cidrfc, '$' + CONVERT(VARCHAR, CAST(mimportetotal  AS MONEY), 1)  importe, dbo.fnCantidadLetra(mimporteTotal) cantidadLetra
, cTipoContrato
from pContratoDiverso PD WITH (NOLOCK)
INNER JOIN tBeneficiario BEN WITH (NOLOCK)
ON PD.cIdRFC = BEN.dRFC
INNER JOIN #CONTRATO comp WITH (NOLOCK)
ON  comp.cIdContrato = PD.cIdContrato 
where   comp.cIdContrato = @contrato

UNION

select comp.cIdContrato
, cObjetoContrato
, isnull((select dbo.fn_mCadenaPartidasContrato(PD.cIdContrato)),'')partida
, ISNULL(BEN.dNombre, '') + ' ' + ISNULL(BEN.dApellidoPaterno, '') + ' '+ ISNULL(BEN.dApellidoMaterno, '') NOMBRE
--,  CONVERT(varchar(10), fContratoIni, 103) fContratoIni,  CONVERT(varchar(10), fContratoFin, 103) fContratoFin
, cidrfc, '$' + CONVERT(VARCHAR, CAST(mTotal  AS MONEY), 1)  importe, dbo.fnCantidadLetra(mTotal) cantidadLetra
, comp.cTipoContrato
from pContratoFederalizado PD WITH (NOLOCK)
INNER JOIN tBeneficiario BEN WITH (NOLOCK)
ON PD.cIdRFC = BEN.dRFC
INNER JOIN #CONTRATO comp WITH (NOLOCK)
ON  comp.cIdContrato = PD.cIdContrato 
where   comp.cIdContrato = @contrato

UNION

select comp.cIdContrato
, cObjetoContrato
, isnull((select dbo.fn_mCadenaPartidasContrato(PD.cIdContrato)),'')partida
, ISNULL(BEN.dNombre, '') + ' ' + ISNULL(BEN.dApellidoPaterno, '') + ' '+ ISNULL(BEN.dApellidoMaterno, '') NOMBRE
--,  CONVERT(varchar(10), fContratoIni, 103) fContratoIni,  CONVERT(varchar(10), fContratoFin, 103) fContratoFin
, cidrfc, '$' + CONVERT(VARCHAR, CAST(mTotal  AS MONEY), 1)  importe, dbo.fnCantidadLetra(mTotal) cantidadLetra
, comp.cTipoContrato
from pContratoObra PD WITH (NOLOCK)
INNER JOIN tBeneficiario BEN WITH (NOLOCK)
ON PD.cIdRFC = BEN.dRFC
INNER JOIN #CONTRATO comp WITH (NOLOCK)
ON  comp.cIdContrato = PD.cIdContrato 
where   comp.cIdContrato = @contrato

) as tbl


SELECT  PARTIDA, ISNULL(TOTAL_ANUAL,0) TOTAL_ANUAL
, case WHEN @noConvenio !='' THEN @parrafoConvenio
WHEN tipo = 'R' THEN @parrafoDisminucion
WHEN tipo = 'A' and cTipoContrato = 'PD' THEN @parrafo2
else @parrafo1  end parrafo1
, @proveedor proveedor
, @cnet cnet
, isnull(@noConvenio, '') folioConvenio
, isnull(@fInicioConv, '') inicioConv
, isnull(@fFinConv, '') finConvenio
FROM #CONTRATO CONTRATO


DROP TABLE #CONTRATO]]>
	</queryString>
