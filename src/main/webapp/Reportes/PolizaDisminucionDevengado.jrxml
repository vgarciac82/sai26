	<field name="laEP" class="java.lang.String"/>
	<field name="nPorcIva" class="java.math.BigDecimal"/>
	<field name="numReg" class="java.lang.Integer"/>
	<field name="cantLetras" class="java.lang.String"/>
	<field name="sFirmanteVoBo" class="java.lang.String"/>
	<field name="sPuestoVoBo" class="java.lang.String"/>
	<field name="sFirmanteAut" class="java.lang.String"/>
	<field name="sPuestoAut" class="java.lang.String"/>
	<field name="Cuenta" class="java.lang.String"/>
	<field name="subCuenta" class="java.lang.String"/>
	<field name="subSubCuenta" class="java.lang.String"/>
	<field name="calmacen" class="java.lang.String"/>
	<field name="cnombre" class="java.lang.String"/>
	<field name="descripcion" class="java.lang.String"/>
	<field name="dCuenta" class="java.lang.String"/>
	<field name="ctipomovimiento" class="java.lang.String"/>
	<field name="nCuenta" class="java.lang.String"/>
	<field name="mMovimiento2" class="java.math.BigDecimal"/>
	<field name="debe" class="java.math.BigDecimal"/>
	<field name="haber" class="java.math.BigDecimal"/>
	<variable name="nPorcIva" class="java.lang.String">
		<initialValueExpression><![CDATA["IVA (" + $F{nPorcIva}.toString() +  "%)"]]></initialValueExpression>
	</variable>
	<variable name="laEP" class="java.lang.String">
		<initialValueExpression><![CDATA["VARIAS"]]></initialValueExpression>
	</variable>
	<variable name="noPoliza" class="java.lang.String">
		<initialValueExpression><![CDATA["EG-" + $F{nPolizaAP}.toString()]]></initialValueExpression>
	</variable>
	<variable name="mImporteRetencion" class="java.lang.String"/>
	<variable name="cnoEstimacion" class="java.lang.String"/>
	<group name="caNoContrarrecibo">
		<groupExpression><![CDATA[$F{caNoContrarrecibo}]]></groupExpression>
		<groupHeader>
			<band height="389" splitType="Stretch">
				<rectangle>
					<reportElement key="rectangle" x="0" y="106" width="551" height="247" uuid="75f6d2bf-a0b3-4ee5-9f78-4f4a65b970a4"/>
