	<field name="fRegistro" class="java.lang.String"/>
	<field name="cIdEstadoReintegro" class="java.lang.String"/>
	<field name="cIdTipoReclasificacion" class="java.lang.String"/>
	<field name="fAplicacionSiaff" class="java.lang.String"/>
	<field name="fPagoSiaff" class="java.lang.String"/>
	<field name="cIdEstadoContrarrecibo" class="java.lang.String"/>
	<field name="cconcepto" class="java.lang.String"/>
	<field name="cTipoDocumento" class="java.lang.String"/>
	<field name="TIPO_OPERACION" class="java.lang.String"/>
	<field name="cDescripcion" class="java.lang.String"/>
