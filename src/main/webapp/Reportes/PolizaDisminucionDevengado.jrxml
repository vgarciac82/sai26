	<property name="ireport.y" value="0"/>
	<property name="ireport.scriptlethandling" value="0"/>
	<property name="ireport.encoding" value="UTF-8"/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="194"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w1" value="151"/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w2" value="842"/>
	<import value="net.sf.jasperreports.engine.*"/>
	<import value="java.util.*"/>
	<import value="net.sf.jasperreports.engine.data.*"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="whereFolio" class="java.lang.String">
		<defaultValueExpression><![CDATA["CR.canocontrarrecibo = @canocontrarrecibo"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[DECLARE @laPoliza VARCHAR(10)
DECLARE @cUnidadResponsable VARCHAR(10)
DECLARE @cTipopoliza VARCHAR(10)
DECLARE @canocontrarrecibo VARCHAR(19)
DECLARE @cuantos SMALLINT
--SET @canocontrarrecibo = '10DD2015100006'
-- "$P!{whereFolio}"--> "CR.canocontrarrecibo = @canocontrarrecibo"

SELECT  @laPoliza = nFolioPoliza ,
        @cUnidadResponsable = Det.cCentroContable ,
        @cTipopoliza = cTipoPoliza
FROM    tDisminucionDevEncabezado CR WITH ( NOLOCK )
	INNER JOIN  ( SELECT DISTINCT
                    nFolioDisminucionDev ,
                    cCentroContable
          FROM      tDisminucionDevDetalle d WITH ( NOLOCK )
        ) Det ON CR.nFolioDisminucionDev = Det.nFolioDisminucionDev
WHERE   $P!{whereFolio}
        AND 1 = 1
--las de mayor

SELECT  *
INTO    #tmp_detalle
FROM    ( SELECT    Ep ,
                    COUNT(DISTINCT Ep) numReg
          FROM      tDisminucionDevDetalle WITH ( NOLOCK )
          WHERE     nFolioDisminucionDev IN (
                    SELECT  nFolioDisminucionDev
                    FROM    tDisminucionDevEncabezado cr WITH ( NOLOCK )
                    WHERE   $P!{whereFolio} AND 1 = 1 )
          GROUP BY  ep
        ) m

SELECT  *
INTO    #tmp_polizapagos
FROM    ( SELECT    SUBSTRING(m.nCuenta, 1, 5) Cuenta ,
                    '' subCuenta ,
                    '' subSubCuenta ,
                    calmacen ,
                    dCuenta cnombre ,
                    dCuenta descripcion ,
                    dCuenta ,
                    m.ctipomovimiento ,
                    m.nCuenta/*,  m.**/ ,
                    SUM(mMovimiento) mMovimiento2
          FROM      tcuentas c WITH ( NOLOCK ) ,
                    tmovimiento m WITH ( NOLOCK )
                    LEFT JOIN cat_almacen a ON CAST(a.nidalmacen AS VARCHAR(10)) = nsubcuenta
                                               AND a.ccentrocontable = m.ccentrocontable
          WHERE
                    SUBSTRING(m.ncuenta, 1, 5) + '-00000-00000-00000' = c.ncuenta
                    AND nFolioPoliza = @laPoliza
                    AND m.cCentroContable = @cUnidadResponsable
                    AND cTipopoliza = @cTipoPoliza
                    AND mmovimiento != 0
                    AND NOT ( c.TipoBalance = 'P'
                              AND c.TipoCuenta = 'P'
                            )
          GROUP BY  SUBSTRING(m.nCuenta, 1, 5) ,
                    calmacen ,
                    dCuenta ,
                    dCuenta ,
                    dCuenta ,
                    m.ctipomovimiento ,
                    m.nCuenta
          UNION
--2o nivel
          SELECT    '' Cuenta ,
                    SUBSTRING(m.nCuenta, 7, 5) subCuenta ,
                    '' subSubCuenta ,
                    calmacen ,
                    dcuenta cnombre ,
                    '  ' + dCuenta descripcion ,
                    dCuenta ,
                    m.ctipomovimiento ,
                    m.nCuenta,
                    0 mMovimiento2
          FROM      tcuentas c WITH ( NOLOCK ) ,
                    tmovimiento m WITH ( NOLOCK )
                    LEFT JOIN cat_almacen a ON CAST(a.nidalmacen AS VARCHAR(10)) = nsubcuenta
                                               AND a.ccentrocontable = m.ccentrocontable
          WHERE
                    SUBSTRING(m.ncuenta, 1, 11) + '-00000-00000' = c.ncuenta
                    AND nFolioPoliza = @laPoliza
                    AND m.cCentroContable = @cUnidadResponsable
                    AND cTipopoliza = @cTipoPoliza
                    AND mmovimiento != 0
                    AND SUBSTRING(m.nCuenta, 7, 5) != '00000'
                    AND NOT ( c.TipoBalance = 'P'
                              AND c.TipoCuenta = 'P'
                            )
          GROUP BY  SUBSTRING(m.nCuenta, 7, 5) ,
                    calmacen ,
                    dcuenta ,
                    '  ' + dCuenta ,
                    dCuenta ,
                    m.ctipomovimiento ,
                    m.nCuenta
          UNION
--3er nivel
          SELECT    '' Cuenta ,
                    '' subCuenta ,
                    SUBSTRING(m.nCuenta, 13, 5) subSubCuenta ,
                    calmacen ,
                    dCuenta cnombre ,
                    '    ' + dCuenta descripcion ,
                    dCuenta ,
                    m.ctipomovimiento ,
                    m.nCuenta/*, m.**/ ,
                    0 mMovimiento2
          FROM      tcuentas c WITH ( NOLOCK ) ,
                    tmovimiento m WITH ( NOLOCK )
                    LEFT JOIN cat_almacen a ON CAST(a.nidalmacen AS VARCHAR(10)) = nsubcuenta
                                               AND a.ccentrocontable = m.ccentrocontable
          WHERE
                    SUBSTRING(m.ncuenta, 1, 17) + '-00000' = c.ncuenta
                    AND nFolioPoliza = @laPoliza
                    AND m.cCentroContable = @cUnidadResponsable
                    AND cTipopoliza = @cTipoPoliza
                    AND mmovimiento != 0
                    AND SUBSTRING(m.nCuenta, 13, 5) != '00000'
                    AND NOT ( c.TipoBalance = 'P'
                              AND c.TipoCuenta = 'P'
                            )
          GROUP BY  SUBSTRING(m.nCuenta, 13, 5) ,
                    calmacen ,
                    dCuenta ,
                    '    ' + dCuenta ,
                    dCuenta ,
                    m.ctipomovimiento ,
                    m.nCuenta
          UNION
          SELECT    '' Cuenta ,
                    '' subCuenta ,
                    CASE WHEN nSubCuenta = '' THEN SUBSTRING(m.nCuenta, 13, 5)
                         ELSE CASE WHEN cnombre IS NULL THEN calmacen
                                   ELSE nSubCuenta
                              END
                    END subSubCuenta ,
                    calmacen ,
                    cnombre ,
                    '      '
                    + CASE WHEN nSubCuenta = ''
                           THEN SUBSTRING(m.nCuenta, 13, 5)
                           ELSE CASE WHEN cnombre IS NULL THEN calmacen
                                     ELSE '[' + nSubCuenta + ']' + cNombre
                                END
                      END descripcion ,
                    dCuenta ,
                    m.ctipomovimiento ,
                    m.nCuenta/*, m.**/ ,
                    0 mMovimiento2
          FROM      tcuentas c ,
                    tmovimiento m
                    LEFT JOIN cat_almacen a ON CAST(a.nidalmacen AS VARCHAR(10)) = nsubcuenta
                                               AND a.ccentrocontable = m.ccentrocontable
                    LEFT JOIN v_pcatalogorfc rfc ON cidrfc = nsubcuenta
          WHERE     m.nSubcuenta != ''
                    AND m.ncuenta = c.ncuenta
                    AND nFolioPoliza = @laPoliza
                    AND m.cCentroContable = @cUnidadResponsable
                    AND cTipopoliza = @cTipoPoliza
                    AND mmovimiento != 0
                    AND NOT ( c.TipoBalance = 'P'
                              AND c.TipoCuenta = 'P'
                            )
          GROUP BY  CASE WHEN nSubCuenta = '' THEN SUBSTRING(m.nCuenta, 13, 5)
                         ELSE CASE WHEN cnombre IS NULL THEN calmacen
                                   ELSE nSubCuenta
                              END
                    END ,
                    calmacen ,
                    cnombre ,
                    '      '
                    + CASE WHEN nSubCuenta = ''
                           THEN SUBSTRING(m.nCuenta, 13, 5)
                           ELSE CASE WHEN cnombre IS NULL THEN calmacen
                                     ELSE '[' + nSubCuenta + ']' + cNombre
                                END
                      END ,
                    dCuenta ,
                    m.ctipomovimiento ,
                    m.nCuenta
        ) poliza
WHERE subsubcuenta is NOT null
ORDER BY ncuenta ,
        cuenta DESC ,
        subcuenta DESC ,
        subsubcuenta ,
        ctipomovimiento DESC

SELECT  rfc.CNOMBRE CNOMBRE2 ,
        CR.aEjercicioFiscal ,
        CR.cIdEntidadContable ,
        CR.caNoContrarrecibo ,
        m.cIdDocumento ,
        CR.cIdTipoDocumento ,
        0 cIdSubtipoDocumento ,
        1 cIdTipoOperacion ,
        0 caNoAP ,
        '' nPolizaAP ,
        CR.cIdRFC ,
        CR.cIdTipoMoneda ,
        CR.nTipoCambio ,
        CAST(CR.mImporteBruto AS DECIMAL(17, 2)) mImporteBruto ,
        CAST(CR.mImporteSancion AS DECIMAL(17, 2)) mImporteSancion ,
        CAST(CR.mImporteDevolucion AS DECIMAL(17, 2)) mImporteDevolucion ,
        ( CAST(mAmortizacionAnticipo AS DECIMAL(17, 2)) / ( 1 + ( nPorcIva / 100 ) ) ) AS mAmortizacionAnticipo ,
        CAST(CR.mImporteIVA AS DECIMAL(17, 2)) mImporteIVA ,
        CAST(CR.mImporteRetencion AS DECIMAL(17, 2)) mImporteRetencion ,
        CAST(CR.mImportePenalizacion AS DECIMAL(17, 2)) mImportePenalizacion ,
        CAST(CR.mImporteNeto AS DECIMAL(17, 2)) mImporteNeto ,
        CONVERT(VARCHAR(10), CR.fProgramadaPago, 103) fProgramadaPago ,
        CONVERT(VARCHAR(10), '', 103) fValidacionDisponible ,
        0 lEsCandidatoCP ,
        0 lHaySubpartidaExcluidaCP ,
        1 cIdTipoCLCSiaff ,
        1 cIdLeyendaSiaff ,
        '' cReferencia1 ,
        0 nEsSubsidio ,
        CONVERT(VARCHAR(10), CR.fRegistro, 103) fRegistro ,
        0 cIdEstadoReintegro ,
        0 cIdTipoReclasificacion ,
        CONVERT(VARCHAR(10), '', 103) fAplicacionSiaff ,
        '' fPagoSiaff ,
        '' cIdEstadoContrarrecibo ,
        m.cconcepto ,
        ctd.cTipoDocumento ,
        '' AS TIPO_OPERACION ,
        cc.cDescripcion ,
        m.cUnidadResponsable ,
        cnoEstimacion ,
        periodo ,
        CAST(nPorcIva AS DECIMAL(10, 2)) nPorcIva ,
        ( SELECT    MIN(EP) FROM      #tmp_detalle WITH ( NOLOCK )) laEP ,
        ( SELECT    SUM(numReg) FROM      #tmp_detalle WITH ( NOLOCK )) numReg ,
        dbo.fnCantidadLetra(CR.mImporteNeto) cantLetras ,
        m.sFirmanteVoBo ,
        m.sPuestoVoBo ,
        m.sFirmanteAut ,
        m.sPuestoAut
INTO    #tmp_detalle2
FROM    vContrarrecibo CR WITH ( NOLOCK )
        LEFT JOIN pCatalogoTipoDocumento ctd ON ctd.cIdTipoDocumento = cr.cIdTipoDocumento
        LEFT JOIN tCatalogoCentroContable cc ON cc.cCentrocontable = cr.cIdEntidadContable ,
        v_PCATALOGORFC RFC ,
        ( SELECT    cConcepto cIdDocumento ,
                    0 nPorcIva ,
                    0 mImporteRetencion ,
                    cconcepto ,
                    canocontrarrecibo ,
                    'OPERACIONES AJENAS' tipoObra ,
                    cUnidadResponsable ,
                    ' ' cnoEstimacion ,
                    'Del ' + CASE WHEN fCaptura IS NULL THEN ''
                                  ELSE CONVERT(VARCHAR(10), fCaptura, 103)
                             END + ' al ' + CASE WHEN fCaptura IS NULL THEN ''
                                                 ELSE CONVERT(VARCHAR(10), fCaptura, 103)
                                            END Periodo ,
                    sFirmanteVoBo ,
                    sPuestoVoBo ,
                    sFirmanteAut ,
                    sPuestoAut
          FROM      tDisminucionDevEncabezado e
        ) m
WHERE   LTRIM(RTRIM(RFC.cIdRFC)) = LTRIM(RTRIM(CR.cIdRFC))
        AND m.canocontrarrecibo = cr.canocontrarrecibo
        AND $P!{whereFolio}

SELECT  MAX(CNOMBRE2) CNOMBRE2 ,
        aEjercicioFiscal ,
        cIdEntidadContable ,
        caNoContrarrecibo ,
        cIdDocumento ,
        cIdTipoDocumento ,
        cIdSubtipoDocumento ,
        cIdTipoOperacion ,
        caNoAP ,
        @laPoliza nPolizaAP ,
        cIdRFC ,
        cIdTipoMoneda ,
        nTipoCambio ,
        mImporteBruto ,
        mImporteSancion ,
        mImporteDevolucion ,
        mAmortizacionAnticipo ,
        mImporteIVA ,
        mImporteRetencion ,
        mImportePenalizacion ,
        mImporteNeto ,
        fProgramadaPago ,
        fValidacionDisponible ,
        lEsCandidatoCP ,
        lHaySubpartidaExcluidaCP ,
        cIdTipoCLCSiaff ,
        cIdLeyendaSiaff ,
        cReferencia1 ,
        nEsSubsidio ,
        fRegistro ,
        cIdEstadoReintegro ,
        cIdTipoReclasificacion ,
        fAplicacionSiaff ,
        fPagoSiaff ,
        cIdEstadoContrarrecibo ,
        cconcepto ,
        cTipoDocumento ,
        TIPO_OPERACION ,
        cDescripcion ,
        cUnidadResponsable ,
        cnoEstimacion ,
        periodo ,
        laEP ,
        MAX(nPorcIva) nPorcIva ,
        MAX(numReg) numReg ,
        MAX(cantLetras) cantLetras ,
        ISNULL(sFirmanteVoBo, '-') sFirmanteVoBo ,
        ISNULL(sPuestoVoBo, '-') sPuestoVoBo ,
        ISNULL(sFirmanteAut, '-') sFirmanteAut ,
        ISNULL(sPuestoAut, '-') sPuestoAut,
        pol.*,
        CASE WHEN ctipomovimiento='C' THEN mmovimiento2 ELSE 0 END debe,
        CASE WHEN ctipomovimiento='A' THEN mmovimiento2 ELSE 0 END haber
FROM    #tmp_detalle2 WITH ( NOLOCK ),
        #tmp_polizapagos pol
GROUP BY aEjercicioFiscal ,
        cIdEntidadContable ,
        caNoContrarrecibo ,
        cIdDocumento ,
        cIdTipoDocumento ,
        cIdSubtipoDocumento ,
        cIdTipoOperacion ,
        caNoAP ,
        nPolizaAP ,
        cIdRFC ,
        cIdTipoMoneda ,
        nTipoCambio ,
        mImporteBruto ,
        mImporteSancion ,
        mImporteDevolucion ,
        mAmortizacionAnticipo ,
        mImporteIVA ,
        mImporteRetencion ,
        mImportePenalizacion ,
        mImporteNeto ,
        fProgramadaPago ,
        fValidacionDisponible ,
        lEsCandidatoCP ,
        lHaySubpartidaExcluidaCP ,
        cIdTipoCLCSiaff ,
        cIdLeyendaSiaff ,
        cReferencia1 ,
        nEsSubsidio ,
        fRegistro ,
        cIdEstadoReintegro ,
        cIdTipoReclasificacion ,
        fAplicacionSiaff ,
        fPagoSiaff ,
        cIdEstadoContrarrecibo ,
        cconcepto ,
        cTipoDocumento ,
        TIPO_OPERACION ,
        cDescripcion ,
        cUnidadResponsable ,
        cnoEstimacion ,
        periodo ,
        laEP ,
        sFirmanteVoBo ,
        sPuestoVoBo ,
        sFirmanteAut ,
        sPuestoAut,
        pol.cuenta,
        pol.subcuenta,
        pol.subsubcuenta,
        pol.calmacen,
        pol.cnombre,
        pol.descripcion,
        pol.dcuenta,
        pol.ctipomovimiento,
        pol.ncuenta,
        pol.mmovimiento2
   ORDER BY ncuenta ,
    cuenta DESC ,
    subcuenta DESC ,
    subsubcuenta ,
    ctipomovimiento DESC

DROP TABLE #tmp_detalle
DROP TABLE #tmp_detalle2
DROP TABLE #tmp_polizapagos]]>
	</queryString>
	<field name="CNOMBRE2" class="java.lang.String"/>
	<field name="aEjercicioFiscal" class="java.lang.String"/>
	<field name="cIdEntidadContable" class="java.lang.String"/>
	<field name="caNoContrarrecibo" class="java.lang.String"/>
	<field name="cIdDocumento" class="java.lang.String"/>
	<field name="cIdTipoDocumento" class="java.lang.String"/>
	<field name="cIdSubtipoDocumento" class="java.lang.String"/>
	<field name="cIdTipoOperacion" class="java.lang.String"/>
	<field name="caNoAP" class="java.lang.String"/>
	<field name="nPolizaAP" class="java.lang.String"/>
	<field name="cIdRFC" class="java.lang.String"/>
	<field name="cIdTipoMoneda" class="java.lang.String"/>
	<field name="nTipoCambio" class="java.math.BigDecimal"/>
	<field name="mImporteBruto" class="java.math.BigDecimal"/>
	<field name="mImporteSancion" class="java.math.BigDecimal"/>
	<field name="mImporteDevolucion" class="java.math.BigDecimal"/>
	<field name="mAmortizacionAnticipo" class="java.math.BigDecimal"/>
	<field name="mImporteIVA" class="java.math.BigDecimal"/>
	<field name="mImporteRetencion" class="java.math.BigDecimal"/>
	<field name="mImportePenalizacion" class="java.math.BigDecimal"/>
	<field name="mImporteNeto" class="java.math.BigDecimal"/>
	<field name="fProgramadaPago" class="java.lang.String"/>
	<field name="fValidacionDisponible" class="java.lang.String"/>
	<field name="lEsCandidatoCP" class="java.lang.Boolean"/>
	<field name="lHaySubpartidaExcluidaCP" class="java.lang.Boolean"/>
	<field name="cIdTipoCLCSiaff" class="java.lang.String"/>
	<field name="cIdLeyendaSiaff" class="java.lang.String"/>
	<field name="cReferencia1" class="java.lang.String"/>
