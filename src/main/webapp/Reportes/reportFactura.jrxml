	<queryString>
		<![CDATA[SELECT nIdFactura, cUUID, cNoCertificado, cLugarExp, cFecha, isnull(cTipoComprob, '')cTipoComprob
, isnull(cFolioSerie,'') cFolioSerie
, isnull(cRegimen, '') cRegimen
, cNombreEmisor, cRFCReceptor, cNombreReceptor
, isnull(cMoneda, '') cMoneda , isnull(cFormaPago, '') cFormaPago
, isnull(cMetodoPago, '') cMetodoPago, mSubtotal
, isnull(mImpustosTras, 0) mImpustosTras
, isnull(mDescuento, 0) mDescuento
, isnull(mImpuestosRet, 0) mImpuestosRet, 
mTotal AS  mTotal, cSelloCFD, cSelloSAT, cNoCertificadoSAT, cFechaCertificado
, isnull(cFolio,0) cFolio , '||' + cVersion + '|' + cUUID + '|' + cFechaCertificado + '|' + cSelloCFD + '|' + cNoCertificadoSAT + '||'  CadenaOriginal
FROM dbo.tFacturasCFDIEncabezado
 WHERE nIdFactura = $P{UUID}]]>
	</queryString>
