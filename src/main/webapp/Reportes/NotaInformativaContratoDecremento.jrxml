	<queryString>
		<![CDATA[declare @compromiso varchar(20) =$P{where2} 
declare @contrato varchar(50) 
declare @folioSicop varchar(10)
declare @folioSuficiencia varchar(10)
declare @nfoliocompromiso int

SELECT @contrato =cIdContrato ,
@nfoliocompromiso = nFolioCompromiso
from tCompromisoEncabezado  with (nolock) where caNoCompromiso = @compromiso 

SELECT TOP 1
@folioSicop = nFolioAutSICOP ,
@folioSuficiencia = nFolioSuficiencia
from tCompromisoEncabezado where cIdContrato = @contrato  and cDocumentoHaplicado = 'S' AND nFolioSuficiencia != -1 order by cIdContrato


	SELECT SUBSTRING(EP,32,5) PARTIDA, SUM(DET.mImporte) IMPORTE
	INTO #CONTRATO
	FROM tCompromisoEncabezado comp 
	INNER JOIN tCompromisoDetalle DET
	ON comp.nFolioCompromiso = DET.nFolioCompromiso
	WHERE caNoCompromiso = @compromiso
	GROUP BY SUBSTRING(EP,32,5) 
	
	
	SELECT PARTIDA,  SUM(ENERO) ENERO, SUM(FEBRERO) FEBRERO, SUM(MARZO) MARZO
	, SUM(ABRIL) ABRIL, SUM(  MAYO ) MAYO
	, SUM(JUNIO) JUNIO, SUM(JULIO ) JULIO, SUM(AGOSTO) AGOSTO
	, SUM(SEPTIEMBRE) SEPTIEMBRE, SUM(OCTUBRE) OCTUBRE, SUM(NOVIEMBRE) NOVIEMBRE, SUM(DICIEMBRE) DICIEMBRE, SUM(TOTAL_ANUAL)  TOTAL_ANUAL
	INTO #CALENDARIO
	FROM (
		select SUBSTRING(EP, 32, 5) PARTIDA
		, case when cMes = 1 then SUM(mImporte) else 0 END ENERO
		, case when cMes = 2 then SUM(mImporte) else 0 END FEBRERO
		, case when cMes = 3 then SUM(mImporte) else 0 END MARZO
		, case when cMes = 4 then SUM(mImporte) else 0 END ABRIL
		, case when cMes = 5 then SUM(mImporte) else 0 END MAYO
		, case when cMes = 6 then SUM(mImporte) else 0 END JUNIO
		, case when cMes = 7 then SUM(mImporte) else 0 END JULIO
		, case when cMes = 8 then SUM(mImporte) else 0 END AGOSTO
		, case when cMes = 9 then SUM(mImporte) else 0 END SEPTIEMBRE
		, case when cMes = 10 then SUM(mImporte) else 0 END OCTUBRE
		, case when cMes = 11 then SUM(mImporte) else 0 END NOVIEMBRE
		, case when cMes = 12 then SUM(mImporte) else 0 END DICIEMBRE
		, SUM(MIMPORTE) TOTAL_ANUAL
		from tCompromisoDetalle where nFolioCompromiso = @nfoliocompromiso
		GROUP BY SUBSTRING(EP, 32, 5), cMes
	) AS TBL
	GROUP BY PARTIDA

declare @saldo as money, @modificado money, @ejercido money
declare @parrafo1 as varchar(max), @parrafo2 as varchar(MAX), @proveedor varchar(1000), @vigencia varchar (100), @cnet varchar(100)

SELECT @saldo= sum(ISNULL(CONT.IMPORTE,0)) , @modificado =sum(ISNULL(CONT.IMPORTE,0) + ISNULL( TOTAL_ANUAL,0 )) , @ejercido =sum(ISNULL(TOTAL_ANUAL, 0)) 
FROM #CALENDARIO CAL
right JOIN  #CONTRATO CONT
ON CAL.PARTIDA = CONT.PARTIDA


select @parrafo1 = 'Se hace referencia al contrato ' + cNoContratoCNET + ' correspondiente al concepto de "' + DescripcionPedCont + '", correspondientes a la partida especifica  ' + REPLACE(partida, ';', ',') + ' y adjudicado al proveedor ' 
+ razonsocial + ' durante el presente ejercicio fiscal actual.',
@proveedor = RazonSocial,
@vigencia = CONVERT(varchar(10), fechainicio, 103) + ' - ' + CONVERT(varchar(10), fechafin, 103),
@cnet = cNoContratoCnet
from (

SELECT [Contrato CNET] cNoContratoCNET, REPLACE([CONCEPTO DEL CONTRATO], '"', '') DescripcionPedCont, [Partida Presupuestal] partida, [Razón Social] razonsocial, [Fecha Inicio] fechainicio, [Fecha Fin] fechafin
FROM [v_mMontoMaximoContratoPartPresupuestal] 
WHERE  [Contrato SAI]  = @contrato
UNION
select cIdContrato, cConceptoContrato
, isnull((select dbo.fn_mCadenaPartidasContrato(PD.cIdContrato)),'')partida
, BEN.dNombre + ' ' + isnull(BEN.dApellidoPaterno, '') + ' '+ isnull(BEN.dApellidoMaterno, '') NOMBRE
,  CONVERT(varchar(10), fContratoIni, 103) fContratoIni,  CONVERT(varchar(10), fContratoFin, 103) fContratoFin
from pContratoDiverso PD WITH (NOLOCK)
INNER JOIN tBeneficiario BEN WITH (NOLOCK)
ON PD.cIdRFC = BEN.dRFC
where   cIdContrato = @contrato
) as tbl

SELECT  CONT.PARTIDA, ISNULL(ENERO, 0 ) ENERO, ISNULL(FEBRERO,0 ) FEBRERO, ISNULL(MARZO,0) MARZO, ISNULL(ABRIL,0 )ABRIL , ISNULL( MAYO,0) MAYO, ISNULL(JUNIO,0) JUNIO
, ISNULL(JULIO,0) JULIO, ISNULL(AGOSTO, 0) AGOSTO, ISNULL(SEPTIEMBRE,0) SEPTIEMBRE, ISNULL(OCTUBRE,0) OCTUBRE, ISNULL(NOVIEMBRE,0) NOVIEMBRE, ISNULL(DICIEMBRE,0) DICIEMBRE, ISNULL(TOTAL_ANUAL,0) TOTAL_ANUAL
, CONT.IMPORTE SALDO, ISNULL(CONT.IMPORTE,0) + ISNULL(TOTAL_ANUAL ,0) MODIF
, @folioSicop FolioComp,  @folioSuficiencia folioSuficiencia , @parrafo1 parrafo1
, @proveedor proveedor, @vigencia vigencia, @cnet cnet
FROM #CALENDARIO CAL
RIGHT JOIN  #CONTRATO CONT
ON CAL.PARTIDA = CONT.PARTIDA


DROP TABLE #CONTRATO
DROP TABLE #CALENDARIO]]>
	</queryString>
