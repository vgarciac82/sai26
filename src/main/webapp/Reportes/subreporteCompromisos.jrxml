	<parameter name="where2" class="java.lang.String"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT DISTINCT CASE WHEN CPARTIDA = '31301' 
	THEN '•	31301 Contratos de Servicio de agua potable' 
	WHEN CPARTIDA = '31101'  
	THEN '•	31101 Medidores de la CFE ' 
	WHEN CPARTIDA = '35701'  
	THEN '•	35701-39202 Parque Vehicular ' 
	WHEN CPARTIDA = '39202'  
	THEN '•	35701-39202 Parque Vehicular ' 
	ELSE ''
	END adjunto
	FROM tCompromisoEncabezado COMP WITH (NOLOCK)
INNER JOIN TCOMPROMISODETALLE DET WITH (NOLOCK)
ON DET.nfoliocompromiso = comp.nfoliocompromiso
INNER JOIN TCATALOGOPARTIDA partida WITH (NOLOCK)
on partida.cpartida = substring(ep, 32,5)
WHERE  COMP.caNoCompromiso = $P{where2}
AND CPARTIDA IN (31301,31101,35701,39202)]]>
	</queryString>
	<field name="adjunto" class="java.lang.String">
