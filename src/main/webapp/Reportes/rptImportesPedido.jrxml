<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="rptImportesPedido"  pageWidth="752" pageHeight="572" orientation="Landscape" columnWidth="752" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0">
	<property name="ireport.zoom" value="2.0"/>
	<property name="ireport.x" value="246"/>
	<property name="ireport.y" value="0"/>
	<parameter name="importeSubtotal" class="java.math.BigDecimal"/>
	<parameter name="importeIVA" class="java.math.BigDecimal"/>
	<parameter name="cIdTipoPedido" class="java.lang.String"/>
	<parameter name="cIdUnidadEjecutora" class="java.lang.String"/>
	<parameter name="nIdConsecutivo" class="java.lang.String"/>
	<parameter name="cEjercicio" class="java.lang.String"/>
	<parameter name="abreviatura" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="nIva" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["C:\\Users\\Ivan\\Workspaces\\MyEclipse 10\\sai\\WebContent\\Reportes\\"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT cImpuesto,  cDescripcion AS cDescripcion,
CONVERT(VARCHAR,CAST( ISNULL(monto,0) AS money),1) AS importe,
(SELECT dbo.CantidadConLetraPedido(CONVERT(MONEY,((CONVERT(float, REPLACE(REPLACE(CAST($P{importeSubtotal} AS VARCHAR),'$',''),',',''))))),(
select cTipoMoneda from mPedido WITH(NOLOCK) inner join mcatalogoTipoMoneda WITH(NOLOCK) on nIdTipoCambio=cIdTipoMoneda where cEjercicio=$P{cEjercicio} and cidtipoPedido=$P{cIdTipoPedido}
 and cIdUnidadEjecutora=$P{cIdUnidadEjecutora} and nIdConsecutivo=$P{nIdConsecutivo}))) +$P{abreviatura} as subtotalLetra,
	 '$'+CONVERT(VARCHAR, CAST(total  AS MONEY),1) AS total,
	----
	dbo.CantidadConLetraPedido(CONVERT(MONEY,total),(select cTipoMoneda from mPedido WITH(NOLOCK) inner join mcatalogoTipoMoneda WITH(NOLOCK) on nIdTipoCambio=cIdTipoMoneda where
cEjercicio=$P{cEjercicio} and cidtipoPedido=$P{cIdTipoPedido} and cIdUnidadEjecutora=$P{cIdUnidadEjecutora} and nIdConsecutivo=$P{nIdConsecutivo}))+ $P{abreviatura} AS totalLetra,

'$'+CONVERT(VARCHAR,CAST( ISNULL(CONVERT(FLOAT,$P{importeSubtotal}),0) AS money),1) AS subtotalTemp,
'$'+CONVERT(VARCHAR,CAST( ISNULL(CONVERT(FLOAT,$P{importeIVA}),0) AS money),1) AS IVATemp
----
FROM(
SELECT cImpuesto, cDescripcion, monto, 0.00 as cPorcentaje, (SELECT  ISNULL(dbo.fn_mPedidoMontoBruto($P{cEjercicio},$P{cIdTipoPedido},$P{cIdUnidadEjecutora},$P{nIdConsecutivo}),0)) as subtotal,
(SELECT CONVERT(MONEY,
	(SUM(subtotal)+
	(CONVERT(float, REPLACE(REPLACE(CAST($P{importeSubtotal} AS VARCHAR),'$',''),',','')))+
	(CONVERT(float, REPLACE(REPLACE(CAST($P{importeIVA} AS VARCHAR),'$',''),',',''))))) as total
	FROM(
		 SELECT '1' AS indica, monto as subtotal FROM mOtrosImpuestos WITH(NOLOCK) WHERE cIdTipoDocumento=$P{cIdTipoPedido} AND cIdUnidadEjecutora=$P{cIdUnidadEjecutora} AND nIdConsecutivo=$P{nIdConsecutivo}
		 union
		 SELECT '1' AS indica, cPorcentaje/100 * (SELECT  ISNULL(dbo.fn_mPedidoMontoBruto($P{cEjercicio},$P{cIdTipoPedido},$P{cIdUnidadEjecutora},$P{nIdConsecutivo}),0)) as subtotal FROM mImpuestosAdicionales WITH(NOLOCK)
		 WHERE cIdTipoDocumento=$P{cIdTipoPedido} AND cIdUnidadEjecutora=$P{cIdUnidadEjecutora} AND nIdConsecutivo=$P{nIdConsecutivo}
	) as tab) AS total
	 FROM mOtrosImpuestos WITH(NOLOCK)
WHERE cIdTipoDocumento=$P{cIdTipoPedido} AND cIdUnidadEjecutora=$P{cIdUnidadEjecutora} AND nIdConsecutivo=$P{nIdConsecutivo}
UNION
SELECT '' AS cImpuesto, cDescripcion, cPorcentaje/100 * (SELECT  ISNULL(dbo.fn_mPedidoMontoBruto($P{cEjercicio},$P{cIdTipoPedido},$P{cIdUnidadEjecutora},$P{nIdConsecutivo}),0)), cPorcentaje, (SELECT  ISNULL(dbo.fn_mPedidoMontoBruto($P{cEjercicio},$P{cIdTipoPedido},$P{cIdUnidadEjecutora},$P{nIdConsecutivo}),0))
as subtotal,
(SELECT CONVERT(MONEY,
	(SUM(subtotal)+
	(CONVERT(float, REPLACE(REPLACE(CAST($P{importeSubtotal} AS VARCHAR),'$',''),',','')))+
	(CONVERT(float, REPLACE(REPLACE(CAST($P{importeIVA} AS VARCHAR),'$',''),',',''))))) as total
	FROM(
		 SELECT '1' AS indica, monto as subtotal FROM mOtrosImpuestos WITH(NOLOCK) WHERE cIdTipoDocumento=$P{cIdTipoPedido} AND cIdUnidadEjecutora=$P{cIdUnidadEjecutora} AND nIdConsecutivo=$P{nIdConsecutivo}
		 union
		 SELECT '1' AS indica, cPorcentaje/100 * (SELECT  ISNULL(dbo.fn_mPedidoMontoBruto($P{cEjercicio},$P{cIdTipoPedido},$P{cIdUnidadEjecutora},$P{nIdConsecutivo}),0)) as subtotal FROM mImpuestosAdicionales WITH(NOLOCK)
		 WHERE cIdTipoDocumento=$P{cIdTipoPedido} AND cIdUnidadEjecutora=$P{cIdUnidadEjecutora} AND nIdConsecutivo=$P{nIdConsecutivo}
	) as tab) AS total

FROM mImpuestosAdicionales WITH(NOLOCK) WHERE cIdTipoDocumento=$P{cIdTipoPedido} AND cIdUnidadEjecutora=$P{cIdUnidadEjecutora}
 AND nIdConsecutivo=$P{nIdConsecutivo}

 ) AS TAB1
 UNION
 SELECT
'' AS cImporte,
'' AS cDescripcion,
'' AS importe,
dbo.CantidadConLetraPedido(CONVERT(MONEY,((CONVERT(float, REPLACE(REPLACE(CAST($P{importeSubtotal} AS VARCHAR),'$',''),',',''))))),(select
cTipoMoneda from mPedido WITH(NOLOCK) inner join mcatalogoTipoMoneda WITH(NOLOCK) on nIdTipoCambio=cIdTipoMoneda where cEjercicio=$P{cEjercicio} and cidtipoPedido=$P{cIdTipoPedido}
 and cIdUnidadEjecutora=$P{cIdUnidadEjecutora} and nIdConsecutivo=$P{nIdConsecutivo})) +$P{abreviatura} as subtotalLetra,

'$'+CONVERT(VARCHAR,CAST(CONVERT(MONEY,(CONVERT(float, REPLACE(REPLACE(CAST($P{importeSubtotal} AS VARCHAR),'$',''),',','')))+
(CONVERT(float, REPLACE(REPLACE(CAST($P{importeIVA} AS VARCHAR),'$',''),',','')))) AS MONEY),1) as total
----
,dbo.CantidadConLetraPedido(CONVERT(MONEY,(SELECT CONVERT(MONEY,(CONVERT(float, REPLACE(REPLACE(CAST($P{importeSubtotal} AS VARCHAR),'$',''),',','')))+
(CONVERT(float, REPLACE(REPLACE(CAST($P{importeIVA} AS VARCHAR),'$',''),',','')))))),(select cTipoMoneda
from mPedido inner join mcatalogoTipoMoneda WITH(NOLOCK) on nIdTipoCambio=cIdTipoMoneda
 where cEjercicio=$P{cEjercicio} and cidtipoPedido=$P{cIdTipoPedido}
 and cIdUnidadEjecutora=$P{cIdUnidadEjecutora} and nIdConsecutivo=$P{nIdConsecutivo})) + $P{abreviatura} AS totalLetra,
'$'+CONVERT(VARCHAR,CAST( ISNULL(CONVERT(FLOAT,$P{importeSubtotal}),0) AS money),1) AS subtotalTemp,
'$'+CONVERT(VARCHAR,CAST( ISNULL(CONVERT(FLOAT,$P{importeIVA}),0) AS money),1) AS IVATemp]]>
	</queryString>
