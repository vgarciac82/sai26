	<parameter name="whereFolio" class="java.lang.String">
		<defaultValueExpression><![CDATA["AND nFolioRegistroIngreso = 7"]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[DECLARE @laPoliza varchar(10)
DECLARE @cUnidadResponsable varchar(10)
DECLARE @cTipoPoliza varchar(10)
DECLARE @cTipoObra varchar(10)
DECLARE @cIdTipoPago varchar(1)
DECLARE @cuantos smallint
DECLARE @noFolio int

--set @laPoliza=2
--set @cUnidadResponsable=10
--set @cTipoPoliza='EG'

SELECT
  @noFolio = nFolioRegistroIngreso,
  @laPoliza = nFolioPoliza,
  @cTipoPoliza = cTipoPoliza,
  @cUnidadResponsable = cIDEntidadContable,
  @cTipoObra = tipoObra,
  @cIdTipoPago = cIdTipoPagoDirecto
FROM (SELECT
	  nFolioRegistroIngreso,
	  C.nFolioPoliza,
	  C.cTipoPoliza,
	  C.cDescripcionPoliza,
	  '' canocontrarrecibo,
	  'DIRECTO' tipoObra,
	  C.cunidadresponsablecontable,
	  CAST('' AS varchar(5)) cnoEstimacion,
	  '' Periodo,
	  cCentrocontable cIdEntidadContable,
	  '' cIdTipoPagoDirecto
	FROM tregistroingresoencabezado e WITH (NOLOCK)
	LEFT OUTER JOIN tLayoutsCreadosRegistroIngresoEncabezado layout WITH (NOLOCK) ON caNoContrarrecibo = sNoContrarrecibo
	JOIN tconsolidacionrelaciongastosEncabezado C WITH (NOLOCK) ON sAuxiliarComodin = nIdIntegracion
	WHERE nTipoIngreso = 1

	UNION

	SELECT
	  nFolioRegistroIngreso,
	  nFolioPoliza,
	  cTipoPoliza,
	  cdescripcionpoliza,
	  '' canocontrarrecibo,
	  'DIRECTO' tipoObra,
	  cunidadresponsablecontable,
	  CAST('' AS varchar(5)) cnoEstimacion,
	  '' Periodo,
	  cCentrocontable cIdEntidadContable,
	  '' cIdTipoPagoDirecto
	FROM tregistroingresoencabezado e WITH (NOLOCK)
	WHERE nTipoIngreso = 2
) Ce
WHERE 1 = 1
--AND CE.nFolioRegistroIngreso = 7
 $P!{whereFolio}

--select @laPoliza,@cUnidadResponsable,@cTipoPoliza

IF OBJECT_ID('tempdb..#tmp_polizapagos') IS NOT NULL
  DROP TABLE #tmp_polizapagos;

-----------------------Poliza Contabl----------------------
SELECT
  * INTO #tmp_polizapagos
FROM (
SELECT
	  SUBSTRING(m.nCuenta, 1, 5) Cuenta,
	  '' subCuenta,
	  '' subSubCuenta,
	  '' dSubCuenta,
	  calmacen,
	  dCuenta cnombre,
	  dCuenta descripcion,
	  dCuenta,
	  m.ctipomovimiento,
	  m.nCuenta,
	  SUM(mMovimiento) mMovimiento2
	FROM tcuentas c WITH (NOLOCK),
		 tmovimiento m WITH (NOLOCK)
		 LEFT JOIN cat_almacen a
		   ON CAST(a.nidalmacen AS varchar(10)) = nsubcuenta
		   AND a.ccentrocontable = m.ccentrocontable
	--left join v_pcatalogorfc rfc on cidrfc=nsubcuenta
	WHERE /*m.ncuenta = c.ncuenta */ SUBSTRING(m.ncuenta, 1, 5) + '-00000-00000-00000' = c.ncuenta
	AND nFolioPoliza = @laPoliza
	AND m.cCentroContable = @cUnidadResponsable
	AND cTipopoliza = @cTipoPoliza
	AND mmovimiento != 0
	AND NOT (c.TipoBalance = 'P'
	AND c.TipoCuenta = 'P')
	GROUP BY SUBSTRING(m.nCuenta, 1, 5),
			 calmacen,
			 dCuenta,
			 dCuenta,
			 dCuenta,
			 m.ctipomovimiento,
			 m.nCuenta
	--order by m.ncuenta, ctipomovimiento desc
	UNION
	--2o nivel
	SELECT
	  '' Cuenta,
	  SUBSTRING(m.nCuenta, 7, 5) subCuenta,
	  '' subSubCuenta,
	  ' ' dSubCuenta,
	  calmacen,
	  dcuenta cnombre,
	  '  ' + dCuenta descripcion,
	  dCuenta,
	  m.ctipomovimiento,
	  m.nCuenta,
	  ' ' mMovimiento2
	FROM tcuentas c WITH (NOLOCK),
		 tmovimiento m WITH (NOLOCK)
		 LEFT JOIN cat_almacen a
		   ON CAST(a.nidalmacen AS varchar(10)) = nsubcuenta
		   AND a.ccentrocontable = m.ccentrocontable
	--left join v_pcatalogorfc rfc on cidrfc=nsubcuenta
	WHERE /*m.ncuenta*/ SUBSTRING(m.ncuenta, 1, 11) + '-00000-00000' = c.ncuenta
	AND nFolioPoliza = @laPoliza
	AND m.cCentroContable = @cUnidadResponsable
	AND cTipopoliza = @cTipoPoliza
	AND mmovimiento != 0
	AND SUBSTRING(m.nCuenta, 7, 5) != '00000'
	AND NOT (c.TipoBalance = 'P'
	AND c.TipoCuenta = 'P')
	GROUP BY SUBSTRING(m.nCuenta, 7, 5),
			 calmacen,
			 dcuenta,
			 '  ' + dCuenta,
			 dCuenta,
			 m.ctipomovimiento,
			 m.nCuenta
	--order by m.ncuenta, ctipomovimiento desc
	UNION
	--3er nivel
	SELECT
	  '' Cuenta,
	  '' subCuenta,
	  SUBSTRING(m.nCuenta, 13, 5) subSubCuenta,
	  ' ' dSubCuenta,
	  calmacen,
	  dCuenta cnombre,
	  '    ' + dCuenta descripcion,
	  dCuenta,
	  m.ctipomovimiento,
	  m.nCuenta,
	  '' mMovimiento2
	FROM tcuentas c WITH (NOLOCK),
		 tmovimiento m WITH (NOLOCK)
		 LEFT JOIN cat_almacen a
		   ON CAST(a.nidalmacen AS varchar(10)) = nsubcuenta
		   AND a.ccentrocontable = m.ccentrocontable
	-- left join v_pcatalogorfc rfc on cidrfc=nsubcuenta
	WHERE /*m.ncuenta*/ SUBSTRING(m.ncuenta, 1, 17) + '-00000' = c.ncuenta
	AND nFolioPoliza = @laPoliza
	AND m.cCentroContable = @cUnidadResponsable
	AND cTipopoliza = @cTipoPoliza
	AND mmovimiento != 0
	AND SUBSTRING(m.nCuenta, 13, 5) != '00000'
	AND NOT (c.TipoBalance = 'P'
	AND c.TipoCuenta = 'P')
	GROUP BY SUBSTRING(m.nCuenta, 13, 5),
			 calmacen,
			 dCuenta,
			 '    ' + dCuenta,
			 dCuenta,
			 m.ctipomovimiento,
			 m.nCuenta
	--order by m.ncuenta, ctipomovimiento desc

	UNION

	SELECT
	  '' Cuenta,
	  '' subCuenta,
	  ' ' subSubCuenta,
	  CASE
		WHEN nSubCuenta = '' THEN SUBSTRING(m.nCuenta, 13, 5)
		WHEN m.nCuenta LIKE '8%' OR m.nCuenta liKE '4%' THEN ''--SUBSTRING(nSubCuenta, 32,5)
		ELSE nSubCuenta
	  END dSubCuenta,
	  calmacen,
	  ----ISNULL(cidrfc, nSubCuenta) AS cnombre,
	  nSubCuenta AS cnombre,
	  '      ' + '[' + nSubCuenta + ']' + cnombre AS descripcion,
	 -- '      ' + ISNULL(' ', CASE
		--WHEN nSubCuenta = '' THEN SUBSTRING(m.nCuenta, 13, 5)
		--ELSE CASE
		--	WHEN cidrfc IS NULL THEN calmacen
		--	ELSE '[' + nSubCuenta + ']' + cidrfc
		--  END
	 -- END) descripcion,
	  dCuenta,
	  m.ctipomovimiento,
	  m.nCuenta,
	  '' mMovimiento2
	FROM tcuentas c,
		 tmovimiento m
		 LEFT JOIN cat_almacen a
		   ON CAST(a.nidalmacen AS varchar(10)) = nsubcuenta
		   AND a.ccentrocontable = m.ccentrocontable
		 LEFT JOIN v_pcatalogorfc rfc
		   ON cidrfc = nsubcuenta
	WHERE m.nSubcuenta != ''
	AND m.ncuenta = c.ncuenta
	AND nFolioPoliza = @laPoliza
	AND m.cCentroContable = @cUnidadResponsable
	AND cTipopoliza = @cTipoPoliza
	AND mmovimiento != 0
	AND NOT (c.TipoBalance = 'P'
	AND c.TipoCuenta = 'P')
	GROUP BY CASE
			   WHEN nSubCuenta = '' THEN SUBSTRING(m.nCuenta, 13, 5)
			   ELSE CASE
				   WHEN cidrfc IS NULL THEN calmacen
				   ELSE nSubCuenta
				 END
			 END,
			 calmacen,
			 cidrfc,
			 '      ' + CASE
			   WHEN nSubCuenta = '' THEN SUBSTRING(m.nCuenta, 13, 5)
			   ELSE CASE
				   WHEN cidrfc IS NULL THEN calmacen
				   ELSE '[' + nSubCuenta + ']' + cidrfc
				 END
			 END,
			 dCuenta,
			 m.ctipomovimiento,
			 m.nCuenta,
			 nSubCuenta,
			 cnombre
) kk
--order by m.ncuenta, cuenta desc, subcuenta desc,subsubcuenta, ctipomovimiento desc
ORDER BY ctipomovimiento DESC, ncuenta, cuenta DESC, subcuenta DESC, subsubcuenta DESC


SET @cuantos = 0
SELECT
  @cuantos = COUNT(*)
FROM #tmp_polizapagos


IF @cuantos = 0
BEGIN
  INSERT INTO #tmp_polizapagos
    SELECT
      *
    FROM (SELECT
      SUBSTRING(m.nCuenta, 1, 5) Cuenta,
      '' subCuenta,
      '' subSubCuenta,
      '' dSubCuenta,
      calmacen,
      dCuenta cnombre,
      dCuenta descripcion,
      dCuenta,
      m.ctipomovimiento,
      m.nCuenta,
      SUM(mMovimiento) mMovimiento2
    FROM tcuentas c WITH (NOLOCK),
         tmovimiento m WITH (NOLOCK)
         LEFT JOIN cat_almacen a
           ON CAST(a.nidalmacen AS varchar(10)) = nsubcuenta
           AND a.ccentrocontable = m.ccentrocontable
    --left join v_pcatalogorfc rfc on cidrfc=nsubcuenta
    WHERE /*m.ncuenta = c.ncuenta */ SUBSTRING(m.ncuenta, 1, 5) + '-00000-00000-00000' = c.ncuenta
    AND nFolioPoliza = @laPoliza
    AND m.cCentroContable = @cUnidadResponsable
    AND cTipopoliza = @cTipoPoliza
    AND mmovimiento != 0
    GROUP BY SUBSTRING(m.nCuenta, 1, 5),
             calmacen,
             dCuenta,
             dCuenta,
             dCuenta,
             m.ctipomovimiento,
             m.nCuenta,
             m.nsubcuenta
    --order by m.ncuenta, ctipomovimiento desc
    UNION
    --2o nivel
    SELECT
      '' Cuenta,
      SUBSTRING(m.nCuenta, 7, 5) subCuenta,
      '' subSubCuenta,
      ' ' dSubCuenta,
      calmacen,
      dcuenta cnombre,
      '  ' + dCuenta descripcion,
      dCuenta,
      m.ctipomovimiento,
      m.nCuenta,
      ' ' mMovimiento2
    FROM tcuentas c WITH (NOLOCK),
         tmovimiento m WITH (NOLOCK)
         LEFT JOIN cat_almacen a
           ON CAST(a.nidalmacen AS varchar(10)) = nsubcuenta
           AND a.ccentrocontable = m.ccentrocontable
    --left join v_pcatalogorfc rfc on cidrfc=nsubcuenta
    WHERE /*m.ncuenta*/ SUBSTRING(m.ncuenta, 1, 11) + '-00000-00000' = c.ncuenta
    AND nFolioPoliza = @laPoliza
    AND m.cCentroContable = @cUnidadResponsable
    AND cTipopoliza = @cTipoPoliza
    AND mmovimiento != 0
    AND SUBSTRING(m.nCuenta, 7, 5) != '00000'
    GROUP BY SUBSTRING(m.nCuenta, 7, 5),
             calmacen,
             dcuenta,
             '  ' + dCuenta,
             dCuenta,
             m.ctipomovimiento,
             m.nCuenta
    --order by m.ncuenta, ctipomovimiento desc
    UNION
    --3er nivel
    SELECT
      '' Cuenta,
      '' subCuenta,
      SUBSTRING(m.nCuenta, 13, 5) subSubCuenta,
      ' ' dSubCuenta,
      calmacen,
      dCuenta cnombre,
      '    ' + dCuenta descripcion,
      dCuenta,
      m.ctipomovimiento,
      m.nCuenta,
      '' mMovimiento2
    FROM tcuentas c WITH (NOLOCK),
         tmovimiento m WITH (NOLOCK)
         LEFT JOIN cat_almacen a
           ON CAST(a.nidalmacen AS varchar(10)) = nsubcuenta
           AND a.ccentrocontable = m.ccentrocontable
    -- left join v_pcatalogorfc rfc on cidrfc=nsubcuenta
    WHERE /*m.ncuenta*/ SUBSTRING(m.ncuenta, 1, 17) + '-00000' = c.ncuenta
    AND nFolioPoliza = @laPoliza
    AND m.cCentroContable = @cUnidadResponsable
    AND cTipopoliza = @cTipoPoliza
    AND mmovimiento != 0
    AND SUBSTRING(m.nCuenta, 13, 5) != '00000'
    GROUP BY SUBSTRING(m.nCuenta, 13, 5),
             calmacen,
             dCuenta,
             '    ' + dCuenta,
             dCuenta,
             m.ctipomovimiento,
             m.nCuenta
    --order by m.ncuenta, ctipomovimiento desc
    UNION
    SELECT
      '' Cuenta,
      '' subCuenta,
      ' ' subSubCuenta,
      CASE
        WHEN nSubCuenta = '' THEN SUBSTRING(m.nCuenta, 13, 5)
        ELSE nSubCuenta
      END dSubCuenta,
      calmacen,
      cnombre,
      '      ' + ISNULL(' ', CASE
        WHEN nSubCuenta = '' THEN SUBSTRING(m.nCuenta, 13, 5)
        ELSE CASE
            WHEN cnombre IS NULL THEN calmacen
            ELSE '[' + nSubCuenta + ']' + cNombre
          END
      END) descripcion,
      dCuenta,
      m.ctipomovimiento,
      m.nCuenta,
      '' mMovimiento2
    FROM tcuentas c,
         tmovimiento m
         LEFT JOIN cat_almacen a
           ON CAST(a.nidalmacen AS varchar(10)) = nsubcuenta
           AND a.ccentrocontable = m.ccentrocontable
         LEFT JOIN v_pcatalogorfc rfc
           ON cidrfc = nsubcuenta
    WHERE m.nSubcuenta != ''
    AND m.ncuenta = c.ncuenta
    AND nFolioPoliza = @laPoliza
    AND m.cCentroContable = @cUnidadResponsable
    AND cTipopoliza = @cTipoPoliza
    AND mmovimiento != 0
    GROUP BY CASE
               WHEN nSubCuenta = '' THEN SUBSTRING(m.nCuenta, 13, 5)
               ELSE CASE
                   WHEN cnombre IS NULL THEN calmacen
                   ELSE nSubCuenta
                 END
             END,
             calmacen,
             cnombre,
             '      ' + CASE
               WHEN nSubCuenta = '' THEN SUBSTRING(m.nCuenta, 13, 5)
               ELSE CASE
                   WHEN cnombre IS NULL THEN calmacen
                   ELSE '[' + nSubCuenta + ']' + cNombre
                 END
             END,
             dCuenta,
             m.ctipomovimiento,
             m.nCuenta,
             nSubCuenta) kk
    --order by m.ncuenta, cuenta desc, subcuenta desc, subsubcuenta, ctipomovimiento desc
    ORDER BY ctipomovimiento DESC, ncuenta, cuenta DESC, subcuenta DESC, subsubcuenta DESC
END


SELECT
  @cTipoPoliza + '-' + @laPoliza AS Poliza,
  *,
  CASE
    WHEN cTipoMovimiento = 'C' THEN mMovimiento2
    ELSE 0
  END Debe,
  CASE
    WHEN cTipoMovimiento = 'A' THEN mMovimiento2
    ELSE 0
  END Haber
FROM #tmp_polizapagos
IF OBJECT_ID('tempdb..#tmp_polizapagos') IS NOT NULL
  DROP TABLE #tmp_polizapagos;]]>
	</queryString>
