				<textField>
					<reportElement mode="Transparent" x="503" y="0" width="74" height="47" forecolor="#000000" backcolor="#FFFFFF" uuid="53e26770-84a1-4428-a431-5406768dae93"/>
					<box leftPadding="3" rightPadding="3">
						<pen lineWidth="1.0"/>
						<topPen lineWidth="1.0"/>
						<leftPen lineWidth="1.0"/>
						<bottomPen lineWidth="1.0"/>
						<rightPen lineWidth="1.0"/>
					</box>
