<?xml version="1.0" encoding="UTF-8"?>
<!-- Created with Jaspersoft Studio version 6.17.0.final using JasperReports Library version 6.17.0-6d93193241dd8cc42629e188b94f9e0bc5722efd  -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="OP_AvanceContratacion" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="5" bottomMargin="5" uuid="736df2fa-79a9-45b9-9356-ecb3ac5dee5f">
	<property name="ireport.zoom" value="1.363636363636364"/>
	<property name="ireport.x" value="221"/>
	<property name="ireport.y" value="0"/>
	<parameter name="fIni" class="java.lang.String"/>
	<parameter name="fFin" class="java.lang.String">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select 'NADA' tipoArea, uEjecutora, ORIGINAL, Modificado, ISNULL(techonormal,0) techonormal,ISNULL(asignadonormal,0) asignadonormal,ISNULL(ejecutadonormal,0) ejecutadonormal
  ,ISNULL(techoanor,0) techoanor,ISNULL(asignadoanor,0) asignadoanor,ISNULL(ejecutadoanor,0) ejecutadoanor
 ,ISNULL(techonormal,0) +ISNULL(techoanor,0) techoTotal ,ISNULL(asignadonormal,0) + ISNULL(asignadoanor,0 ) asignadoTotal
 ,case when Modificado = 0 then 0 else ( ISNULL(asignadonormal,0) + ISNULL(asignadoanor,0 ) )/ Modificado end AvanceAsignado
 , case when case when Modificado = 0 then 0 else ( ISNULL(asignadonormal,0) + ISNULL(asignadoanor,0 ) )/ Modificado end < .39 then 'ROJO'
   when case when Modificado = 0 then 0 else ( ISNULL(asignadonormal,0) + ISNULL(asignadoanor,0 ) )/ Modificado end between .4 and .5999999 then 'AMARILLO'
   else 'VERDE' end semaforo
 ,ISNULL(ejecutadonormal,0) +ISNULL(ejecutadoanor,0) ejecutadoTotal
 , case when (ISNULL(asignadonormal,0) + ISNULL(asignadoanor,0 )) = 0 then 0 else ( ISNULL(ejecutadonormal,0) +ISNULL(ejecutadoanor,0)) / (ISNULL(asignadonormal,0) + ISNULL(asignadoanor,0 ))  end AvanceEjecutado
 , ISNULL(AD,0) AD_Nor
 , ISNULL(CC,0) CC_Nor
 , ISNULL(LP,0) LP_Nor
 , ISNULL(I3P,0) I3P_Nor
 , ISNULL(EME,0) EME_Nor
 , ISNULL(MOC,0) MOC_Nor

 , ISNULL(AD,0) +ISNULL(AD_Anor,0) AD
 , ISNULL(CC,0)+ ISNULL(CC_Anor,0) CC
 , ISNULL(LP,0)+ISNULL(LP_Anor,0) LP
 , ISNULL(I3P,0) +ISNULL(I3P_Anor,0) I3P
 , ISNULL(EME,0) + ISNULL(EME_Anor,0) EME
 , ISNULL(MOC,0)+ ISNULL(MOC_Anor,0) MOC
 , ISNULL(AD,0) + ISNULL(CC,0) + ISNULL(LP,0) + ISNULL(I3P,0) + ISNULL(EME,0) + ISNULL(MOC,0) TOTNOR
 , ISNULL(AD_Anor,0) AD_Anor
 , ISNULL(CC_Anor,0) CC_Anor
 , ISNULL(LP_Anor,0) LP_Anor
 , ISNULL(I3P_Anor,0) I3P_Anor
 , ISNULL(EME_Anor,0) EME_Anor
 , ISNULL(MOC_Anor,0) MOC_Anor
 , ISNULL(AD_Anor,0) + ISNULL(CC_Anor,0) + ISNULL(LP_Anor,0) + ISNULL(I3P_Anor,0) + ISNULL(EME_Anor,0) + ISNULL(MOC,0) TOT_Anor
 , ISNULL(AD,0) + ISNULL(CC,0) + ISNULL(LP,0) + ISNULL(I3P,0) + ISNULL(EME,0) + ISNULL(MOC,0)
 + ISNULL(AD_Anor,0) + ISNULL(CC_Anor,0) + ISNULL(LP_Anor,0) + ISNULL(I3P_Anor,0) + ISNULL(EME_Anor,0) + ISNULL(MOC,0) TOTTipos
, 'Acumulado del ' + $P{fIni} + ' al ' + $P{fFin} lbAcumuladoAl
, 'Acumulado del ' + $P{fIni} + ' al ' + $P{fFin} lbAcumuladoAl
, cast(year(convert(date, $P{fFin}, 103)) as varchar(4)) anio  from (select
 unor.D_DESCRIPCION uEjecutora
 , Unor.cUnidadResponsable UniEjec
,sum(case when substring(s.nCuenta,1,5) = '81101' then s.mSaldoarrastre else 0 end)/1000.00 Original
,sum(case when substring(s.nCuenta,1,5) = '81102' then s.mSaldoarrastre else 0 end)/1000.00 Modificado
 from tSaldos S with(nolock)
, tcatalogoep catEP  with(nolock)
, tCatalogoCentroContable CC with(nolock)
, tCatUnidadResponsable UResp with(nolock)
, tCatUnidadResponsable UNor with(nolock)
, tCatUnidadResponsable Ueje with(nolock)
 where catep.EP = s.cSubCuenta and  CC.CcENTROcONTABLE = S.cCentroContable
 and UResp.cUnidadResponsable = s.cUnidadResponsable
  and unor.cUnidadResponsable = cUnidadNorativa
  and Ueje.cUnidadResponsable = cUnidadEjecutora
  AND (nCuenta like '81101%' or nCuenta like '81102%')--substring(nCuenta,1,5) in  ('81101', '81102')
  and cPartida like '6%'
  group by
  unor.D_DESCRIPCION
 , Unor.cUnidadResponsable ) Tsal left join
(select isnull(pasEnc.cU_UE, isnull(comEnc.cU_Ue, isnull(preEnc.cU_Ue, apaEnc.cU_Ue))) UEjec
,tr.cDescripcion
, case tr.cDescripcion when 'fiscales' then (sum(ISNULL(pasEnc.mMontoConIVA,ISNULL(comEnc.nMontoConIVA,ISNULL(preEnc.nMontoConIVA,ISNULL(apaEnc.nMontoConIVA,0)))) +isnull(conmod.mMontoconIva, 0)))/1000.00 else 0 end techoNormal
, case tr.cDescripcion when 'fiscales' then (sum(ISNULL(mmontoestimacion, 0)))/1000.00  else 0 end asignadoNormal
, case tr.cDescripcion when 'fiscales' then sum(isnull(mmontoFisicoEjecutado, 0))/1000.00 else 0 end ejecutadoNormal
, case when tr.cDescripcion  != 'fiscales' then (sum(ISNULL(pasEnc.mMontoConIVA,ISNULL(comEnc.nMontoConIVA,ISNULL(preEnc.nMontoConIVA,ISNULL(apaEnc.nMontoConIVA,0)))) +isnull(conmod.mMontoconIva, 0)))/1000.00 else 0 end techoAnor
, case when tr.cDescripcion  != 'fiscales' then (sum(ISNULL(mmontoestimacion, 0)))/1000.00  else 0 end asignadoAnor
, case when tr.cDescripcion  != 'fiscales' then sum(isnull(mmontoFisicoEjecutado, 0))/1000.00 else 0 end ejecutadoAnor
, sum(Case tr.cDescripcion when 'fiscales' then case when ta.siglasTAdjudicacion = 'A.D.' then 1 else 0 end else 0 end) AD
, sum(Case tr.cDescripcion when 'fiscales' then case when ta.siglasTAdjudicacion = 'C.C.' then 1 else 0 end else 0 end) CC
, sum(Case tr.cDescripcion when 'fiscales' then case when ta.siglasTAdjudicacion = 'L.P.' then 1 else 0 end else 0 end) LP
, sum(Case tr.cDescripcion when 'fiscales' then case when ta.siglasTAdjudicacion = 'I3P' then 1 else 0 end else 0 end) I3P
, sum(Case tr.cDescripcion when 'fiscales' then case when ta.siglasTAdjudicacion = 'EME' then 1 else 0 end else 0 end) EME
, sum(Case tr.cDescripcion when 'fiscales' then case when ta.siglasTAdjudicacion = 'MOC' then 1 else 0 end else 0 end) MOC

, sum(Case when tr.cDescripcion  != 'fiscales' then case when ta.siglasTAdjudicacion = 'A.D.' then 1 else 0 end else 0 end) AD_Anor
, sum(Case when tr.cDescripcion  != 'fiscales' then case when ta.siglasTAdjudicacion = 'C.C.' then 1 else 0 end else 0 end) CC_Anor
, sum(Case when tr.cDescripcion  != 'fiscales' then case when ta.siglasTAdjudicacion = 'L.P.' then 1 else 0 end else 0 end) LP_Anor
, sum(Case when tr.cDescripcion  != 'fiscales' then case when ta.siglasTAdjudicacion = 'I3P' then 1 else 0 end else 0 end) I3P_Anor
, sum(Case when tr.cDescripcion  != 'fiscales' then case when ta.siglasTAdjudicacion = 'EME' then 1 else 0 end else 0 end) EME_Anor
, sum(Case when tr.cDescripcion  != 'fiscales' then case when ta.siglasTAdjudicacion = 'MOC' then 1 else 0 end else 0 end) MOC_Anor
   from
 tObraPublicaApartadoEncabezado apaEnc with(nolock)
 left join tObraPublicaApartadoEncabezado preEnc with(nolock) on apaEnc.foliosai = preenc.FolioSAI
 left join tObraPublicaCompromisoEncabezado comEnc with(nolock) on apaEnc.foliosai = comEnc.FolioSAI
	left join pCatalogoTipoContratoObra tc with(nolock) on tc.cidtipocontratoobra = comEnc.cTipoContrato
	left join tCatalogoTipoObra tob with(nolock) on tob.cidtobra = comEnc.cTipoObra
	left join tCatalogoAdjudicacion ta with(nolock) on ta.cIdTAdjudicacion = comEnc.cTipoAdjudica
	left join tCatalogoTipoRecursos tr with(nolock) on tr.cIdTRercursos= comEnc.cTipoRecurso
 left join tObraPublicaPagoPasivoEncabezado pasEnc with(nolock) on apaEnc.foliosai = pasEnc.FolioSAI
 left join ( select af.foliosai,sum(isnull(af.mmontoestimacion,0)) mmontoestimacion, af.efiscalpago
 , sum(isnull(af.nporceavancefisicoejecutado,0)) nporceavancefisicoejecutado
 , sum(isnull(af.nporceavancefisicoestimado,0)) nporceavancefisicoestimado
 , sum(isnull(af.mmontoFisicoEjecutado,0)) mmontoFisicoEjecutado
 , sum(isnull(af.nporceavancefisicoprogramado,0)) nporceavancefisicoprogramado
 , sum(isnull(
 CASE WHEN siaff.FOLIO_CLC = sicop.FOLIO_SIAFF_112 and sicop.FOLIO_SIAFF_112 = pe.nFolioSIAFF and obrae.cDocumentoHaplicado = 'S' and siaff.ESTATUS_CLC = 'Pagada' THEN CAST(SIAFF.TOTAL_MN AS MONEY) ELSE 0 END
 ,0)) TOTAL_MN
  FROM tObraPublicaAvanceFisico AF with(nolock)
							 left join tpagoobraencabezado obrae with(nolock) on AF.noestimacion = obrae.cNoEstimacion and AF.mmontoestimacion = obrae.mImporteMasIva and obrae.cDocumentoHaplicado != 'C'
							 left join tpagoobraencabezado poe with(nolock) on poe.cFolioContratoObra = AF.ccvecontrato and poe.cnoestimacion = AF.noestimacion and poe.cDocumentoHaplicado ='S'
							 left join tpagadoencabezado pe with(nolock) on pe.nFolioPAGO = obrae.nFolioPAGOOBRA and pe.cTipoPago ='PAGOOBRA'
							 left join clc_sicop sicop with(nolock) on sicop.FOLIO_SIAFF_112 = pe.nFolioSIAFF
							 left join CLC_SIAFF_ENC siaff with(nolock) on siaff.FOLIO_CLC = sicop.FOLIO_SIAFF_112
							  group by af.foliosai,af.efiscalpago
) avfEnc on apaEnc.foliosai = avfEnc.FolioSAI and avfEnc.efiscalpago = (SELECT aejerciciofiscal AS cEjercicio
				FROM   tejerciciofiscal WITH(NOLOCK)
				WHERE  cactivo = 1 )
left join (select epe.ccvecontrato, sum(epe.mMontoconIva) mMontoconIva, epe.cU_UR, epe.aEjercicioFiscal
   from tObraPublicaConvModifEncabezado epe with(nolock) where epe.cDocumentoHaplicado = 'S' and epe.aEjercicioFiscal =(SELECT aejerciciofiscal AS cEjercicio
				FROM   tejerciciofiscal WITH(NOLOCK)
				WHERE  cactivo = 1 )
    group by epe.cCveContrato, epe.cU_UR, epe.aEjercicioFiscal ) conMod
      on conmod.cCveContrato = comEnc.cCveContrato
 where apaEnc.cDocumentoHaplicado = 'S'
 and preEnc.cDocumentoHaplicado = 'S'
 and comEnc.cDocumentoHaplicado = 'S'
and comEnc.fFechaOficio >= cast($P{fIni} as datetime)
and comEnc.fFechaOficio <= cast($P{fFin} as datetime)

 group by  tr.cDescripcion, isnull(pasEnc.cU_Ue, isnull(comEnc.cU_Ue, isnull(preEnc.cU_Ue, apaEnc.cU_Ue)))) tabContr
 on tabContr.UEjec = Tsal.UniEjec
 order by uEjecutora]]>
	</queryString>
	<field name="tipoArea" class="java.lang.String"/>
	<field name="uEjecutora" class="java.lang.String"/>
	<field name="ORIGINAL" class="java.math.BigDecimal"/>
	<field name="Modificado" class="java.math.BigDecimal"/>
	<field name="techonormal" class="java.math.BigDecimal"/>
	<field name="asignadonormal" class="java.math.BigDecimal"/>
	<field name="ejecutadonormal" class="java.math.BigDecimal"/>
	<field name="techoanor" class="java.math.BigDecimal"/>
	<field name="asignadoanor" class="java.math.BigDecimal"/>
	<field name="ejecutadoanor" class="java.math.BigDecimal"/>
	<field name="techoTotal" class="java.math.BigDecimal"/>
	<field name="asignadoTotal" class="java.math.BigDecimal"/>
	<field name="AvanceAsignado" class="java.math.BigDecimal"/>
	<field name="semaforo" class="java.lang.String"/>
	<field name="ejecutadoTotal" class="java.math.BigDecimal"/>
	<field name="AvanceEjecutado" class="java.math.BigDecimal"/>
	<field name="AD_Nor" class="java.lang.Integer"/>
	<field name="CC_Nor" class="java.lang.Integer"/>
	<field name="LP_Nor" class="java.lang.Integer"/>
	<field name="I3P_Nor" class="java.lang.Integer"/>
	<field name="EME_Nor" class="java.lang.Integer"/>
	<field name="MOC_Nor" class="java.lang.Integer"/>
	<field name="AD" class="java.lang.Integer"/>
	<field name="CC" class="java.lang.Integer"/>
	<field name="LP" class="java.lang.Integer"/>
	<field name="I3P" class="java.lang.Integer"/>
	<field name="EME" class="java.lang.Integer"/>
	<field name="MOC" class="java.lang.Integer"/>
	<field name="TOTNOR" class="java.lang.Integer"/>
	<field name="AD_Anor" class="java.lang.Integer"/>
	<field name="CC_Anor" class="java.lang.Integer"/>
	<field name="LP_Anor" class="java.lang.Integer"/>
	<field name="I3P_Anor" class="java.lang.Integer"/>
	<field name="EME_Anor" class="java.lang.Integer"/>
	<field name="MOC_Anor" class="java.lang.Integer"/>
	<field name="TOT_Anor" class="java.lang.Integer"/>
	<field name="TOTTipos" class="java.lang.Integer"/>
	<field name="lbAcumuladoAl" class="java.lang.String"/>
	<field name="anio" class="java.lang.String"/>
	<variable name="totalTipoAdjud" class="java.lang.String">
		<variableExpression><![CDATA[$F{AD}+$F{CC}+$F{LP}+$F{I3P}+$F{EME}+$F{MOC}]]></variableExpression>
	</variable>
	<variable name="ORIGINAL_1" class="java.math.BigDecimal" resetType="Column" calculation="Sum">
		<variableExpression><![CDATA[$F{ORIGINAL}]]></variableExpression>
	</variable>
	<variable name="Modificado_1" class="java.math.BigDecimal" resetType="Column" calculation="Sum">
		<variableExpression><![CDATA[$F{Modificado}]]></variableExpression>
	</variable>
	<variable name="techoTotal_1" class="java.math.BigDecimal" resetType="Column" calculation="Sum">
		<variableExpression><![CDATA[$F{techoTotal}]]></variableExpression>
	</variable>
	<variable name="asignadoTotal_1" class="java.math.BigDecimal" resetType="Column" calculation="Sum">
		<variableExpression><![CDATA[$F{asignadoTotal}]]></variableExpression>
	</variable>
	<variable name="ejecutadoTotal_1" class="java.math.BigDecimal" resetType="Column" calculation="Sum">
		<variableExpression><![CDATA[$F{ejecutadoTotal}]]></variableExpression>
	</variable>
	<variable name="porAvaTot" class="java.math.BigDecimal">
		<variableExpression><![CDATA[new BigDecimal(0).compareTo($F{ORIGINAL})== 0 ? new BigDecimal(0) : $V{asignadoTotal_1}.divide($V{Modificado_1} )]]></variableExpression>
	</variable>
	<variable name="porEjetotal" class="java.math.BigDecimal">
		<variableExpression><![CDATA[new BigDecimal( 0 ).compareTo( $V{asignadoTotal_1}  ) == 0  ? new BigDecimal( 0)  :$F{AvanceEjecutado}.divide($V{asignadoTotal_1} )]]></variableExpression>
	</variable>
	<variable name="TOTTipos_1" class="java.lang.Integer" resetType="Group" resetGroup="PorTipodeArea" calculation="Sum">
		<variableExpression><![CDATA[$F{TOTTipos}]]></variableExpression>
	</variable>
	<variable name="TOTTipos_2" class="java.lang.Integer" resetType="Group" resetGroup="PorTipodeArea" calculation="Sum">
		<variableExpression><![CDATA[$F{TOTTipos}]]></variableExpression>
	</variable>
	<variable name="TOTTipos_3" class="java.lang.Integer" resetType="Group" resetGroup="PorTipodeArea" calculation="Sum">
		<variableExpression><![CDATA[$F{TOTTipos}]]></variableExpression>
	</variable>
	<variable name="lbAsignacoAnio" class="java.lang.String">
		<variableExpression><![CDATA["ASIGNACION FINAL " + $F{anio}]]></variableExpression>
		<initialValueExpression><![CDATA["ASIGNACION FINAL " + $F{anio}]]></initialValueExpression>
	</variable>
	<variable name="lbEjecutadoAnio" class="java.lang.String">
		<variableExpression><![CDATA["EJECUTADO EN " + $F{anio}]]></variableExpression>
		<initialValueExpression><![CDATA["EJECUTADO EN " + $F{anio}]]></initialValueExpression>
	</variable>
	<group name="PorTipodeArea" isStartNewPage="true" isReprintHeaderOnEachPage="true" keepTogether="true">
		<groupExpression><![CDATA[$F{tipoArea}]]></groupExpression>
