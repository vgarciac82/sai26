<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="convenio"  pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<property name="ireport.callouts" value="##Fri Dec 06 20:28:14 CST 2013"/>
	<parameter name="strCadena" class="java.lang.String">
		<defaultValueExpression><![CDATA["1=1"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT foliosai,
isnull(nocontrato,'') AS noContrato,
isnull(beneficiariocompromiso,'') AS beneficiariocompromiso,
CASE WHEN montototalobra IS NULL THEN 0 ELSE  montototalobra END AS montoTotalObra,
estatus_contrato,
isnull(desctipoobra,'') AS descTipoObra,
isnull(desctiporecurso,'') AS descTipoRecurso,
CASE WHEN oli IS NULL OR oli = '-1' THEN '' ELSE oli END AS oli,
CASE WHEN cartera IS NULL OR cartera = '-1' THEN ''  ELSE cartera END AS cartera
FROM   vinformacion_contrato_obra_publica  WITH(nolock)
where   $P!{strCadena}]]>
	</queryString>
	<field name="foliosai" class="java.lang.String"/>
	<field name="noContrato" class="java.lang.String"/>
	<field name="beneficiariocompromiso" class="java.lang.String"/>
	<field name="montoTotalObra" class="java.math.BigDecimal"/>
	<field name="estatus_contrato" class="java.lang.String"/>
	<field name="descTipoObra" class="java.lang.String"/>
	<field name="descTipoRecurso" class="java.lang.String"/>
	<field name="oli" class="java.lang.String"/>
	<field name="cartera" class="java.lang.String"/>
