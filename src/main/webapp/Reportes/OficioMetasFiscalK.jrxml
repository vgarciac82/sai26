		<variableExpression><![CDATA[$F{E014_ORGIF}]]></variableExpression>
	</variable>
	<variable name="E014_MODIF_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{E014_MODIF}]]></variableExpression>
		<initialValueExpression><![CDATA[0]]></initialValueExpression>
	</variable>
	<variable name="E014_VAR_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{E014_VAR}]]></variableExpression>
	</variable>
	<variable name="S219_ORGIF_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{S219_ORGIF}]]></variableExpression>
	</variable>
	<variable name="S219_MODIF_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{S219_MODIF}]]></variableExpression>
	</variable>
	<variable name="S219_VAR_1" class="java.math.BigDecimal" calculation="Sum">
