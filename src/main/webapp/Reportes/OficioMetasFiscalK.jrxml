		<property name="com.jaspersoft.studio.field.label" value="K138_MODIF"/>
	</field>
	<field name="K138_VAR" class="java.math.BigDecimal">
		<property name="com.jaspersoft.studio.field.name" value="K138_VAR"/>
		<property name="com.jaspersoft.studio.field.label" value="K138_VAR"/>
	</field>
