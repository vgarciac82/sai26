	<queryString>
		<![CDATA[declare @cIdPedido varchar(50)
set @cIdPedido=$P{cPedidoDefinitivo}
select fFormalizacion, cClausula, fundamento,pr.cIdpedido,pr.cRepresentanteLegal,cCargoRepresentante,cActaConstitutiva,cNoEscritura,cTelefono,cAutorizacion,  cFechaAutorizacion,
EP from tPreCompromisoDetalle a  inner join tPreCompromisoEncabezado b on a.nFolioPreCompromiso=b.nFolioPreCompromiso inner join mpedido mp on mp.cIdPedidoDefinitivo=b.cIdContrato
 inner join mpedidoClausula pc  on pc.cIdPedidoDefinitivo=mp.cIdPedidoDefinitivo inner join mPedidoFundamentos pf on pc.cIdPedidoDefinitivo=pf.cIdPedidoDefinitivo inner join mPedidoRepresentante pr on pr.cIdPedido=pf.cIdPedidoDefinitivo where pr.cIdPedido=@cIdPedido]]>
	</queryString>
