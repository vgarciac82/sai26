<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="clavesEp"  pageWidth="595" pageHeight="842" columnWidth="595" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0">
	<property name="ireport.zoom" value="1.5"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="cIdUnidadEjecutora" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="cEjercicio" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="cIdTipoPedido" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="nIdConsecutivoPedido" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="cIdAlmacenEntrega" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT distinct ClaveSIAFF + '.' + ClaveInterna EP,
	cIdUnidadEjecutora,
	 '$' + ISNULL(CONVERT(varchar, CONVERT(MONEY, MontoAnual), 1), '0.00') as MontoAnual
	FROM (
		SELECT cIdUnidadEjecutora,cIdSolicitud, ClaveSIAFF, ClaveInterna,
		MontoEnero as mes01, MontoFebrero as mes02, MontoMarzo as mes03,
		MontoAbril as mes04, MontoMayo as mes05, MontoJunio as mes06,
		MontoJulio as mes07, MontoAgosto as mes08, MontoSeptiembre as mes09,
		MontoOctubre as mes10, MontoNoviembre as mes11, MontoDiciembre as mes12
		, MontoAnual
		FROM vPresupuestoSolicitudEP
		)
	Main UNPIVOT (Monto FOR Meses IN (mes01, mes02, mes03, mes04, mes05, mes06,
	mes07, mes08, mes09, mes10, mes11, mes12) ) Mes	WHERE Monto > 0
	and cIdsolicitud in (
	select distinct cidsolicitud from v_mProcedimientoPartidasAnexo
			 WHERE cEjercicio =$P{cEjercicio}
			AND cIdTipoPedido = $P{cIdTipoPedido}
                              AND cIdUnidadEjecutora = $P{cIdUnidadEjecutora}
                              AND nIdConsecutivoPedido = $P{nIdConsecutivoPedido}
                              AND cIdAlmacenEntrega=$P{cIdAlmacenEntrega}
	)]]>
	</queryString>
	<field name="EP" class="java.lang.String"/>
	<field name="cIdUnidadEjecutora" class="java.lang.String"/>
	<field name="MontoAnual" class="java.lang.String"/>
	<detail>
		<band height="15" splitType="Stretch">
			<textField>
				<reportElement x="1" y="1" width="320" height="14"/>
				<textElement>
					<font fontName="Arial" size="8"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{EP}]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true">
				<reportElement isPrintRepeatedValues="false" x="329" y="1" width="65" height="14"/>
				<textElement textAlignment="Right">
					<font fontName="Arial" size="8"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{MontoAnual}]]></textFieldExpression>
			</textField>
		</band>
	</detail>
</jasperReport>
