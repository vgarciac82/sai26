	<variable name="ANTICIPO_FACTURA" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[]]></variableExpression>
		<initialValueExpression><![CDATA[0.0]]></initialValueExpression>
	</variable>
	<variable name="RESTA_ANTICIPO" class="java.lang.Double">
		<variableExpression><![CDATA[$F{tFondenMovimiento_nTotal} - $F{SUMA}]]></variableExpression>
	</variable>
	<variable name="TC_X_TOTAL" class="java.lang.Double">
		<variableExpression><![CDATA[$F{tFondenMovimiento_nTipoCambio}*$F{tFondenMovimiento_nTotal}]]></variableExpression>
	</variable>
	<variable name="SUM_TC_X_TOTAL" class="java.lang.Double" resetType="Group" resetGroup="TIPO MONEDA" calculation="Sum">
		<variableExpression><![CDATA[$F{SUMA}.doubleValue()==0.0?$F{tFondenMovimiento_nTotal}*$F{tFondenMovimiento_nTipoCambio} : 0.0 +
+ $F{SUMA}*$F{tFondenMovimiento_nTipoCambio} + $V{RESTA_ANTICIPO}* ($P{TC_ESTIMADO})]]></variableExpression>
	</variable>
	<variable name="TC_X_ANTICIPO" class="java.lang.Double" resetType="None" calculation="Sum">
		<variableExpression><![CDATA[$F{SUMA}*$F{tFondenMovimiento_nTipoCambio}]]></variableExpression>
	</variable>
	<variable name="SUMA_TOTAL_ANTICIPO" class="java.lang.Double">
		<variableExpression><![CDATA[$F{SUMA}!=0.0?$V{TC_X_ANTICIPO} : 0.0]]></variableExpression>
	</variable>
	<variable name="TOTAL_ESTIMADO" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{SUMA}==0.0?$F{tFondenMovimiento_nTotal}*$F{tFondenMovimiento_nTipoCambio} : 0.0 +
+ $F{SUMA}*$F{tFondenMovimiento_nTipoCambio} + $V{RESTA_ANTICIPO}* $P{TC_ESTIMADO}]]></variableExpression>
	</variable>
	<variable name="SALDO" class="java.lang.Double">
		<variableExpression><![CDATA[$F{tFonden_nImporteAnual} - $V{TOTAL_ESTIMADO}]]></variableExpression>
	</variable>
