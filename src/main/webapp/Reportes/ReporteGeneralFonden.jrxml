	<parameter name="cIdFonden" class="java.lang.String"/>
	<parameter name="crfc" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT
     tFondenMovimiento."cIdFonden" AS tFondenMovimiento_cIdFonden,
     tFondenMovimiento."nIdFondenMovimiento" AS tFondenMovimiento_nIdFondenMovimiento,
     tFondenMovimiento."cConcepto" AS tFondenMovimiento_cConcepto,
     tFondenMovimiento."nPrecioUnitario" AS tFondenMovimiento_nPrecioUnitario,
     tFondenMovimiento."nCantidad" AS tFondenMovimiento_nCantidad,
     tFondenMovimiento."nImporte" AS tFondenMovimiento_nImporte,
     tFondenMovimiento."cRFC" AS tFondenMovimiento_cRFC,
     tFondenMovimiento."cNumPedido" AS tFondenMovimiento_cNumPedido,
     tFondenMovimiento."nNetoPedido" AS tFondenMovimiento_nNetoPedido,
     tFondenMovimiento."nPrecio" AS tFondenMovimiento_nPrecio,
     tFondenMovimiento."nTotal" AS tFondenMovimiento_nTotal,
     tFondenMovimiento."cProveedor" AS tFondenMovimiento_cProveedor,
     tFondenMovimiento."ACTIVO" AS tFondenMovimiento_ACTIVO,
     tFondenMovimiento."ID_GABINETE" AS tFondenMovimiento_ID_GABINETE,
     tFondenMovimiento."cFolio" AS tFondenMovimiento_cFolio,
     tFondenMovimiento."cCentroContable" AS tFondenMovimiento_cCentroContable,
     tFondenMovimiento."cUnidadResponsable" AS tFondenMovimiento_cUnidadResponsable,
     tFondenMovimiento."nNumCaso" AS tFondenMovimiento_nNumCaso,
     tFondenMovimiento."nCantidadTotal" AS tFondenMovimiento_nCantidadTotal,
     tFondenMovimiento."nTechoDef" AS tFondenMovimiento_nTechoDef,
     tFondenMovimiento."cIdMoneda" AS tFondenMovimiento_cIdMoneda,
     tFondenMovimiento."nTipoCambio" AS tFondenMovimiento_nTipoCambio,
     tFondenMovimiento."nIdFondenMovEstatus" AS tFondenMovimiento_nIdFondenMovEstatus,
     tFondenMovEstatus."nIdFondenMovEstatus" AS tFondenMovEstatus_nIdFondenMovEstatus,
     tFondenMovEstatus."cDescripcion" AS tFondenMovEstatus_cDescripcion,
     tFondenMoneda."cIdMoneda" AS tFondenMoneda_cIdMoneda,
     tFondenMoneda."cDescripcion" AS tFondenMoneda_cDescripcion,
     tFondenMoneda."nTipoCambio" AS tFondenMoneda_nTipoCambio,
     tFonden."cIdFonden" AS tFonden_cIdFonden,
     tFonden."cUsuarioCreador" AS tFonden_cUsuarioCreador,
     tFonden."dFechaCaptura" AS tFonden_dFechaCaptura,
     tFonden."cDescripcion" AS tFonden_cDescripcion,
     tFonden."nImporteAnual" AS tFonden_nImporteAnual
FROM
     "dbo"."tFondenMovEstatus" tFondenMovEstatus INNER JOIN "dbo"."tFondenMovimiento" tFondenMovimiento ON tFondenMovEstatus."nIdFondenMovEstatus" = tFondenMovimiento."nIdFondenMovEstatus"
     INNER JOIN "dbo"."tFondenMoneda" tFondenMoneda ON tFondenMovimiento."cIdMoneda" = tFondenMoneda."cIdMoneda"
     INNER JOIN "dbo"."tFonden" tFonden ON tFondenMovimiento."cIdFonden" = tFonden."cIdFonden"

where tFondenMovimiento."cIdFonden" = $P{cIdFonden} AND  tFondenMovimiento."cRFC" = $P{crfc}]]>
	</queryString>
