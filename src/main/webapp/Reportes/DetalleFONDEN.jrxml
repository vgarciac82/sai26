	<variable name="IMPORTE_TOTAL" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{tFondenMovimiento_nImporte}.multiply( $F{tFondenMovimiento_nTipoCambio} )]]></variableExpression>
	</variable>
	<variable name="TECHO_TOTAL" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{tFondenMovimiento_nTechoDef}.multiply( $F{tFondenMovimiento_nTipoCambio} )]]></variableExpression>
	</variable>
	<variable name="IMPORTE_TECHO" class="java.math.BigDecimal">
		<variableExpression><![CDATA[$V{IMPORTE_TOTAL}-$V{TECHO_TOTAL}]]></variableExpression>
	</variable>
	<variable name="SUM_IMPORTE_FACTURA" class="java.math.BigDecimal"/>
