	<parameter name="idVersion" class="java.lang.Integer"/>
	<queryString>
		<![CDATA[SELECT CASE WHEN $P{idVersion} = 0 THEN (SELECT '2  ' + dCuenta AS dCuenta FROM tCuentas WHERE nCuenta LIKE '04200%')
