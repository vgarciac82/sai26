	<queryString>
		<![CDATA[select  nFolioContratoPlurianual ,
  cDescripcion,
  aEjercicioFiscal,
  lAbierto,
  isnull(pe.nTipoCambio,0) as cambio,
 (select dTipoGasto from tCatalogoTipoGasto where cTipoGasto = pe.cTipoGasto) as Gasto,
 (select cTipoMoneda from tCatalogoTipoMoneda WITH(NOLOCK)  where cCveTipoMoneda = pe.cTipoMoneda) as Moneda,
 (select cTipoContrato FROM tCatalogoTipoContrato WITH(NOLOCK)  where cCveTipoContrato = pe.cTipoContrato) as Contrato,
 (select cSolicitudContrato from tCatalogoSolicitudContrato WITH(NOLOCK)  where cCveSolicitudContrato =   pe.cTipoSolicitud) as tipoSolicitud,
 (Select D_DESCRIPCION from tCatUnidadResponsable WITH(NOLOCK)  where cUnidadResponsable = pe.cUnidadResponsable) as UResponsable,
  CONVERT(varchar,fInicio,103) as Inicio,
  CONVERT(varchar,fFin,103) as Termino,
  cJustificacionCompromiso,
  cJustificacionPlazo
FROM    tContratoPlurianualEncabezado pe
where  pe.nFolioContratoPlurianual= $P{folioPlurianual}]]>
	</queryString>
