<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="rptVolanteDevolucion"  pageWidth="612" pageHeight="792" columnWidth="572" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<property name="ireport.zoom" value="1.331000000000003"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="427"/>
	<parameter name="cIdContrato" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String"/>
	<queryString>
		<![CDATA[select ISNULL((select u.U_NOMBRE from cg_usuario u with(nolock), mPedido p with(nolock)
where u.U_LOGIN=p.cIdUsuarioCreacion and p.cIdPedidoDefinitivo=$P{cIdContrato}
union
select u.U_NOMBRE from cg_usuario u with(nolock), mContrato c with(nolock)
where u.U_LOGIN=c.cIdUsuarioCreacion and c.cIdContratoDefinitivo=$P{cIdContrato}),'') as cNombreResponsable,
ISNULL((select ce.CARGO from CG_CAT_EMPLEADO ce with(nolock), mPedido p with(nolock)
where ce.CE_OS_RESPONSABLE=p.cIdUsuarioCreacion and p.cIdPedidoDefinitivo=$P{cIdContrato}
union
select ce.CARGO from CG_CAT_EMPLEADO ce with(nolock), mContrato c with(nolock)
where ce.CE_OS_RESPONSABLE=c.cIdUsuarioCreacion and c.cIdContratoDefinitivo=$P{cIdContrato}),'') as cPuestoResponsable, v.cIdContrato, cRazonSocial,
case(convert(varchar,cmotivorechazo)) when '' then 'NO ESPECIFICADO' else cmotivorechazo end as cMotivoRechazo,
UPPER(DATENAME(day, fDevolucion))+' DE '+ UPPER(DATENAME(month,fDevolucion))+' DE '+UPPER(DATENAME(YEAR, fDevolucion)) as fDevolucion,
cc.cDescripcion
from tPrecompromisoVolanteDevolucion v, tPreCompromisoEncabezado e, tCatalogoURCC ue,tCatalogoCentroContable cc
where v.cIdContrato=e.cIdContrato
and e.cUnidadResponsable=ue.cUnidadResponsable
and ue.cCentroContable=cc.cCentroContable
and v.cIdContrato=$P{cIdContrato}
and nFolioVolante in( select MAX(nFolioVolante) from tPrecompromisoVolanteDevolucion where cIdContrato=$P{cIdContrato} group by cIdContrato)
and e.nFolioPreCompromiso=(select MAX(nfolioprecompromiso) from tPreCompromisoEncabezado where cIdContrato=$P{cIdContrato} group by cIdContrato)]]>
	</queryString>
