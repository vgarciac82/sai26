                    <property name="style">cfdiTotalesTitulo</property>
                    <text-data id="907">
                        <expression name="valueExpr">"I.V.A."+
(row["cfdiIvaTasa"]!= null  ? (" (" + row["cfdiIvaTasa"] +"%) :") : ": " )</expression>
