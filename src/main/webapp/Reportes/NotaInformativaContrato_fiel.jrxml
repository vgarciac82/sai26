		<property name="com.jaspersoft.studio.field.label" value="proveedor"/>
	</field>
	<field name="cnet" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="cnet"/>
		<property name="com.jaspersoft.studio.field.label" value="cnet"/>
	</field>
	<field name="folioConvenio" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="folioConvenio"/>
		<property name="com.jaspersoft.studio.field.label" value="folioConvenio"/>
	</field>
	<field name="inicioConv" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="inicioConv"/>
		<property name="com.jaspersoft.studio.field.label" value="inicioConv"/>
	</field>
	<field name="finConvenio" class="java.lang.String">
