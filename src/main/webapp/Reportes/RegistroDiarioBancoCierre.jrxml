<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="RegistroDiarioBancoCierre"  pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<property name="ireport.zoom" value="1.3310000000000013"/>
	<property name="ireport.x" value="79"/>
	<property name="ireport.y" value="0"/>
	<parameter name="idRdbCargaArchivoRDBSaldo" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT nFolioRDB, fAplicacion, tipoMovimiento, mImporte, sConcepto, mImporteSaldo,
(select isnull(SUM(mImporte),0) from v_RDBImpresionCierre where idRdbCargaArchivoRDBSaldo = $P{idRdbCargaArchivoRDBSaldo} AND tipoMovimiento = 'EGRESO' ) as mImporteEgresoTotal,
(select isnull(SUM(mImporte),0) from v_RDBImpresionCierre where idRdbCargaArchivoRDBSaldo = $P{idRdbCargaArchivoRDBSaldo} AND tipoMovimiento = 'INGRESO' ) as mImporteIngresoTotal,

(select top 1 CONVERT( VARCHAR, CONVERT( DATE,dFecha),103) dFecha from tRdbCargaArchivoRDBSaldo where idRdbCargaArchivoRDBSaldo < $P{idRdbCargaArchivoRDBSaldo} order by idRdbCargaArchivoRDBSaldo desc ) dFechaAnterior,
(select top 1 mImporteSaldo from tRdbCargaArchivoRDBSaldo where idRdbCargaArchivoRDBSaldo < $P{idRdbCargaArchivoRDBSaldo} order by idRdbCargaArchivoRDBSaldo desc ) mImporteSaldoAnterior,
(select sAreaFormulo from tRdbFimantes where Activo = 1 and tipoDocumento = 'CIERRE') as sAreaFormulo,
(select sNombreFormulo from tRdbFimantes where Activo = 1 and tipoDocumento = 'CIERRE') as sNombreFormulo,
(select sAreaReviso from tRdbFimantes where Activo = 1 and tipoDocumento = 'CIERRE') as sAreaReviso,
(select sNombreReviso from tRdbFimantes where Activo = 1 and tipoDocumento = 'CIERRE') as sNombreReviso

FROM v_RDBImpresionCierre
WHERE idRdbCargaArchivoRDBSaldo = $P{idRdbCargaArchivoRDBSaldo}
ORDER BY tipoMovimiento DESC]]>
	</queryString>
	<field name="nFolioRDB" class="java.lang.Integer"/>
	<field name="fAplicacion" class="java.lang.String"/>
	<field name="tipoMovimiento" class="java.lang.String"/>
	<field name="mImporte" class="java.math.BigDecimal"/>
	<field name="sConcepto" class="java.lang.String"/>
	<field name="mImporteSaldo" class="java.math.BigDecimal"/>
	<field name="mImporteEgresoTotal" class="java.math.BigDecimal"/>
	<field name="mImporteIngresoTotal" class="java.math.BigDecimal"/>
	<field name="dFechaAnterior" class="java.lang.String"/>
	<field name="mImporteSaldoAnterior" class="java.math.BigDecimal"/>
	<field name="sAreaFormulo" class="java.lang.String"/>
	<field name="sNombreFormulo" class="java.lang.String"/>
	<field name="sAreaReviso" class="java.lang.String"/>
	<field name="sNombreReviso" class="java.lang.String"/>
