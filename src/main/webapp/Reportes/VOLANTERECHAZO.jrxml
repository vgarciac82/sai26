	<parameter name="NumeroFolio" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT  cmc.sMotivoCancelacion, tvd.DescripcionRechazo DescripcionDevolucion ,tvd.folioRechazo  as folioDevolucion, tvd.NumeroFolio, tvd.FechaRegistro, tvd.Documento, tvd.noContrarrecibo, tvd.RFC, tvd.nomRFC, tvd.fAplicacion, tvd.importeNeto
FROM tVolante_Rechazo tvd, CAT_MOTIVO_CANCELACION cmc
where cmc.idMotivo = tvd.MotivoRechazo and
      tvd.NumeroFolio = $P{NumeroFolio} and
      tvd.folioRechazo = (select MAX(folioRechazo) from tVolante_Rechazo where NumeroFolio =  $P{NumeroFolio})]]>
	</queryString>
