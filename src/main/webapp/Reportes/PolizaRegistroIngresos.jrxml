<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="Poliza_Reint_Rect" pageWidth="612" pageHeight="792" whenNoDataType="AllSectionsNoDetail" columnWidth="552" leftMargin="30" rightMargin="30" topMargin="20" bottomMargin="20" uuid="5c697f32-9755-40f6-853e-7b217319a6be">
	<property name="ireport.zoom" value="1.2100000000000146"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="80"/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="desa"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<parameter name="whereFolio" class="java.lang.String">
		<defaultValueExpression><![CDATA[" AND nFolioRegistroIngreso = 16"]]></defaultValueExpression>
	</parameter>
	<parameter name="whereTipo" class="java.lang.String">
		<defaultValueExpression><![CDATA["1"]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT  *
FROM    ( SELECT    RIE.nFolioRegistroIngreso ,
                    ( SELECT    C_FOLIO
                      FROM      dbo.CG_CASO
                      WHERE     ID_TC = 55
                                AND C_FOLIO LIKE '%-'
                                + CAST(RIE.nFolioRegistroIngreso AS NVARCHAR(10))
                    ) C_FOLIO ,
                    CASE WHEN ISNULL(RIE.nFolioPoliza, 0) = 0
                         THEN 'N/A'
                         ELSE RIE.cTipoPoliza + ' - '
                              + CAST(RIE.nFolioPoliza AS VARCHAR(10))
                    END AS nFolioPoliza ,
                    RIE.cTipoPoliza ,
                    CASE WHEN cxp IS NOT NULL THEN RIE.cConcepto + ' Ver póliza manual modificatoria con el número: ' + CONVERT(VARCHAR(10),POL.nFolioPoliza) + ' de Diario.' ELSE RIE.cConcepto END AS cConcepto,
                    CASE WHEN RIE.nTipoIngreso = 1
                         THEN 'FONDOS FISCALES'
                         WHEN RIE.nTipoIngreso = 2
                         THEN 'INGRESOS PROPIOS'
		    WHEN RIE.nTipoIngreso = 3
                        THEN 'INGRESOS FONDEN'
		ELSE ''
                    END AS TipoIngreso ,
	          RIE.nTipoIngreso ,
                    RIE.cPrograma AS IdPrograma ,
                    PP.dCuenta AS Programa ,
                    RIE.cUnidadResponsable ,
                    cDescripcion ,
                    RIE.fAplicacion ,
                    RIE.mImporte + ISNULL(mImporteRendimientosGM,0) AS ImporteTotal ,
                    dbo.CantidadConLetra(RIE.mImporte + ISNULL(mImporteRendimientosGM,0)) cantLetras ,
                    RID.nDocRenglon ,
                    RID.EP ,
                    RID.mImporte ,
                    RID.cCentroContable ,
                    RID.CTAB ,
					CASE WHEN RIE.nTipoIngreso = 1
						THEN 'TESOFE'
						WHEN RIE.nTipoIngreso IN (2,3)
						 THEN 'CNF010405EG1'
						ELSE ''
					END AS aFavorDeRFC ,
					CASE WHEN RIE.nTipoIngreso = 1
						THEN 'TESORERIA DE LA FEDERACION'
						WHEN RIE.nTipoIngreso IN (2,3)
						 THEN 'COMISION NACIONAL FORESTAL'
						ELSE ''
					END AS aFavorDe ,
                    ISNULL(sFirmanteVoBo, ' - ') sFirmanteVoBo ,
                    ISNULL(sPuestoVoBo, ' - ') sPuestoVoBo ,
                    ISNULL(RIE.sFirmanteAut, ' - ') sFirmanteAut ,
                    ISNULL(RIE.sPuestoAut, ' - ') sPuestoAut ,
                    ISNULL(RIERZ.cClave, 'N/A') AS Clave ,
                    ISNULL(RZ.cNombre, '') AS NombreRZ
          FROM      dbo.tRegistroIngresoEncabezado AS RIE
                    WITH ( NOLOCK )
                    INNER JOIN dbo.tRegistroIngresoDetalle AS RID
                    WITH ( NOLOCK ) ON ( RIE.nFolioRegistroIngreso = RID.nFolioRegistroIngreso )
                    INNER JOIN ( SELECT cc.cCentroContable ,
                                        cUnidadResponsable ,
                                        cDescripcion
                                 FROM   dbo.tCatalogoURCC ur WITH ( NOLOCK )
                                        INNER JOIN tCatalogoCentroContable cc
                                        WITH ( NOLOCK ) ON ( ur.cCentroContable = cc.cCentroContable )
                               ) cc ON RIE.cUnidadResponsable = cc.cUnidadResponsable
                    LEFT JOIN tCatProgramasProyectos AS PP WITH ( NOLOCK ) ON ( PP.nIdPrograma = RIE.cPrograma )
                    LEFT JOIN dbo.tDocPolizaEncabezado AS POL WITH (NOLOCK) ON CONVERT(VARCHAR(14), RIE.nFolioRegistroIngreso) = cxp
                    LEFT JOIN tRegistroIngresoRazonSocial AS RIERZ WITH (NOLOCK) ON RIE.nFolioRegistroIngreso = RIERZ.nFolioRegistroIngreso
                    LEFT JOIN tRazonSocialIP AS RZ WITH (NOLOCK) ON RIERZ.cClave = RZ.cClave
        ) CR
WHERE 1 = 1 $P!{whereFolio}]]>
	</queryString>
