		</band>
		<band height="62">
			<staticText>
				<reportElement x="23" y="22" width="436" height="34" uuid="fa1f3986-7a8f-4e67-8c18-48495ee59620">
					<property name="com.jaspersoft.studio.unit.width" value="px"/>
				</reportElement>
				<textElement textAlignment="Justified"/>
				<text><![CDATA[Es obligación de los entes responsables que la baja del archivo contable gubernamental se realice en los términos establecidos en la presente Norma.]]></text>
			</staticText>
			<staticText>
				<reportElement positionType="Float" x="3" y="22" width="20" height="13" uuid="6df84f62-1369-4df4-961b-35d8409d5067"/>
				<textElement verticalAlignment="Middle">
					<font fontName="Arial" size="10" isBold="true"/>
				</textElement>
				<text><![CDATA[26]]></text>
			</staticText>
			<staticText>
				<reportElement positionType="Float" x="3" y="5" width="456" height="14" isRemoveLineWhenBlank="true" uuid="2186341e-6e88-4163-88e9-64b41894b3ae"/>
				<textElement>
					<font fontName="Arial" size="10" isBold="true"/>
				</textElement>
				<text><![CDATA[RESPONSABILIDADES]]></text>
			</staticText>
		</band>
		<band height="24">
			<staticText>
				<reportElement positionType="Float" x="3" y="5" width="20" height="13" uuid="24ca8ef0-e886-4715-bd53-61b718988fba"/>
				<textElement verticalAlignment="Middle">
					<font fontName="Arial" size="10" isBold="true"/>
				</textElement>
				<text><![CDATA[27]]></text>
			</staticText>
			<textField textAdjust="StretchHeight">
				<reportElement positionType="Float" x="23" y="5" width="436" height="13" isRemoveLineWhenBlank="true" isPrintWhenDetailOverflows="true" uuid="710f1d48-e772-42d9-89ed-7f1a9d482f45">
					<property name="com.jaspersoft.studio.unit.width" value="px"/>
				</reportElement>
				<textElement textAlignment="Justified" markup="html">
					<font fontName="Arial"/>
