				<reportElement positionType="Float" x="3" y="5" width="20" height="13" isRemoveLineWhenBlank="true" uuid="69b436bb-0d96-4232-9e89-8fe24fd65bd3"/>
				<textElement verticalAlignment="Middle">
					<font fontName="Arial" size="10" isBold="true"/>
