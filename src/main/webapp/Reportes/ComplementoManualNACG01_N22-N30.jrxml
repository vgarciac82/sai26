				<text><![CDATA[24]]></text>
			</staticText>
			<staticText>
				<reportElement x="23" y="5" width="436" height="41" uuid="11021735-2e2c-4b52-a0e1-968bf315bc2d">
					<property name="com.jaspersoft.studio.unit.width" value="px"/>
				</reportElement>
				<textElement textAlignment="Justified"/>
				<text><![CDATA[Los libros Diario, Mayor y de Inventarios y Balances se conservarán conforme al plazo establecido en las Disposiciones Generales y para su baja se atenderán los procedimientos establecidos en las disposiciones emitidas por el AGN.]]></text>
			</staticText>
		</band>
		<band height="45">
			<staticText>
				<reportElement positionType="Float" x="3" y="25" width="20" height="13" uuid="035b4808-4b41-45d7-a36c-f59a61c54e5d"/>
				<textElement verticalAlignment="Middle">
					<font fontName="Arial" size="10" isBold="true"/>
				</textElement>
				<text><![CDATA[25]]></text>
			</staticText>
			<staticText>
				<reportElement positionType="Float" x="3" y="6" width="456" height="14" isRemoveLineWhenBlank="true" uuid="1fdd3fdc-f1e1-4afd-8815-97ca6c5e9530"/>
				<textElement>
					<font fontName="Arial" size="10" isBold="true"/>
				</textElement>
				<text><![CDATA[DE LOS DOCUMENTOS DE ARCHIVO ELECTRÓNICOS Y DIGITALES]]></text>
			</staticText>
			<textField textAdjust="StretchHeight">
				<reportElement positionType="Float" x="23" y="25" width="436" height="13" isRemoveLineWhenBlank="true" isPrintWhenDetailOverflows="true" uuid="01f72f2d-09aa-4a51-8f12-16dcdbd4ad0c">
