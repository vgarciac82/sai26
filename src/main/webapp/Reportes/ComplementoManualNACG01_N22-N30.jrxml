	<parameter name="idVersion" class="java.lang.Integer"/>
	<parameter name="final" class="java.lang.Integer"/>
	<parameter name="consulta" class="java.lang.Integer"/>
	<parameter name="tipoManual" class="java.lang.Integer"/>
	<queryString>
		<![CDATA[DECLARE @idVersion INT = $P{idVersion}
DECLARE @final INT = $P{final}
DECLARE @consulta INT = $P{consulta}
DECLARE @tipoManual INT = $P{tipoManual}

IF @final = 0 AND @consulta = 0 --TEMPORAL
BEGIN
	SELECT RTRIM(LTRIM(cParrafo25)) AS cParrafo25
			, RTRIM(LTRIM(cParrafo26)) AS cParrafo26
			, RTRIM(LTRIM(cParrafo27)) AS cParrafo27
			, RTRIM(LTRIM(cParrafo28)) AS cParrafo28
			, RTRIM(LTRIM(cParrafo29)) AS cParrafo29
			, RTRIM(LTRIM(cParrafo30)) AS cParrafo30
		FROM tComplementoManualContable
		WHERE idComplemento = @tipoManual
END

ELSE IF @final = 1 AND @consulta = 1 --CUANDO SE CONULTA UNA VERSION
BEGIN
	SELECT RTRIM(LTRIM(cParrafo25)) AS cParrafo25
			, RTRIM(LTRIM(cParrafo26)) AS cParrafo26
			, RTRIM(LTRIM(cParrafo27)) AS cParrafo27
			, RTRIM(LTRIM(cParrafo28)) AS cParrafo28
			, RTRIM(LTRIM(cParrafo29)) AS cParrafo29
			, RTRIM(LTRIM(cParrafo30)) AS cParrafo30
		FROM tComplementoManualContableVersion
		WHERE idComplemento = @tipoManual
		AND idVersion = @idVersion
END]]>
	</queryString>
