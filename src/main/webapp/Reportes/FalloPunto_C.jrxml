<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="FallosPunto_C"  pageWidth="572" pageHeight="752" columnWidth="572" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0">
	<property name="ireport.zoom" value="1.5"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="DIR_REPORT" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="cIdProcedimiento" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT
pc.cIdRFC,
cp.cRazonSocial,
pc.nIdtipoCambio,
pa.nPorcentajeIVA,
'$'+CONVERT(VARCHAR,CAST(ISNULL(SUM((dbo.fn_mConsolidadoLineaCantidadArticulos(pc.cEjercicio ,pc.cIdTipoConsolidado ,pc.cIdUnidadEjecutora ,pc.nIdConsecutivoConsolidado, pc.nIdLineaConsolidado)*pc.mMontoMaximo)*((CONVERT(FLOAT,nPorcentajeIVA)/100)+1)),0) AS MONEY),1) AS total,
dbo.CantidadConLetraPedido(CAST(ISNULL(SUM((dbo.fn_mConsolidadoLineaCantidadArticulos(pc.cEjercicio ,pc.cIdTipoConsolidado ,pc.cIdUnidadEjecutora ,pc.nIdConsecutivoConsolidado, pc.nIdLineaConsolidado)*pc.mMontoMaximo)*((CONVERT(FLOAT,nPorcentajeIVA)/100)+1)),0) AS MONEY), ct.cAbreviatura) AS cCantidadLetra
FROM
mCatalogoProveedor cp WITH(NOLOCK),
mProcedimientoCompleto pc WITH(NOLOCK),
mProcedimientoAdjudicacion pa WITH(NOLOCK),
mCatalogoTipoMoneda ct WITH(NOLOCK)
WHERE
cp.cIdRFC=pc.cIdRFC
AND pc.cIdProcedimiento=pa.cIdProcedimiento
AND pc.cIdRFC=pa.cIdRFC
AND pc.nIdtipoCambio=ct.cIdTipoMoneda
AND pc.mMontoMaximo<>0
AND pc.mMontoMinimo<>0
AND pc.cGanador=1
AND pc.cIdProcedimiento=$P{cIdProcedimiento}
GROUP BY pc.cIdRFC, cp.cRazonSocial, pc.nIdtipoCambio, nPorcentajeIVA, cAbreviatura
ORDER BY cp.cRazonSocial ASC]]>
	</queryString>
	<field name="cIdRFC" class="java.lang.String"/>
	<field name="cRazonSocial" class="java.lang.String"/>
	<field name="nIdtipoCambio" class="java.lang.Integer"/>
	<field name="nPorcentajeIVA" class="java.lang.Integer"/>
	<field name="total" class="java.lang.String"/>
	<field name="cCantidadLetra" class="java.lang.String"/>
	<variable name="descripcionPie" class="java.lang.String"/>
	<background>
		<band splitType="Stretch"/>
	</background>
	<detail>
		<band height="47" splitType="Stretch">
			<subreport>
				<reportElement x="0" y="17" width="572" height="29"/>
				<subreportParameter name="cRazonSocial">
					<subreportParameterExpression><![CDATA[$F{cRazonSocial}]]></subreportParameterExpression>
				</subreportParameter>
				<subreportParameter name="cIdRFC">
					<subreportParameterExpression><![CDATA[$F{cIdRFC}]]></subreportParameterExpression>
				</subreportParameter>
				<subreportParameter name="cIdProcedimiento">
					<subreportParameterExpression><![CDATA[$P{cIdProcedimiento}]]></subreportParameterExpression>
				</subreportParameter>
				<subreportParameter name="nIdTipoCambio">
					<subreportParameterExpression><![CDATA[$F{nIdtipoCambio}]]></subreportParameterExpression>
				</subreportParameter>
				<connectionExpression><![CDATA[$P{REPORT_CONNECTION}]]></connectionExpression>
				<subreportExpression class="java.lang.String"><![CDATA[$P{DIR_REPORT} + "\\subFallosPunto_C.jasper"]]></subreportExpression>
			</subreport>
		</band>
		<band height="50">
			<textField>
				<reportElement x="0" y="17" width="572" height="32"/>
				<textElement textAlignment="Justified">
					<font fontName="Arial" size="12"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA["El importe total del pedido es de "+$F{total}+" ("+$F{cCantidadLetra}+") importe que incluye el "+$F{nPorcentajeIVA}+"% del I.V.A."]]></textFieldExpression>
			</textField>
		</band>
	</detail>
</jasperReport>
