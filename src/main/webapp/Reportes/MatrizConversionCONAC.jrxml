	, RTRIM(LTRIM(cParrafo7)) AS cParrafo7
	, RTRIM(LTRIM(cParrafo8)) AS cParrafo8
	, RTRIM(LTRIM(cParrafo9)) AS cParrafo9
	, RTRIM(LTRIM(cParrafo10)) AS cParrafo10
	, RTRIM(LTRIM(cParrafo11)) AS cParrafo11
	, RTRIM(LTRIM(cParrafo12)) AS cParrafo12
	, RTRIM(LTRIM(cParrafo13)) AS cParrafo13
	, RTRIM(LTRIM(cParrafo14)) AS cParrafo14
	, RTRIM(LTRIM(cParrafo15)) AS cParrafo15
FROM tComplementoManualContable
WHERE idComplemento = 7]]>
	</queryString>
