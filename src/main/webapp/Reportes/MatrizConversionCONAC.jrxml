	<queryString>
		<![CDATA[SELECT RTRIM(LTRIM(cParrafo1)) AS cParrafo1
	, RTRIM(LTRIM(cParrafo2)) AS cParrafo2
	, RTRIM(LTRIM(cParrafo3)) AS cParrafo3
	, RTRIM(LTRIM(cParrafo4)) AS cParrafo4
	, RTRIM(LTRIM(cParrafo5)) AS cParrafo5
