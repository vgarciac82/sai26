	<parameter name="tipo" class="java.lang.String"/>
	<queryString>
		<![CDATA[declare @mes int
declare @cban varchar(20)
declare @saldoBanco money
declare @fecha date
declare @NombreFirmanteElab varchar (100)
declare @NombreFirmanteVobo varchar (100)
declare @NombreFirmanteAut varchar (100)
declare @PuestoFirmanteElab varchar (100)
declare @PuestoFirmanteVobo varchar (100)
declare @PuestoFirmanteAut varchar (100)

select @mes = nMes, @cban = nCban, @saldoBanco = mSaldoFinal, @fecha = fConciliacion from tconciliacion (nolock)
where nConciliacion = $P{nConciliacion}

select nConciliacion, nFolioOrigen, cOrigen, fFecha, cReferencia, cCheque, cDescripcion, cTipo, mMonto, Conciliado, idDetalle
into #tblConciliados
from fn_l_noConciliados ( $P{nConciliacion}, @mes, @cban)



select *,@mes mes,  @cban cBan, @saldoBanco saldoBanco , @fecha fecha
from #tblConciliados tbl
where corigen = $P{cOrigen} and ctipo = $P{tipo}
order by cOrigen, ctipo

 drop table #tblConciliados]]>
	</queryString>
