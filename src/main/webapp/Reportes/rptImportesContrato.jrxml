<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="rptImportesContrato"  pageWidth="752" pageHeight="572" orientation="Landscape" columnWidth="752" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0">
	<property name="ireport.zoom" value="3.0"/>
	<property name="ireport.x" value="1036"/>
	<property name="ireport.y" value="0"/>
	<parameter name="cIdTipoContrato" class="java.lang.String"/>
	<parameter name="cIdUnidadEjecutora" class="java.lang.String"/>
	<parameter name="nIdConsecutivo" class="java.lang.String"/>
	<parameter name="cEjercicio" class="java.lang.String"/>
	<parameter name="importeSubtotal" class="java.lang.String"/>
	<parameter name="importeIVA" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT cDescripcion, '$'+importe AS importe, subtotalLetra, '$'+CONVERT(VARCHAR, CAST(total  AS MONEY),1) AS total, dbo.CantidadConLetra(CONVERT(MONEY,total)) AS totalLetra FROM (SELECT cDescripcion+' ('+CAST(cPorcentaje AS VARCHAR)+'%)' AS cDescripcion,
CONVERT(VARCHAR,CAST( ISNULL(subtotal*porcentaje,0) AS money),1) AS importe,

(SELECT dbo.CantidadConLetra(CONVERT(MONEY,((CONVERT(float, REPLACE(REPLACE($P{importeSubtotal},'$',''),',',''))))))) as subtotalLetra,

(SELECT CONVERT(MONEY,(SUM(subtotal)+(CONVERT(float, REPLACE(REPLACE($P{importeSubtotal},'$',''),',','')))+(CONVERT(float, REPLACE(REPLACE($P{importeIVA},'$',''),',',''))))) as total FROM (SELECT '1' AS indica, cPorcentaje/100 * (SELECT  ISNULL(dbo.fn_mContratoMontoBruto($P{cEjercicio},$P{cIdTipoContrato},$P{cIdUnidadEjecutora},$P{nIdConsecutivo}),0)) as subtotal FROM mImpuestosAdicionales WHERE cIdTipoDocumento=$P{cIdTipoContrato} AND cIdUnidadEjecutora=$P{cIdUnidadEjecutora} AND nIdConsecutivo=$P{nIdConsecutivo}) AS tab_) as total
FROM (SELECT cDescripcion, cPorcentaje/100 as porcentaje, cPorcentaje, (SELECT  ISNULL(dbo.fn_mContratoMontoBruto($P{cEjercicio},$P{cIdTipoContrato},$P{cIdUnidadEjecutora},$P{nIdConsecutivo}),0)) as subtotal FROM mImpuestosAdicionales WHERE cIdTipoDocumento=$P{cIdTipoContrato} AND cIdUnidadEjecutora=$P{cIdUnidadEjecutora} AND nIdConsecutivo=$P{nIdConsecutivo}) AS tab
) AS tab2
UNION
SELECT
'' AS cDescripcion,
'' AS importe,

dbo.CantidadConLetraPedido(CONVERT(MONEY,((CONVERT(float, REPLACE(REPLACE($P{importeSubtotal},'$',''),',',''))))),(
SELECT TM.cTipoMoneda FROM MCONTRATO MC,mCatalogoTipoMoneda TM
WHERE MC.cEjercicio=$P{cEjercicio} AND MC.cIdTipoContrato=$P{cIdTipoContrato} AND MC.cIdUnidadEjecutora=$P{cIdUnidadEjecutora} AND MC.nIdConsecutivo=$P{nIdConsecutivo}
AND MC.mTipoCambio=TM.cIdTipoMoneda )) as subtotalLetra,

'$'+CONVERT(VARCHAR,round(CAST(CONVERT(MONEY,(CONVERT(float, round( REPLACE(REPLACE($P{importeSubtotal},'$',''),',',''),2) ))+(CONVERT(float, REPLACE(REPLACE($P{importeIVA},'$',''),',','')))) AS MONEY),2),1) as total,
dbo.CantidadConLetraPedido(CONVERT(MONEY,(SELECT CONVERT(MONEY,(CONVERT(float, REPLACE(REPLACE($P{importeSubtotal},'$',''),',','')))+(CONVERT(float, REPLACE(REPLACE($P{importeIVA},'$',''),',',''))))))
,(SELECT TM.cTipoMoneda FROM MCONTRATO MC,mCatalogoTipoMoneda TM
WHERE MC.cEjercicio=$P{cEjercicio} AND MC.cIdTipoContrato=$P{cIdTipoContrato} AND MC.cIdUnidadEjecutora=$P{cIdUnidadEjecutora} AND MC.nIdConsecutivo=$P{nIdConsecutivo}
AND MC.mTipoCambio=TM.cIdTipoMoneda )) AS totalLetra]]>
	</queryString>
	<field name="cDescripcion" class="java.lang.String"/>
	<field name="importe" class="java.lang.String"/>
	<field name="subtotalLetra" class="java.lang.String"/>
	<field name="total" class="java.lang.String"/>
	<field name="totalLetra" class="java.lang.String"/>
	<variable name="importeTotal" class="java.math.BigDecimal" incrementType="Column" calculation="Sum"/>
	<background>
		<band splitType="Stretch"/>
	</background>
	<columnHeader>
		<band height="29">
			<textField>
				<reportElement x="608" y="3" width="105" height="13"/>
				<textElement textAlignment="Right">
					<font fontName="Arial" size="8"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$P{importeSubtotal}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="608" y="16" width="105" height="13"/>
				<textElement textAlignment="Right">
					<font fontName="Arial" size="8"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$P{importeIVA}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="491" y="16" width="116" height="13"/>
				<textElement>
					<font fontName="Arial" size="8" isBold="true"/>
				</textElement>
				<text><![CDATA[IVA COMPROMETIDO:]]></text>
			</staticText>
			<staticText>
				<reportElement x="491" y="3" width="116" height="13"/>
				<textElement>
					<font fontName="Arial" size="8" isBold="true"/>
				</textElement>
				<text><![CDATA[SUBTOTAL COMPROMETIDO:]]></text>
			</staticText>
		</band>
	</columnHeader>
	<detail>
		<band height="14" splitType="Stretch">
			<textField>
				<reportElement x="528" y="1" width="79" height="13" isRemoveLineWhenBlank="true">
					<printWhenExpression><![CDATA[$F{cDescripcion}.equals("")?Boolean.FALSE:Boolean.TRUE]]></printWhenExpression>
				</reportElement>
				<textElement>
					<font fontName="Arial" size="8" isBold="true"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{cDescripcion}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="608" y="1" width="105" height="13">
					<printWhenExpression><![CDATA[$F{importe}.equals("")?Boolean.FALSE:Boolean.TRUE]]></printWhenExpression>
				</reportElement>
				<textElement textAlignment="Right">
					<font fontName="Arial" size="8"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{importe}]]></textFieldExpression>
			</textField>
		</band>
	</detail>
	<pageFooter>
		<band height="26">
			<staticText>
				<reportElement x="491" y="1" width="116" height="13"/>
				<textElement>
					<font fontName="Arial" size="8" isBold="true"/>
				</textElement>
				<text><![CDATA[TOTAL COMPROMETIDO:]]></text>
			</staticText>
			<textField>
				<reportElement x="608" y="1" width="105" height="13"/>
				<textElement textAlignment="Right">
					<font fontName="Arial" size="8"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{total}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="72" y="1" width="419" height="13"/>
				<textElement>
					<font size="8"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{totalLetra}]]></textFieldExpression>
			</textField>
		</band>
	</pageFooter>
</jasperReport>
