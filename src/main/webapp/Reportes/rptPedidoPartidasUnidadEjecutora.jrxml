	<parameter name="cIdUnidadEjecutoraSol" class="java.lang.String"/>
	<queryString>
		<![CDATA[--Reporte complemento de rptPedidoAnexo1.jasper
--Reporte de Pedido Por Unidad Ejecutora
DECLARE @cEjercicio char(4), @cIdUnidadEjecutora char(3), @nIdConsecutivo char(10), @cIdTipoPedido char(2), @cIdUnidadEjecutoraSol char(3);

SET @cEjercicio = $P{cEjercicio};
SET @cIdUnidadEjecutora = $P{cIdUnidadEjecutora};
SET @nIdConsecutivo = $P{nIdConsecutivo};
SET @cIdTipoPedido = $P{cIdTipoPedido};
SET @cIdUnidadEjecutoraSol = $P{cIdUnidadEjecutoraSol};
--SET @cEjercicio = '2012';
--SET @cIdUnidadEjecutora = 'B03';
--SET @nIdConsecutivo = '18';
--SET @cIdTipoPedido = 'PE';
--SET @cIdUnidadEjecutoraSol = 'B03';

exec rpt_mPedidoPartidasUnidadEjecutoraSolicitud @cEjercicio ,@cIdTipoPedido ,@cIdUnidadEjecutora ,@nIdConsecutivo   ,@cIdUnidadEjecutoraSol]]>
	</queryString>
