	<subDataset name="Table Dataset 1"/>
	<parameter name="cIdProcedimiento" class="java.lang.String"/>
	<parameter name="DIR_REPORT" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select pc.cIdRFC, cp.cRazonSocial from mProcedimientoCompleto pc, mCatalogoProveedor cp
where pc.cIdRFC=cp.cIdRFC and pc.cIdProcedimiento=$P{cIdProcedimiento} AND pc.evaluacionTec = 0
group by pc.cIdRFC, cp.cRazonSocial]]>
	</queryString>
	<field name="cIdRFC" class="java.lang.String"/>
	<field name="cRazonSocial" class="java.lang.String"/>
	<background>
		<band splitType="Stretch"/>
	</background>
	<detail>
		<band height="33" splitType="Stretch">
			<subreport>
				<reportElement x="0" y="14" width="572" height="19"/>
				<subreportParameter name="cRazonSocial">
					<subreportParameterExpression><![CDATA[$F{cRazonSocial}]]></subreportParameterExpression>
				</subreportParameter>
				<subreportParameter name="cIdRFC">
					<subreportParameterExpression><![CDATA[$F{cIdRFC}]]></subreportParameterExpression>
				</subreportParameter>
				<subreportParameter name="cIdProcedimiento">
					<subreportParameterExpression><![CDATA[$P{cIdProcedimiento}]]></subreportParameterExpression>
				</subreportParameter>
				<connectionExpression><![CDATA[$P{REPORT_CONNECTION}]]></connectionExpression>
				<subreportExpression class="java.lang.String"><![CDATA[$P{DIR_REPORT} + "\\subFallosPunto_A.jasper"]]></subreportExpression>
			</subreport>
		</band>
	</detail>
</jasperReport>
