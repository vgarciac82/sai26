				<textFieldExpression class="java.lang.Integer"><![CDATA[$F{nNumCheque}]]></textFieldExpression>
			</textField>
		</band>
	</pageFooter>
	<summary>
		<band splitType="Stretch"/>
	</summary>
</jasperReport>
