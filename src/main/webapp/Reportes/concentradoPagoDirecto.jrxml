<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="concentradoPagoDirecto"  pageWidth="612" pageHeight="792" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<property name="ireport.zoom" value="1.5"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="nFolioPago" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="hoja" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="totalHojas" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select ROW_NUMBER() OVER (ORDER BY cidpartida) orden, SUBSTRING(claveEp,0,41) claveSiaff, SUBSTRING(claveEp, 42,len(claveEp))cartera, claveEp,cidPartida,
 /*sum(montoBruto)*(1+d.nPorcentajeIVA)*/ SUM(montoNeto) subTotal, case when d.ID_DESTINO_GASTO='AL' THEN
  SUBSTRING(ALTAALMACENARIA,0,CHARINDEX('|',altaAlmacenaria))
   ELSE
  '' END altaAlmacenaria
,isnull(x.cNombre,'FALTA FIRMANTE') autorizo, ISNULL(x.cPuesto,'FALTA FIRMANTE') puestoAutorizo, ISNULL(y.cNombre,'FALTA FIRMANTE') elaboro, ISNULL(y.cPuesto,'FALTA FIRMANTE') puestoElaboro
 ,(select /*sum(montoBruto)*(1+d.nPorcentajeIVA)*/ SUM(montoNeto) as totalDocumento from mPagoDirectoFacturaDetalle where nFolioPago=a.nFolioPago group by nFolioPago) totalDocumento
 from mPagoDirectoFacturaDetalle a inner join mpagodirectoMateriales d on a.nFolioPago=d.C_CONSECUTIVO_PAGODIRECTO left join
 (select d.cNombre+' '+d.cPaterno+' '+d.cMaterno cNombre,d.cPuesto, b.C_CONSECUTIVO_PAGODIRECTO from
  mPagoDirectoMateriales b inner join mPagoDirectoFirmantes c
  on c.cIdDocumento=b.cIdDocumento
  inner join mCatalogoFirmantes d on c.nIdFirmante=d.nIdFirmante and c.cIdUnidadEjecutora=d.cIdUnidadEjecutora
  where c.nNumeroFirmante=2) x on x.C_CONSECUTIVO_PAGODIRECTO=a.nFolioPago
 left join
 ( select d.cNombre+' '+d.cPaterno+' '+d.cMaterno cNombre,d.cPuesto, b.C_CONSECUTIVO_PAGODIRECTO from
  mPagoDirectoMateriales b inner join mPagoDirectoFirmantes c
  on c.cIdDocumento=b.cIdDocumento
  inner join mCatalogoFirmantes d on c.nIdFirmante=d.nIdFirmante and c.cIdUnidadEjecutora=d.cIdUnidadEjecutora
  where c.nNumeroFirmante=1) y on y.C_CONSECUTIVO_PAGODIRECTO=a.nFolioPago
where nFolioPago=$P{nFolioPago} group by cIdPartida, claveEp,altaAlmacenaria, x.cNombre, y.cNombre, x.cPuesto, y.cPuesto, nFolioPago,nPorcentajeIVA ,d.ID_DESTINO_GASTO order by cIdPartida]]>
	</queryString>
	<field name="orden" class="java.lang.Long"/>
	<field name="claveSiaff" class="java.lang.String"/>
	<field name="cartera" class="java.lang.String"/>
	<field name="claveEp" class="java.lang.String"/>
	<field name="cidPartida" class="java.lang.String"/>
	<field name="subTotal" class="java.math.BigDecimal"/>
