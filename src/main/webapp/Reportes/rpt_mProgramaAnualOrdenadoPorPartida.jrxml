<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="rpt_mProgramaAnualOrdenadoPorPartida"  pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="13">
	<property name="ireport.zoom" value="1.1269722013523664"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<queryString>
		<![CDATA[DECLARE @Decimales tinyint
SET @Decimales = '2'
SELECT pad.cEjercicio As _Ejercicio,
	pad.cEjercicio As _Ejercicio1,
       pad.cIdUnidadEjecutora AS _Unidad_RM,
       ccc.D_DESCRIPCION AS _Unidad,
       ccc.ID_AREA As _Entidad_Contable,
       ccabm.cIdCABM AS _CABMS,
       ccabm.cCABM AS _Descripcion_CABMS,
       pad.cIdSubPartida AS _Partida,
       csp.cSubPartida AS _Descripcion_Partida,
       ccabm.cIdUnidadMedida AS _Unidad_Medida,
       ISNULL(IT.nCantidad,0) AS _Cantidad_ITrimestre,
       ISNULL(IIT.nCantidad,0) AS _Cantidad_IITrimestre,
       ISNULL(IIIT.nCantidad,0) AS _Cantidad_IIITrimestre,
       ISNULL(IVT.nCantidad,0) AS _Cantidad_IVTrimestre
       --CANTIDAD TOTAL
       ,ISNULL(IT.nCantidad,0)
         + ISNULL(IIT.nCantidad,0)
         + ISNULL(IIIT.nCantidad,0)
         + ISNULL(IVT.nCantidad,0)
       AS _Cantidad_Total
       ---------------------------------------------
       -- PRECIO UNITARIO
       ,ROUND(CAST((ISNULL((CAST(IT.nCantidad AS MONEY) * IT.mPrecioUnitario),0)
          + ISNULL((CAST (IIT.nCantidad AS MONEY) * IIT.mPrecioUnitario),0)
          + ISNULL((CAST (IIIT.nCantidad AS MONEY) * IIIT.mPrecioUnitario),0)
          + ISNULL((CAST (IVT.nCantidad AS MONEY) * IVT.mPrecioUnitario),0))
          / (ISNULL(IT.nCantidad,0)
            + ISNULL(IIT.nCantidad,0)
            + ISNULL(IIIT.nCantidad,0)
            + ISNULL(IVT.nCantidad,0) + 0.000001) AS MONEY),@Decimales)
       AS _Precio_Unitario
       ----------------------------------------------
       -- MONTO BRUTO
      ,ROUND((ISNULL((IT.mMontoNeto),0)
             + ISNULL((IIT.mMontoNeto),0)
             + ISNULL((IIIT.mMontoNeto),0)
             + ISNULL((IVT.mMontoNeto),0)) ,@Decimales)
       as _Monto_Bruto
       ----------------------------------------------
       ,pad.nPorcentajeIVA AS _IVA
       -- MONTO NETO
       ,ROUND((ISNULL((IT.mMontoNeto),0)
             + ISNULL((IIT.mMontoNeto),0)
             + ISNULL((IIIT.mMontoNeto),0)
             + ISNULL((IVT.mMontoNeto),0))
              * CAST(1 + (pad.nPorcentajeIVA * 0.01) as money),@Decimales)
        AS _Monto_Neto
        --------------------------------------------
FROM mProgramaAnualDetalle pad WITH(NOLOCK)
INNER JOIN mCatalogoSubpartida csp WITH(NOLOCK) ON pad.cIdSubPartida = csp.cIdSubPartida
INNER JOIN v_unidadEjecutoraPadre ccc WITH(NOLOCK) ON pad.cIdUnidadEjecutora= ccc.cUnidadResponsable
INNER JOIN mCatalogoCABM ccabm WITH(NOLOCK) ON pad.cIdSubPartida = ccabm.cIdSubPartida
                              AND pad.cIdCABM = ccabm.cIdCABM
LEFT JOIN (SELECT padp.cEjercicio,
                   padp.cIdUnidadEjecutora,
                   padp.cIdCABM,
                   padp.cIdSubPartida,
                   SUM(padp.nCantidad) As nCantidad,
                   SUM(padp.mPrecioUnitario)  AS mPrecioUnitario
                   ,SUM(ROUND(padp.nCantidad * padp.mPrecioUnitario,2)) AS mMontoNeto
            FROM mProgramaAnualDetallePeriodo padp WITH(NOLOCK)
            INNER JOIN mCatalogoPeriodo cp WITH(NOLOCK) ON padp.nIdPeriodo = cp.nIdPeriodo
            WHERE nIdTrimestre = 1
                  AND (padp.nCantidad * padp.mPrecioUnitario) > 0
            GROUP BY padp.cEjercicio,
                     padp.cIdUnidadEjecutora,
                     padp.cIdCABM,
                     padp.cIdSubPartida) AS IT ON pad.cEjercicio = IT.cEjercicio
                                              AND pad.cIdUnidadEjecutora = IT.cIdUnidadEjecutora
                                              AND pad.cIdCABM = IT.cIdCABM
                                              AND pad.cIdSubPartida = IT.cIdSubPartida
LEFT JOIN (SELECT padp.cEjercicio,
                   padp.cIdUnidadEjecutora,
                   padp.cIdCABM,
                   padp.cIdSubPartida,
                   SUM(padp.nCantidad) As nCantidad,
                   SUM(padp.mPrecioUnitario)  AS mPrecioUnitario
                   ,SUM(ROUND(padp.nCantidad * padp.mPrecioUnitario,2)) AS mMontoNeto
            FROM mProgramaAnualDetallePeriodo padp WITH(NOLOCK)
            INNER JOIN mCatalogoPeriodo cp WITH(NOLOCK) ON padp.nIdPeriodo = cp.nIdPeriodo
            WHERE nIdTrimestre = 2
                  AND (padp.nCantidad * padp.mPrecioUnitario) > 0
            GROUP BY padp.cEjercicio,
                     padp.cIdUnidadEjecutora,
                     padp.cIdCABM,
                     padp.cIdSubPartida) AS IIT ON pad.cEjercicio = IIT.cEjercicio
                                              AND pad.cIdUnidadEjecutora = IIT.cIdUnidadEjecutora
                                              AND pad.cIdCABM = IIT.cIdCABM
                                              AND pad.cIdSubPartida = IIT.cIdSubPartida
LEFT JOIN (SELECT padp.cEjercicio,
                   padp.cIdUnidadEjecutora,
                   padp.cIdCABM,
                   padp.cIdSubPartida,
                   SUM(padp.nCantidad) As nCantidad,
                   SUM(padp.mPrecioUnitario) AS mPrecioUnitario
                   ,SUM(ROUND(padp.nCantidad * padp.mPrecioUnitario,2)) AS mMontoNeto
            FROM mProgramaAnualDetallePeriodo padp WITH(NOLOCK)
            INNER JOIN mCatalogoPeriodo cp WITH(NOLOCK) ON padp.nIdPeriodo = cp.nIdPeriodo
            WHERE nIdTrimestre = 3
                  AND (padp.nCantidad * padp.mPrecioUnitario) > 0
            GROUP BY padp.cEjercicio,
                     padp.cIdUnidadEjecutora,
                     padp.cIdCABM,
                     padp.cIdSubPartida) AS IIIT ON pad.cEjercicio = IIIT.cEjercicio
                                              AND pad.cIdUnidadEjecutora = IIIT.cIdUnidadEjecutora
                                              AND pad.cIdCABM = IIIT.cIdCABM
                                              AND pad.cIdSubPartida = IIIT.cIdSubPartida
LEFT JOIN (SELECT padp.cEjercicio,
                   padp.cIdUnidadEjecutora,
                   padp.cIdCABM,
                   padp.cIdSubPartida,
                   SUM(padp.nCantidad) As nCantidad,
                   SUM(padp.mPrecioUnitario)  AS mPrecioUnitario
                   ,SUM(ROUND(padp.nCantidad * padp.mPrecioUnitario,2)) AS mMontoNeto
            FROM mProgramaAnualDetallePeriodo padp WITH(NOLOCK)
            INNER JOIN mCatalogoPeriodo cp WITH(NOLOCK) ON padp.nIdPeriodo = cp.nIdPeriodo
            WHERE nIdTrimestre = 4
                  AND (padp.nCantidad * padp.mPrecioUnitario) > 0
            GROUP BY padp.cEjercicio,
                     padp.cIdUnidadEjecutora,
                     padp.cIdCABM,
                     padp.cIdSubPartida) AS IVT ON pad.cEjercicio = IVT.cEjercicio
                                              AND pad.cIdUnidadEjecutora = IVT.cIdUnidadEjecutora
                                              AND pad.cIdCABM = IVT.cIdCABM
                                              AND pad.cIdSubPartida = IVT.cIdSubPartida]]>
	</queryString>
