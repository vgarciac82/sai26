	<parameter name="sWhere" class="java.lang.Integer"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT  FACT.NFOLIOPAGO, FACT.cFactura, Fact.dFechaFactura, Fact.dFechaTimbrado, Fact.mimporteconIva, Fact.cRFCFactura,Just.*
FROM tComisionComprobacion COMP WITH (NOLOCK)
INNER JOIN v_AgendaDiasAcumulados AGENDA WITH (NOLOCK)
ON COMP.nIdComision = AGENDA.nIdComision
INNER JOIN tPagoFactura FACT WITH (NOLOCK)
ON FACT.nFolioPago = COMP.nFolioRelacion AND FACT.cTipoPago = COMP.cTipoPago
INNER JOIN tJustificacionRG Just WITH (NOLOCK)
ON just.nFolioRELACIONGASTOS = COMP.nFolioRelacion
WHERE  nFolioRelacion = $P{sWhere}  and
	COMP.cTipoPago = 'RELACIONGASTOS'
AND ( CAST(dFechaFactura AS date) < AGENDA.FINICIO OR CAST(dFechaFactura AS date) > AGENDA.FFIN )]]>
	</queryString>
