<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="Anexo1" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="21ee3b59-a6d6-478e-826d-2a7fb009d122">
	<property name="ireport.zoom" value="1.5"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<property name="ireport.scriptlethandling" value="0"/>
	<property name="ireport.encoding" value="UTF-8"/>
	<import value="net.sf.jasperreports.engine.*"/>
	<import value="java.util.*"/>
	<import value="net.sf.jasperreports.engine.data.*"/>
	<parameter name="swhere" class="java.lang.String">
		<defaultValueExpression><![CDATA["and canocontrarrecibo ='10CP2012004513'"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select tre.caNoContrarrecibo,tre.cIdRelacion,trd.EP, sum( trd.mImporteMasIVA) Importe,tre.cnombre,tre.nFolioRELACIONGASTOS,'RG' as tipodoc
INTO #tmp_anexo
from  tRELACIONGASTOSDetalle trd
inner join tRELACIONGASTOSEncabezado tre
on trd.nFolioRELACIONGASTOS=tre.nFolioRELACIONGASTOS
where 1 = 1 $P!{swhere}
group by tre.caNoContrarrecibo, tre.cIdRelacion, trd.EP, tre.cnombre, tre.nFolioRELACIONGASTOS

insert into #tmp_anexo
select tre.caNoContrarrecibo, tre.cIdDocumento, trd.EP, sum(trd.mImporteMasIVA) Importe, isnull(b.dNombre, '') + ' ' + isnull(b.dApellidoPaterno, '') + ' ' + isnull(b.dApellidoMaterno, ''), tre.nFolioPagoDirecto,'PI' as tipodoc
from  tPagoDirectoDetalle trd inner join tPagoDirectoEncabezado tre on trd.nFolioPagoDirecto=tre.nFolioPagoDirecto inner join tbeneficiario b on
tre.cIdRFC = b.drfc
where 1 = 1 $P!{swhere}
group by tre.caNoContrarrecibo, tre.cIdDocumento, trd.EP, isnull(b.dNombre, '') + ' ' + isnull(b.dApellidoPaterno, '') + ' ' + isnull(b.dApellidoMaterno, ''), tre.nFolioPagoDirecto

insert into #tmp_anexo
select tre.caNoContrarrecibo, tre.cIdRelacion, trd.EP, sum(trd.mImporteMasIVA) Importe, tre.cNombre, tre.nFolioNOMINA, 'NO' as tipodoc
from  tNOMINADetalle trd inner join tNOMINAEncabezado tre on trd.nFolioNOMINA=tre.nFolioNOMINA
 where 1 = 1 $P!{swhere}
group by tre.caNoContrarrecibo, tre.cIdRelacion, trd.EP, tre.cNombre, tre.nFolioNOMINA

insert into #tmp_anexo
select tre.caNoContrarrecibo, tre.cFolioContratoObra, trd.EP, sum(trd.mImporteMasIVA) Importe, isnull(b.dNombre, '') + ' ' + isnull(b.dApellidoPaterno, '') + ' ' + isnull(b.dApellidoMaterno, ''), tre.nFolioPAGOOBRA, 'PO' as tipodoc
from  tPAGOOBRADetalle trd inner join tPAGOOBRAEncabezado tre on trd.nFolioPAGOOBRA=tre.nFolioPAGOOBRA and left(trd.cEvento, 8) <> 'ANTICIPO' inner join tbeneficiario b on
tre.RFC = b.drfc
where 1 = 1 $P!{swhere}
Group by tre.caNoContrarrecibo, tre.cFolioContratoObra, trd.EP, isnull(b.dNombre, '') + ' ' + isnull(b.dApellidoPaterno, '') + ' ' + isnull(b.dApellidoMaterno, ''), tre.nFolioPAGOOBRA

insert into #tmp_anexo
select tre.caNoContrarrecibo, tre.cFolioContratoObra, trd.EP, sum(trd.mImporteMasIVA) Importe, isnull(b.dNombre, '') + ' ' + isnull(b.dApellidoPaterno, '') + ' ' + isnull(b.dApellidoMaterno, ''), tre.nFolioPAGOFEDERALIZADO, 'PF' as tipodoc
from  tPAGOFEDERALIZADODetalle trd inner join tPAGOFEDERALIZADOEncabezado tre on trd.nFolioPAGOFEDERALIZADO=tre.nFolioPAGOFEDERALIZADO  and left(trd.cEvento, 8) <> 'ANTICIPO' inner join tbeneficiario b on
tre.RFC = b.drfc
where 1 = 1 $P!{swhere}
Group by tre.caNoContrarrecibo, tre.cFolioContratoObra, trd.EP, trd.EP, isnull(b.dNombre, '') + ' ' + isnull(b.dApellidoPaterno, '') + ' ' + isnull(b.dApellidoMaterno, ''), tre.nFolioPAGOFEDERALIZADO

insert into #tmp_anexo
select tre.caNoContrarrecibo, tre.cFolioPAGODIVERSO, trd.EP, sum(trd.mImporteMasIVA), isnull(b.dNombre, '') + ' ' + isnull(b.dApellidoPaterno, '') + ' ' + isnull(b.dApellidoMaterno, ''),  tre.nFolioPAGODIVERSO, 'PD' as tipodoc
from  tPAGODIVERSODetalle trd inner join tPAGODIVERSOEncabezado tre on trd.nFolioPAGODIVERSO=tre.nFolioPAGODIVERSO  and left(trd.cEvento, 8) <> 'ANTICIPO' inner join tbeneficiario b on
rtrim(tre.RFC) = rtrim(b.drfc)
 where 1 = 1 $P!{swhere}
Group by tre.caNoContrarrecibo, tre.cFolioPAGODIVERSO, trd.EP, isnull(b.dNombre, '') + ' ' + isnull(b.dApellidoPaterno, '') + ' ' + isnull(b.dApellidoMaterno, ''), tre.nFolioPAGODIVERSO

select caNoContrarrecibo, cIdRelacion, EP, SUM(Importe) AS Importe, cnombre, nFolioRELACIONGASTOS, tipodoc
from #tmp_anexo
GROUP BY caNoContrarrecibo,cIdRelacion,EP,cnombre,nFolioRELACIONGASTOS,tipodoc]]>
	</queryString>
	<field name="caNoContrarrecibo" class="java.lang.String"/>
	<field name="cIdRelacion" class="java.lang.String"/>
	<field name="EP" class="java.lang.String"/>
	<field name="Importe" class="java.lang.Double"/>
	<field name="cnombre" class="java.lang.String"/>
	<field name="nFolioRELACIONGASTOS" class="java.lang.Integer"/>
	<field name="tipodoc" class="java.lang.String"/>
	<variable name="sImporte" class="java.lang.Double">
		<variableExpression><![CDATA[$F{Importe} + $F{Importe}]]></variableExpression>
	</variable>
	<variable name="Importe_1" class="java.math.BigDecimal" resetType="Column" calculation="Sum">
		<variableExpression><![CDATA[$F{Importe}]]></variableExpression>
	</variable>
	<variable name="Importe_2" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{Importe}]]></variableExpression>
	</variable>
