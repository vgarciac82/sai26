	<parameter name="SUBREPORT_DIR" class="java.lang.String">
		<defaultValueExpression><![CDATA["C:\\Axtel\\Clientes\\CONAFOR\\Workspaces\\sai\\WebContent\\Reportes\\"]]></defaultValueExpression>
	</parameter>
	<parameter name="nConciliacion" class="java.lang.String"/>
	<queryString>
		<![CDATA[declare @mes int
declare @cban varchar(20)
declare @saldoBanco money, @msaldoLibros money
declare @fecha date
declare @NombreFirmanteElab varchar (100)
declare @NombreFirmanteVobo varchar (100) 
declare @NombreFirmanteAut varchar (100)
declare @PuestoFirmanteElab varchar (100)
declare @PuestoFirmanteVobo varchar (100)
declare @PuestoFirmanteAut varchar (100)
declare @BancoA money, @BancoC money, @ContaA money, @contaC money

select @mes = nMes, @cban = nCban, @saldoBanco = mSaldoFinal, @fecha = fConciliacion, @msaldoLibros = mSaldoLibros from tconciliacion (nolock)
where nConciliacion = $P{nConciliacion}

select SUM(mmonto) Monto, cOrigen+ cTipo id
into #tblConciliados
from fn_l_noConciliados ( $P{nConciliacion}, @mes, @cban)
group by cOrigen, cTipo

set @BancoA = (select monto from #tblConciliados where id = 'BancoA')
set @BancoC = (select monto from #tblConciliados where id = 'BancoC')
set @ContaA = (select monto from #tblConciliados where id = 'ContabilidadA')
set @contaC = (select monto from #tblConciliados where id = 'ContabilidadC')


select @NombreFirmanteElab = isnull(NOMBREN, '') + ' ' +  isnull(NOMBREP, '') + ' ' +  isnull(NOMBREM, '') ,
@PuestoFirmanteElab = DESCRIPCION_PUESTO
from TFIRMANTECONCILIACION  firma (nolock)
inner join v_empleados_giro emp (nolock)
on firma.cnumeroEmpleado = emp.CLAVE
where nconciliacion = $P{nConciliacion} and nidtipofirmante = 1

select @NombreFirmanteVobo = isnull(NOMBREN, '') + ' ' +  isnull(NOMBREP, '') + ' ' +  isnull(NOMBREM, '') ,
@PuestoFirmanteVobo = DESCRIPCION_PUESTO
from TFIRMANTECONCILIACION  firma (nolock)
inner join v_empleados_giro emp (nolock)
on firma.cnumeroEmpleado = emp.CLAVE
where nconciliacion = $P{nConciliacion} and nidtipofirmante =3

select @NombreFirmanteAut =  isnull(NOMBREN, '') + ' ' +  isnull(NOMBREP, '') + ' ' +  isnull(NOMBREM, '') ,
@PuestoFirmanteAut = DESCRIPCION_PUESTO
from TFIRMANTECONCILIACION  firma (nolock)
inner join v_empleados_giro emp (nolock)
on firma.cnumeroEmpleado = emp.CLAVE
where nconciliacion = $P{nConciliacion} and nidtipofirmante =4

select @mes mes,  @cban cBan, isnull(@saldoBanco,0) saldoBanco , @fecha fecha
,isnull(@BancoA,0) BancoA, isnull(@BancoC,0) BancoC, isnull(@ContaA,0) ContaA, isnull(@contaC,0) contaC, isnull(@msaldoLibros,0) msaldoLibros,
@NombreFirmanteElab NombreFirmanteElab,
@NombreFirmanteVobo NombreFirmanteVobo,
@NombreFirmanteAut NombreFirmanteAut,
@PuestoFirmanteElab PuestoFirmanteElab,
@PuestoFirmanteVobo PuestoFirmanteVobo,
@PuestoFirmanteAut PuestoFirmanteAut


drop table #tblConciliados]]>
	</queryString>
	<field name="mes" class="java.lang.Integer"/>
	<field name="cBan" class="java.lang.String"/>
	<field name="saldoBanco" class="java.math.BigDecimal"/>
	<field name="fecha" class="java.lang.String"/>
	<field name="BancoA" class="java.math.BigDecimal"/>
	<field name="BancoC" class="java.math.BigDecimal"/>
	<field name="ContaA" class="java.math.BigDecimal"/>
	<field name="contaC" class="java.math.BigDecimal"/>
	<field name="msaldoLibros" class="java.math.BigDecimal"/>
	<field name="NombreFirmanteElab" class="java.lang.String"/>
	<field name="NombreFirmanteVobo" class="java.lang.String"/>
	<field name="NombreFirmanteAut" class="java.lang.String"/>
	<field name="PuestoFirmanteElab" class="java.lang.String"/>
	<field name="PuestoFirmanteVobo" class="java.lang.String"/>
	<field name="PuestoFirmanteAut" class="java.lang.String"/>
	<variable name="saldoChequera" class="java.math.BigDecimal">
		<variableExpression><![CDATA[$F{saldoBanco}.subtract($F{ContaA}).add($F{contaC}).subtract($F{BancoC}).add($F{BancoA})]]></variableExpression>
		<initialValueExpression><![CDATA[]]></initialValueExpression>
	</variable>
	<variable name="diferencia" class="java.math.BigDecimal">
		<variableExpression><![CDATA[$V{saldoChequera}.subtract( $F{msaldoLibros})]]></variableExpression>
	</variable>
