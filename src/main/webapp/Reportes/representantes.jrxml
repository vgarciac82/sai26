			</staticText>
			<staticText>
				<reportElement x="2" y="147" width="91" height="22"/>
				<textElement>
					<font fontName="Arial" size="6"/>
				</textElement>
				<text><![CDATA[AUTORIZACION PARA INVERSION ]]></text>
			</staticText>
			<line>
				<reportElement x="94" y="123" width="1" height="46"/>
