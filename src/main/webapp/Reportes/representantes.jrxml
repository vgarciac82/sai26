				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[(($P{cIdRFC}.replaceAll( " ", "" ).substring(3,4)).equals( "-" ) ? "NO. ESCRITURA ACTA CONSTITUTIVA" : "ACTA DE NACIMIENTO" )]]></textFieldExpression>
