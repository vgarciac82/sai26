<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="representantes"  pageWidth="360" pageHeight="188" orientation="Landscape" columnWidth="360" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0">
	<property name="ireport.zoom" value="2.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="idPedidoDefinitivo" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="cIdRFC" class="java.lang.String"/>
	<queryString>
		<![CDATA[declare @IdPedido varchar(40)
set @IdPedido=$P{idPedidoDefinitivo}
declare @numEP int;
select @numEP=dbo.fn_mEP(@IdPedido)
if (@numEP>0)
begin
select distinct convert(varchar(15),fFormalizacion,105)  as fFormalizacion, pr.cIdpedido,pr.cRepresentanteLegal,cCargoRepresentante,cActaConstitutiva,cNoEscritura,cTelefono,cAutorizacion, cFechaAutorizacion,
case when dbo.fn_mEP(@IdPedido)>1 then 'VER ANEXO I DEL PRESENTE PEDIDO' else EP end  as EP from    tPreCompromisoDetalle a  inner join tPreCompromisoEncabezado b on a.nFolioPreCompromiso=b.nFolioPreCompromiso inner join mpedido mp
on mp.cIdPedidoDefinitivo=b.cIdContrato
inner join mPedidoRepresentante pr on pr.cIdPedido=mp.cIdPedidoDefinitivo where pr.cIdPedido=@IdPedido
end
else
begin
select distinct convert(varchar(15),fFormalizacion,105)  as fFormalizacion, pr.cIdpedido,pr.cRepresentanteLegal,cCargoRepresentante,cActaConstitutiva,cNoEscritura,cTelefono,cAutorizacion, cFechaAutorizacion,' ' as EP
from mpedido mp
inner join mPedidoRepresentante pr on pr.cIdPedido=mp.cIdPedidoDefinitivo where pr.cIdPedido=@IdPedido
end]]>
	</queryString>
	<field name="fFormalizacion" class="java.lang.String"/>
	<field name="cIdpedido" class="java.lang.String"/>
	<field name="cRepresentanteLegal" class="java.lang.String"/>
	<field name="cCargoRepresentante" class="java.lang.String"/>
	<field name="cActaConstitutiva" class="java.lang.String"/>
	<field name="cNoEscritura" class="java.lang.String"/>
	<field name="cTelefono" class="java.lang.String"/>
	<field name="cAutorizacion" class="java.lang.String"/>
	<field name="cFechaAutorizacion" class="java.lang.String"/>
	<field name="EP" class="java.lang.String"/>
	<detail>
		<band height="188" splitType="Prevent">
			<rectangle>
				<reportElement x="1" y="1" width="302" height="122"/>
			</rectangle>
			<textField>
				<reportElement x="154" y="97" width="148" height="11"/>
				<textElement>
					<font fontName="Arial" size="7"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{cTelefono}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="154" y="84" width="149" height="9">
					<printWhenExpression><![CDATA[($P{cIdRFC}.replaceAll( " ", "" ).substring(3,4)).equals( "-" ) ? Boolean.TRUE:Boolean.FALSE]]></printWhenExpression>
				</reportElement>
				<textElement>
					<font fontName="Arial" size="7"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{cNoEscritura}]]></textFieldExpression>
			</textField>
			<line>
				<reportElement x="149" y="56" width="150" height="1"/>
			</line>
			<staticText>
				<reportElement stretchType="RelativeToBandHeight" x="3" y="45" width="139" height="11"/>
				<textElement>
					<font fontName="Arial" size="7"/>
				</textElement>
				<text><![CDATA[FIRMA]]></text>
			</staticText>
			<textField>
				<reportElement x="153" y="71" width="149" height="12"/>
				<textElement>
					<font fontName="Arial" size="7"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{cActaConstitutiva}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement stretchType="RelativeToTallestObject" x="3" y="58" width="139" height="11"/>
				<textElement>
					<font fontName="Arial" size="7"/>
				</textElement>
				<text><![CDATA[CARGO]]></text>
			</staticText>
			<staticText>
				<reportElement x="4" y="84" width="139" height="9">
					<printWhenExpression><![CDATA[($P{cIdRFC}.replaceAll( " ", "" ).substring(3,4)).equals( "-" ) ? Boolean.TRUE:Boolean.FALSE]]></printWhenExpression>
				</reportElement>
				<textElement>
					<font fontName="Arial" size="7"/>
				</textElement>
				<text><![CDATA[No. ESCRITURA PODER NOTARIAL]]></text>
			</staticText>
			<rectangle>
				<reportElement x="1" y="124" width="302" height="45"/>
			</rectangle>
			<textField>
				<reportElement x="156" y="111" width="118" height="10"/>
				<textElement>
					<font fontName="Arial" size="7"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{fFormalizacion}]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true">
				<reportElement x="153" y="29" width="150" height="13"/>
				<textElement>
					<font fontName="Arial" size="7" isUnderline="false"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{cRepresentanteLegal}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement stretchType="RelativeToTallestObject" x="3" y="2" width="300" height="25"/>
				<textElement>
					<font fontName="Arial" size="6" isBold="false" isItalic="false" isUnderline="false" isStrikeThrough="false"/>
				</textElement>
				<text><![CDATA[EL PROVEEDOR SE OBLIGA A ENTREGAR LOS BIENES EN LOS TERMINOS PACTADOS EN ESTE PEDIDO Y SE SUJETA A LAS DISPOSICIONES DE LA LEY DE ADQUISICIONES, ARRENDAMIENTOS Y SERVICIOS DEL SECTOR PUBLICO Y SU REGLAMENTO]]></text>
			</staticText>
			<staticText>
				<reportElement x="3" y="111" width="139" height="10"/>
				<textElement>
					<font fontName="Arial" size="7"/>
				</textElement>
				<text><![CDATA[FECHA]]></text>
			</staticText>
			<textField>
				<reportElement x="153" y="58" width="149" height="12"/>
				<textElement>
					<font fontName="Arial" size="7"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{cCargoRepresentante}]]></textFieldExpression>
			</textField>
			<line>
				<reportElement x="2" y="145" width="300" height="1"/>
			</line>
			<staticText>
				<reportElement x="199" y="147" width="95" height="12"/>
				<textElement>
					<font fontName="Arial" size="6"/>
				</textElement>
				<text><![CDATA[FECHA:   DIA    MES    AÑO]]></text>
			</staticText>
			<staticText>
				<reportElement x="2" y="125" width="91" height="21"/>
				<textElement>
