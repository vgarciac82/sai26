			<textField>
				<reportElement x="216" y="157" width="79" height="12"/>
				<textElement>
					<font fontName="Arial" size="7"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{cFechaAutorizacion}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="136" y="147" width="31" height="10"/>
				<textElement>
					<font fontName="Arial" size="7"/>
				</textElement>
				<text><![CDATA[No. oficio]]></text>
			</staticText>
			<textField>
				<reportElement x="126" y="157" width="66" height="12"/>
				<textElement>
					<font fontName="Arial" size="7"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{cAutorizacion}]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true">
				<reportElement x="96" y="126" width="206" height="18"/>
				<textElement verticalAlignment="Middle">
					<font fontName="Arial" size="6"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{EP}]]></textFieldExpression>
			</textField>
			<line>
				<reportElement x="149" y="108" width="150" height="1"/>
			</line>
			<line>
				<reportElement x="149" y="93" width="150" height="1">
					<printWhenExpression><![CDATA[($P{cIdRFC}.replaceAll( " ", "" ).substring(3,4)).equals( "-" ) ? Boolean.TRUE:Boolean.FALSE]]></printWhenExpression>
				</reportElement>
			</line>
			<line>
				<reportElement x="149" y="81" width="150" height="1"/>
			</line>
			<line>
