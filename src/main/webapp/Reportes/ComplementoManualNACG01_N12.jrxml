	<queryString>
		<![CDATA[DECLARE @idVersion INT = $P{idVersion}
DECLARE @final INT = $P{final}
DECLARE @consulta INT = $P{consulta}
DECLARE @tipoManual INT = $P{tipoManual}

IF @final = 0 AND @consulta = 0 --TEMPORAL
BEGIN
	SELECT RTRIM(LTRIM(cParrafo15)) AS cParrafo15
			, RTRIM(LTRIM(cParrafo16)) AS cParrafo16
			, RTRIM(LTRIM(cParrafo17)) AS cParrafo17
		FROM tComplementoManualContable
		WHERE idComplemento = @tipoManual
END

ELSE IF @final = 1 AND @consulta = 1 --CUANDO SE CONULTA UNA VERSION
BEGIN
	SELECT RTRIM(LTRIM(cParrafo15)) AS cParrafo15
			, RTRIM(LTRIM(cParrafo16)) AS cParrafo16
			, RTRIM(LTRIM(cParrafo17)) AS cParrafo17
		FROM tComplementoManualContableVersion
		WHERE idComplemento = @tipoManual
		AND idVersion = @idVersion
END]]>
	</queryString>
