			<textField>
				<reportElement x="237" y="95" width="294" height="13" uuid="ed7fad04-bd37-4374-ac94-32379340fbe0"/>
				<textElement textAlignment="Center">
					<font fontName="Arial" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA[($P{miles}==1 ? "(miles de pesos)" : "(en pesos)" )]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="237" y="82" width="294" height="13" uuid="bebde03a-2306-47e2-894d-d8ad469ad548"/>
				<textElement textAlignment="Center">
					<font fontName="Arial" isBold="false"/>
				</textElement>
				<textFieldExpression><![CDATA[(
    $P{mes}==1 ? "Al 31 de Enero de " +$P{anio}.toString():
    $P{mes}==2 && ($P{anio}%400 == 0 || ($P{anio}%100 != 0 && $P{anio}%4 == 0)) ? "Al 29 de Febrero de " +$P{anio}.toString():
    $P{mes}==2 ? "Al 28 de Febrero de " +$P{anio}.toString():
    $P{mes}==3 ? "Al 31 de Marzo de " +$P{anio}.toString():
    $P{mes}==4 ? "Al 30 de Abril de " +$P{anio}.toString():
    $P{mes}==5 ? "Al 31 de Mayo de " +$P{anio}.toString():
    $P{mes}==6 ? "Al 30 de Junio de " +$P{anio}.toString():
    $P{mes}==7 ? "Al 31 de Julio de " +$P{anio}.toString():
    $P{mes}==8 ? "Al 31 de Agosto de " +$P{anio}.toString():
    $P{mes}==9 ? "Al 30 de Septiembre de " +$P{anio}.toString():
    $P{mes}==10 ? "Al 31 de Octubre de " +$P{anio}.toString():
    $P{mes}==11 ? "Al 30 de Noviembre de " +$P{anio}.toString():
    $P{mes}==12 ? "Al 31 de Diciembre de " +$P{anio}.toString():
    ""
)]]></textFieldExpression>
			</textField>
		</band>
