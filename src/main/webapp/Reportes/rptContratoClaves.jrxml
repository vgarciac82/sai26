	<parameter name="cEjercicio" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="cIdContrato" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[declare @cIdContrato varchar(40), @cEjercicio varchar(4);

set @cIdContrato = $P{cIdContrato};
set @cEjercicio = $P{cEjercicio};

--set @cIdContrato = 'CV-B03-12';
--set @cEjercicio = '2013';

--SELECT
--	'' AS EP,
--	'' AS cPeriodo,
--	'' AS mImporte,
--	'' AS mTotal
--UNION
SELECT
	tCD.EP,
	mper.cPeriodo,
	'$' + ISNULL(CONVERT(varchar,CONVERT(MONEY,tCD.mImporte), 1), '0.00') AS mImporte,
	'Total: $' + (SELECT ISNULL(CONVERT(varchar,CONVERT(MONEY,SUM(tCD.mImporte)), 1), '0.00') AS mTotal
		FROM mContrato mc WITH(NOLOCK)
			inner join pContratoDiverso pCD WITH(NOLOCK) ON
			mc.cIdContratoDefinitivo = pCD.cIdContrato
			INNER JOIN tpreCompromisoEncabezado tCE WITH(NOLOCK) ON
			pCD.cIdContrato = tCE.cIdContrato
			INNER JOIN tpreCompromisoDetalle tCD WITH(NOLOCK) ON
			tCE.nFoliopreCompromiso = tCD.nFolioPreCompromiso
			WHERE mc.cIdContrato = @cIdContrato
                             --- and tce.C_FOLIO_COMP is not null
			AND mc.cEjercicio = @cEjercicio
                               and tcd.cEvento not in('APTDDISP')
			 and tce.cDocumentoHaplicado='S'
			GROUP BY mc.cIdContrato)
		AS mTotal,
		substring(tCD.EP,len(tCD.EP) - charindex('.', reverse(tCD.EP))+2,3 )as ue
FROM mContrato mc WITH(NOLOCK)
	INNER JOIN pContratoDiverso pCD WITH(NOLOCK) ON
	mc.cIdContratoDefinitivo = pCD.cIdContrato
	INNER JOIN tpreCompromisoEncabezado tCE WITH(NOLOCK) ON
	pCD.cIdContrato = tCE.cIdContrato
	INNER JOIN tPreCompromisoDetalle tCD WITH(NOLOCK) ON
	tCE.nFoliopreCompromiso = tCD.nFoliopreCompromiso
	INNER JOIN mCatalogoPeriodo mPer WITH(NOLOCK) ON
	tCD.cMes = mPer.nIdPeriodo

WHERE mc.cIdContrato = @cIdContrato
AND mc.cEjercicio = @cEjercicio
AND tcd.cEvento not in ('APTDDISP')
 and tce.cDocumentoHaplicado='S'
group by tCD.EP,mper.cPeriodo,tCD.mImporte,mPer.nIdPeriodo
order by ue,nIdPeriodo]]>
	</queryString>
	<field name="EP" class="java.lang.String"/>
	<field name="cPeriodo" class="java.lang.String"/>
	<field name="mImporte" class="java.lang.String"/>
	<field name="mTotal" class="java.lang.String"/>
	<field name="ue" class="java.lang.String"/>
