	<queryString>
		<![CDATA[select top 1 substring(nCuenta, 1,5) Cuenta, substring(nCuenta, 7,5) subCuenta, case when nSubCuenta = ''
then substring(nCuenta, 13,5) else case when cnombre is null then calmacen else nSubCuenta end end subSubCuenta
,calmacen, cnombre
, *
   from tmovimiento m
   left join cat_almacen a on cast(a.nidalmacen as varchar(10))=nsubcuenta and a.ccentrocontable = m.ccentrocontable
   left join v_pcatalogorfc rfc on cidrfc=nsubcuenta
   where nFolioPoliza = 5 and cTipopoliza ='CH' and mmovimiento != 0 and ncuenta not like '8%'
order by ncuenta, ctipomovimiento desc]]>
	</queryString>
