<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="subReportPenasDetalle"  pageWidth="551" pageHeight="752" columnWidth="551" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0">
	<property name="ireport.zoom" value="3.4522712143931114"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="whereFolio" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["CR.caNoContrarrecibo = '10PC2016100001'"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[--WITH CR AS (SELECT penas.caNoContrarrecibo,  det.caNoContrarrecibo caNoContrarreciboDet
--, mImporteMasIva mTotal
--, ep
--FROM dbo.tPagoPenasConvEncabezado penas
--INNER JOIN dbo.tPagoPenasConvDetalle det
--ON penas.nFolioPagoPenasConv = det.nFolioPagoPenasConv
--)
--SELECT * FROM CR
--WHERE $P!{whereFolio} AND 1 = 1

SELECT caNoContrarrecibo,  caNoContrarreciboDet,  mTotal, ep
FROM
(
	SELECT penas.caNoContrarrecibo,  det.caNoContrarrecibo AS caNoContrarreciboDet, 		mImporteMasIva AS mTotal, ep
	FROM dbo.tPagoPenasConvEncabezado penas
	INNER JOIN dbo.tPagoPenasConvDetalle det
		ON penas.nFolioPagoPenasConv = det.nFolioPagoPenasConv
) AS penas
WHERE $P!{whereFolio} AND 1 = 1]]>
	</queryString>
	<field name="caNoContrarrecibo" class="java.lang.String"/>
	<field name="caNoContrarreciboDet" class="java.lang.String"/>
	<field name="Ep" class="java.lang.String"/>
	<field name="mTotal" class="java.math.BigDecimal"/>
	<columnHeader>
		<band height="1">
			<line>
				<reportElement x="0" y="0" width="551" height="1"/>
			</line>
		</band>
	</columnHeader>
	<detail>
		<band height="12" splitType="Stretch">
			<textField>
				<reportElement x="23" y="1" width="100" height="11"/>
				<textElement>
					<font size="8"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{caNoContrarreciboDet}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="123" y="1" width="305" height="11"/>
				<box>
					<leftPen lineWidth="0.0"/>
					<rightPen lineWidth="0.0"/>
				</box>
				<textElement textAlignment="Center">
					<font size="8"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{Ep}]]></textFieldExpression>
			</textField>
			<textField pattern="#,##0.00">
				<reportElement x="428" y="1" width="100" height="11"/>
				<textElement textAlignment="Right">
					<font size="8"/>
				</textElement>
				<textFieldExpression class="java.math.BigDecimal"><![CDATA[$F{mTotal}]]></textFieldExpression>
			</textField>
			<line>
				<reportElement x="0" y="0" width="1" height="12"/>
			</line>
			<line>
				<reportElement x="550" y="0" width="1" height="12"/>
			</line>
		</band>
	</detail>
	<columnFooter>
		<band height="1">
			<line>
				<reportElement x="0" y="0" width="551" height="1"/>
			</line>
		</band>
	</columnFooter>
</jasperReport>
