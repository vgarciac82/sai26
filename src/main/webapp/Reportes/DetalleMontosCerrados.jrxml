	</variable>
	<variable name="EtAvance" class="java.lang.String">
		<variableExpression><![CDATA[($F{AvanceFisico} ==0 ? "  No Aplica" :$F{AvanceFisico})]]></variableExpression>
		<initialValueExpression><![CDATA[]]></initialValueExpression>
	</variable>
	<variable name="Avance_Total" class="java.lang.String">
