<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="concentradoPagoDirecto"  pageWidth="612" pageHeight="792" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<property name="ireport.zoom" value="1.5"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="15"/>
	<parameter name="hoja" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="totalHojas" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="nFolioRelacionGastos" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select ROW_NUMBER() OVER (ORDER BY cIdSubPartida) orden, SUBSTRING(EP,0,41) claveSiaff, SUBSTRING(EP, 42,len(EP))cartera, EP,cIdSubPartida,
 SUBSTRING(a.altaAlmacenaria,0,CHARINDEX('|',a.altaAlmacenaria)) altaAlmacenaria
,x.cNombre autorizo, x.cPuesto puestoAutorizo, y.cNombre elaboro, y.cPuesto puestoElaboro
 ,(select sum(mImporteTotalFacturaDetalle) as totalDocumento from mRelacionGastosFacturasDetalle where nFolioRelacionGastos=a.nFolioRelacionGastos group by nFolioRelacionGastos) totalDocumento
  ,sum(mImporteTotalFacturaDetalle) subTotal
  from  mRelacionGastosFacturasDetalle a inner join mRelacionGastos d on a.nFolioRelacionGastos=d.ConsecutivoRELGASTOS left join
 (select d.cNombre+' '+d.cPaterno+' '+d.cMaterno cNombre,d.cPuesto, b.ConsecutivoRELGASTOS from
  mRelacionGastos b inner join mRelacionGastosFirmantes c
  on c.cIdDocumento=b.cIdDocumento
  inner join mCatalogoFirmantes d on c.nIdFirmante=d.nIdFirmante and c.cIdUnidadEjecutora=d.cIdUnidadEjecutora
  where c.nNumeroFirmante=2) x on x.ConsecutivoRELGASTOS=a.nFolioRelacionGastos
 left join
 ( select d.cNombre+' '+d.cPaterno+' '+d.cMaterno cNombre,d.cPuesto, b.ConsecutivoRELGASTOS    from

  mRelacionGastos b inner join mRelacionGastosFirmantes c
   on c.cIdDocumento=b.cIdDocumento
  inner join mCatalogoFirmantes d on c.nIdFirmante=d.nIdFirmante and c.cIdUnidadEjecutora=d.cIdUnidadEjecutora
  where c.nNumeroFirmante=1)

  y on y.ConsecutivoRELGASTOS=a.nFolioRelacionGastos
where nFolioRelacionGastos=$P{nFolioRelacionGastos}
 group by cIdSubPartida, EP,a.altaAlmacenaria, x.cNombre, y.cNombre, x.cPuesto, y.cPuesto, nFolioRelacionGastos order by cIdSubPartida]]>
	</queryString>
