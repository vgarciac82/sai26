<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="ComprobanteRegistro" pageWidth="612" pageHeight="792" whenNoDataType="AllSectionsNoDetail" columnWidth="552" leftMargin="30" rightMargin="30" topMargin="10" bottomMargin="10">
	<property name="ireport.zoom" value="1.3636363636363644"/>
	<property name="ireport.x" value="101"/>
	<property name="ireport.y" value="37"/>
	<property name="ireport.scriptlethandling" value="0"/>
	<property name="ireport.encoding" value="UTF-8"/>
	<import value="net.sf.jasperreports.engine.*"/>
	<import value="java.util.*"/>
	<import value="net.sf.jasperreports.engine.data.*"/>
	<parameter name="whereFolio" class="java.lang.String">
		<defaultValueExpression><![CDATA[" folioSAI = 1"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select ca.folioSai+' / '+ca.nFolio as nFolio,  CONVERT( VARCHAR, CONVERT( DATE,fechaCarga),103) as fechaCarga,
case banco when 'BANORTE' THEN CONVERT( VARCHAR, CONVERT( DATE,ca.dFechaOperacionValor),103)
else CONVERT( VARCHAR, CONVERT( DATE,ca.dFecha),103) end as fechaBanco,
ca.tipoMovimiento as movimiento, ca.mImporte, '('+(SELECT dbo.CantidadConLetraPedido(ca.mImporte, 'PESOS'))+'M.N.)' as letraImporte,
ca.sBeneficiarioCompleto, case ca.banco when 'BANORTE' THEN 'BANCO MERCANTIL DEL NORTE, S.A.'
			  when 'BANCOMER' THEN 'BBVA BANCOMER, S.A.'
			  when 'SCOTIABANK' THEN 'SCOTIABANK INVERLAT, S.A.'
			  when 'BBVA BANCOMER' THEN 'BBVA BANCOMER, S.A.'
			  else '' end as banco,

ca.sCuenta, ca.cuentaBancaria,
isnull(o.sOrigenDeposito,'N/A') as sOrigenDeposito, isnull(c.sConcepto,'N/A') as sConcepto, isnull(m.sMedioPago,'N/A') as sMedioPago,
case isnull(ca.sTipoPago,'-') when '-' then 'N/A'
when 'SELECCIONE' then 'N/A'
else ca.sTipoPago end sTipoPago,
ca.sNotas,
isnull(trdbD.documentoSoporte,'N/A') as documentoSoporte,
(select sAreaFormulo from tRdbFimantes where Activo = 1 and tipoDocumento = 'RDB') as sAreaFormulo,
(select sNombreFormulo from tRdbFimantes where Activo = 1 and tipoDocumento = 'RDB') as sNombreFormulo,
(select sAreaReviso from tRdbFimantes where Activo = 1 and tipoDocumento = 'RDB') as sAreaReviso,
(select sNombreReviso from tRdbFimantes where Activo = 1 and tipoDocumento = 'RDB') as sNombreReviso

from trdbcargaarchivordb ca LEFT OUTER JOIN trdbcat_concepto c ON ca.sConcepto = c.idRdbCat_Concepto
	 LEFT OUTER JOIN trdbcat_MedioPago m ON ca.sMedioPago = m.idRdbCat_MedioPago
	 LEFT OUTER JOIN trdbcat_OrigenDeposito o ON ca.sOrigenDeposito = o.idRdbCat_OrigenDeposito
	 LEFT OUTER JOIN tRdbCargaArchivoRDBDetalle trdbD ON ca.nFolio = trdbD.nFolio
where $P!{whereFolio}]]>
	</queryString>
