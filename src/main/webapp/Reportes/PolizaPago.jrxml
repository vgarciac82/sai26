<!-- Created with Jaspersoft Studio version 6.17.0.final using JasperReports Library version 6.17.0-6d93193241dd8cc42629e188b94f9e0bc5722efd  -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="PolizaPago" pageWidth="612" pageHeight="792" whenNoDataType="AllSectionsNoDetail" columnWidth="552" leftMargin="30" rightMargin="30" topMargin="20" bottomMargin="20" uuid="a1d583e8-7f10-4b3b-9bca-8deec783fa8b">
	<property name="ireport.zoom" value="1.502629601803156"/>
	<property name="ireport.x" value="110"/>
	<property name="ireport.y" value="439"/>
	<property name="ireport.scriptlethandling" value="0"/>
	<property name="ireport.encoding" value="UTF-8"/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="194"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w1" value="18"/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w2" value="975"/>
	<import value="net.sf.jasperreports.engine.*"/>
	<import value="java.util.*"/>
	<import value="net.sf.jasperreports.engine.data.*"/>
	<parameter name="whereFolio" class="java.lang.String">
		<defaultValueExpression><![CDATA[" and CR.canocontrarrecibo ='10CP2022125905'"]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[-- Relacion de gastos
DECLARE @sFirmanteDelegatorio VARCHAR(250)
DECLARE @sPuestoFirmanteDelegatorio VARCHAR(70)
DECLARE @sFirmanteAut VARCHAR(250)
DECLARE @sLeyenda VARCHAR(500)
DECLARE @sOficio VARCHAR(128)
DECLARE @sFechaOficio VARCHAR(20)
DECLARE @cTipoSuplencia VARCHAR(20)
DECLARE @cTipoObra VARCHAR(10)= 'RELGASTO'
DECLARE @cTipoPago VARCHAR(15) = 'RELACIONGASTOS'
DECLARE @nFolioPago INT 
SET	@sFirmanteDelegatorio = ''
SET @sPuestoFirmanteDelegatorio = ''

SET @sFirmanteAut = ''
SET @sLeyenda = ''
SET @sOficio = ''
SET @sFechaOficio = ''


SELECT @nFolioPago = (SELECT nFolioRELACIONGASTOS FROM tRELACIONGASTOSEncabezado CR WHERE  1 = 1
						--and CR.canocontrarrecibo ='10CP2023103232'
						$P!{whereFolio}
						)

IF (SELECT OBJECT_ID('tempdb..#tmp_TablaFinal')) 	IS NOT NULL	DROP TABLE #tmp_TablaFinal

declare  @importeIva money 
set @importeIva = isnull(( select SUM(mimporteiva) from tPagoFactura where nFolioPago = @nFolioPago and cTipoPago = 'RELACIONGASTOS'),0)

	SELECT rfc.CNOMBRE CNOMBRE2
		, CR.aEjercicioFiscal
		, CR.cIdEntidadContable
		, CR.caNoContrarrecibo
		, 'RELGASTOS -' +  CAST(CR.nFolioRELACIONGASTOS AS varchar(4))  cIdDocumento
		, '3' cIdTipoDocumento
		, CR.TIPO_OPERACION AS cIdTipoOperacion
		, CR.cIdRFC
		, '01' cIdTipoMoneda
		, '0.00' nTipoCambio
		, cast((CR.mImporteMasIva - @importeIva) as decimal(17,2)) mImporteBruto 
		, sum(cast((isnull(rgDet.mSancion,0)) as decimal(17,2))) mImporteSancion
		, sum(cast((isnull(rgDet.mDevolucion,0)) as decimal(17,2))) mimporteDevolucion
		, sum(cast((isnull(rgDet.mImporteAmortiza,0)) as decimal(17,2))) mAmortizacionAnticipo
		, @importeIva mImporteIVA 
		, sum(rgDet.mISROtros) + sum(isnull(rgDet.mimporteIva6,0)) + sum(ISNULL(rgDet.mimporteISRLaudos,0)) 
			+ sum(ISNULL(rgDet.mImporteISRResico, '0'))+ sum(ISNULL(rgDet.mImporteIvaArrenda, '0'))+ sum(ISNULL(rgDet.mISRArrenda, '0'))
			+ sum(ISNULL(rgDet.mImporteIvaHonorarios, '0'))+ sum(ISNULL(rgDet.mISRHonorarios, '0')) 
			+ sum(ISNULL(rgDet.mImporteFlete23, '0'))   + sum(ISNULL(rgDet.mImporteFlete4, '0')) mImporteRetencion 
		, sum(cast((isnull(rgDet.mPenalizacion,0)) as decimal(17,2))) mImportePenalizacion 
		, cast(CR.mImporteNeto as decimal(17,2)) mImporteNeto 
		, convert(varchar(10),CR.fProgramadaPago,103) fProgramadaPago
		, cast(cast(CR.fAplicacion as varchar(12)) as date) fRegistro
		, CASE WHEN cxp IS NOT NULL THEN cr.cconcepto + ' Ver póliza manual modificatoria con el número: ' + CONVERT(VARCHAR(10),d.nFolioPoliza) + ' de Diario.' ELSE   CR.cConcepto + ISNULL(' /Solicitud Origen: '+CAST(nFolioCaja AS NVARCHAR(10)),'')   END cconcepto
		, ctd.cTipoDocumento
		, o.TIPO_OPERACION
		, cc.cDescripcion
		, '' cnoEstimacion
		, '' periodo
		, 0 nPorcIva
		, dbo.fnCantidadLetra(CR.mImporteNeto) cantLetras
		, CR.ID_DESTINO_GASTO
		, CR.ID_DESTINO_GASTO  DESTINO_GASTO
		, ISNULL(isnull(cr.sFirmanteVoBo, (select NOMBREN + ' ' + NOMBREP+ ' ' + NOMBREM from v_empleados_giro  (nolock) where CLAVE = cr.nNumEmpleadoVoBo)), '-') sFirmanteVoBo
		, ISNULL(isnull(cr.sPuestoVoBo, (select DESCRIPCION_PUESTO from v_empleados_giro  (nolock) where CLAVE = cr.nNumEmpleadoVoBo)), '-') sPuestoVoBo
		, ISNULL(isnull(cr.sFirmanteAut, (select NOMBREN + ' ' + NOMBREP+ ' ' + NOMBREM from v_empleados_giro  (nolock) where CLAVE = cr.nNumEmpleadoAut)), '-') sFirmanteAut
		, ISNULL(isnull(cr.sPuestoAut, (select DESCRIPCION_PUESTO from v_empleados_giro  (nolock) where CLAVE = cr.nNumEmpleadoAut)), '-') sPuestoAut
		, ISNULL(isnull(cr.sFirmanteEla, (select NOMBREN + ' ' + NOMBREP+ ' ' + NOMBREM from v_empleados_giro  (nolock) where CLAVE =  (select cNumeroEmpleado from cg_usuario (NOLOCK) where U_LOGIN = cr.cIdUsuarioCaptura) )), '-') sFirmanteEla
		, ISNULL(isnull(cr.sPuestoEla, (select DESCRIPCION_PUESTO from v_empleados_giro  (nolock) where CLAVE =  (select cNumeroEmpleado from cg_usuario (NOLOCK) where U_LOGIN = cr.cIdUsuarioCaptura))), '-') sPuestoEla
		, '' AS cBoletoReservacion
		,0 mOtrosImpuestos
		, CASE WHEN max (rgDet.mImporteHospedaje) > 0 THEN max (rgDet.mImporteHospedaje)
			ELSE ISNULL(CCV.mHotel, 0) END AS ImporteHospedaje
		, nFolioCaja
		, CR.nFolioPoliza nPolizaAP
		, CR.CTAB CtaBanc
		,ISNULL((SELECT TOP 1 dBanco FROM dbo.tBeneficiarioCuentasBancarias WITH (NOLOCK) WHERE subCuentaBancaria = CR.CTAB),'') Banco
		, CR.cTipoPoliza
		, (select cUnidadEjecutora + ' - '+D_DESCRIPCION from tCatUnidadEjecutora  with(NOLOCK) where cUnidadEjecutora=CR.cUnidadResponsable)cUnidadResponsable
		, ben.CLAVE
		,@cTipoObra tipoPago
		,@nFolioPago noFolio
		,(select dbo.fn_tipoConceptoPago(@cTipoObra,@nFolioPago))tipoConcepto
		,(SELECT TIPO_CONCEPTO FROM dbo.CAT_TIPO_CONCEPTO WITH (NOLOCK) WHERE ID_TIPO_CONCEPTO =(select dbo.fn_tipoConceptoPago(@cTipoObra,@nFolioPago)))conceptoDescripcion
		,CASE WHEN ISNULL(CR.nFolioPolizaCancelacion,'')<>'' THEN 'Cancelada con la poliza #'+ CAST(CR.nFolioPolizaCancelacion  AS VARCHAR(6)) ELSE '' END polizaCancelacion
		,CASE WHEN CR.cDocumentoHaplicado IS NULL OR CR.cDocumentoHaplicado = '' THEN 'SIN APLICAR' WHEN CR.cDocumentoHaplicado IN ('C','N') THEN 'CANCELADA' ELSE '' END estatus
		, (SELECT ISNULL(SUM(mMontoNoComprobable),0) FROM dbo.tRelacionGastosNoComprobable WITH (NOLOCK) WHERE nFolioRelacionGastos = @nFolioPago) AS noComprobable
	into #tmp_TablaFinal
	from  trelaciongastosEncabezado CR with(NOLOCK)
		INNER JOIN tRELACIONGASTOSDetalle rgDet WITH(NOLOCK)
			ON CR.nFolioRELACIONGASTOS = rgDet.nFolioRELACIONGASTOS
		left join pCatalogoTipoDocumento ctd (nolock) on ctd.cIdTipoDocumento = cr.cIdTipoDocumento
		left join cat_tipo_operacion o (nolock) on o.id_tipo_oper=CR.TIPO_OPERACION and TO_TIPO_DOCTO=@cTipoObra
		left join tCatalogoCentroContable cc (nolock) on cc.cCentrocontable = cr.cCentroContable
		left join v_empleados_giro ben (nolock) on ben.RFC = CR.RFC
		LEFT JOIN dbo.tDocPolizaEncabezado d WITH (NOLOCK) ON CR.caNoContrarrecibo = cxp
		LEFT JOIN (SELECT DISTINCT cIDRFC, cnombre FROM v_PCATALOGORFC RFC (nolock)) RFC ON CR.RFC = RFC.cIDRFC
		LEFT JOIN tComisionComprobacion CCV WITH (NOLOCK) ON CR.nFolioRELACIONGASTOS = CCV.nFolioRelacion
	WHERE 
		 LTRIM(RTRIM(RFC.cIdRFC)) = LTRIM(RTRIM(CR.cIdRFC))
 		--and CR.canocontrarrecibo ='10CP2023103232'
  		 $P!{whereFolio}
	GROUP BY rfc.CNOMBRE , CR.ID_DESTINO_GASTO, nFolioCaja
		, CR.aEjercicioFiscal , CR.sFirmanteVoBo, CR.sFirmanteAut, CR.sFirmanteEla, CR.sPuestoAut, CR.sPuestoEla, CR.sPuestoVoBo
		, CR.cIdEntidadContable, cr.nNumEmpleadoVoBo, CR.nNumEmpleadoAut, CR.nNumEmpleadoElab
		, CR.caNoContrarrecibo,  cr.cIdUsuarioCaptura
		, CR.nFolioRELACIONGASTOS, CR.nFolioPoliza, CR.CTAB
		, CR.TIPO_OPERACION, CR.cTipoPoliza
		, CR.cIdRFC, ben.CLAVE, CR.nFolioPolizaCancelacion, CR.cDocumentoHaplicado
		, CR.mImporteMasIva 
		, CR.mImporteNeto 
		, CR.fProgramadaPago
		, CR.fAplicacion 
		, cxp, cr.cconcepto ,CONVERT(VARCHAR(10),d.nFolioPoliza) 
		, ctd.cTipoDocumento
		, o.TIPO_OPERACION
		, cc.cDescripcion
		, cr.cUnidadResponsable
		, CCV.mHotel
		


	IF (SELECT COUNT(*) FROM tPagoFirmanteDelagatorio WITH (NOLOCK) WHERE cTipoPago = @cTipoPago AND nFolioPago = @nFolioPago) > 0
		BEGIN

			SELECT TOP 1 @sFirmanteAut = sFirmanteAut 
			FROM #tmp_TablaFinal tablafinal WITH (NOLOCK)

			SELECT	@sFirmanteDelegatorio = ISNULL((cNombreTitular + ' ' + cApellidoPaternoTitular + ' ' + cApellidoMaternoTitular) , (NOMBREN + ' ' + NOMBREP + ' ' +  NOMBREM))
				, @sPuestoFirmanteDelegatorio = ISNULL(cPuestoTitular, CARGO)
				, @sOficio = cFolioOficio
				, @sFechaOficio = CONVERT(varchar(10), CONVERT(date, dFechaOficio, 106), 103)
				, @cTipoSuplencia = cTipoSuplencia
			FROM tPagoFirmanteDelagatorio pago WITH (NOLOCK)
			INNER JOIN tCatTipoSuplencia WITH (NOLOCK)
				ON pago.nTipoSuplencia = tCatTipoSuplencia.ntiposuplencia
			LEFT JOIN v_empleados_giro WITH (NOLOCK)
						ON clave = cNumeroEmpleado
			WHERE cTipoPago = @cTipoPago AND nFolioPago = @nFolioPago

			SET @sLeyenda = 'Firma ' + @cTipoSuplencia + ' de: ' + @sFirmanteAut + ', con fundamento en el oficio: ' + @sOficio + ', de fecha: ' + @sFechaOficio

		END

	DECLARE @sFirmanteDeleVoBo VARCHAR(250)
	DECLARE @sPuestoFirmanteDeleVoBo VARCHAR(70)
	DECLARE @sFirmanteVoBo VARCHAR(250)
	DECLARE @sLeyendaVoBo VARCHAR(500)
	DECLARE @sOficioVoBo VARCHAR(128)
	DECLARE @sFechaOficioVoBo VARCHAR(20)

	SET @sFirmanteDeleVoBo = ''
	SET @sPuestoFirmanteDeleVoBo = ''
	SET @sFirmanteVoBo = ''
	SET @sLeyendaVoBo = ''
	SET @sOficioVoBo = ''
	SET @sFechaOficioVoBo = ''

	IF (SELECT COUNT(*) FROM tPagoFirmanteDelegatorioVoBo WITH (NOLOCK) WHERE cTipoPago = @cTipoPago AND nFolioPago = @nFolioPago) > 0
			BEGIN

				SELECT TOP 1 @sFirmanteVoBo = sFirmanteVoBo 
				FROM #tmp_TablaFinal tablafinal WITH (NOLOCK)

				SELECT	@sFirmanteDeleVoBo = ISNULL((cNombreTitular + ' ' + cApellidoPaternoTitular + ' ' + cApellidoMaternoTitular) , (NOMBREN + ' ' + NOMBREP + ' ' +  NOMBREM))
					, @sPuestoFirmanteDeleVoBo = ISNULL(cPuestoTitular, CARGO)
					, @sOficioVoBo = cFolioOficio
					, @sFechaOficioVoBo = CONVERT(varchar(10), CONVERT(date, dFechaOficio, 106), 103)
					, @cTipoSuplencia = cTipoSuplencia
				FROM tPagoFirmanteDelegatorioVoBo WITH (NOLOCK)
				INNER JOIN tCatTipoSuplencia WITH (NOLOCK)
					ON tPagoFirmanteDelegatorioVoBo.ntipoSuplencia = tCatTipoSuplencia.ntiposuplencia
				LEFT JOIN v_empleados_giro WITH (NOLOCK)
						ON clave = cNumeroEmpleado
				WHERE cTipoPago = @cTipoPago AND nFolioPago = @nFolioPago

				SET @sLeyendaVoBo =  'Firma ' + @cTipoSuplencia + ' de: ' + @sFirmanteVoBo + ', con fundamento en el oficio: ' + @sOficioVoBo + ', de fecha: ' + @sFechaOficioVoBo

		END

	DECLARE @cConcepto_Comision VARCHAR(600)
	DECLARE @cInformeComision VARCHAR(600)
	DECLARE @cLugarFecha VARCHAR(240)
	DECLARE @ID_DESTINO_GASTO VARCHAR(10)
	DECLARE @nIdComision INT
	DECLARE @nEsAlimentacionBrigadistas INT

	SET @cInformeComision = ''
	SET @cLugarFecha = ''
	SET @ID_DESTINO_GASTO = ''
	SET	@nIdComision = 0
	SET @nEsAlimentacionBrigadistas = 0

	IF ((SELECT TOP 1 tipoPago FROM #tmp_TablaFinal WITH (NOLOCK) ) = 'RELGASTO')
		BEGIN
			SELECT @cInformeComision = (CASE WHEN cInformeComision = '' THEN '' ELSE 'Objeto e Informe: ' + cInformeComision END) 
			FROM tRELACIONGASTOSEncabezado WITH (NOLOCK)
			WHERE nFolioRELACIONGASTOS = @nFolioPago

			SET @ID_DESTINO_GASTO = (SELECT TOP 1 ID_DESTINO_GASTO FROM #tmp_TablaFinal WITH (NOLOCK) )
			SET	@nEsAlimentacionBrigadistas = (SELECT nEsAlimentacionBrigadistas FROM tRELACIONGASTOSEncabezado WITH (NOLOCK) WHERE nFolioRELACIONGASTOS = @nFolioPago )
			SET	@nIdComision = (SELECT nIdComision FROM tRELACIONGASTOSEncabezado WITH (NOLOCK) WHERE nFolioRELACIONGASTOS = @nFolioPago )
			
			IF (@nIdComision > 0)
				BEGIN
							SELECT DISTINCT @cLugarFecha = ( 'Lugar y periodo de la comisión: ' + ISNULL(ISNULL(MPO_NOMBRE,'') + ', ' + EDO_NOMBRE + ', '+ UPPER(cPais)
															+ ' DEL ' +CONVERT( VARCHAR(12),fInicio,103)+ ' AL '
															+ CONVERT(VARCHAR(12), fFin ,103 ),''))
										  , @cConcepto_Comision =  'Nombre de la comisión:  ' + isnull(COMISION.cConcepto_Comision, '')
								FROM dbo.tViaticosComisiones COMISION WITH (NOLOCK)
								INNER JOIN dbo.tCatalogoPaises PAIS WITH (NOLOCK)
									ON COMISION.nIdPais = PAIS.nIdPais
								INNER JOIN CAT_ESTADOS ESTADO WITH (NOLOCK)
									ON ESTADO.ID_ESTADO = COMISION.ID_ESTADO
								LEFT JOIN dbo.CAT_MUNICIPIO MPIO WITH (NOLOCK)
									ON COMISION.ID_MUNICIPIO = MPIO.ID_MUNICIPIO
								WHERE COMISION.nIdComision = @nIdComision
				END
			ELSE IF (@nEsAlimentacionBrigadistas = 1)
				BEGIN
					SET @cLugarFecha = 'Lugar y periodo de la comisión: Observar Objeto e Informe.'
				END
		END

	DECLARE @cTipoDePagoSol VARCHAR(20)


	SET @cInformeComision = LTRIM(RTRIM(@cInformeComision + ' ' + ISNULL((	SELECT CASE WHEN COUNT(*) > 0 THEN cconcepto ELSE '' END 
																FROM tRELACIONGASTOSDetalle WITH (NOLOCK) 
																inner join #tmp_TablaFinal (nolock) tbl
																on tbl.noFolio = tRELACIONGASTOSDetalle.nFolioRELACIONGASTOS
																WHERE SUBSTRING(ep, 32, 5) = '38501'
																GROUP BY cconcepto ), '')))
		
	DECLARE @esSaiAmbiental varchar(10)

	SET @esSaiAmbiental = (SELECT GP_VALOR FROM  CG_GRUPO_PROPIEDADES WHERE GP_NOMBRE LIKE '%SAI_AMBIENTAL%')

	SELECT *
		, CASE WHEN (cIdRFC = 'BMN930209927')
				THEN ISNULL((	SELECT CASE WHEN pagofederalizado.nidprograma IS NOT NULL 
											THEN 'Programa: ' + pagofederalizado.nidprograma + ' - ' + fideicomiso.cprograma 
											ELSE '' 
									   END AS Programa
								FROM tRELACIONGASTOSEncabezado pagofederalizado WITH (NOLOCK)
								INNER JOIN tfideicomiso fideicomiso WITH (NOLOCK) 
									ON (fideicomiso.id = pagofederalizado.nidprograma and fideicomiso.nidprograma = pagofederalizado.cUnidadResponsable)
								WHERE pagofederalizado.nFolioRELACIONGASTOS = noFolio), '')
				ELSE '' 
		   END AS Programa
		, CASE WHEN (cIdRFC = 'BMN930209927')
				THEN ISNULL((	SELECT CASE WHEN pagofederalizado.cSubPrograma IS NOT NULL 
											THEN 'SubPrograma: ' + pagofederalizado.cSubPrograma + ' - ' + programafideicomiso.cdescsubprograma 
											ELSE '' 
										END AS SubPrograma
								FROM tRELACIONGASTOSEncabezado pagofederalizado WITH (NOLOCK)
								INNER JOIN tprogramafideicomiso programafideicomiso WITH (NOLOCK)
										ON ( programafideicomiso.id = pagofederalizado.nidprograma AND programafideicomiso.csubprograma = pagofederalizado.cSubPrograma)
								WHERE pagofederalizado.nFolioRELACIONGASTOS = noFolio), '')
				ELSE '' 
		  END AS SubPrograma
		, @sFirmanteDelegatorio AS sFirmanteDelegatorio
		, @sPuestoFirmanteDelegatorio AS sPuestoFirmanteDelegatorio
		, @sLeyenda AS Leyenda
		, @cInformeComision AS cInformeComision
		, @sFirmanteDeleVoBo AS sFirmanteDeleVoBo
		, @sPuestoFirmanteDeleVoBo AS sPuestoFirmanteDeleVoBo
		, @sLeyendaVoBo AS LeyendaVoBo
		, @cLugarFecha AS cLugarFecha
    	, @cConcepto_Comision as cConcepto_Comision
    	, @esSaiAmbiental as saiAmbiental
	FROM #tmp_TablaFinal  tablafinal WITH (NOLOCK)
	

	IF (SELECT OBJECT_ID('tempdb..#tmp_TablaFinal')) 	IS NOT NULL	DROP TABLE #tmp_TablaFinal]]>
	</queryString>
	<field name="CNOMBRE2" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="CNOMBRE2"/>
		<property name="com.jaspersoft.studio.field.label" value="CNOMBRE2"/>
	</field>
	<field name="aEjercicioFiscal" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="aEjercicioFiscal"/>
		<property name="com.jaspersoft.studio.field.label" value="aEjercicioFiscal"/>
	</field>
	<field name="cIdEntidadContable" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="cIdEntidadContable"/>
		<property name="com.jaspersoft.studio.field.label" value="cIdEntidadContable"/>
	</field>
	<field name="caNoContrarrecibo" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="caNoContrarrecibo"/>
		<property name="com.jaspersoft.studio.field.label" value="caNoContrarrecibo"/>
	</field>
	<field name="cIdDocumento" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="cIdDocumento"/>
		<property name="com.jaspersoft.studio.field.label" value="cIdDocumento"/>
	</field>
	<field name="cIdTipoDocumento" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="cIdTipoDocumento"/>
		<property name="com.jaspersoft.studio.field.label" value="cIdTipoDocumento"/>
	</field>
	<field name="cIdTipoOperacion" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="cIdTipoOperacion"/>
		<property name="com.jaspersoft.studio.field.label" value="cIdTipoOperacion"/>
	</field>
	<field name="cIdRFC" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="cIdRFC"/>
		<property name="com.jaspersoft.studio.field.label" value="cIdRFC"/>
	</field>
	<field name="cIdTipoMoneda" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="cIdTipoMoneda"/>
		<property name="com.jaspersoft.studio.field.label" value="cIdTipoMoneda"/>
	</field>
	<field name="nTipoCambio" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="nTipoCambio"/>
		<property name="com.jaspersoft.studio.field.label" value="nTipoCambio"/>
	</field>
	<field name="mImporteBruto" class="java.math.BigDecimal">
		<property name="com.jaspersoft.studio.field.name" value="mImporteBruto"/>
		<property name="com.jaspersoft.studio.field.label" value="mImporteBruto"/>
	</field>
	<field name="mImporteSancion" class="java.math.BigDecimal">
		<property name="com.jaspersoft.studio.field.name" value="mImporteSancion"/>
		<property name="com.jaspersoft.studio.field.label" value="mImporteSancion"/>
	</field>
	<field name="mimporteDevolucion" class="java.math.BigDecimal">
		<property name="com.jaspersoft.studio.field.name" value="mimporteDevolucion"/>
		<property name="com.jaspersoft.studio.field.label" value="mimporteDevolucion"/>
