	<parameter name="whereFolio" class="java.lang.String">
		<defaultValueExpression><![CDATA["and CR.canocontrarrecibo ='10CP2012000693'"]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["C:/Users/ULISES/Workspaces/CONAFOR/sai/WebContent/Reportes"]]></defaultValueExpression>
