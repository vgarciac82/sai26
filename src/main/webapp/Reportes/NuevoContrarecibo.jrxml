	<queryString>
		<![CDATA[DECLARE @laPoliza varchar(10)
DECLARE @cUnidadResponsable varchar(10)
DECLARE @cTipoPoliza varchar(10)
DECLARE @cTipoObra varchar(10)
DECLARE @cIdTipoPago varchar(1)
declare @cuantos smallint
DECLARE @noFolio INT


select @noFolio = nFolioPagoDirecto, @laPoliza= nFolioPoliza, @cTipoPoliza = cTipoPoliza
, @cUnidadResponsable = cIDEntidadContable, @cTipoObra = tipoObra, @cIdTipoPago = cIdTipoPagoDirecto
	from (select nFolioPagoDirecto, nFolioPoliza, cTipoPoliza, cconcepto, canocontrarrecibo
		,'DIRECTO' tipoObra, cUnidadResponsable, cast('' as varchar(5)) cnoEstimacion, '' Periodo, cIdEntidadContable, cIdTipoPagoDirecto
		from tpagodirectoencabezado e with(NOLOCK)
		union
		select nFolioRELACIONGASTOS,nFolioPoliza, cTipoPoliza, cconcepto, canocontrarrecibo,'RELGASTO' tipoObra
		, cUnidadResponsable, cast('' as varchar(5)) cnoEstimacion, '' Periodo, cCentroContable cIdEntidadContable, TIPO_OPERACION
		from trelaciongastosencabezado e with(NOLOCK) ) CR where 1 = 1
 $P!{whereFolio}
 --and CR.canocontrarrecibo ='10CT2014000003'
--las de mayor
if exists(select 1 from sysobjects where name = '#tmp_detalle2') drop table  #tmp_detalle2
if exists(select 1 from sysobjects where name = '#tmp_polizapagos') drop table  #tmp_polizapagos
if exists(select 1 from sysobjects where name = '#tmp_detalle') drop table  #tmp_detalle

--drop table #tmp_detalle
--drop table #tmp_detalle2
select * into #tmp_detalle from (select ep, count(distinct ep) numReg from tpagodirectodetalle with(NOLOCK) where nfoliopagodirecto in (select nfoliopagodirecto from tpagodirectoencabezado cr with(NOLOCK) where 1 = 1
--and CR.canocontrarrecibo ='10CP2012000042'
  $P!{whereFolio}
  --and CR.canocontrarrecibo ='10CT2014000003'
) group by ep
union
select ep, count(distinct ep) numReg  from trelaciongastosdetalle with(NOLOCK) where nfoliorelaciongastos in (select nfoliorelaciongastos from trelaciongastosencabezado cr with(NOLOCK) where 1 = 1
--and CR.canocontrarrecibo ='10CP2012000042'
  $P!{whereFolio}
  --and CR.canocontrarrecibo ='10CT2014000003'
) group by ep) m


select
rfc.CNOMBRE CNOMBRE2,
 CR.aEjercicioFiscal, CR.cIdEntidadContable, CR.caNoContrarrecibo, CR.cIdDocumento, CR.cIdTipoDocumento, CR.cIdSubtipoDocumento
, CR.cIdTipoOperacion, CR.caNoAP, CR.nPolizaAP, CR.cIdRFC, CR.cIdTipoMoneda, CR.nTipoCambio, cast(CR.mImporteBruto as decimal(17,2)) mImporteBruto ,
cast(CR.mImporteSancion as decimal(17,2)) mImporteSancion ,
cast(CR.mImporteDevolucion as decimal(17,2)) mImporteDevolucion ,
cast(CR.mAmortizacionAnticipo as decimal(17,2)) mAmortizacionAnticipo ,
cast(CR.mImporteIVA as decimal(17,2)) mImporteIVA ,
cast(CR.mImporteRetencion as decimal(17,2)) mImporteRetencion ,
cast(CR.mImportePenalizacion as decimal(17,2)) mImportePenalizacion ,
cast(CR.mImporteNeto as decimal(17,2)) mImporteNeto , convert(varchar(10),CR.fProgramadaPago,103) fProgramadaPago, convert(varchar(10), CR.fValidacionDisponible, 103) fValidacionDisponible, CR.lEsCandidatoCP, CR.lHaySubpartidaExcluidaCP, CR.cIdTipoCLCSiaff, CR.cIdLeyendaSiaff, CR.cReferencia1, CR.nEsSubsidio, convert(varchar(10), CR.fRegistro, 103) fRegistro, CR.cIdEstadoReintegro, CR.cIdTipoReclasificacion, CR.fAplicacionSiaff, CR.fPagoSiaff, CR.cIdEstadoContrarrecibo, m.cconcepto
--, cidtipooperacion
, ctd.cTipoDocumento, TIPO_OPERACION, cc.cDescripcion, m.cUnidadResponsable, cnoEstimacion, periodo
--, pp.*, case when cTipoMovimiento = 'C' then mMovimiento2 else 0 end Debe, case when cTipoMovimiento = 'A' then mMovimiento2 else 0 end Haber
, cast(m.nPorcIva*100 as decimal(10,2)) nPorcIva
, (SELECT min(EP) FROM #tmp_detalle with(NOLOCK)) laEP
, (SELECT sum(numReg) FROM #tmp_detalle with(NOLOCK)) numReg
,dbo.fnCantidadLetra(CR.mImporteNeto) cantLetras, m.ID_DESTINO_GASTO
, m.sFirmanteVoBo, m.sPuestoVoBo, m.sFirmanteAut, m.sPuestoAut
into #tmp_detalle2
from  tcontrarrecibo CR with(NOLOCK)
left join pCatalogoTipoDocumento ctd on ctd.cIdTipoDocumento = cr.cIdTipoDocumento
left join cat_tipo_operacion o on o.id_tipo_oper=@cIdTipoPago and TO_TIPO_DOCTO=@cTipoObra
left join tCatalogoCentroContable cc on cc.cCentrocontable = cr.cIdEntidadContable
left join tPagoDirectoEncabezado tPDEnc on CR.caNoContrarrecibo = tPDEnc.caNoContrarrecibo
, v_PCATALOGORFC RFC, (
 select 0 nPorcIva, cconcepto, canocontrarrecibo,'OBRA' tipoObra, cUnidadResponsable, cast(cnoEstimacion as varchar(5)) cnoEstimacion, 'Del ' + case when fperiodode is null then '' else convert(varchar(10), fperiodode, 103) end + ' al ' + case when fperiodohasta is null then '' else convert(varchar(10), fperiodohasta, 103) end Periodo, ID_DESTINO_GASTO, '-' sFirmanteVoBo, '-' sPuestoVoBo, '-' sFirmanteAut, '-' sPuestoAut
   from tPagoObraencabezado e
union select nPorcIva, cconcepto, canocontrarrecibo,'DIRECTO' tipoObra, cUnidadResponsable, cast('' as varchar(5)) cnoEstimacion, '' Periodo, ID_DESTINO_GASTO, sFirmanteVoBo, sPuestoVoBo, sFirmanteAut, sPuestoAut
   from tpagodirectoencabezado e
union select 0.0 nPorcIva, cconcepto, canocontrarrecibo,'NOMINA' tipoObra, cUnidadResponsable, cast('' as varchar(5)) cnoEstimacion, '' Periodo, ID_DESTINO_GASTO, '-' sFirmanteVoBo, '-' sPuestoVoBo, '-' sFirmanteAut, '-' sPuestoAut
   from tnominaencabezado e
union select 0 nPorcIva, cconcepto, canocontrarrecibo,'DIVERSO' tipoObra, cUnidadResponsable, cast('' as varchar(5))   cnoEstimacion, '' Periodo, ID_DESTINO_GASTO, sFirmanteVoBo, sPuestoVoBo, sFirmanteAut, sPuestoAut
from tPagoDiversoEncabezado e
union select 0 nPorcIva, cconcepto, canocontrarrecibo,'RELGASTO' tipoObra, cUnidadResponsable, cast('' as varchar(5)) cnoEstimacion, '' Periodo, ID_DESTINO_GASTO, sFirmanteVoBo, sPuestoVoBo, sFirmanteAut, sPuestoAut
  from trelaciongastosencabezado e
) m  WHERE o.to_tipo_docto =tipoobra and LTRIM(RTRIM(RFC.cIdRFC)) = LTRIM(RTRIM(CR.cIdRFC))
and m.canocontrarrecibo = cr.canocontrarrecibo
$P!{whereFolio}
--   and CR.canocontrarrecibo ='10CP2012000042'
   --and CR.canocontrarrecibo ='10CT2014000003'


DECLARE @strFacturas VARCHAR(500) = ''
DECLARE @fact VARCHAR(50)
DECLARE @imp VARCHAR(500)
DECLARE facturas CURSOR FOR SELECT cfactura,mImporteBruto FROM tPagoFactura WHERE cTipoPago LIKE '%'+@cTipoObra AND nFolioPago=@noFolio
OPEN facturas
	FETCH NEXT FROM facturas INTO @fact,@imp
	WHILE @@FETCH_STATUS = 0
	BEGIN
		SET @strFacturas +='Folio: '+@fact+' Importe $'+@imp+ '   '
		FETCH NEXT FROM facturas INTO @fact,@imp
	END
CLOSE facturas
DEALLOCATE facturas


select MAX(CNOMBRE2) CNOMBRE2, aEjercicioFiscal, cIdEntidadContable, caNoContrarrecibo, cIdDocumento
, cIdTipoDocumento, cIdSubtipoDocumento, cIdTipoOperacion, caNoAP, @laPoliza nPolizaAP, cIdRFC, cIdTipoMoneda
, nTipoCambio, mImporteBruto, mImporteSancion, mImporteDevolucion, mAmortizacionAnticipo, mImporteIVA, mImporteRetencion
, mImportePenalizacion, mImporteNeto, fProgramadaPago, fValidacionDisponible, lEsCandidatoCP, lHaySubpartidaExcluidaCP
, cIdTipoCLCSiaff, cIdLeyendaSiaff, cReferencia1, nEsSubsidio, fRegistro, cIdEstadoReintegro, cIdTipoReclasificacion
, fAplicacionSiaff, fPagoSiaff, cIdEstadoContrarrecibo, cconcepto, cTipoDocumento, TIPO_OPERACION, cDescripcion
, cUnidadResponsable, cnoEstimacion, periodo
,laEP
--, Cuenta
--, subCuenta
--, isnull(subSubCuenta, '') subSubCuenta
--, ctipomovimiento
--, calmacen
--, isnull(dCuenta, '') dCuenta
--, nCuenta
--, max(cnombre) CNOMBRE
--, max(isnull(descripcion, '')) descripcion
--, max(mMovimiento2) mMovimiento2
--, sum(Debe) Debe
--, sum(Haber) Haber
, max(nPorcIva) nPorcIva
, max(numReg) numReg
, max(cantLetras) cantLetras, @cTipoPoliza AS cTipoPoliza
, CAT_DESTINO_GASTO.ID_DESTINO_GASTO, DESTINO_GASTO
, isnull(sFirmanteVoBo, '') sFirmanteVoBo, isnull(sPuestoVoBo,'') sPuestoVoBo, isnull(sFirmanteAut,'') sFirmanteAut
, isnull(sPuestoAut,'') sPuestoAut,
@strFacturas Facturas
 from #tmp_detalle2 with(NOLOCK), CAT_DESTINO_GASTO
 where #tmp_detalle2.ID_DESTINO_GASTO = CAT_DESTINO_GASTO.ID_DESTINO_GASTO
 group by aEjercicioFiscal, cIdEntidadContable, caNoContrarrecibo, cIdDocumento, cIdTipoDocumento
 , cIdSubtipoDocumento, cIdTipoOperacion, caNoAP, nPolizaAP, cIdRFC, cIdTipoMoneda, nTipoCambio
 , mImporteBruto, mImporteSancion, mImporteDevolucion, mAmortizacionAnticipo, mImporteIVA, mImporteRetencion
 , mImportePenalizacion, mImporteNeto, fProgramadaPago, fValidacionDisponible, lEsCandidatoCP, lHaySubpartidaExcluidaCP
 , cIdTipoCLCSiaff, cIdLeyendaSiaff, cReferencia1, nEsSubsidio, fRegistro, cIdEstadoReintegro, cIdTipoReclasificacion
 , fAplicacionSiaff, fPagoSiaff, cIdEstadoContrarrecibo, cconcepto, cTipoDocumento, TIPO_OPERACION, cDescripcion
 , cUnidadResponsable, cnoEstimacion, periodo
 ,laEP
--, Cuenta
--, subCuenta
--, subSubCuenta
--, ctipomovimiento
-- ,calmacen
--, dCuenta
--, nCuenta
, CAT_DESTINO_GASTO.ID_DESTINO_GASTO, DESTINO_GASTO
, sFirmanteVoBo, sPuestoVoBo, sFirmanteAut, sPuestoAut
--order by
--ncuenta, cuenta desc, subcuenta desc,
 --subsubcuenta
 --, ctipomovimiento desc


if exists(select 1 from sysobjects where name = '#tmp_detalle2') drop table  #tmp_detalle2
if exists(select 1 from sysobjects where name = '#tmp_polizapagos') drop table  #tmp_polizapagos
if exists(select 1 from sysobjects where name = '#tmp_detalle') drop table  #tmp_detalle]]>
	</queryString>
