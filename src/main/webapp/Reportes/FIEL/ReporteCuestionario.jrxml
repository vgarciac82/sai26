	<subDataset name="Table Dataset 1" uuid="7a1aa722-00ea-4fed-80e6-ac834635fbdd"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="cIdSolicitud" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[
select req.cidsolicitud, req.nIdPregunta, cRespuesta, uLogin, convert(varchar,fCuestionario,103)  fCuestionario, cPregunta, cActionYes, cActionNo
		, dbo.Fn_Mayusc_Formato( usu.U_NOMBRE) U_NOMBRE
		, ISNULL( dbo.Fn_Mayusc_Formato(DESCRIPCION_PUESTO), '') DESCRIPCION_PUESTO, fiel.cAplica15D
        , case when cRespuesta = 'N' then 'No' else 'Si' end respuesta
        from tCuestionarioRequisicion req (nolock)
        inner join tCuestionarioContratacion cont (nolock)
        on req.nIdPregunta = cont.nIdPregunta
		inner join tCuestionarioRequisicionFIEL fiel (nolock)
		on req.cIdSolicitud = fiel.cIdSolicitud
        inner join CG_USUARIO  usu (nolock)
        on usu.U_LOGIN = req.uLogin
		left join v_empleados_giro emp (nolock)
		on usu.cNumeroEmpleado = emp.CLAVE
        where req.cIdSolicitud = $P!{cIdSolicitud}]]>
	</queryString>
