					<font isBold="true"/>
				</textElement>
				<text><![CDATA[Gerente de Recursos Materiales]]></text>
			</staticText>
			<textField>
				<reportElement x="0" y="51" width="190" height="13" isPrintWhenDetailOverflows="true" uuid="4168f0b2-bec4-46c4-9d9c-7e327ef6c565">
