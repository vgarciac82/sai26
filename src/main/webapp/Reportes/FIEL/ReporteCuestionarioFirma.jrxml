	<subDataset name="Table Dataset 1" uuid="c5c94599-553e-4012-8bf7-97b8fe09038a"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="cIdSolicitud" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select req.cidsolicitud, req.nIdPregunta, cRespuesta, uLogin, convert(varchar,fCuestionario,103)  fCuestionario, cPregunta, cActionYes, cActionNo
		, dbo.Fn_Mayusc_Formato( usu.U_NOMBRE) U_NOMBRE
		, ISNULL( dbo.Fn_Mayusc_Formato(DESCRIPCION_PUESTO), '') DESCRIPCION_PUESTO, fiel.cAplica15D
        , case when cRespuesta = 'N' then 'No' else 'Si' end respuesta
		, cat.cNombre + ' ' + cat.cPaterno + ' ' + cat.cMaterno NombreFirmante, cPuesto puestoFirmante
        from tCuestionarioRequisicion req (nolock)
        inner join tCuestionarioContratacion cont (nolock)
        on req.nIdPregunta = cont.nIdPregunta
		inner join tCuestionarioRequisicionFIEL fiel (nolock)
		on req.cIdSolicitud = fiel.cIdSolicitud
        inner join CG_USUARIO  usu (nolock)
        on usu.U_LOGIN = req.uLogin
		left join v_empleados_giro emp (nolock)
		on usu.cNumeroEmpleado = emp.CLAVE
		inner join  mSolicitudFirmantes sol (nolock)
		on sol.cIdSolicitud = req.cidsolicitud
		inner join mCatalogoFirmantes cat (nolock)
		on sol.nIdFirmante = cat.nIdFirmante and sol.cIdUnidadEjecutora = cat.cIdUnidadEjecutora
        where req.cIdSolicitud = $P!{cIdSolicitud}]]>
	</queryString>
	<field name="U_NOMBRE" class="java.lang.String"/>
	<field name="cPregunta" class="java.lang.String"/>
	<field name="fCuestionario" class="java.lang.String"/>
	<field name="respuesta" class="java.lang.String"/>
	<field name="uLogin" class="java.lang.String"/>
	<field name="cIdSolicitud" class="java.lang.String"/>
	<field name="DESCRIPCION_PUESTO" class="java.lang.String"/>
	<field name="cAplica15D" class="java.lang.String"/>
	<field name="puestoFirmante" class="java.lang.String"/>
	<field name="NombreFirmante" class="java.lang.String"/>
	<group name="Nivel4">
		<groupExpression><![CDATA[]]></groupExpression>
		<groupFooter>
			<band height="156">
				<staticText>
					<reportElement x="37" y="5" width="450" height="116" uuid="4f64694a-c000-4331-8352-1d61c50b5197">
						<printWhenExpression><![CDATA[$F{cAplica15D}.equals( "S" )]]></printWhenExpression>
					</reportElement>
					<textElement textAlignment="Justified">
						<font fontName="Arial" size="9"/>
					</textElement>
					<text><![CDATA[Derivado a que te aplica el art 15D deberas contar en tu expediente de seguimiento al contrato con la siguiente documentación complementaria :
•   Registro a que se refiere el artículo 15 de la Ley federal del trabajo,
•   Copia de los comprobantes fiscales por concepto de pago de salarios de los trabajadores con los que le
    hayan proporcionado el servicio o ejecutado la obra correspondiente
•  Recibo de pago expedido por institución bancaria por la declaración de entero de las retenciones de
    impuestos efectuadas a dichos trabajadores
•  Pago de las cuotas obrero-patronales al Instituto Mexicano del Seguro Social, así como del pago de las
    aportaciones al Instituto del Fondo Nacional de la Vivienda para los Trabajadores
•  Copia de la declaración del impuesto al valor agregado y del acuse de recibo del pago correspondiente al
    periodo en que el contratante efectuó el pago de la contraprestación y del impuesto al valor agregado que le
    fue trasladado.
]]></text>
				</staticText>
				<line>
					<reportElement x="20" y="129" width="493" height="1" uuid="99d260c6-d093-4871-b00a-eda02bec93e8">
						<printWhenExpression><![CDATA[$F{cAplica15D}.equals( "S" )]]></printWhenExpression>
					</reportElement>
				</line>
				<line>
					<reportElement x="496" y="50" width="1" height="106" uuid="1e73abe9-eb2b-4a62-8e94-2acfdd63dbc7">
						<printWhenExpression><![CDATA[$F{cAplica15D}.equals( "S" )]]></printWhenExpression>
					</reportElement>
				</line>
			</band>
		</groupFooter>
	</group>
