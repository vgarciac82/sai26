	<parameter name="cIdContrato" class="java.lang.String">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select 
 ccvecontrato contrato
 ,case when noestimacion='0' then 'Anticipo' else noestimacion end noestimacion
 ,1 nCantidad ,convert(varchar,mmontoestimacion,103 )mmontoestimacion 
 ,convert(varchar,mMontoEstimacionIva,103 ) mMontoEstimacionIva
 ,convert(varchar,mMontoEstimacionMasIva,103 ) mMontoEstimacionMasIva 
 ,convert(varchar,mMontoEstimacionAmortizado,103 ) mMontoEstimacionAmortizado
 ,convert(varchar,mMontoEstimacionRetencion,103 ) mMontoEstimacionRetencion
 from tobrapublicaavancefisico with(Nolock)
 where ccvecontrato=$P{cIdContrato} and noestimacion=$P{nEstimacion}]]>
	</queryString>
