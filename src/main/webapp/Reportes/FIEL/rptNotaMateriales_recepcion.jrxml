	<queryString>
		<![CDATA[select recepcion.* from mRecepcionConDescripcion recepcion (nolock)
inner join tNotaAutorizaRM nota (nolock)
on recepcion.cIdRecepMat = nota.cIDRecepMat and recepcion.cIdpedContDef = nota.cIDContratoDefinitivo
 where nota.cIdRecepMat =  $P{cIdRecepMat} and recepcion.cIdpedContDef = $P{cIdpedContDef}]]>
