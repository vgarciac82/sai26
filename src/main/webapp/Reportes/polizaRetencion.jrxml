<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="polizaRetenciones" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="2719c276-8051-4fd3-956e-9398593f3508">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="194"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<parameter name="whereFolio" class="java.lang.String">
		<defaultValueExpression><![CDATA["and ce.nFolioRetencion= 4"]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[DECLARE @nFolioPago INT
DECLARE @cTipoPago VARCHAR(64)
DECLARE @sFirmanteDelegatorio VARCHAR(250)
DECLARE @sPuestoFirmanteDelegatorio VARCHAR(70)
DECLARE @sFirmanteAut VARCHAR(250)
DECLARE @sLeyenda VARCHAR(500)
DECLARE @sOficio VARCHAR(128)
DECLARE @sFechaOficio VARCHAR(20)
DECLARE @cTipoSuplencia VARCHAR(20)

SET @cTipoPago = 'RETENCION'

SET	@sFirmanteDelegatorio = ''
SET @sPuestoFirmanteDelegatorio = ''

SET @sFirmanteAut = ''
SET @sLeyenda = ''
SET @sOficio = ''
SET @sFechaOficio = ''

select
ce.nFolioRetencion
,ce.fCarga
,ce.faplicacion
,sum(cd.mimporte) mimporte
,isnull(cd.rfc,'No Aplica')rfc
,isnull(tb.dNombre+' '+tb.dApellidoPaterno+' '+tb.dApellidoMaterno,'No Aplica') as nombreRFC
,ce.cdescripcionpoliza
,coalesce((select ISNULL(NOMBREN,'') + ' ' + ISNULL(NOMBREP,'')+ ' '+ ISNULL(NOMBREM,'')  from v_empleados_giro where clave = nnumEmpleadoVobo),'Firmante No Agregado') sFirmanteVoBo
,coalesce((select descripcion_puesto from v_empleados_giro where clave = nnumEmpleadoVobo),'Puesto No Agregado')sPuestoVoBo
,coalesce((select ISNULL(NOMBREN,'') + ' ' + ISNULL(NOMBREP,'')+ ' '+ ISNULL(NOMBREM,'')  from v_empleados_giro where clave = nnumEmpleadoAut),'Firmante No Agregado')sFirmanteAut
,coalesce((select  descripcion_puesto from v_empleados_giro where clave = nnumEmpleadoAut),'Puesto No Agregado') sPuestoAut
,cd.cevento+' '+ev.dEvento as cevento
,ce.ccentrocontable
,(select cDescripcion from tCatalogoCentroContable as ccc WHERE ccc.cCentroContable=ce.ccentrocontable) dCENTROCONTABLE
,ce.cUnidadResponsable+' '+ue.D_DESCRIPCION as cunidadejecutora
,dbo.fnCantidadLetra(sum(cd.mimporte)) cantLetras
, SUM(mObra5) mObra5
, SUM(mImporteFlete4) mImporteFlete4
, SUM(mISRHonorarios) mISRHonorarios
, SUM(mISRArrenda) mISRArrenda
, SUM(mISROtros) mISROtros
, SUM(mImporteIvaHonorarios) mImporteIvaHonorarios
, SUM(mImporteIvaArrenda) mImporteIvaArrenda
, SUM(mImporteISRLaudos) mImporteISRLaudos
, SUM(mimporteISRResico) mimporteISRResico
, SUM(ISNULL(mPenalizacion, 0) ) mPenalizacion
INTO #tmpTablaSalida
from tRetencionEncabezado as ce with(NOLOCK)
inner join tRetencionDetalle as cd with(NOLOCK) on ce.nFolioRetencion=cd.nFolioRetencion
inner join tCatUnidadEjecutora as ue with(nolock) on ue.cUnidadEjecutora=ce.cUnidadResponsable
inner join tEvento as ev with(nolock) on cd.cEvento=ev.cEvento
left join tBeneficiario as tb with(NOLOCK) on cd.rfc=tb.dRFC
where  1=1
$P!{whereFolio}
GROUP BY ce.nFolioRetencion
,ce.fCarga, ce.cUnidadResponsable, ue.D_DESCRIPCION
,ce.faplicacion, cd.rfc,tb.dNombre, tb.dApellidoPaterno, tb.dApellidoMaterno, ce.cdescripcionpoliza
,cd.cevento, ev.dEvento 
,ce.ccentrocontable, nnumEmpleadoVobo, nnumEmpleadoAut


SELECT TOP 1 @nFolioPago = nFolioRetencion FROM #tmpTablaSalida WITH (NOLOCK)

	IF (SELECT COUNT(*) FROM tPagoFirmanteDelagatorio WITH (NOLOCK) WHERE cTipoPago = @cTipoPago AND nFolioPago = @nFolioPago) > 0
		BEGIN
	SELECT TOP 1 @sFirmanteAut = sFirmanteAut FROM #tmpTablaSalida WITH (NOLOCK)

	SELECT	@sFirmanteDelegatorio =
		ISNULL((cNombreTitular + ' ' + cApellidoPaternoTitular + ' ' + cApellidoMaternoTitular)
				,(emp.NOMBREN + ' ' + emp.NOMBREP+ ' ' + emp.NOMBREM)  ),
			@sPuestoFirmanteDelegatorio = ISNULL(cPuestoTitular, DESCRIPCION_PUESTO)
			, @sOficio = cFolioOficio, @sFechaOficio = dFechaOficio
			, @cTipoSuplencia = cTipoSuplencia
			FROM tPagoFirmanteDelagatorio pago WITH (NOLOCK)
			INNER JOIN tCatTipoSuplencia WITH (NOLOCK)
				ON pago.nTipoSuplencia = tCatTipoSuplencia.ntiposuplencia
			INNER JOIN dbo.v_empleados_giro emp (NOLOCK)
				ON emp.CLAVE = pago.cNumeroEmpleado
			WHERE cTipoPago = @cTipoPago AND nFolioPago = @nFolioPago

		SET @sLeyenda = 'Firma ' + @cTipoSuplencia + ' de: ' + @sFirmanteAut + ', con fundamento en el oficio: ' + @sOficio + ' de fecha: ' + @sFechaOficio + '.'
		END

	SELECT *, @sFirmanteDelegatorio AS sFirmanteDelegatorio, @sPuestoFirmanteDelegatorio AS sPuestoFirmanteDelegatorio, @sLeyenda AS sLeyenda
	FROM #tmpTablaSalida WITH (NOLOCK)

IF (SELECT OBJECT_ID('tempdb..#tmpTablaSalida')) IS NOT NULL	DROP TABLE #tmpTablaSalida]]>
	</queryString>
