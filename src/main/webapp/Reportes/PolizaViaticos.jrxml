	<parameter name="idComision" class="java.lang.String"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT NOMBREN + ' ' + NOMBREP + ' '  + NOMBREM NombreCompleto
, RFC , CLAVE, NIVEL,DESCRIPCION_PUESTO, UNIDAD,cUejecutora
, isnull(mTotalAgenda,0) mTotalAgenda
, isnull(mTotalTransporte,0) mTotalTransporte, CTAB
, isnull(mTotalAgenda,0) + isnull(mTotalTransporte,0) total
, dbo.fnCantidadLetra( isnull(mTotalAgenda,0) + isnull(mTotalTransporte,0) ) cantLetraTotal
, nIdComision
, ISNULL(dbo.fn_diasNacional (comision.nidEmpleado, nIdComision), 0) diasNacional
, ISNULL(dbo.fn_diasInternacional (comision.nidEmpleado, nIdComision),0) diasInter
, ISNULL(dbo.fn_diasPendientes( comision.nidEmpleado, nIdComision ),0)	diasPendientes
, ISNULL(dbo.fn_diasNacional (comision.nidEmpleado, nIdComision), 0) + 
ISNULL(dbo.fn_diasInternacional (comision.nidEmpleado, nIdComision),0) + 
ISNULL(dbo.fn_diasPendientes( comision.nidEmpleado, nIdComision),0) totalDias
 FROM tComision COMISION (NOLOCK)
INNER JOIN v_empleados_giro EMP (NOLOCK)
ON EMP.CLAVE = COMISION.nIdEmpleado
WHERE nIdComision =  $P{idComision}]]>
	</queryString>
