	<queryString>
		<![CDATA[SELECT nMes,
		cCodigo,
		cSunCuenta,
		cEstado,
		ROUND(nCantidad,2) AS nCantidad,
		cUnidadMedida,
		ROUND(mCostoUnitario,2) AS mCostoUnitario,
		ROUND(mMonto,2) AS mMonto
	FROM tInventarioGermo
	WHERE nMes = $P{mes}]]>
	</queryString>
