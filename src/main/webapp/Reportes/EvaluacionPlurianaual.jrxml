				<textElement>
					<font isUnderline="true" isStrikeThrough="false"/>
				</textElement>
				<text><![CDATA[c)	Justificación del plazo de la contratación y de que el mismo no afectará negativamente  la competencia económica del SEMERNAT.]]></text>
			</staticText>
			<textField isStretchWithOverflow="true">
