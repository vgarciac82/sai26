					<leftPen lineWidth="0.0" lineStyle="Solid"/>
					<bottomPen lineWidth="0.0" lineStyle="Solid"/>
					<rightPen lineWidth="0.0" lineStyle="Solid"/>
				</box>
				<textElement textAlignment="Justified">
					<font isBold="false" isUnderline="false" isStrikeThrough="false"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{a}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="0" y="0" width="545" height="30"/>
				<textElement>
					<font isUnderline="true"/>
				</textElement>
				<text><![CDATA[a)	Especificación de las obras, adquisiciones, arrendamientos,  o servicios, señalando  si corresponden  a  inversión  o a gasto corriente.]]></text>
			</staticText>
		</band>
		<band height="286">
			<textField>
				<reportElement isPrintRepeatedValues="false" x="0" y="47" width="545" height="117" isPrintWhenDetailOverflows="true"/>
				<textElement textAlignment="Justified"/>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{b}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="0" y="0" width="545" height="47"/>
				<textElement textAlignment="Justified">
					<font isUnderline="true" isStrikeThrough="false"/>
				</textElement>
				<text><![CDATA[b)	Justificación  de  que la celebración de dichos compromisos  representa ventajas  económicas o que sus términos o condiciones  son más favorables respecto a la celebración  de  representa ventajas económicas  o que en sus  términos y condiciones son más favorables  con respecto a la  celebración de dichos contratos  por un solo ejercicio fiscal;]]></text>
			</staticText>
			<textField>
				<reportElement x="0" y="200" width="254" height="82"/>
