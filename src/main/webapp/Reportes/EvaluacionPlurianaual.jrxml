<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="EvaluacionPlurianaual"  pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<property name="ireport.zoom" value="1.1269722013523666"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="479"/>
	<parameter name="folioPlurianual" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["C:\\SYC\\Clientes\\CONAGUA\\workspace\\sai\\WebContent\\Reportes\\"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select cDescripcion as a,cJustificacionCompromiso as b,cJustificacionPlazo as c,
cp.lAbierto,
(Select D_DESCRIPCION from tCatUnidadResponsable ur where ur.cUnidadResponsable = cp.cUnidadResponsable) as Direccion_Responsable,
nMontoTotalxContrato,
nValorComparativoAnual,
(select COUNT(cd.aEjercicioFiscal) from tContratoPlurianualDetalle cd WITH(NOLOCK) where cd.nFolioContratoPlurianual = cp.nFolioContratoPlurianual ) as nAnios,
abs(nValorComparativoAnual - nMontoTotalxContrato) AS Comparativo,
cp.FundamentoMotivacion as e

from tContratoPlurianualEncabezado cp WITH(NOLOCK)
where nFolioContratoPlurianual =$P{folioPlurianual}]]>
	</queryString>
	<field name="a" class="java.lang.String"/>
	<field name="b" class="java.lang.String"/>
	<field name="c" class="java.lang.String"/>
	<field name="lAbierto" class="java.lang.String"/>
	<field name="Direccion_Responsable" class="java.lang.String"/>
	<field name="nMontoTotalxContrato" class="java.math.BigDecimal"/>
	<field name="nValorComparativoAnual" class="java.math.BigDecimal"/>
	<field name="nAnios" class="java.lang.Integer"/>
	<field name="Comparativo" class="java.math.BigDecimal"/>
	<field name="e" class="java.lang.String"/>
	<background>
		<band splitType="Stretch"/>
	</background>
	<title>
		<band height="143" splitType="Stretch">
			<textField>
