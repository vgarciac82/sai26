				<textElement textAlignment="Center" verticalAlignment="Middle"/>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{Direccion_Responsable}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="0" y="74" width="555" height="53" isPrintInFirstWholeBand="true"/>
				<textElement textAlignment="Justified">
					<font size="12" isBold="true"/>
				</textElement>
				<text><![CDATA[Evaluación sobre los mejores términos y condiciones respecto a la celebración de un contrato plurianual para dar  cumplimiento  a lo señalado en el artículo 14, fracción I, incisos a), b), c), d) Del Reglamento de la ley Federal de Presupuesto y Responsabilidad Hacendaria:]]></text>
			</staticText>
			<image>
				<reportElement x="0" y="0" width="242" height="55"/>
				<imageExpression class="java.lang.String"><![CDATA["report\\images\\logotipo-usuario.png"]]></imageExpression>
			</image>
		</band>
	</title>
	<pageHeader>
		<band height="7" splitType="Stretch"/>
	</pageHeader>
	<columnHeader>
		<band splitType="Stretch"/>
	</columnHeader>
	<detail>
		<band height="91" splitType="Stretch">
			<textField isStretchWithOverflow="true">
				<reportElement isPrintRepeatedValues="false" x="0" y="40" width="545" height="47" isPrintWhenDetailOverflows="true"/>
				<box>
