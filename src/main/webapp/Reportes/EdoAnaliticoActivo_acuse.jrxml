					<textElement>
						<font fontName="Arial" size="6"/>
					</textElement>
					<text><![CDATA[*La suma de los parciales puede no coincidir con los totales debido al redondeo de las cifras.]]></text>
				</staticText>
				<staticText>
					<reportElement x="1" y="9" width="469" height="8" uuid="1e5f61b1-4595-494a-a7a4-214cd443f3df"/>
					<textElement>
						<font fontName="Arial" size="6" isBold="true"/>
					</textElement>
					<text><![CDATA[Bajo protesta de decir verdad declaramos que los Estados Financieros y sus notas, son razonablemente correctos y son responsabilidad del emisor.]]></text>
