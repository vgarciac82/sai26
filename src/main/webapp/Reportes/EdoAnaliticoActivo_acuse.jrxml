				<reportElement x="157" y="37" width="221" height="13" uuid="00fda503-39bc-45bf-9d15-c75b865ff048"/>
				<textElement textAlignment="Center">
					<font fontName="Arial" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA[( $P{nombreCentro}.equals( " " ) ? "" : $P{nombreCentro} )]]></textFieldExpression>
			</textField>
			<rectangle>
				<reportElement x="0" y="48" width="528" height="51" backcolor="#CCCCCC" uuid="675540ca-0bf9-4ef1-b8cc-0eb4766903b4"/>
			</rectangle>
			<staticText>
				<reportElement x="157" y="48" width="221" height="12" uuid="102225f0-b2aa-441e-9465-69d7a0793320"/>
				<textElement textAlignment="Center">
					<font fontName="Arial" size="10" isBold="false"/>
				</textElement>
				<text><![CDATA[Comisión Nacional Forestal]]></text>
			</staticText>
			<textField>
				<reportElement x="157" y="85" width="221" height="13" uuid="1e58257a-8514-4ad1-b022-5d5976f0a431"/>
				<textElement textAlignment="Center">
					<font fontName="Arial" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA[($P{miles}==1 ? "(miles de pesos)" : "(en pesos)" )]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="157" y="73" width="221" height="13" uuid="4a774a92-d960-435e-ac43-07626056a112"/>
				<textElement textAlignment="Center">
					<font fontName="Arial" isBold="false"/>
				</textElement>
				<textFieldExpression><![CDATA[(
    $P{mes}==1 ? "Del 01 de Enero al 31 de Enero de " +$P{anio}.toString():
    $P{mes}==2 && ($P{anio}%400 == 0 || ($P{anio}%100 != 0 && $P{anio}%4 == 0)) ? "Al 29 de Febrero de " +$P{anio}.toString():
    $P{mes}==2 ? "Del 01 de Enero al 28 de Febrero de " +$P{anio}.toString():
    $P{mes}==3 ? "Del 01 de Enero al 31 de Marzo de " +$P{anio}.toString():
    $P{mes}==4 ? "Del 01 de Enero al 30 de Abril de " +$P{anio}.toString():
    $P{mes}==5 ? "Del 01 de Enero al 31 de Mayo de " +$P{anio}.toString():
    $P{mes}==6 ? "Del 01 de Enero al 30 de Junio de " +$P{anio}.toString():
    $P{mes}==7 ? "Del 01 de Enero al 31 de Julio de " +$P{anio}.toString():
    $P{mes}==8 ? "Del 01 de Enero al 31 de Agosto de " +$P{anio}.toString():
    $P{mes}==9 ? "Del 01 de Enero al 30 de Septiembre de " +$P{anio}.toString():
    $P{mes}==10 ? "Del 01 de Enero al 31 de Octubre de " +$P{anio}.toString():
    $P{mes}==11 ? "Del 01 de Enero al 30 de Noviembre de " +$P{anio}.toString():
    $P{mes}==12 ? "Del 01 de Enero al 31 de Diciembre de " +$P{anio}.toString():
    ""
)]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement mode="Transparent" x="157" y="61" width="221" height="12" forecolor="#000000" backcolor="#FFFFFF" uuid="302be2c4-283c-4eb9-bd16-d30c9007c996"/>
				<textElement textAlignment="Center" verticalAlignment="Top" rotation="None" markup="none">
					<font fontName="Arial" size="10" isBold="false" isItalic="false" isUnderline="false" isStrikeThrough="false"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression><![CDATA[($P{nivel}==3 ? "Estado Analítico del Activo" : "Estado Analítico del Activo (Detallado)")]]></textFieldExpression>
			</textField>
