				<rectangle>
					<reportElement key="rectangle" x="0" y="83" width="551" height="21" uuid="1eea8ec0-55a3-4782-8327-798dfc0d1af6"/>
				</rectangle>
				<rectangle>
					<reportElement key="rectangle" x="361" y="83" width="190" height="21" uuid="5b1c637c-8a8a-4de5-a28e-9995ca94ec0e"/>
				</rectangle>
				<staticText>
					<reportElement key="staticText" x="6" y="164" width="81" height="11" uuid="456a138c-6124-4be6-b96f-a29d82c23790"/>
					<textElement verticalAlignment="Middle">
						<font size="8"/>
					</textElement>
					<text><![CDATA[Concepto:]]></text>
				</staticText>
				<line>
					<reportElement x="424" y="1" width="1" height="45" uuid="8883fd5f-6c42-44bd-9e3c-5f5e4c251aab"/>
				</line>
				<line>
					<reportElement x="297" y="1" width="1" height="45" uuid="398122bc-3f5a-4859-b202-1c0351751b8e"/>
				</line>
				<staticText>
					<reportElement key="staticText" x="361" y="83" width="189" height="11" uuid="a80789fd-9715-49cc-ba00-7992bef9375a"/>
					<textElement textAlignment="Center">
						<font size="8"/>
					</textElement>
