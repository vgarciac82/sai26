<!-- Created with Jaspersoft Studio version 6.17.0.final using JasperReports Library version 6.17.0-6d93193241dd8cc42629e188b94f9e0bc5722efd  -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="PolizaRectificacion" pageWidth="612" pageHeight="792" whenNoDataType="AllSectionsNoDetail" columnWidth="552" leftMargin="30" rightMargin="30" topMargin="20" bottomMargin="20" uuid="27788ebd-f4af-468d-b8eb-d8c166f5addc">
	<property name="ireport.zoom" value="3.215383215000002"/>
	<property name="ireport.x" value="678"/>
	<property name="ireport.y" value="653"/>
	<parameter name="whereFolio" class="java.lang.String">
		<defaultValueExpression><![CDATA["1"]]></defaultValueExpression>
	</parameter>
	<parameter name="whereTipo" class="java.lang.String">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[DECLARE @sFirmanteDelegatorio VARCHAR(250)
DECLARE @sPuestoFirmanteDelegatorio VARCHAR(70)
DECLARE @sFirmanteAut VARCHAR(250)
DECLARE @sLeyenda VARCHAR(500)
DECLARE @sOficio VARCHAR(128)
DECLARE @sFechaOficio VARCHAR(20)
DECLARE @cTipoSuplencia VARCHAR(20)

DECLARE @sFirmanteDelegatorioVoBo VARCHAR(250)
DECLARE @sPuestoFirmanteDelegatorioVoBo VARCHAR(70)
DECLARE @sFirmanteVoBo VARCHAR(250)
DECLARE @sLeyendaVoBo VARCHAR(500)
DECLARE @sOficioVoBo VARCHAR(128)
DECLARE @sFechaOficioVoBo VARCHAR(20)
DECLARE @cTipoSuplenciaVoBo VARCHAR(20)

SET @sFirmanteDelegatorio = ''
SET @sPuestoFirmanteDelegatorio = ''
SET @sFirmanteAut = ''
SET @sLeyenda = ''
SET @sOficio = ''
SET @sFechaOficio = ''
SET @cTipoSuplencia = ''

SET @sFirmanteDelegatorioVoBo = ''
SET @sPuestoFirmanteDelegatorioVoBo = ''
SET @sFirmanteVoBo = ''
SET @sLeyendaVoBo = ''
SET @sOficioVoBo = ''
SET @sFechaOficioVoBo = ''
SET @cTipoSuplenciaVoBo = ''

SELECT  *
INTO #tmpTablaSalida
FROM    (
			SELECT    e.nFolioRectificacion AS nFolioRectificacion,
						ISNULL((SELECT C_FOLIO FROM CG_CASO WITH(NOLOCK) WHERE ID_TC=17 AND C_FOLIO LIKE '%-'+CAST(e.nFolioRectificacion AS NVARCHAR(10))),'') AS C_FOLIO,
						ISNULL(CASE WHEN ISNULL(eAut.nFolioPoliza,0) = 0 THEN '' ELSE eAut.cTipoPoliza+' - ' +CAST(eAut.nFolioPoliza AS VARCHAR(10)) END ,' ') AS nFolioPoliza ,
						e.cTipoPoliza ,
						e.cConceptoRectificacion AS concepto ,
						e.cConceptoRectificacion AS observaciones ,
						'RECTIFICACION' AS tipoObra ,
						e.cUnidadResponsable ,
						cDescripcion,
						e.fAplicacion ,
						(SELECT dTipoMOVTO FROM tCatalogoTipoMovimiento WITH(NOLOCK) WHERE cTipoTRAN = 8 AND cTipoMOVTO = e.cTipoMovto) AS cTipoMovto,
						(SELECT dTipoPPTO FROM tCatalogoTipoPresupuesto WITH ( NOLOCK ) WHERE cTipoTRAN = 8 AND cTipoMOVTO = e.cTipoMOVTO AND cTipoPPTO = e.nOrigenPPTO) AS nOrigenPPTO,
						e.totalDebe AS importeLC,
						dbo.CantidadConLetra(e.totalDebe) AS cantLetras,
						nDocRenglon,
						e.nFolioSIAFF AS noCLC,
						EP,
						CASE WHEN (SELECT TOP 1 cEvento FROM dbo.tPagadoEncabezado pag WITH(NOLOCK) JOIN dbo.tPagadoDetalle pagd WITH(NOLOCK) ON pag.nFolioPagado = pagd.nFolioPagado WHERE caNoContrarrecibo = e.caNoContrarrecibo) LIKE '%ffm%'
						THEN CONVERT(VARCHAR(5), Substring(ep, 32, 5)) + CASE WHEN LTRIM(RTRIM(nidprograma)) = '13' AND LTRIM(RTRIM(cSubPrograma)) = '45' THEN '0000' ELSE SUBSTRING(EP,1,4) END + RIGHT('00' + LTRIM(RTRIM(nidprograma)),2) + RIGHT('00' + LTRIM(RTRIM(cSubPrograma)),2) + '00'
						ELSE '' END AS FFM,
						cEvento,
						mImporte,
						d.cCentroContable,
						SUBSTRING(d.EP,32,5) AS nCapitulo,
						e.caNoContrarrecibo AS cxp,
						'rfc' AS RFC,
						'ctab' AS CTAB,
						ISNULL(e.sFirmanteRev,' - ') AS sFirmanteRev,
						ISNULL(e.sPuestoRev,' - ') AS sPuestoRev,
						ISNULL(e.sFirmanteAut,' - ') AS sFirmanteAut,
						ISNULL(e.sPuestoAut,' - ') AS sPuestoAut
			  FROM      tRectificacionEncabezado e WITH (NOLOCK)
			  INNER JOIN tRectificacionDetalle d WITH (NOLOCK) ON e.nFolioRectificacion = d.nFolioRectificacion
			  INNER JOIN (SELECT cc.cCentroContable,cUnidadResponsable,cDescripcion
						FROM tCatalogoURCC ur WITH (NOLOCK)
						INNER JOIN tCatalogoCentroContable cc WITH (NOLOCK)
						ON ur.cCentroContable = cc.cCentroContable)cc
			  ON e.cUnidadResponsable=cc.cUnidadResponsable
			  LEFT OUTER JOIN dbo.tRectificacionAutEncabezado eAut WITH(NOLOCK)
			  ON e.nFolioRectificacion=nFolioRectificacionAut
			UNION
			SELECT    e.nFolioRectificacionMil AS nFolioRectificacion,
						ISNULL((SELECT C_FOLIO FROM CG_CASO WITH(NOLOCK) WHERE ID_TC=27 AND C_FOLIO LIKE '%-'+CAST(e.nFolioRectificacionMil AS NVARCHAR(10))),'') AS C_FOLIO,
						CASE WHEN ISNULL(nFolioPoliza,0) = 0 THEN '' ELSE cTipoPoliza+' - ' +CAST(nFolioPoliza AS VARCHAR(10)) END  AS nFolioPoliza ,
						cTipoPoliza ,
						cConceptoRectificacion AS concepto ,
						cConceptoRectificacion AS observaciones ,
						'RECTIFICACIONMIL' AS tipoObra,
						e.cUnidadResponsable ,
						cDescripcion,
						ISNULL(e.fAplicacion,e.fExp) AS fAplicacion ,
						(SELECT dTipoMOVTO FROM tCatalogoTipoMovimiento WITH(NOLOCK) WHERE cTipoTRAN = 8 AND cTipoMOVTO = e.cTipoMovto) AS cTipoMovto,
						(SELECT dTipoPPTO FROM tCatalogoTipoPresupuesto WITH ( NOLOCK ) WHERE cTipoTRAN = 8 AND cTipoMOVTO = e.cTipoMOVTO AND cTipoPPTO = e.nOrigenPPTO) AS nOrigenPPTO,
						totalDebe AS importeLC,
						dbo.CantidadConLetra(totalDebe) AS cantLetras,
						nDocRenglon,
						nFolioSIAFF AS noCLC,
						EP,
						'' AS FFM,
						cEvento,
						mImporte,
						d.cCentroContable,
						SUBSTRING(d.EP,32,5) AS nCapitulo,
						caNoContrarrecibo AS cxp,
						'rfc' AS RFC,
						'd.CTAB' AS CTAB,
						ISNULL(sFirmanteRev,' - ') AS sFirmanteRev,
						ISNULL(sPuestoRev,' - ') AS sPuestoRev,
						ISNULL(sFirmanteAut,' - ') AS sFirmanteAut,
						ISNULL(sPuestoAut,' - ') AS sPuestoAut
			  FROM      tRectificacionEncabezadoMil e WITH (NOLOCK)
			  INNER JOIN tRectificacionDetalleMil d WITH (NOLOCK)
			  ON e.nFolioRectificacionMil = d.nFolioRectificacionMil
			   INNER JOIN (SELECT cc.cCentroContable,cUnidadResponsable,cDescripcion
			 FROM tCatalogoURCC ur WITH (NOLOCK)
			 INNER JOIN tCatalogoCentroContable cc WITH (NOLOCK)
			 ON ur.cCentroContable = cc.cCentroContable)cc
			 ON e.cUnidadResponsable=cc.cUnidadResponsable
UNION
			SELECT    e.nFolioRectificaAnexo1 AS nFolioRectificacion,
						ISNULL((SELECT C_FOLIO FROM CG_CASO WITH(NOLOCK) WHERE ID_TC=51 AND C_FOLIO LIKE '%-'+CAST(e.nFolioRectificaAnexo1 AS NVARCHAR(10))),'') AS C_FOLIO,
						CASE WHEN ISNULL(nFolioPoliza,0) = 0 THEN '' ELSE cTipoPoliza+' - ' +CAST(nFolioPoliza AS VARCHAR(10)) END AS nFolioPoliza ,
						cTipoPoliza ,
						cConceptoRectificacion AS concepto ,
						cConceptoRectificacion AS observaciones ,
						'RECTIFICACIONANEXO1' AS tipoObra,
						e.cUnidadResponsable ,
						cDescripcion,
						ISNULL(e.fAplicacion,e.fExp) AS fAplicacion ,
						(SELECT dTipoMOVTO FROM tCatalogoTipoMovimiento WITH(NOLOCK) WHERE cTipoTRAN = 8 AND cTipoMOVTO = e.cTipoMovto) AS cTipoMovto,
						(SELECT dTipoPPTO FROM tCatalogoTipoPresupuesto WITH ( NOLOCK ) WHERE cTipoTRAN = 8 AND cTipoMOVTO = e.cTipoMOVTO AND cTipoPPTO = e.nOrigenPPTO) AS nOrigenPPTO,
						totalDebe AS importeLC,
						dbo.CantidadConLetra(totalDebe) AS cantLetras,
						nDocRenglon,
						nFolioSIAFF AS noCLC,
						EP,
						'' AS FFM,
						cEvento,
						mImporte,
						d.cCentroContable,
						SUBSTRING(d.EP,32,5) AS nCapitulo,
						e.caNoContrarrecibo AS cxp,
						'rfc' AS RFC,
						'd.CTAB' AS CTAB,
						ISNULL(sFirmanteRev,' - ') AS sFirmanteRev,
						ISNULL(sPuestoRev,' - ') AS sPuestoRev,
						ISNULL(sFirmanteAut,' - ') AS sFirmanteAut,
						ISNULL(sPuestoAut,' - ') AS sPuestoAut
			  FROM      dbo.tRectificaAnexo1Encabezado e WITH (NOLOCK)
			  INNER JOIN dbo.tRectificaAnexo1Detalle d WITH (NOLOCK)
			  ON e.nFolioRectificaAnexo1 = d.nFolioRectificaAnexo1
			   INNER JOIN (SELECT cc.cCentroContable,cUnidadResponsable,cDescripcion
			 FROM tCatalogoURCC ur WITH (NOLOCK)
			 INNER JOIN tCatalogoCentroContable cc WITH (NOLOCK)
			 ON ur.cCentroContable = cc.cCentroContable)cc
			 ON e.cUnidadResponsable=cc.cUnidadResponsable
UNION
		SELECT    e.nFolioRectificaIngreso AS nFolioRectificacion,
		ISNULL((SELECT C_FOLIO FROM CG_CASO WITH(NOLOCK) WHERE ID_TC=61 AND C_FOLIO LIKE '%-'+CAST(e.nFolioRectificaIngreso AS NVARCHAR(10))),'') AS C_FOLIO,
		CASE WHEN ISNULL(nFolioPoliza,0) = 0 THEN '' ELSE cTipoPoliza+' - ' +CAST(nFolioPoliza AS VARCHAR(10)) END AS nFolioPoliza ,
		cTipoPoliza ,
		cConceptoRectificacion AS concepto ,
		cConceptoRectificacion AS observaciones ,
		'RECTIFICAINGRESO' AS tipoObra,
		e.cUnidadResponsable ,
		cDescripcion,
		ISNULL(e.fAplicacion,e.fExp) AS fAplicacion ,
		(SELECT dTipoMOVTO FROM tCatalogoTipoMovimiento WITH(NOLOCK) WHERE cTipoTRAN = 8 AND cTipoMOVTO = e.cTipoMovto) AS cTipoMovto,
		(SELECT dTipoPPTO FROM tCatalogoTipoPresupuesto WITH ( NOLOCK ) WHERE cTipoTRAN = 8 AND cTipoMOVTO = e.cTipoMOVTO AND cTipoPPTO = e.nOrigenPPTO) AS nOrigenPPTO,
		totalDebe AS importeLC,
		dbo.CantidadConLetra(totalDebe) AS cantLetras,
		nDocRenglon,
		nFolioSIAFF AS noCLC,
		EP,
		'' AS FFM,
		cEvento,
		mImporte,
		d.cCentroContable,
		SUBSTRING(d.EP,32,5) AS nCapitulo,
		e.caNoContrarrecibo AS cxp,
		'rfc' AS RFC,
		'd.CTAB' AS CTAB,
		ISNULL(sFirmanteRev,' - ') AS sFirmanteRev,
		ISNULL(sPuestoRev,' - ') AS sPuestoRev,
		ISNULL(sFirmanteAut,' - ') AS sFirmanteAut,
		ISNULL(sPuestoAut,' - ') AS sPuestoAut
		FROM      dbo.tRectificacionIngresosEncabezado e WITH (NOLOCK)
		INNER JOIN dbo.tRectificacionIngresosDetalle d WITH (NOLOCK)
			ON ( e.nFolioRectificaIngreso = d.nFolioRectificaIngreso )
		INNER JOIN
		(
			SELECT cc.cCentroContable,cUnidadResponsable,cDescripcion
			FROM tCatalogoURCC ur WITH (NOLOCK)
			INNER JOIN tCatalogoCentroContable cc WITH (NOLOCK)
				ON ( ur.cCentroContable = cc.cCentroContable)
		)cc
			ON ( e.cUnidadResponsable=cc.cUnidadResponsable )

        ) CR
WHERE nFolioRectificacion = $P!{whereFolio}
        AND tipoObra = $P!{whereTipo}

IF (SELECT COUNT(*) FROM tPagoFirmanteDelagatorio WITH (NOLOCK) WHERE cTipoPago = $P!{whereTipo} AND nFolioPago = $P!{whereFolio}) > 0
	BEGIN
		SELECT TOP 1 @sFirmanteAut = sFirmanteAut FROM #tmpTablaSalida WITH (NOLOCK)

		SELECT	@sFirmanteDelegatorio = ISNULL((cNombreTitular + ' ' + cApellidoPaternoTitular + ' ' + cApellidoMaternoTitular),(NOMBREN + ' ' + NOMBREP + ' ' +  NOMBREM)),
				@sPuestoFirmanteDelegatorio = ISNULL(cPuestoTitular, CARGO)
				, @sOficio = cFolioOficio, @sFechaOficio = dFechaOficio
				, @cTipoSuplencia = cTipoSuplencia
		FROM tPagoFirmanteDelagatorio pago WITH (NOLOCK)
		INNER JOIN tCatTipoSuplencia WITH (NOLOCK)
			ON pago.nTipoSuplencia = tCatTipoSuplencia.ntiposuplencia
		LEFT JOIN v_empleados_giro WITH (NOLOCK)
			ON clave = cNumeroEmpleado
		WHERE cTipoPago = $P!{whereTipo} AND nFolioPago = $P!{whereFolio}

		SET @sLeyenda = 'Firma ' + @cTipoSuplencia + ' de: ' + @sFirmanteAut + ', con fundamento en el oficio: ' + @sOficio + ' de fecha: ' + @sFechaOficio + '.'
	END

IF (SELECT COUNT(*) FROM tPagoFirmanteDelegatorioVoBo WITH (NOLOCK) WHERE cTipoPago = $P!{whereTipo} AND nFolioPago = $P!{whereFolio}) > 0
	BEGIN
		SELECT TOP 1 @sFirmanteVoBo = sFirmanteRev FROM #tmpTablaSalida WITH (NOLOCK)

		SELECT	@sFirmanteDelegatorioVoBo = ISNULL((cNombreTitular + ' ' + cApellidoPaternoTitular + ' ' + cApellidoMaternoTitular),(NOMBREN + ' ' + NOMBREP + ' ' +  NOMBREM)),
				@sPuestoFirmanteDelegatorioVoBo = ISNULL(cPuestoTitular, CARGO)
				, @sOficioVoBo = cFolioOficio, @sFechaOficioVoBo = dFechaOficio
				, @cTipoSuplenciaVoBo = cTipoSuplencia
		FROM tPagoFirmanteDelegatorioVoBo pago WITH (NOLOCK)
		INNER JOIN tCatTipoSuplencia WITH (NOLOCK)
			ON pago.nTipoSuplencia = tCatTipoSuplencia.ntiposuplencia
		LEFT JOIN v_empleados_giro WITH (NOLOCK)
			ON clave = cNumeroEmpleado
		WHERE cTipoPago = $P!{whereTipo} AND nFolioPago = $P!{whereFolio}

		SET @sLeyendaVoBo = 'Firma ' + @cTipoSuplenciaVoBo + ' de: ' + @sFirmanteVoBo + ', con fundamento en el oficio: ' + @sOficioVoBo + ' de fecha: ' + @sFechaOficioVoBo + '.'
	END

SELECT *
, @sFirmanteDelegatorio AS sFirmanteDelegatorio, @sPuestoFirmanteDelegatorio AS sPuestoFirmanteDelegatorio, @sLeyenda AS sLeyenda
, @sFirmanteDelegatorioVoBo AS sFirmanteDelegatorioVoBo, @sPuestoFirmanteDelegatorioVoBo AS sPuestoFirmanteDelegatorioVoBo, @sLeyendaVoBo AS sLeyendaVoBo
FROM #tmpTablaSalida WITH (NOLOCK)

IF (SELECT OBJECT_ID('tempdb..#tmpTablaSalida')) IS NOT NULL	DROP TABLE #tmpTablaSalida]]>
	</queryString>
	<field name="nFolioRectificacion" class="java.lang.Integer"/>
	<field name="C_FOLIO" class="java.lang.String"/>
	<field name="nFolioPoliza" class="java.lang.String"/>
	<field name="cTipoPoliza" class="java.lang.String"/>
	<field name="concepto" class="java.lang.String"/>
	<field name="observaciones" class="java.lang.String"/>
	<field name="tipoObra" class="java.lang.String"/>
	<field name="cUnidadResponsable" class="java.lang.String"/>
	<field name="cDescripcion" class="java.lang.String"/>
	<field name="fAplicacion" class="java.lang.String"/>
	<field name="cTipoMovto" class="java.lang.String"/>
	<field name="nOrigenPPTO" class="java.lang.String"/>
	<field name="importeLC" class="java.math.BigDecimal"/>
	<field name="cantLetras" class="java.lang.String"/>
	<field name="nDocRenglon" class="java.lang.Integer"/>
