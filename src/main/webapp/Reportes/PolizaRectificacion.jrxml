	<field name="CTAB" class="java.lang.String"/>
	<field name="sFirmanteRev" class="java.lang.String"/>
	<field name="sPuestoRev" class="java.lang.String"/>
	<field name="sFirmanteAut" class="java.lang.String"/>
	<field name="sPuestoAut" class="java.lang.String"/>
	<field name="sFirmanteDelegatorio" class="java.lang.String"/>
	<field name="sPuestoFirmanteDelegatorio" class="java.lang.String"/>
	<field name="sLeyenda" class="java.lang.String"/>
	<field name="sFirmanteDelegatorioVoBo" class="java.lang.String"/>
	<field name="sPuestoFirmanteDelegatorioVoBo" class="java.lang.String"/>
	<field name="sLeyendaVoBo" class="java.lang.String"/>
	<group name="caNoContrarrecibo">
		<groupExpression><![CDATA[]]></groupExpression>
		<groupHeader>
			<band height="221">
				<rectangle>
					<reportElement key="rectangle" x="0" y="83" width="551" height="138" uuid="8f449e10-fe55-4310-9655-2820ca9e1098"/>
				</rectangle>
