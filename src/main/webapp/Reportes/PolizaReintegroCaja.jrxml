	<field name="dCENTROCONTABLE" class="java.lang.String"/>
	<field name="cunidadejecutora" class="java.lang.String"/>
	<field name="cantLetras" class="java.lang.String"/>
	<field name="AplicadoAUT" class="java.lang.String"/>
	<field name="sFirmanteDelegatorio" class="java.lang.String"/>
	<field name="sPuestoFirmanteDelegatorio" class="java.lang.String"/>
	<field name="sLeyenda" class="java.lang.String"/>
