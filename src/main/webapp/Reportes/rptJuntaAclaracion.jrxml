	</parameter>
	<parameter name="DIR_REPORT" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="REQUISICIONES" class="java.lang.String"/>
	<parameter name="UNIDAD_EJECUTORA" class="java.lang.String"/>
	<parameter name="CATEGORIA_PROCEDIMIENTO" class="java.lang.String"/>
	<parameter name="DESCRIPCION_PROCEDIMIENTO" class="java.lang.String"/>
	<parameter name="DIRECCION" class="java.lang.String"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["C:\\Users\\Faviola\\gestion_conagua_sif_pruebas\\WebContent\\Reportes\\"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT cNumeroPregunta, cIdRFC, cRazonSocial FROM
(SELECT cp.cIdRFC, cp.cRazonSocial, MAX(pp.ConsecutivoPreg) AS cNumeroPregunta
FROM mCatalogoProveedor cp WITH(NOLOCK), mProcedimientoPreguntas pp WITH(NOLOCK)
WHERE cp.cIdRFC = pp.cIdRFC AND pp.cIdProcedimiento=$P{cIdProcedimiento}
GROUP BY cp.cIdRFC, cRazonSocial
) AS tab
GROUP BY tab.cNumeroPregunta, tab.cIdRFC, tab.cRazonSocial ORDER BY tab.cNumeroPregunta]]>
	</queryString>
	<field name="cNumeroPregunta" class="java.lang.Integer"/>
	<field name="cIdRFC" class="java.lang.String"/>
	<field name="cRazonSocial" class="java.lang.String"/>
