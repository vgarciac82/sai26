		<defaultValueExpression><![CDATA["FechaFactura BETWEEN CONVERT(DATE,'01/01/2013') AND CONVERT(DATE,'01/01/2015')"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
     *
FROM
     vReporteGeneralPrestamos
