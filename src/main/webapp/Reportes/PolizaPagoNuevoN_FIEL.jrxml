					<reportElement key="staticText" x="189" y="374" width="170" height="11" uuid="adafe479-1908-420d-97b9-9c37da5d1844"/>
					<textElement textAlignment="Center" verticalAlignment="Middle">
						<font size="8"/>
					</textElement>
					<text><![CDATA[NOMBRE]]></text>
