	<variable name="nPorcIva" class="java.lang.String">
		<initialValueExpression><![CDATA["IVA (" + $F{nPorcIva}.toString() +  "%)"]]></initialValueExpression>
	</variable>
	<variable name="laEP" class="java.lang.String">
		<initialValueExpression><![CDATA["VARIAS"]]></initialValueExpression>
	</variable>
	<variable name="Debe_1" class="java.math.BigDecimal" resetType="Group" resetGroup="caNoContrarrecibo" calculation="Sum">
		<variableExpression><![CDATA[$F{Debe}]]></variableExpression>
	</variable>
	<variable name="Haber_1" class="java.math.BigDecimal" resetType="Group" resetGroup="caNoContrarrecibo" calculation="Sum">
		<variableExpression><![CDATA[$F{Haber}]]></variableExpression>
	</variable>
	<variable name="noPoliza" class="java.lang.String">
		<initialValueExpression><![CDATA[$F{cTipoPoliza} + "-" + $F{nPolizaAP}.toString()]]></initialValueExpression>
	</variable>
	<variable name="mImporteRetencion" class="java.lang.String"/>
	<variable name="cnoEstimacion" class="java.lang.String"/>
	<variable name="FirmanteAutoriza" class="java.lang.String"/>
	<variable name="PuestoFirmanteAutoriza" class="java.lang.String"/>
