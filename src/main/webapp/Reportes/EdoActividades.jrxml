	<pageHeader>
		<band height="72" splitType="Stretch">
			<staticText>
				<reportElement x="158" y="5" width="221" height="12" uuid="e099eaaa-2e00-4d7c-ace8-88803049ad0f"/>
				<textElement textAlignment="Center">
					<font fontName="Arial" size="10" isBold="true"/>
				</textElement>
				<text><![CDATA[COMISIÓN NACIONAL FORESTAL
]]></text>
			</staticText>
			<textField>
				<reportElement x="158" y="44" width="221" height="13" uuid="8fc0f19f-85f8-4a18-86bd-120f2aa02d70"/>
				<textElement textAlignment="Center">
					<font fontName="Arial" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA[($P{miles}==1 ? "(miles de pesos)" : "(en pesos)" )]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="158" y="29" width="221" height="13" uuid="8a58081b-7b51-47f3-89b2-b538e862d50b"/>
				<textElement textAlignment="Center">
					<font fontName="Arial" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA[(
    $P{mes}==1 ? "Del 01 de Enero al 31 de Enero de " +$P{anio}.toString():
    $P{mes}==2 && ($P{anio}%400 == 0 || ($P{anio}%100 != 0 && $P{anio}%4 == 0)) ? "Al 29 de Febrero de " +$P{anio}.toString():
    $P{mes}==2 ? "Del 01 de Enero al 28 de Febrero de " +$P{anio}.toString():
    $P{mes}==3 ? "Del 01 de Enero al 31 de Marzo de " +$P{anio}.toString():
    $P{mes}==4 ? "Del 01 de Enero al 30 de Abril de " +$P{anio}.toString():
    $P{mes}==5 ? "Del 01 de Enero al 31 de Mayo de " +$P{anio}.toString():
    $P{mes}==6 ? "Del 01 de Enero al 30 de Junio de " +$P{anio}.toString():
    $P{mes}==7 ? "Del 01 de Enero al 31 de Julio de " +$P{anio}.toString():
    $P{mes}==8 ? "Del 01 de Enero al 31 de Agosto de " +$P{anio}.toString():
    $P{mes}==9 ? "Del 01 de Enero al 30 de Septiembre de " +$P{anio}.toString():
    $P{mes}==10 ? "Del 01 de Enero al 31 de Octubre de " +$P{anio}.toString():
    $P{mes}==11 ? "Del 01 de Enero al 30 de Noviembre de " +$P{anio}.toString():
    $P{mes}==12 ? "Del 01 de Enero al 31 de Diciembre de " +$P{anio}.toString():
    ""
)]]></textFieldExpression>
			</textField>
			<image>
				<reportElement x="1" y="1" width="121" height="56" uuid="28e376c6-569c-48c5-a7c6-6e400481eb0c"/>
				<imageExpression><![CDATA[$P{SUBREPORT_DIR} + "\\logotipo-usuario.png"]]></imageExpression>
			</image>
			<textField>
				<reportElement mode="Transparent" x="158" y="17" width="221" height="12" forecolor="#000000" backcolor="#FFFFFF" uuid="64cbb304-6f06-4cbf-a1d8-a63a8a56e235"/>
				<textElement textAlignment="Center" verticalAlignment="Top" rotation="None" markup="none">
					<font fontName="Arial" size="10" isBold="true" isItalic="false" isUnderline="false" isStrikeThrough="false"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression><![CDATA[($P{nivel}==3 ? "Estado de Actividades" : "Estado de Actividades (Detallado)")]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="158" y="57" width="221" height="13" uuid="345c42a6-0caf-43f8-a19c-b1ed3e488e1a"/>
				<textElement textAlignment="Center">
					<font fontName="Arial" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA[( $P{nombreCentro}.equals( " " ) ? "" : $P{nombreCentro} )]]></textFieldExpression>
			</textField>
