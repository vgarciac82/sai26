	<parameter name="SUBREPORT_DIR" class="java.lang.String">
		<defaultValueExpression><![CDATA["C:\\SyC\\Clientes\\CONAFOR\\Desarrollo\\Workspace\\sai_conafor\\WebContent\\Reportes\\"]]></defaultValueExpression>
	</parameter>
	<parameter name="formato" class="java.lang.String"/>
	<parameter name="cIdContrato" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[select
'Ejercicio: '+div.cEjercicio as cEjercicio,div.cIdContrato
,div.cIdRFC
,case when benef.cIdTipoPersonaRFC='1' then div.cIdRFC+': '+benef.dNombre
when benef.cIdTipoPersonaRFC='2' then div.cIdRFC+': '+benef.dNombre+' '+benef.dApellidoPaterno+' '+dApellidoMaterno
else div.cIdRFC+': '
end proveedor
,cIdUnidadAdministrativa
,cConceptoContrato,mImporteContrato,mImporteBruto
,mImporteIVA,mImporteTotal,mContratoMN,'RESUMEN DEL CONTRATO '+div.cIdContrato AS CONTRATO
,'Fecha Documento: '+convert(varchar,fDocumento,111) as fDocumento,'Fecha de Adjudicación: '+convert(varchar,fAdjudicacion,111)fAdjudicacion
,'Fecha de Inicio: '+convert(varchar,fContratoIni,111)fContratoIni,'Fecha Fin: '+convert(varchar,fContratoFin,111)fContratoFin
,'['+ue.cUnidadEjecutora+'] '+ue.D_DESCRIPCION as unidadEjecutora
,contEP.EP,SUBSTRING(contEP.EP,32,5) partida,catSub.cSubPartida
from pContratoDiverso as div with(Nolock)
inner join tCatUnidadEjecutora as ue with(Nolock) on ue.cUnidadEjecutora=div.cIdUnidadAdministrativa
inner join tBeneficiario as benef with(Nolock) on benef.dRFC=div.cIdRFC
left join tContratoEP contEP with(Nolock)  on contEP.cIdContrato=div.cIdContrato
left join mCatalogoSubPartida catSub with(Nolock) on catSub.cIdSubPartida=SUBSTRING(contEP.EP,32,5)
where div.cIdContrato like $P{cIdContrato}]]>
	</queryString>
