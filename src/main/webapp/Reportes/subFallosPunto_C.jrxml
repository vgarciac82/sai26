<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="subFallosPunto_C"  pageWidth="572" pageHeight="752" columnWidth="555" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0">
	<property name="ireport.zoom" value="1.8150000000000037"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="cRazonSocial" class="java.lang.String"/>
	<parameter name="cIdRFC" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="cIdProcedimiento" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="nIdTipoCambio" class="java.lang.Integer"/>
	<queryString>
		<![CDATA[SELECT
pc.nIdLineaConsolidado,
pc.cDescripcion,
dbo.fn_mConsolidadoLineaCantidadArticulos(pc.cEjercicio ,pc.cIdTipoConsolidado ,pc.cIdUnidadEjecutora ,pc.nIdConsecutivoConsolidado, pc.nIdLineaConsolidado) AS cCantidad,
cc.cIdUnidadMedida,
CONVERT(VARCHAR,CAST( ISNULL(CONVERT(FLOAT,pc.mMontoMaximo),0) AS MONEY),1) AS cImporteUnitario,
CONVERT(VARCHAR,CAST( ISNULL(CONVERT(FLOAT,dbo.fn_mConsolidadoLineaCantidadArticulos(pc.cEjercicio ,pc.cIdTipoConsolidado ,pc.cIdUnidadEjecutora ,pc.nIdConsecutivoConsolidado, pc.nIdLineaConsolidado)*pc.mMontoMaximo),0) AS MONEY),1) AS cImporteTotal
FROM
mProcedimientoCompleto pc WITH(NOLOCK),
mCatalogoTipoMoneda cm WITH(NOLOCK),
mConsolidadoLineas cl WITH(NOLOCK),
mConsolidado c WITH(NOLOCK),
mCatalogoCABM cc WITH(NOLOCK)
WHERE
pc.nIdTipoCambio=cm.cIdTipoMoneda
AND cl.cIdConsolidado=pc.cIdConsolidado
AND cl.nIdLineaConsolidado=pc.nIdLineaConsolidado
AND c.cIdConsolidado=pc.cIdConsolidado
AND cc.cIdCABM=cl.cIdCABM
AND pc.cIdProcedimiento=$P{cIdProcedimiento}
AND pc.cIdRFC=$P{cIdRFC}
AND pc.nIdTipoCambio=$P{nIdTipoCambio}
AND pc.cGanador=1
AND pc.mMontoMinimo<>0
ORDER BY pc.nIdLineaConsolidado]]>
	</queryString>
	<field name="nIdLineaConsolidado" class="java.lang.Integer"/>
	<field name="cDescripcion" class="java.lang.String"/>
	<field name="cCantidad" class="java.lang.Integer"/>
