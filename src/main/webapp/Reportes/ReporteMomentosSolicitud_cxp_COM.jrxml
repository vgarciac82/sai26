				<connectionExpression><![CDATA[$P{REPORT_CONNECTION}]]></connectionExpression>
				<subreportExpression><![CDATA[$P{SUBREPORT_DIR} + "ReporteMomentosSolicitud_cxp_ajenas_cxp.jasper"]]></subreportExpression>
			</subreport>
		</band>
	</summary>
</jasperReport>
