	<queryString>
		<![CDATA[SELECT ROW_NUMBER() OVER ( PARTITION BY nCuenta, cPartida ORDER BY nCuenta, cPartida ) AS row
	, CASE WHEN LEN(nCuenta) = 4 THEN '<b>' ELSE '' END + nCuenta + CASE WHEN LEN(nCuenta) = 4 THEN '</b>' ELSE '' END AS nCuenta
	, CASE WHEN LEN(nCuenta) = 4 THEN '<b>' ELSE '' END + dCuenta + CASE WHEN LEN(nCuenta) = 4 THEN '</b>' ELSE '' END AS dCuenta
	, CASE WHEN LEN(cPartida) = 4 THEN '<b>' ELSE '' END + cPartida + CASE WHEN LEN(cPartida) = 4 THEN '</b>' ELSE '' END AS cPartida
	, CASE WHEN LEN(cPartida) = 4 THEN '<b>' ELSE '' END + dPartida + CASE WHEN LEN(cPartida) = 4 THEN '</b>' ELSE '' END AS dPartida
FROM tRelacionContablePresupeustal rcs
ORDER BY 1]]>
	</queryString>
