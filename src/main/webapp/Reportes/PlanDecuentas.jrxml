	<queryString>
		<![CDATA[SELECT aEjercicioFiscal
		, CASE WHEN $P{idVersion} = 0 THEN '' ELSE (SELECT TOP 1 'Fecha Aplicación: ' + CONVERT(VARCHAR(15), fAplicacion) FROM tGuiaVersionTipoNivel WHERE idVersion = $P{idVersion} ) END fAplicacion
		, CASE WHEN $P{idVersion} = 0 THEN '' ELSE (SELECT TOP 1 'Versión: ' + CONVERT(VARCHAR(5), idVersion) FROM tGuiaVersionTipoNivel WHERE idVersion = $P{idVersion} ) END idVersion
FROM dbo.tEjercicioFiscal
WHERE cActivo = 1]]>
	</queryString>
