	<parameter name="nFolioOperAjenas" class="java.lang.String">
		<defaultValueExpression><![CDATA[11]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT TOAE.caNoContrarreciboCLC AS caNoContrarreciboEnb,
	TOAE.cIDRFC,
   	sbeneficiario nombreOA,
	d.caNoContrarrecibo,
	d.ep,
	d.ID_TIPO_CONCEPTO,
	d.ID_TIPO_MOVIMIENTO,
	convert(decimal(14, 2), d.mImporteNeto) ImportesTotal,
	isnull(cConcepto, 'NOMINA CLC 2013') cNombre
FROM tNOMINACLCEncabezado TOAE, tNOMINACLCDetalle D, tBeneficiarioCapituloMil B
WHERE TOAE.nFolioNOMINACLC = d.nFolioNOMINACLC AND
      TOAE.cIDRFC = B.sCodigoEntidad and
      TOAE.nFolioNOMINACLC = $P{nFolioOperAjenas}
order by d.ID_TIPO_CONCEPTO,
	d.ID_TIPO_MOVIMIENTO]]>
	</queryString>
