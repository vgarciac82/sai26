	<parameter name="SUBREPORT_DIR" class="java.lang.String">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="whereFolio" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT DISTINCT CAST(nFolioRELACIONGASTOS AS VARCHAR(9)) nFolioComision, CONVERT(VARCHAR(12), COM.fAplicacion,103) fInforme, cInformeComision, nFolioRELACIONGASTOS
, COM.RFC, rTRIM(emp.NOMBREN) + ' ' + RTRIM(emp.NOMBREP) + ' ' + RTRIM(emp.NOMBREM) Beneficiario
, com.cConcepto, caNoContrarrecibo, 'Nombre comisión: ' + cConcepto_comision cConcepto_comision
, CONVERT(VARCHAR(12),via.fInicio,103) fInicio, CONVERT(VARCHAR(12),via.fFin,103) fFin
, mImporteNeto, cPais, EDO_NOMBRE, MPO_NOMBRE, cLocalidad, Ubicacion
,  DESCRIPCION_PUESTO, emp.CARGO,  UNIDAD,  UNIDAD cUnidadResponsable
,dbo.fnCantidadLetra(mImporteNeto) cantLetras
, COALESCE( (SELECT nombreCompleto from v_empleados where nEmpleado = nnumEmpleadoVobo) , com.sFirmanteVoBo) sFirmanteVoBo 
, COALESCE( (SELECT cargo from v_empleados where nEmpleado = nnumEmpleadoVobo) , com.sPuestoVoBo) sPuestoVoBo
, COALESCE( (SELECT nombreCompleto from v_empleados where nEmpleado = nnumEmpleadoAut) , com.sFirmanteAut) sFirmanteAut 
, COALESCE( (SELECT cargo from v_empleados where nEmpleado = nnumEmpleadoAut) , com.sPuestoAut) sPuestoAut
, COALESCE( (SELECT nombreCompleto from v_empleados where nEmpleado = nnumEmpleadoElab) , com.sFirmanteEla) sFirmanteEla
, COALESCE( (SELECT cargo from v_empleados where nEmpleado = nNumEmpleadoElab) , com.sPuestoEla) sPuestoEla
,  (select nombreCompleto from v_empleados where nEmpleado = dele.cNumeroEmpleado) sFirmanteDelegatorio
, dele.cPuestoTitular sPuestoFirmanteDelegatorio
, isnull( 'Firma ' + Sup.cTipoSuplencia + ' de: ' + (SELECT nombreCompleto from v_empleados where nEmpleado = nnumEmpleadoAut) + ', con fundamento en el oficio: ' + dele.cFolioOficio + ', de fecha: ' + CAST(dele.dFechaOficio AS VARCHAR(10)),'') Leyenda
, (select nombrecompleto from v_empleados where nEmpleado = DeleVb.cnumeroEmpleado) sFirmanteDeleVoBo
, delevb.cPuestoTitular sPuestoFirmanteDeleVoBo
, isnull('Firma ' + SupVb.cTipoSuplencia +' de: ' + (SELECT nombreCompleto from v_empleados where nEmpleado = nnumEmpleadoVobo) + ', con fundamento en el oficio: ' + delevb.cFolioOficio + ', de fecha: ' + CAST(delevb.dFechaOficio AS VARCHAR(10)), '') LeyendaVoBo
, nidComisionModulo AS nFolioAgenda
FROM dbo.tRELACIONGASTOSEncabezado com with (nolock)
INNER JOIN dbo.v_ViaticosComisiones via with (nolock)
ON com.nIdComision = via.nIdComision
LEFT JOIN dbo.v_empleados_giro emp with (nolock)
ON emp.RFC  = com.RFC COLLATE SQL_Latin1_General_CP1_CI_AS
LEFT JOIN dbo.tPagoFirmanteDelagatorio Dele with (nolock)
ON dele.nFolioPago = com.nFolioRELACIONGASTOS AND  cTipoPago = 'RELACIONGASTOS'
LEFT JOIN dbo.tPagoFirmanteDelegatorioVoBo DeleVb with (nolock)
ON delevb.nFolioPago = com.nFolioRELACIONGASTOS AND  DeleVb.cTipoPago = 'RELACIONGASTOS'
left JOIN tCatTipoSuplencia Sup WITH (NOLOCK)
				ON Dele.nTipoSuplencia = Sup.ntiposuplencia
LEFT JOIN tCatTipoSuplencia SupVb WITH (NOLOCK)
				ON DeleVb.nTipoSuplencia = Supvb.ntiposuplencia
LEFT JOIN tRelacionComprobacionComisiones COMPCOM WITH (NOLOCK)
				ON com.nFolioRELACIONGASTOS = nFolioTramite AND cTipoTramite = 'RELACIONGASTOS'
where caNoContrarrecibo = $P{whereFolio}]]>
	</queryString>
