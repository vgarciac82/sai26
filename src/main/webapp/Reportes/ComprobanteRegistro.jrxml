	<import value="net.sf.jasperreports.engine.*"/>
	<import value="java.util.*"/>
	<import value="net.sf.jasperreports.engine.data.*"/>
	<parameter name="whereFolio" class="java.lang.String">
		<defaultValueExpression><![CDATA[" and CR.caNoContrarrecibo ='10CT2013000006'"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select CNOMBRE, CR.aEjercicioFiscal, CR.cIdEntidadContable, CR.caNoContrarrecibo, CR.cIdDocumento, CR.cIdTipoDocumento,
CR.cIdSubtipoDocumento, CR.cIdTipoOperacion, CR.caNoAP, CR.nPolizaAP, CR.cIdRFC, CR.cIdTipoMoneda, CR.nTipoCambio,
CR.mImporteBruto, CR.mImporteSancion, CR.mImporteDevolucion, CR.mAmortizacionAnticipo, CR.mImporteIVA, CR.mImporteRetencion,
CR.mImportePenalizacion, CR.mImporteNeto, convert(varchar(10),m.fProgramadaPago,103) fProgramadaPago, convert(varchar(10),
CR.fValidacionDisponible, 103) fValidacionDisponible, CR.lEsCandidatoCP, CR.lHaySubpartidaExcluidaCP, CR.cIdTipoCLCSiaff,
CR.cIdLeyendaSiaff, CR.cReferencia1, CR.nEsSubsidio, convert(varchar(10), CR.fRegistro, 103) fRegistro, CR.cIdEstadoReintegro,
CR.cIdTipoReclasificacion, CR.fAplicacionSiaff, CR.fPagoSiaff, CR.cIdEstadoContrarrecibo, cconcepto, m.cUnidadResponsable,
cIDTipoFondo, convert(varchar(10),frecepcion,103) frecepcion,
DCD_ISR, DCD_IVA, DCD_MIL5, DCD_MIL2, DCD_OTRAS_RET, DCD_PENALIZACION, DCD_CONTRIBUCION, dc.DCD_CBEN, u.d_descripcion, ep, mImporte
 from tcontrarrecibo CR with(NOLOCK), v_pagosDocComprobatoria DC with(NOLOCK), v_PCATALOGORFC RFC with(NOLOCK),  (  select frecepcion, fprogramadapago, cconcepto, canocontrarrecibo, e.cUnidadResponsable, ff.cIDTipoFondo, dd.ep, sum(mImporteMasIva) mImporte  from tPagoDirectoEncabezado e with(NOLOCK)
	inner join tpagodirectofinanciamiento ff on ff.nFolioPagodirecto = e.nFolioPagodirecto
	inner join tpagodirectodetalle dd on dd.nFolioPagodirecto = e.nFolioPagodirecto
    group by frecepcion, fprogramadapago, cconcepto, canocontrarrecibo, e.cUnidadResponsable, ff.cIDTipoFondo, ep
 union
     select e.frecepcion, e.fprogramadapago, e.cconcepto, canocontrarrecibo, e.cUnidadResponsable, ff.cIDTipoFondo, rd.ep,
    sum(rd.mImporteMasIva)
    from tRELACIONGASTOSEncabezado  e with(NOLOCK)
    inner join trelaciongastofinanciamiento ff on ff.cfolio = e.nFoliorelaciongastos
    inner join tRELACIONGASTOSDetalle rd on rd.nFoliorelaciongastos = e.nFoliorelaciongastos
    group by frecepcion, fprogramadapago, cconcepto, canocontrarrecibo, e.cUnidadResponsable, ff.cIDTipoFondo, ep ) m, tCatUnidadResponsable u with(NOLOCK)
WHERE LTRIM(RTRIM(RFC.cIdRFC)) = LTRIM(RTRIM(CR.cIdRFC)) and m.canocontrarrecibo = cr.canocontrarrecibo and DC.canocontrarrecibo = cr.canocontrarrecibo and m.cUnidadResponsable = u.cUnidadResponsable
 $P!{whereFolio}
  --and CR.caNoContrarrecibo ='10CP2012000003']]>
	</queryString>
