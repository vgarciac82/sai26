	<queryString>
		<![CDATA[SELECT  EP, cMes, convert ( varchar , convert (money,mImporte),1) as mImporte FROM tCompromisoDetalle with(Nolock) where nFolioCompromiso in (SELECT top 1 nFolioCompromiso FROM tCompromisoEncabezado with(Nolock) where cIdContrato like $P{cIdContrato})]]>
	</queryString>
