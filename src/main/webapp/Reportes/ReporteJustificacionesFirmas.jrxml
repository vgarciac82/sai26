<!-- Created with Jaspersoft Studio version 6.17.0.final using JasperReports Library version 6.17.0-6d93193241dd8cc42629e188b94f9e0bc5722efd  -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="ReporteJustificaciones" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="86527ea0-8035-4411-893e-f1665e15706e">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="sai_pruebas"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<parameter name="where2" class="java.lang.Integer"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select just.*, cUnidadResponsable
, COALESCE( (SELECT nombreCompleto from v_empleados where nEmpleado = nnumEmpleadoVobo) , rg.sFirmanteVoBo) sFirmanteVoBo 
, COALESCE( (SELECT cargo from v_empleados where nEmpleado = nnumEmpleadoVobo) , rg.sPuestoVoBo) sPuestoVoBo
, COALESCE( (SELECT nombreCompleto from v_empleados where nEmpleado = nnumEmpleadoAut) , rg.sFirmanteAut) sFirmanteAut 
, COALESCE( (SELECT cargo from v_empleados where nEmpleado = nnumEmpleadoAut) , rg.sPuestoAut) sPuestoAut
, COALESCE( (SELECT nombreCompleto from v_empleados where nEmpleado = nnumEmpleadoElab) , rg.sFirmanteEla) sFirmanteEla
, COALESCE( (SELECT cargo from v_empleados where nEmpleado = nNumEmpleadoElab) , rg.sPuestoEla) sPuestoEla
, (select nombreCompleto from v_empleados where nEmpleado = dele.cnumeroEmpleado) sFirmanteDelegatorio
, dele.cPuestoTitular sPuestoFirmanteDelegatorio
, isnull( 'Firma ' + Sup.cTipoSuplencia + ' de: ' + (select nombreCompleto from v_empleados where nEmpleado = dele.cnumeroEmpleado) + ', con fundamento en el oficio: ' + dele.cFolioOficio + ', de fecha: ' + CAST(dele.dFechaOficio AS VARCHAR(10)),'') Leyenda
, (select nombrecompleto from v_empleados where nEmpleado = DeleVb.cnumeroEmpleado) sFirmanteDeleVoBo
, delevb.cPuestoTitular  sPuestoFirmanteDeleVoBo
, isnull('Firma ' + SupVb.cTipoSuplencia +' de: ' + (select nombrecompleto from v_empleados where nEmpleado = DeleVb.cnumeroEmpleado) + ', con fundamento en el oficio: ' + delevb.cFolioOficio + ', de fecha: ' + CAST(delevb.dFechaOficio AS VARCHAR(10)), '') LeyendaVoBo
from tJustificacionRG just WITH (NOLOCK)
INNER  JOIN tRELACIONGASTOSEncabezado RG WITH (NOLOCK)
ON RG.nFolioRELACIONGASTOS = just.nFolioRELACIONGASTOS
LEFT JOIN dbo.v_empleados_giro emp with (nolock)
ON emp.RFC  = rg.RFC COLLATE SQL_Latin1_General_CP1_CI_AS
LEFT JOIN dbo.tPagoFirmanteDelagatorio Dele with (nolock)
ON dele.nFolioPago = rg.nFolioRELACIONGASTOS AND  cTipoPago = 'RELACIONGASTOS'
LEFT JOIN dbo.tPagoFirmanteDelegatorioVoBo DeleVb with (nolock)
ON delevb.nFolioPago = rg.nFolioRELACIONGASTOS AND  DeleVb.cTipoPago = 'RELACIONGASTOS'
left JOIN tCatTipoSuplencia Sup WITH (NOLOCK)
				ON Dele.nTipoSuplencia = Sup.ntiposuplencia
LEFT JOIN tCatTipoSuplencia SupVb WITH (NOLOCK)
				ON DeleVb.nTipoSuplencia = Supvb.ntiposuplencia
WHERE just.nFolioRELACIONGASTOS =  $P{where2}]]>
	</queryString>
