	<parameter name="whereFolio" class="java.lang.String">
		<defaultValueExpression><![CDATA["and ce.nfoliocaja=31908"]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[DECLARE @nFolioPago INT
DECLARE @cTipoPago VARCHAR(64)
DECLARE @sFirmanteDelegatorio VARCHAR(250)
DECLARE @sPuestoFirmanteDelegatorio VARCHAR(70)
DECLARE @sFirmanteAut VARCHAR(250)
DECLARE @sLeyenda VARCHAR(500)
DECLARE @sOficio VARCHAR(128)
DECLARE @sFechaOficio VARCHAR(20)
DECLARE @cTipoSuplencia VARCHAR(20)

SET @cTipoPago = 'CAJA'

SET	@sFirmanteDelegatorio = ''
SET @sPuestoFirmanteDelegatorio = ''

SET @sFirmanteAut = ''
SET @sLeyenda = ''
SET @sOficio = ''
SET @sFechaOficio = ''

select
ce.nfoliocaja
,ce.fcreacion
,ce.faplicacion
,ge.cNombreGrupo
,cd.mimporte
,isnull((select distinct cd.ctab+' '+strNombreBeneficiario  from tuecuentasbancarias where strClabe=cd.CTAB
	union select distinct cd.ctab+' '+strNombreBeneficiario  from tuecuentasbancariasffm where strClabe=cd.CTAB
),'No Aplica') CTAB
,isnull(cd.rfc,'No Aplica')rfc
,isnull(tb.dNombre+' '+tb.dApellidoPaterno+' '+tb.dApellidoMaterno,'No Aplica') as nombreRFC
,'Cuenta: '+ISNULL (cd.nCuentaBeneficiario,'N/A ')+'  Banco:  '+ISNULL(ctabe.dBanco,'N/A') as CuentaBeneficiario
,'Clabe: '+ISNULL(ctabe.subCuentaBancaria,'N/A') as clabe
,'Partida: '+CASE WHEN FFM = 'undefined' OR FFM = '' OR FFM = 'NA' THEN '' ELSE ISNULL(SUBSTRING(FFM,1,5),'') END AS partida
,'Programa: '+CASE WHEN FFM = 'undefined' OR FFM = '' OR FFM = 'NA' THEN '' ELSE ISNULL(SUBSTRING(FFM,6,15),'') END AS Programa
,ce.cdescripcionpoliza
,coalesce(ce.sFirmanteVoBo, (select ISNULL(NOMBREN,'') + ' ' + ISNULL(NOMBREP,'')+ ' '+ ISNULL(NOMBREM,'')  from v_empleados_giro where clave = nnumEmpleadoVobo),'Firmante No Agregado') sFirmanteVoBo
,coalesce(ce.sPuestoVoBo,(select descripcion_puesto from v_empleados_giro where clave = nnumEmpleadoVobo),'Puesto No Agregado')sPuestoVoBo
,coalesce(ce.sFirmanteAut, (select ISNULL(NOMBREN,'') + ' ' + ISNULL(NOMBREP,'')+ ' '+ ISNULL(NOMBREM,'')  from v_empleados_giro where clave = nnumEmpleadoAut),'Firmante No Agregado')sFirmanteAut
,coalesce(ce.sPuestoAut,(select  descripcion_puesto from v_empleados_giro where clave = nnumEmpleadoAut),'Puesto No Agregado') sPuestoAut
,cd.cevento+' '+ev.dEvento as cevento
,ce.ccentrocontable
,(select cDescripcion from tCatalogoCentroContable as ccc with(NOLOCK) WHERE ccc.cCentroContable=ce.ccentrocontable) dCENTROCONTABLE
,ce.cunidadejecutora+' '+ue.D_DESCRIPCION as cunidadejecutora
,dbo.fnCantidadLetra(cd.mimporte) cantLetras
,  cast( finicio as date) fInicio, cast (ffin as date) fFin
, viat.cConcepto_Comision as comision
, ISNULL('Relacionado con la META: ' + CATMETA.cMeta,'') AS meta
, rgc.nidComisionModulo
, ISNULL(caNoContrarrecibo,'N/A') AS caNoContrarrecibo
INTO #tmpTablaSalida
from tcajaencabezado as ce with(NOLOCK)
inner join tcajadetalle as cd with(NOLOCK) on ce.nfoliocaja=cd.nfoliocaja
inner join tGrupoEvento as ge with(NOLOCK) on ge.nIdGrupoEvento=ce.nidgrupoevento
inner join tCatUnidadEjecutora as ue with(nolock) on ue.cUnidadEjecutora=ce.cunidadejecutora
inner join tEvento as ev with(nolock) on cd.cEvento=ev.cEvento
left join tBeneficiarioCuentasBancarias as ctabe with(nolock) on cd.ncuentaBeneficiario=ctabe.dCuentaBancaria
left join tBeneficiario as tb with(NOLOCK) on cd.rfc=tb.dRFC
LEFT JOIN dbo.tRelacionComprobacionComisiones rgc (NOLOCK) ON rgc.nFolioTramite = ce.nFoliocaja AND CTIPOTRAMITE = 'CAJA'
LEFT JOIN dbo.tViaticosComisiones viat (NOLOCK) ON viat.nIdComision = rgc.nIdComision
LEFT JOIN tAnticiposMetas META on ce.nFoliocaja = META.nFolioCaja
LEFT JOIN tCatalogoMetas CATMETA ON META.idMeta = CATMETA.idMeta
LEFT JOIN tCaja_CxPISN CXPISN ON ce.nFoliocaja = CXPISN.nFolioCaja
where  1=1
$P!{whereFolio}

SELECT TOP 1 @nFolioPago = nfoliocaja FROM #tmpTablaSalida WITH (NOLOCK)

	IF (SELECT COUNT(*) FROM tPagoFirmanteDelagatorio WITH (NOLOCK) WHERE cTipoPago = @cTipoPago AND nFolioPago = @nFolioPago) > 0
		BEGIN
	SELECT TOP 1 @sFirmanteAut = sFirmanteAut FROM #tmpTablaSalida WITH (NOLOCK)

	SELECT	@sFirmanteDelegatorio =
		ISNULL((cNombreTitular + ' ' + cApellidoPaternoTitular + ' ' + cApellidoMaternoTitular)
				,(emp.NOMBREN + ' ' + emp.NOMBREP+ ' ' + emp.NOMBREM)  ),
			@sPuestoFirmanteDelegatorio = ISNULL(cPuestoTitular, DESCRIPCION_PUESTO)
			, @sOficio = cFolioOficio, @sFechaOficio = dFechaOficio
			, @cTipoSuplencia = cTipoSuplencia
			FROM tPagoFirmanteDelagatorio pago WITH (NOLOCK)
			INNER JOIN tCatTipoSuplencia WITH (NOLOCK)
				ON pago.nTipoSuplencia = tCatTipoSuplencia.ntiposuplencia
			INNER JOIN dbo.v_empleados_giro emp (NOLOCK)
				ON emp.CLAVE = pago.cNumeroEmpleado
			WHERE cTipoPago = @cTipoPago AND nFolioPago = @nFolioPago

		SET @sLeyenda = 'Firma ' + @cTipoSuplencia + ' de: ' + @sFirmanteAut + ', con fundamento en el oficio: ' + @sOficio + ' de fecha: ' + @sFechaOficio + '.'
		END

	SELECT *, @sFirmanteDelegatorio AS sFirmanteDelegatorio, @sPuestoFirmanteDelegatorio AS sPuestoFirmanteDelegatorio, @sLeyenda AS sLeyenda
	FROM #tmpTablaSalida WITH (NOLOCK)

IF (SELECT OBJECT_ID('tempdb..#tmpTablaSalida')) IS NOT NULL	DROP TABLE #tmpTablaSalida]]>
	</queryString>
