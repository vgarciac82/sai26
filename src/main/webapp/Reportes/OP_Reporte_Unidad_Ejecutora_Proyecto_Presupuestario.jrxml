<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="OP_Reporte_Unidad_Ejecutora_Proyecto_Presupuestario" pageWidth="792" pageHeight="612" orientation="Landscape" columnWidth="752" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="8c3fcc46-ab17-40e9-89bb-5623aae5d07c">
	<property name="ireport.zoom" value="1.6105100000000012"/>
	<property name="ireport.x" value="136"/>
	<property name="ireport.y" value="0"/>
	<parameter name="fIni" class="java.lang.String"/>
	<parameter name="fFin" class="java.lang.String">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select tipoArea, Proyecto, IdProyecto, UniEjec, UniNormativa, uNormativa, uEjecutora, isnull(Original,0) Original, isnull(Modificado,0) Modificado, cProgramaPresupuestario, UEjec, isnull(montoContrxProg,0) montoContrxProg, isnull(montoContratado,0)montoContratado , isnull(montoEstimado,0)montoEstimado, isnull(montoEjecutado,0)montoEjecutado, isnull(TOTAL_MN,0)TOTAL_MN
 from (select case when uniejec < 'B20'
    then 'GERENCIAS CENTRALES'
    else case when uejecutora like '% cuenca %' then 'ORGANISMOS DE CUENCA' else 'GERENCIAS REGIONALES' end end tipoArea,
   * from (select Proy.cProgramaPresupuestario + ' ' + Proy.dProgramaPresupuestario Proyecto,
				  Proy.cProgramaPresupuestario IdProyecto,
                  Ueje.cUnidadResponsable UniEjec,
                  uNor.cUnidadResponsable UniNormativa,
                  uNor.D_DESCRIPCION uNormativa,
                  ueje.D_DESCRIPCION uEjecutora,
   sum(case when substring(s.nCuenta,1,5) = '81101' then s.mSaldoarrastre else 0 end)/1000.00 Original
  ,sum(case when substring(s.nCuenta,1,5) = '81102' then s.mSaldoarrastre else 0 end)/1000.00 Modificado
 from tSaldos S with(nolock)
, tcatalogoep catEP  with(nolock)
, tCatalogoCentroContable CC with(nolock)
, tCatUnidadResponsable UResp with(nolock)
, tCatUnidadResponsable UNor with(nolock)
, tCatUnidadResponsable Ueje with(nolock)
, tCatalogoProgramaPresupuestario Proy with(nolock)
 where catep.EP = s.cSubCuenta
   and catep.cProgramaPresupuestario =Proy.cProgramaPresupuestario
   and  CC.CcENTROcONTABLE = S.cCentroContable
   and UResp.cUnidadResponsable = s.cUnidadResponsable
   and unor.cUnidadResponsable =   catEP.cUnidadNorativa
   and Ueje.cUnidadResponsable = catEP.cUnidadEjecutora
  AND (nCuenta like '81101%' or nCuenta like '81102%')
  and cPartida  like '6%'
 group by Proy.cProgramaPresupuestario ,Proy.dProgramaPresupuestario ,
           ueje.D_DESCRIPCION ,ueje.cUnidadResponsable,uNor.D_DESCRIPCION, uNor.cUnidadResponsable, UResp.cUnidadResponsable

) Tsal left join

  (select cProgramaPresupuestario, isnull(pasEnc.cU_UR, isnull(comEnc.cU_UR, isnull(preEnc.cU_UR, apaEnc.cU_UR))) UEjec
,SUM(mimporte)/1000.0 montoContrxProg, (sum(ISNULL(pasEnc.mMontoConIVA,ISNULL(comEnc.nMontoConIVA,ISNULL(preEnc.nMontoConIVA,ISNULL(apaEnc.nMontoConIVA,0)))) +isnull(conmod.mMontoconIva, 0)))/1000.00 montoContratado
,  sum(isnull(mmontoestimacion, 0))/1000.00 montoEstimado,
   sum(isnull(mmontoFisicoEjecutado, 0))/1000.00 montoEjecutado, SUM(ISNULL(TOTAL_MN,0))/1000.00 TOTAL_MN
    from tObraPublicaApartadoEncabezado apaEnc with(nolock)
 left join tObraPublicaApartadoEncabezado preEnc with(nolock) on apaEnc.foliosai = preenc.FolioSAI
 left join (select cEnc.cU_Ur, cEnc.cDocumentoHaplicado, cEnc.cCveContrato, cEnc.nMontoConIVA, cEnc.FolioSAI, sum(cDet.mImporte) mImporte, epcom.cProgramaPresupuestario
  from tobrapublicacompromisoencabezado cEnc with(nolock)
  , tobrapublicacompromisodetalle cDet with(nolock),
    tCatalogoEP EPcom with(nolock)
    where cenc.nFolioOPComHeader  = cDet.nFolioOPComHeader
     and epcom.EP=cDet.ep
     and cEvento = 'OP_PCM'
and cEnc.fFechaOficio >= '01/01/2014'
 and cEnc.fFechaOficio < '15/01/2014' group by cEnc.cU_Ur, cEnc.cDocumentoHaplicado, cEnc.cCveContrato, cEnc.nMontoConIVA, cEnc.FolioSAI, epcom.cProgramaPresupuestario
 ) comEnc  on apaEnc.foliosai = comEnc.FolioSAI
 left join tObraPublicaPagoPasivoEncabezado pasEnc with(nolock) on apaEnc.foliosai = pasEnc.FolioSAI
 left join ( select af.foliosai,sum(isnull(af.mmontoestimacion,0)) mmontoestimacion, af.efiscalpago
 , sum(isnull(af.nporceavancefisicoejecutado,0)) nporceavancefisicoejecutado
 , sum(isnull(af.nporceavancefisicoestimado,0)) nporceavancefisicoestimado
 , sum(isnull(af.mmontoFisicoEjecutado,0)) mmontoFisicoEjecutado
 , sum(isnull(af.nporceavancefisicoprogramado,0)) nporceavancefisicoprogramado
 , sum(isnull(CASE WHEN siaff.FOLIO_CLC = sicop.FOLIO_SIAFF_112 and sicop.FOLIO_SIAFF_112 = pe.nFolioSIAFF and obrae.cDocumentoHaplicado = 'S' and siaff.ESTATUS_CLC = 'Pagada' THEN CAST(SIAFF.TOTAL_MN AS MONEY) ELSE 0 END,0)) TOTAL_MN

FROM tObraPublicaAvanceFisico AF with(nolock)
							 left join tpagoobraencabezado obrae with(nolock) on AF.noestimacion = obrae.cNoEstimacion and AF.mmontoestimacion = obrae.mImporteMasIva and obrae.cDocumentoHaplicado != 'C'
							 left join tpagoobraencabezado poe with(nolock) on poe.cFolioContratoObra = AF.ccvecontrato and poe.cnoestimacion = AF.noestimacion and poe.cDocumentoHaplicado ='S'
							 left join tpagadoencabezado pe with(nolock) on pe.nFolioPAGO = obrae.nFolioPAGOOBRA and pe.cTipoPago ='PAGOOBRA'
							 left join clc_sicop sicop with(nolock) on sicop.FOLIO_SIAFF_112 = pe.nFolioSIAFF
							 left join CLC_SIAFF_ENC siaff with(nolock) on siaff.FOLIO_CLC = sicop.FOLIO_SIAFF_112
							  group by af.foliosai,af.efiscalpago
)                             avfEnc on apaEnc.foliosai = avfEnc.FolioSAI and avfEnc.efiscalpago = (SELECT aejerciciofiscal AS cEjercicio
				FROM   tejerciciofiscal WITH(NOLOCK)
				WHERE  cactivo = 1 )
left join (select epe.ccvecontrato, sum(epe.mMontoconIva) mMontoconIva, epe.cU_UR, epe.aEjercicioFiscal
   from tObraPublicaConvModifEncabezado epe with(nolock) where epe.cDocumentoHaplicado = 'S' and epe.aEjercicioFiscal =(SELECT aejerciciofiscal AS cEjercicio
				FROM   tejerciciofiscal WITH(NOLOCK)
				WHERE  cactivo = 1 )
    group by epe.cCveContrato, epe.cU_UR, epe.aEjercicioFiscal ) conMod --NOMBRE TABLA CONMOD
      on conmod.cCveContrato = comEnc.cCveContrato
 where apaEnc.cDocumentoHaplicado = 'S'
 and preEnc.cDocumentoHaplicado = 'S'
 and comEnc.cDocumentoHaplicado = 'S'
 and comenc.cCveContrato in (select e.cIdContrato from tCompromisoEncabezado e where e.cDocumentoHaplicado = 'S')
 group by isnull(pasEnc.cU_Ur, isnull(comEnc.cU_Ur, isnull(preEnc.cU_Ur, apaEnc.cU_Ur))),cProgramaPresupuestario ) tabContr --NOMBRE DE TABLA tabContr
on tabContr.UEjec = Tsal.UniEjec and tabcontr.cProgramaPresupuestario = tsal.IdProyecto)m
order by m.IdProyecto, m.tipoArea
--where UEjec is not null]]>
	</queryString>
