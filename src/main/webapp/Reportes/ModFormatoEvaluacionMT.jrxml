	<field name="mMontoMaximo" class="java.math.BigDecimal"/>
	<field name="mMontoTotalContrato" class="java.math.BigDecimal"/>
	<field name="sFirmanteSol" class="java.lang.String"/>
	<field name="sPuestoSol" class="java.lang.String"/>
