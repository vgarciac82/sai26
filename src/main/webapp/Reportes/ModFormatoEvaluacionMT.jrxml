				<textElement textAlignment="Justified">
					<font fontName="Arial" size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[Dice:]]></text>
			</staticText>
		</band>
		<band height="29">
			<subreport>
				<reportElement x="1" y="1" width="200" height="26"/>
				<subreportParameter name="nFolio">
