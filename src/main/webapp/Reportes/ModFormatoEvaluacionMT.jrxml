	<parameter name="SUBREPORT_DIR" class="java.lang.String">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="whereFolio" class="java.lang.String">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="folioUltimo" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select cDescripcionProyecto, cJustifSolicitud, cFundamentoMotivacion, cEspecificacion, cJustificacionEconomica, cJustificacionPlazo
, mMontoMinimo, mMontoMaximo, mMontoTotalContrato , sFirmanteSol, sPuestoSol, nFolioContratoPlurianual folio, nFolioContratoOrigen
from tContratosPlurianualEnc_Mod cont with(NOLOCK)
where nFolioContratoPlurianual =   $P{whereFolio}]]>
	</queryString>
	<field name="cDescripcionProyecto" class="java.lang.String"/>
	<field name="cJustifSolicitud" class="java.lang.String"/>
	<field name="cFundamentoMotivacion" class="java.lang.String"/>
	<field name="cEspecificacion" class="java.lang.String"/>
	<field name="cJustificacionEconomica" class="java.lang.String"/>
