				<connectionExpression><![CDATA[$P{REPORT_CONNECTION}]]></connectionExpression>
				<subreportExpression class="java.lang.String"><![CDATA[$P{SUBREPORT_DIR}+ "//FormatoEvalDetAnio.jasper"]]></subreportExpression>
			</subreport>
			<staticText>
				<reportElement positionType="Float" x="20" y="1" width="74" height="14"/>
				<textElement textAlignment="Justified">
					<font fontName="Arial" size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[Debe decir:]]></text>
			</staticText>
		</band>
