<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="ReporteCompromiso" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="86527ea0-8035-4411-893e-f1665e15706e">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="sai_2025"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.report.description" value=""/>
	<parameter name="where2" class="java.lang.String"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="concepto" class="java.lang.String"/>
	<queryString>
		<![CDATA[DECLARE @ANIO INT
SET @ANIO = (SELECT aEjercicioFiscal - 1 FROM tEjercicioFiscal WHERE cActivo = 1)
create table #pagadoAA(importe money, partida varchar(5) )

INSERT INTO #pagadoAA
exec sp_pagadoAAporPartida @ANIO


		SELECT cIdContrato,comp.caNoCompromiso, cPartida, dPartida
		,  SUM(DET.mImporte) importe
		,  CASE WHEN EXISTS (
            SELECT 1
            FROM tLayoutsCreadosRelacionGastosHeader l WITH (NOLOCK)
            INNER JOIN tRelacionGastosEncabezado rg WITH (NOLOCK)
                ON rg.caNoContrarrecibo = l.sNoContrarrecibo
            WHERE l.sAuxiliarComodin = COMP.cIdContrato
              AND (
                    rg.ID_DESTINO_GASTO IN ('CPRP')
                    OR (rg.CTAB = 'Pago_Referenciado' AND rg.ID_DESTINO_GASTO NOT IN ('2NRQ'))
                  )
              AND rg.cDocumentoHaplicado = 'S'
        ) THEN 		
			'Por lo anterior, solicito de su apoyo para autorizar el presente compromiso por <b>' 
			+  cast((select FORMAT(sum(mImporte), 'C', 'es-MX') + '</b>' from tCompromisoDetalle WITH (NOLOCK) where nFolioCompromiso= COMP.nFolioCompromiso group by nFolioCompromiso ) as varchar(20)) + ' (' +
			 dbo.CantidadConLetra((select SUM(mImporte) from tCompromisoDetalle WITH (NOLOCK) where nFolioCompromiso= COMP.nFolioCompromiso group by nFolioCompromiso )) + ' )'
			 + ' por concepto de <b>'  + $P{concepto} + '</b> el cual se integra de las siguientes partidas que se desglosan en el cuadro siguiente:'  
        ELSE
		'Por lo anterior, solicito de su apoyo para autorizar el presente compromiso por <b>' 
		+  cast((select FORMAT(sum(mImporte), 'C', 'es-MX') + '</b>' from tCompromisoDetalle WITH (NOLOCK) where nFolioCompromiso= COMP.nFolioCompromiso group by nFolioCompromiso ) as varchar(20)) + ' (' +
		 dbo.CantidadConLetra((select SUM(mImporte) from tCompromisoDetalle WITH (NOLOCK) where nFolioCompromiso= COMP.nFolioCompromiso group by nFolioCompromiso )) + ' )'
		 + ' por concepto de <b>' + $P{concepto} +  '</b> necesarios para la operación de la institución, el cual se integra de las siguientes partidas que se desglosan en el cuadro siguiente:'  
    END parrafo
 , (select top 1 cFolioOficio  from tLayoutsCreadosRelacionGastosHeader WITH (NOLOCK) where sAuxiliarComodin = COMP.cIdContrato) cFolioOficio
 , importe importeAA
 , (select FORMAT(sum(mImporte), 'C', 'es-MX') from tCompromisoDetalle WITH (NOLOCK) where nFolioCompromiso= COMP.nFolioCompromiso group by nFolioCompromiso )  importeTotal
 ,  CASE WHEN EXISTS (
            SELECT 1
            FROM tLayoutsCreadosRelacionGastosHeader l WITH (NOLOCK)
            INNER JOIN tRelacionGastosEncabezado rg WITH (NOLOCK)
                ON rg.caNoContrarrecibo = l.sNoContrarrecibo
            WHERE l.sAuxiliarComodin = COMP.cIdContrato
              AND (
                    rg.ID_DESTINO_GASTO IN ('CPRP')
                    OR (rg.CTAB = 'Pago_Referenciado' AND rg.ID_DESTINO_GASTO NOT IN ('2NRQ'))
                  )
              AND rg.cDocumentoHaplicado = 'S'
        ) THEN 1
        ELSE   0		
    END esProveedor
FROM tCompromisoEncabezado COMP WITH (NOLOCK)
INNER JOIN TCOMPROMISODETALLE DET WITH (NOLOCK)
ON DET.nfoliocompromiso = comp.nfoliocompromiso
INNER JOIN TCATALOGOPARTIDA partida WITH (NOLOCK)
on partida.cpartida = substring(ep, 32,5)
inner  JOIN #pagadoAA pagadoAA
ON pagadoAA.partida = partida.cpartida
WHERE  COMP.caNoCompromiso = $P{where2}
GROUP BY  cIdContrato,  comp.caNoCompromiso,  COMP.nFolioCompromiso, importe, cPartida, dPartida
drop table #pagadoAA]]>
	</queryString>
