	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w1" value="26"/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w2" value="967"/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="sai_2025"/>
	<import value="net.sf.jasperreports.engine.*"/>
