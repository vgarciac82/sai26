	<parameter name="SUBREPORT_DIR" class="java.lang.String">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="whereFolio" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT DISTINCT CAST(nFolioComision AS VARCHAR(9)) nFolioComision, CONVERT(VARCHAR(12), fInforme,103) fInforme, cInformeComision
, COM.RFC, rTRIM(emp.NOMBREN) + ' ' + RTRIM(emp.NOMBREP) + ' ' + RTRIM(emp.NOMBREM) Beneficiario
, com.cConcepto_Comision, CONVERT(VARCHAR(12),com.fInicio,103) fInicio, CONVERT(VARCHAR(12),com.fFin,103) fFin
, mImporteNeto, cPais, EDO_NOMBRE, MPO_NOMBRE, cLocalidad, Ubicacion
, DESCRIPCION_PUESTO, emp.CARGO, UNIDAD
,dbo.fnCantidadLetra(mImporteNeto) cantLetras
,com.sFirmanteVoBo, com.sPuestoVoBo, com.sFirmanteAut, sPuestoAut
, sFirmanteElabora, sPuestoElabora
, coalesce (dele.cNombreTitular + ' ' + dele.cApellidoPaternoTitular+ ' ' +  dele.cApellidoMaternoTitular, (select nombreN + ' ' + nombreP + ' ' + nombreM from v_empleados_giro where clave = dele.cnumeroEmpleado))
NombreTitular
, dele.cPuestoTitular
, isnull( 'Firma ' + Sup.cTipoSuplencia + ' de: ' + sFirmanteAut + ', con fundamento en el oficio: ' + dele.cFolioOficio + ', de fecha: ' + CAST(dele.dFechaOficio AS VARCHAR(10)),'') Leyenda
, coalesce (delevb.cNombreTitular + ' ' + delevb.cApellidoPaternoTitular+ ' ' +  delevb.cApellidoMaternoTitular ,
(select nombreN + ' ' + nombreP + ' ' + nombreM from v_empleados_giro where clave = DeleVb.cnumeroEmpleado)) NombreTitularvb
, delevb.cPuestoTitular PuestoTitularvb
, isnull('Firma ' + SupVb.cTipoSuplencia +' de: ' + sFirmanteAut + ', con fundamento en el oficio: ' + delevb.cFolioOficio + ', de fecha: ' + CAST(delevb.dFechaOficio AS VARCHAR(10)), '') LeyendaVb
, nidComisionModulo AS nFolioAgenda
FROM dbo.vw_ComisionesSinComprobacion com
INNER JOIN dbo.v_ViaticosComisiones via
ON com.nIdComision = via.nIdComision
LEFT JOIN dbo.v_empleados_giro emp
ON emp.RFC  = com.RFC COLLATE SQL_Latin1_General_CP1_CI_AS
LEFT JOIN dbo.tPagoFirmanteDelagatorio Dele
ON dele.nFolioPago = com.nFolioComision AND  cTipoPago = 'COMSINVIATICOS'
LEFT JOIN dbo.tPagoFirmanteDelegatorioVoBo DeleVb
ON delevb.nFolioPago = com.nFolioComision AND  DeleVb.cTipoPago = 'COMSINVIATICOS'
left JOIN tCatTipoSuplencia Sup WITH (NOLOCK)
				ON Dele.nTipoSuplencia = Sup.ntiposuplencia
LEFT JOIN tCatTipoSuplencia SupVb WITH (NOLOCK)
				ON DeleVb.nTipoSuplencia = Supvb.ntiposuplencia
LEFT JOIN tRelacionComprobacionComisiones COMPCOM WITH (NOLOCK)
				ON com.nfoliocomision = nFolioTramite AND cTipoTramite = 'COMSINVIATICOS'
where nFolioComision = $P{whereFolio} AND 1 = 1]]>
	</queryString>
