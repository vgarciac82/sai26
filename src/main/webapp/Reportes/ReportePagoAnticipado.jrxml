<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="ReportePagoAnticipado"  pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="nFolio" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="NoOficio" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="Unormativa" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="noEncabezado" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[Select

isnull((SELECT D_DESCRIPCION FROM tCatUnidadResponsable WHERE cUnidadResponsable =$P{Unormativa} ),'') as direccion,


(select cNombreDestinatario from tReportePagoAnticipado where nClave = $P{noEncabezado}) as nomDes,
(select cPuestoDestinatario from tReportePagoAnticipado where nClave = $P{noEncabezado} ) as PuestoDes,
(select cNombreRemitente from tReportePagoAnticipado where nClave = $P{noEncabezado}) as NomRem,
(select cPuestoRemitente from tReportePagoAnticipado where nClave = $P{noEncabezado}) as PuestoRem,

justificacion from tPAnticipadoEncanbezado
where nFolioPagoAnticipado= $P{nFolio}]]>
	</queryString>
	<field name="direccion" class="java.lang.String"/>
	<field name="nomDes" class="java.lang.String"/>
	<field name="PuestoDes" class="java.lang.String"/>
	<field name="NomRem" class="java.lang.String"/>
	<field name="PuestoRem" class="java.lang.String"/>
	<field name="justificacion" class="java.lang.String"/>
