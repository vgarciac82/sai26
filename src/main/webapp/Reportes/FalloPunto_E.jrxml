<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="FalloPunto_E"  pageWidth="572" pageHeight="752" columnWidth="572" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0">
	<property name="ireport.zoom" value="1.9487171000000083"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="cIdProcedimiento" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select pc.nIdLineaConsolidado,
dbo.fn_mLugarOcupadoCotizacion((select mpc.ganadorSug from mProcedimientoCompleto mpc where mpc.cIdProcedimiento=$P{cIdProcedimiento} and mpc.nIdLineaConsolidado=pc.nIdLineaConsolidado and mpc.cIdRFC=pc.cIdRFC)) as cLugarOcupado,
cp.cRazonSocial,
 cp.cRazonSocial,
dbo.fn_mConsolidadoLineaCantidadArticulos(pc.cEjercicio, pc.cIdTipoConsolidado, pc.cIdUnidadEjecutora, nIdConsecutivoConsolidado,pc.nIdLineaConsolidado)*
pc.mMontoMinimo*pc.mTipoCambio AS importeBruto,
CONVERT(VARCHAR,CAST( ISNULL(CONVERT(FLOAT,(dbo.fn_mConsolidadoLineaCantidadArticulos(pc.cEjercicio, pc.cIdTipoConsolidado, pc.cIdUnidadEjecutora, nIdConsecutivoConsolidado,pc.nIdLineaConsolidado)*
pc.mMontoMinimo*pc.mTipoCambio)),0) AS money),1) as importeSinIVA,
pc.mTipoCambio, ctm.cAbreviatura
from mProcedimientoCompleto pc, mCatalogoProveedor cp, mCatalogoTipoMoneda ctm, mConsolidadoLineas cl
where ctm.cIdTipoMoneda=pc.nIdtipoCambio AND pc.cIdRFC=cp.cIdRFC AND cl.cIdConsolidado=pc.cIdConsolidado AND pc.nIdLineaConsolidado=cl.nIdLineaConsolidado
AND pc.cIdProcedimiento=$P{cIdProcedimiento} AND pc.cGanador<>1  AND pc.mMontoMinimo<>0 and cl.agregaProveedor=1 and pc.ganadorSug=3 and pc.evaluacionTec=1
order by nIdLineaConsolidado, pc.ganadorSug]]>
	</queryString>
	<field name="nIdLineaConsolidado" class="java.lang.Integer"/>
	<field name="cLugarOcupado" class="java.lang.String"/>
	<field name="cRazonSocial" class="java.lang.String"/>
	<field name="importeBruto" class="java.math.BigDecimal"/>
	<field name="importeSinIVA" class="java.lang.String"/>
	<field name="mTipoCambio" class="java.math.BigDecimal"/>
	<field name="cAbreviatura" class="java.lang.String"/>
