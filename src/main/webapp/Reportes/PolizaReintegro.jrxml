<!-- Created with Jaspersoft Studio version 6.17.0.final using JasperReports Library version 6.17.0-6d93193241dd8cc42629e188b94f9e0bc5722efd  -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="Poliza_Reint_Rect" pageWidth="612" pageHeight="792" whenNoDataType="AllSectionsNoDetail" columnWidth="552" leftMargin="30" rightMargin="30" topMargin="20" bottomMargin="20" uuid="cb5cde43-a8ac-4b3d-8521-f63fb450b9ac">
	<property name="ireport.zoom" value="1.9487171000000243"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="472"/>
	<parameter name="whereFolio" class="java.lang.String">
		<defaultValueExpression><![CDATA["1"]]></defaultValueExpression>
	</parameter>
	<parameter name="whereTipo" class="java.lang.String">
		<defaultValueExpression><![CDATA["1"]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String"/>
	<queryString>
		<![CDATA[DECLARE @cTipoObra VARCHAR(50)
DECLARE @nFolioReintegro VARCHAR(20)

SET @cTipoObra = $P!{whereTipo}
SET @nFolioReintegro = $P!{whereFolio}

DECLARE @nFolioPago INT
DECLARE @cTipoPago VARCHAR(64)
DECLARE @sFirmanteDelegatorio VARCHAR(250)
DECLARE @sPuestoFirmanteDelegatorio VARCHAR(70)
DECLARE @sFirmanteAut VARCHAR(250)
DECLARE @sLeyenda VARCHAR(500)
DECLARE @sOficio VARCHAR(128)
DECLARE @sFechaOficio VARCHAR(20)

SET @nFolioPago = @nFolioReintegro
SET @cTipoPago = ''
SET @sFirmanteDelegatorio = ''
SET @sPuestoFirmanteDelegatorio = ''
SET @sFirmanteAut = ''
SET @sLeyenda = ''
SET @sOficio = ''
SET @sFechaOficio = ''

DECLARE @sFirmanteDeleVoBo VARCHAR(250)
DECLARE @sPuestoFirmanteDeleVoBo VARCHAR(70)
DECLARE @sFirmanteVoBo VARCHAR(250)
DECLARE @sLeyendaVoBo VARCHAR(500)
DECLARE @sOficioVoBo VARCHAR(128)
DECLARE @sFechaOficioVoBo VARCHAR(20)

SET @sFirmanteDeleVoBo = ''
SET @sPuestoFirmanteDeleVoBo = ''
SET @sFirmanteVoBo = ''
SET @sLeyendaVoBo = ''
SET @sOficioVoBo = ''
SET @sFechaOficioVoBo = ''

IF @cTipoObra = 'REINTEGROAUT' OR @cTipoObra = 'REINTEGROCONT'
BEGIN
	SET @cTipoPago = 'REINTEGRO'
END

IF (SELECT COUNT(*) FROM dbo.tReintegroEncabezado WITH (NOLOCK) WHERE nFolioReintegro = @nFolioPago) > 0
BEGIN
	IF (SELECT COUNT(*) FROM tPagoFirmanteDelagatorio WITH (NOLOCK) WHERE cTipoPago = @cTipoPago AND nFolioPago = @nFolioPago) > 0
		BEGIN

			SELECT TOP 1 @sFirmanteAut = sFirmanteAut FROM dbo.tReintegroEncabezado WITH (NOLOCK) WHERE nFolioReintegro = @nFolioPago

			SELECT	@sFirmanteDelegatorio = (SELECT NOMBREN + ' ' + NOMBREP + ' ' + NOMBREM FROM v_empleados_giro WHERE CLAVE = cNumeroEmpleado),
			@sPuestoFirmanteDelegatorio = (SELECT DESCRIPCION_PUESTO FROM v_empleados_giro WHERE CLAVE = cNumeroEmpleado)
			, @sOficio = cFolioOficio, @sFechaOficio = CONVERT(varchar(10), CONVERT(date, dFechaOficio, 106), 103)
			FROM tPagoFirmanteDelagatorio WITH (NOLOCK)
			WHERE cTipoPago = @cTipoPago AND nFolioPago = @nFolioPago

			SET @sLeyenda = 'Firma en suplencia de: ' + @sFirmanteAut + ', con fundamento en el oficio: ' + @sOficio + ', de fecha: ' + @sFechaOficio
		END


	IF (SELECT COUNT(*) FROM tPagoFirmanteDelegatorioVoBo WITH (NOLOCK) WHERE cTipoPago = @cTipoPago AND nFolioPago = @nFolioPago) > 0
		BEGIN

			SELECT TOP 1 @sFirmanteVoBo = sFirmanteRev FROM dbo.tReintegroEncabezado WITH (NOLOCK) WHERE nFolioReintegro = @nFolioPago

			SELECT	@sFirmanteDeleVoBo = (SELECT NOMBREN + ' ' + NOMBREP + ' ' + NOMBREM FROM v_empleados_giro WHERE CLAVE = cNumeroEmpleado),
			@sPuestoFirmanteDeleVoBo = (SELECT DESCRIPCION_PUESTO FROM v_empleados_giro WHERE CLAVE = cNumeroEmpleado)
			, @sOficioVoBo = cFolioOficio, @sFechaOficioVoBo = CONVERT(varchar(10), CONVERT(date, dFechaOficio, 106), 103)
			FROM tPagoFirmanteDelegatorioVoBo WITH (NOLOCK)
			WHERE cTipoPago = @cTipoPago AND nFolioPago = @nFolioPago

			SET @sLeyendaVoBo = 'Firma en suplencia de: ' + @sFirmanteVoBo + ', con fundamento en el oficio: ' + @sOficioVoBo + ', de fecha: ' + @sFechaOficioVoBo
		END
END

SELECT  *
, CASE WHEN nidprograma > 0 THEN 'Programa: ' + CAST(nidprograma AS VARCHAR(6)) + (SELECT ' ' + cprograma FROM tfideicomiso WITH (NOLOCK) WHERE id = CR.nidprograma AND nidprograma = CR.cUnidadResponsable ) ELSE '' END AS Programa
, CASE WHEN cSubPrograma > 0 THEN 'SubPrograma: ' + (SELECT cdescsubprograma FROM tprogramafideicomiso WITH (NOLOCK) WHERE id = CR.nidprograma AND csubprograma = CR.cSubPrograma ) ELSE '' END AS SubPrograma
FROM    ( SELECT    e.nFolioReintegro nFolioReintegro ,
		(SELECT C_FOLIO FROM dbo.CG_CASO WHERE ID_TC=15 AND C_FOLIO LIKE '%-'+CAST(e.nFolioReintegro AS NVARCHAR(10)))C_FOLIO,
                    ISNULL((SELECT CASE WHEN ISNULL(nFolioPoliza,0) = 0 THEN 'N/A' ELSE cTipoPoliza+' - ' +CAST(nFolioPoliza AS VARCHAR(10)) END  FROM tReintegroAutEncabezado WITH(NOLOCK) WHERE nFolioReintegroaut=e.nFolioReintegro),'N/A')nFolioPoliza ,
                    (SELECT cTipoPoliza FROM tReintegroAutEncabezado WITH(NOLOCK) WHERE nFolioReintegroaut=e.nFolioReintegro)cTipoPoliza ,
                    concepto ,
                    observaciones ,
                    'REINTEGROAUT' tipoObra ,
                    e.cUnidadResponsable ,
                    cDescripcion,
                    fSolicitud as fAplicacion ,
                    (SELECT dCausaAviso FROM dbo.tCatalogoCausaAviso WHERE aCausaAviso=e.tipoAviso AND cCausaAviso=e.causaAviso)causaAviso,
                    (SELECT dTipoCausaAviso FROM dbo.tCatalogoTipoCausaAviso WHERE cTipoCausaAviso=e.tipoAviso)tipoAviso,
		importeLC,
		dbo.CantidadConLetra(importeLC)cantLetras,
                    nDocRenglon,
                    noCLC,
                    EP,
                    mImporte,
                    d.cCentroContable,
                    nCapitulo,
                    cxp,
                    RFC,
                    CTAB,
                    ISNULL(sFirmanteRev,' - ')sFirmanteRev,
                    ISNULL(sPuestoRev,' - ')sPuestoRev,
                    ISNULL(sFirmanteAut,' - ')sFirmanteAut,
                    ISNULL(sPuestoAut,' - ')sPuestoAut,
	          CASE WHEN nidprograma > 0 THEN nidprograma ELSE 0 END AS nidprograma,
                    CASE WHEN cSubPrograma > 0 THEN cSubPrograma ELSE 0 END AS cSubPrograma,
	@sFirmanteDelegatorio AS sFirmanteDelegatorio, @sPuestoFirmanteDelegatorio AS sPuestoFirmanteDelegatorio, 	@sLeyenda AS Leyenda, @sFirmanteDeleVoBo AS sFirmanteDeleVoBo, @sPuestoFirmanteDeleVoBo AS 			sPuestoFirmanteDeleVoBo, @sLeyendaVoBo AS LeyendaVoBo
          FROM      dbo.tReintegroEncabezado e WITH (NOLOCK)
          INNER JOIN dbo.tReintegroDetalle d WITH (NOLOCK) ON e.nFolioReintegro = d.nFolioReintegro
          INNER JOIN (SELECT cc.cCentroContable,cUnidadResponsable,cDescripcion
					FROM dbo.tCatalogoURCC ur WITH (NOLOCK)
					INNER JOIN tCatalogoCentroContable cc WITH (NOLOCK)
					ON ur.cCentroContable = cc.cCentroContable)cc
		  ON e.cUnidadResponsable=cc.cUnidadResponsable
          UNION
          SELECT    e.nFolioReintegroMil nFolioReintegro,
		(SELECT C_FOLIO FROM dbo.CG_CASO WHERE ID_TC=26 AND C_FOLIO LIKE '%-'+CAST(e.nFolioReintegroMil AS NVARCHAR(10)))C_FOLIO,
                    CASE WHEN ISNULL(nFolioPoliza,0) = 0 THEN 'N/A' ELSE cTipoPoliza+' - ' +CAST(nFolioPoliza AS VARCHAR(10)) END  nFolioPoliza ,
                    cTipoPoliza ,
                    concepto ,
                    observaciones ,
                    'REINTEGROAUTMIL',
                    e.cUnidadResponsable ,
                    cDescripcion,
                    fAplicacion ,
                    (SELECT dCausaAviso FROM dbo.tCatalogoCausaAviso WHERE aCausaAviso=e.tipoAviso AND cCausaAviso=e.causaAviso)causaAviso,
                    (SELECT dTipoCausaAviso FROM dbo.tCatalogoTipoCausaAviso WHERE cTipoCausaAviso=e.tipoAviso)tipoAviso,
		importeLC,
		dbo.CantidadConLetra(importeLC)cantLetras,
		nDocRenglon,
                    noCLC,
                    EP,
                    mImporte,
                    d.cCentroContable,
                    nCapitulo,
                    cxp,
                    RFC,
                    d.CTAB,
                    ISNULL(sFirmanteRev,' - ')sFirmanteRev,
                    ISNULL(sPuestoRev,' - ')sPuestoRev,
                    ISNULL(sFirmanteAut,' - ')sFirmanteAut,
                    ISNULL(sPuestoAut,' - ')sPuestoAut,
                    0 AS nidprograma,
                    0 AS cSubPrograma,
	@sFirmanteDelegatorio AS sFirmanteDelegatorio, @sPuestoFirmanteDelegatorio AS sPuestoFirmanteDelegatorio, 	@sLeyenda AS Leyenda, @sFirmanteDeleVoBo AS sFirmanteDeleVoBo, @sPuestoFirmanteDeleVoBo AS 			sPuestoFirmanteDeleVoBo, @sLeyendaVoBo AS LeyendaVoBo
          FROM      dbo.tReintegroEncabezadoMil e WITH (NOLOCK)
          INNER JOIN dbo.tReintegroDetalleMil d WITH (NOLOCK)
          ON e.nFolioReintegroMil=d.nFolioReintegroMil
           INNER JOIN (SELECT cc.cCentroContable,cUnidadResponsable,cDescripcion
		 FROM dbo.tCatalogoURCC ur WITH (NOLOCK)
		 INNER JOIN tCatalogoCentroContable cc WITH (NOLOCK)
		 ON ur.cCentroContable = cc.cCentroContable)cc
		 ON e.cUnidadResponsable=cc.cUnidadResponsable
UNION
          SELECT    e.nFolioReintegroAnexo1 nFolioReintegro,
		(SELECT C_FOLIO FROM dbo.CG_CASO WHERE ID_TC=50 AND C_FOLIO LIKE '%-'+CAST(e.nFolioReintegroAnexo1 AS NVARCHAR(10)))C_FOLIO,
                    CASE WHEN ISNULL(nFolioPoliza,0) = 0 THEN 'N/A' ELSE cTipoPoliza+' - ' +CAST(nFolioPoliza AS VARCHAR(10)) END  nFolioPoliza ,
                    cTipoPoliza ,
                    concepto ,
                    observaciones ,
                    'REINTEGROANEXO1' ,
                    e.cUnidadResponsable ,
                    cDescripcion,
		ISNULL(fAplicacion,fSolicitud) ,
                    (SELECT dCausaAviso FROM dbo.tCatalogoCausaAviso WHERE aCausaAviso=e.tipoAviso AND cCausaAviso=e.causaAviso)causaAviso,
                    (SELECT dTipoCausaAviso FROM dbo.tCatalogoTipoCausaAviso WHERE cTipoCausaAviso=e.tipoAviso)tipoAviso,
		importeLC,
		dbo.CantidadConLetra(importeLC)cantLetras,
		nDocRenglon,
                    noCLC,
                    EP,
                    mImporte,
                    d.cCentroContable,
                    nCapitulo,
                    cxp,
                    CASE WHEN RFC<>'' THEN RFC ELSE 'TESOFE' END RFC,
                    d.CTAB,
                    ISNULL(sFirmanteRev,' - ')sFirmanteRev,
                    ISNULL(sPuestoRev,' - ')sPuestoRev,
                    ISNULL(sFirmanteAut,' - ')sFirmanteAut,
                    ISNULL(sPuestoAut,' - ')sPuestoAut,
                    0 AS nidprograma,
                    0 AS cSubPrograma,
	@sFirmanteDelegatorio AS sFirmanteDelegatorio, @sPuestoFirmanteDelegatorio AS sPuestoFirmanteDelegatorio, 	@sLeyenda AS Leyenda, @sFirmanteDeleVoBo AS sFirmanteDeleVoBo, @sPuestoFirmanteDeleVoBo AS 			sPuestoFirmanteDeleVoBo, @sLeyendaVoBo AS LeyendaVoBo
          FROM      dbo.tReintegroAnexo1Encabezado e WITH (NOLOCK)
          INNER JOIN dbo.tReintegroAnexo1Detalle d WITH (NOLOCK)
          ON e.nFolioReintegroAnexo1=d.nFolioReintegroAnexo1
           INNER JOIN (SELECT cc.cCentroContable,cUnidadResponsable,cDescripcion
		 FROM dbo.tCatalogoURCC ur WITH (NOLOCK)
		 INNER JOIN tCatalogoCentroContable cc WITH (NOLOCK)
		 ON ur.cCentroContable = cc.cCentroContable)cc
		 ON e.cUnidadResponsable=cc.cUnidadResponsable
UNION
		SELECT    e.nFolioReintegro nFolioReintegro,
		(SELECT C_FOLIO FROM dbo.CG_CASO WHERE ID_TC=52 AND C_FOLIO LIKE '%-'+CAST(e.nFolioReintegro AS NVARCHAR(10)))C_FOLIO,
                    ISNULL((SELECT CASE WHEN ISNULL(nFolioPoliza,0) = 0 THEN 'N/A' ELSE cTipoPoliza+' - ' +CAST(nFolioPoliza AS VARCHAR(10)) END
							FROM tReintegroAutEncabezado WITH(NOLOCK) WHERE nFolioReintegroaut=e.nFolioReintegro),'N/A')nFolioPoliza ,
                    (SELECT cTipoPoliza FROM tReintegroAutEncabezado WITH(NOLOCK) WHERE nFolioReintegroaut=e.nFolioReintegro)cTipoPoliza ,
                    concepto ,
                    observaciones ,
                    'REINTEGROCONT' ,
                    e.cUnidadResponsable ,
                    cDescripcion,
                    fAplicacion ,
                    (SELECT dCausaAviso FROM dbo.tCatalogoCausaAviso WHERE aCausaAviso=e.tipoAviso AND cCausaAviso=e.causaAviso)causaAviso,
                    (SELECT dTipoCausaAviso FROM dbo.tCatalogoTipoCausaAviso WHERE cTipoCausaAviso=e.tipoAviso)tipoAviso,
		importeLC,
		dbo.CantidadConLetra(importeLC)cantLetras,
		nDocRenglon,
                    noCLC,
                    EP,
                    mImporte,
                    d.cCentroContable,
                    nCapitulo,
                    cxp,
                    RFC,
                    d.CTAB,
                    ISNULL(sFirmanteRev,' - ')sFirmanteRev,
                    ISNULL(sPuestoRev,' - ')sPuestoRev,
                    ISNULL(sFirmanteAut,' - ')sFirmanteAut,
                    ISNULL(sPuestoAut,' - ')sPuestoAut,
                    CASE WHEN RFC = 'BMN930209927' THEN nidprograma ELSE 0 END AS nidprograma,
                    CASE WHEN RFC = 'BMN930209927' THEN cSubPrograma ELSE 0 END AS cSubPrograma,
	@sFirmanteDelegatorio AS sFirmanteDelegatorio, @sPuestoFirmanteDelegatorio AS sPuestoFirmanteDelegatorio, 	@sLeyenda AS Leyenda, @sFirmanteDeleVoBo AS sFirmanteDeleVoBo, @sPuestoFirmanteDeleVoBo AS 			sPuestoFirmanteDeleVoBo, @sLeyendaVoBo AS LeyendaVoBo
          FROM      dbo.tReintegroEncabezado e WITH (NOLOCK)
          INNER JOIN dbo.tReintegroDetalle d WITH (NOLOCK)
          ON e.nFolioReintegro=d.nFolioReintegro
           INNER JOIN (SELECT cc.cCentroContable,cUnidadResponsable,cDescripcion
		 FROM dbo.tCatalogoURCC ur WITH (NOLOCK)
		 INNER JOIN tCatalogoCentroContable cc WITH (NOLOCK)
		 ON ur.cCentroContable = cc.cCentroContable)cc
		 ON e.cUnidadResponsable=cc.cUnidadResponsable

UNION
		SELECT    e.nFolioReintegroIngreso nFolioReintegro,
		(SELECT C_FOLIO FROM dbo.CG_CASO WHERE ID_TC=59 AND C_FOLIO LIKE '%-'+CAST(e.nFolioReintegroIngreso AS NVARCHAR(10)))C_FOLIO,
                     CASE WHEN ISNULL(nFolioPoliza,0) = 0 THEN 'N/A' ELSE cTipoPoliza+' - ' +CAST(nFolioPoliza AS VARCHAR(10)) END nFolioPoliza,
                    cTipoPoliza ,
                    concepto ,
                    observaciones ,
                    'REINTEGROINGRESO' ,
                    e.cUnidadResponsable  ,
                    cDescripcion,
                    CASE WHEN ISNULL(cDocumentoHaplicado, '') = '' THEN GETDATE() ELSE fAplicacion END AS fAplicacion ,
                    (SELECT dCausaAviso FROM dbo.tCatalogoCausaAviso WHERE aCausaAviso=e.tipoAviso AND cCausaAviso=e.causaAviso)causaAviso,
                    (SELECT dTipoCausaAviso FROM dbo.tCatalogoTipoCausaAviso WHERE cTipoCausaAviso=e.tipoAviso)tipoAviso,
		importeLC,
		dbo.CantidadConLetra(importeLC)cantLetras,
		nDocRenglon,
                    noCLC,
                    EP,
                    mImporte,
                    d.cCentroContable,
                    nCapitulo,
                    cxp,
                    RFC,
                    d.CTAB,
                    ISNULL(sFirmanteRev,' - ')sFirmanteRev,
                    ISNULL(sPuestoRev,' - ')sPuestoRev,
                    ISNULL(sFirmanteAut,' - ')sFirmanteAut,
                    ISNULL(sPuestoAut,' - ')sPuestoAut,
                    0 AS nidprograma,
                    0 AS cSubPrograma,
	@sFirmanteDelegatorio AS sFirmanteDelegatorio, @sPuestoFirmanteDelegatorio AS sPuestoFirmanteDelegatorio, 	@sLeyenda AS Leyenda, @sFirmanteDeleVoBo AS sFirmanteDeleVoBo, @sPuestoFirmanteDeleVoBo AS 			sPuestoFirmanteDeleVoBo, @sLeyendaVoBo AS LeyendaVoBo
          FROM      dbo.tReintegroIngresoEncabezado e WITH (NOLOCK)
          INNER JOIN dbo.tReintegroIngresoDetalle d WITH (NOLOCK)
          ON e.nFolioReintegroIngreso=d.nFolioReintegroIngreso
           INNER JOIN (SELECT cc.cCentroContable,cUnidadResponsable,cDescripcion
		 FROM dbo.tCatalogoURCC ur WITH (NOLOCK)
		 INNER JOIN tCatalogoCentroContable cc WITH (NOLOCK)
		 ON ur.cCentroContable = cc.cCentroContable)cc
		 ON e.cUnidadResponsable=cc.cUnidadResponsable

        ) CR
WHERE nFolioReintegro = @nFolioPago
AND tipoObra = @cTipoObra]]>
	</queryString>
	<field name="nFolioReintegro" class="java.lang.Integer"/>
	<field name="C_FOLIO" class="java.lang.String"/>
	<field name="nFolioPoliza" class="java.lang.String"/>
	<field name="cTipoPoliza" class="java.lang.String"/>
	<field name="concepto" class="java.lang.String"/>
	<field name="observaciones" class="java.lang.String"/>
	<field name="tipoObra" class="java.lang.String"/>
	<field name="cUnidadResponsable" class="java.lang.String"/>
	<field name="cDescripcion" class="java.lang.String"/>
	<field name="fAplicacion" class="java.sql.Timestamp"/>
	<field name="causaAviso" class="java.lang.String"/>
	<field name="tipoAviso" class="java.lang.String"/>
	<field name="importeLC" class="java.math.BigDecimal"/>
	<field name="cantLetras" class="java.lang.String"/>
	<field name="nDocRenglon" class="java.lang.Integer"/>
	<field name="noCLC" class="java.lang.Integer"/>
	<field name="EP" class="java.lang.String"/>
	<field name="mImporte" class="java.math.BigDecimal"/>
	<field name="cCentroContable" class="java.lang.String"/>
	<field name="nCapitulo" class="java.lang.String"/>
	<field name="cxp" class="java.lang.String"/>
	<field name="RFC" class="java.lang.String"/>
	<field name="CTAB" class="java.lang.String"/>
	<field name="sFirmanteRev" class="java.lang.String"/>
	<field name="sPuestoRev" class="java.lang.String"/>
	<field name="sFirmanteAut" class="java.lang.String"/>
	<field name="sPuestoAut" class="java.lang.String"/>
	<field name="nidprograma" class="java.lang.Integer"/>
	<field name="cSubPrograma" class="java.lang.Integer"/>
	<field name="sFirmanteDelegatorio" class="java.lang.String"/>
	<field name="sPuestoFirmanteDelegatorio" class="java.lang.String"/>
	<field name="Leyenda" class="java.lang.String"/>
	<field name="sFirmanteDeleVoBo" class="java.lang.String"/>
	<field name="sPuestoFirmanteDeleVoBo" class="java.lang.String"/>
	<field name="LeyendaVoBo" class="java.lang.String"/>
	<field name="Programa" class="java.lang.String"/>
	<field name="SubPrograma" class="java.lang.String"/>
	<group name="caNoContrarrecibo">
		<groupExpression><![CDATA[]]></groupExpression>
		<groupHeader>
			<band height="235">
				<rectangle>
					<reportElement key="rectangle" x="0" y="83" width="551" height="152" uuid="3b85c28c-c8af-491a-a2d4-abd60652eab7"/>
				</rectangle>
