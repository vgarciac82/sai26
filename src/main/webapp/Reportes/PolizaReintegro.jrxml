					<text><![CDATA[Importe a Pagar:]]></text>
				</staticText>
				<line>
					<reportElement key="line" x="281" y="104" width="1" height="58" uuid="b3edffe5-9944-475a-a7e1-f67eb391b598"/>
				</line>
				<line>
					<reportElement key="line" x="0" y="162" width="551" height="1" uuid="7617fb1a-fcfd-43ac-a0a3-218b1fec39a7"/>
				</line>
				<rectangle>
					<reportElement key="rectangle" x="171" y="1" width="380" height="50" uuid="5c1d340d-d3e6-4a4b-b85b-9e90a336b99c"/>
				</rectangle>
				<staticText>
					<reportElement key="staticText" x="298" y="1" width="127" height="16" uuid="19ad23e6-b515-43ef-9816-5f8bd77a6a28"/>
