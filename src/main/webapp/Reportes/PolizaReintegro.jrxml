					<text><![CDATA[Tipo de documento]]></text>
				</staticText>
				<staticText>
					<reportElement key="staticText" x="424" y="1" width="127" height="16" uuid="ff22a148-d963-489d-9292-467c27413af6"/>
					<textElement textAlignment="Center">
						<font size="8"/>
					</textElement>
					<text><![CDATA[Fecha de Aplicacion]]></text>
				</staticText>
				<rectangle>
					<reportElement key="rectangle" x="171" y="47" width="190" height="36" uuid="9be0c366-3ce5-49a8-8d7f-f7f8f1c6c179"/>
				</rectangle>
				<staticText>
					<reportElement key="staticText" x="171" y="50" width="190" height="11" uuid="af5ef296-f3ff-4a3c-a5d1-62af01d79d94"/>
					<textElement textAlignment="Center">
						<font size="8"/>
					</textElement>
					<text><![CDATA[Causa Aviso]]></text>
				</staticText>
				<rectangle>
					<reportElement key="rectangle" x="361" y="47" width="190" height="36" uuid="db4e029b-ad46-41d3-b51a-0e4ed805301f"/>
				</rectangle>
