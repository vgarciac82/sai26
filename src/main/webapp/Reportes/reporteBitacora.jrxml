				<textFieldExpression class="java.lang.String"><![CDATA[$F{cIdDocumento}]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement x="124" y="0" width="228" height="20" isPrintWhenDetailOverflows="true"/>
				<textElement>
