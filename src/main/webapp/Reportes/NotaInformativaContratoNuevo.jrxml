	<queryString>
		<![CDATA[declare @compromiso varchar(20) =  $P{where2} 
declare @contrato varchar(50) = (SELECT cIdContrato from tCompromisoEncabezado where caNoCompromiso = @compromiso )
declare @esIntegrada int = $P{esIntegrada} 


create table #CONTRATO  (
PARTIDA int,
TOTAL_ANUAL money,
ENERO money,
FEBRERO money,
MARZO money,
ABRIL MONEY,
MAYO MONEY,
JUNIO MONEY,
JULIO MONEY,
AGOSTO MONEY,
SEPTIEMBRE MONEY,
OCTUBRE MONEY,
NOVIEMBRE MONEY,
DICIEMBRE MONEY,
cesCalendario varchar(1),
TIPO varchar(1)
)

IF (@esIntegrada = 0)
BEGIN

INSERT INTO #CONTRATO
SELECT  PARTIDA, SUM(TOTAL_ANUAL) TOTAL_ANUAL
, SUM(ENERO) ENERO 
, SUM(FEBRERO) FEBRERO
, SUM(MARZO) MARZO
, SUM(ABRIL) ABRIL
, SUM(MAYO) MAYO
, SUM(JUNIO) JUNIO
, SUM(JULIO) JULIO
, SUM(AGOSTO) AGOSTO
, SUM(SEPTIEMBRE) SEPTIEMBRE
, SUM(OCTUBRE) OCTUBRE
, SUM(NOVIEMBRE) NOVIEMBRE
, SUM(DICIEMBRE) DICIEMBRE
, cesCalendario 
, TIPO 
FROM
 (
	SELECT SUBSTRING(EP,32,5) PARTIDA
	, SUM(DET.mImporte) TOTAL_ANUAL
	, CASE WHEN CMES = 1 THEN SUM(MIMPORTE) ELSE 0 END ENERO
	, CASE WHEN CMES = 2 THEN SUM(MIMPORTE) ELSE 0 END FEBRERO
	, CASE WHEN CMES = 3 THEN SUM(MIMPORTE) ELSE 0 END MARZO
	, CASE WHEN CMES = 4 THEN SUM(MIMPORTE) ELSE 0 END ABRIL
	, CASE WHEN CMES = 5 THEN SUM(MIMPORTE) ELSE 0 END MAYO
	, CASE WHEN CMES = 6 THEN SUM(MIMPORTE) ELSE 0 END JUNIO
	, CASE WHEN CMES = 7 THEN SUM(MIMPORTE) ELSE 0 END JULIO
	, CASE WHEN CMES = 8 THEN SUM(MIMPORTE) ELSE 0 END AGOSTO
	, CASE WHEN CMES = 9 THEN SUM(MIMPORTE) ELSE 0 END SEPTIEMBRE
	, CASE WHEN CMES = 10 THEN SUM(MIMPORTE) ELSE 0 END OCTUBRE
	, CASE WHEN CMES = 11 THEN SUM(MIMPORTE) ELSE 0 END NOVIEMBRE
	, CASE WHEN CMES = 12 THEN SUM(MIMPORTE) ELSE 0 END DICIEMBRE
	, comp.cesCalendario
	, case WHEN SUM(MIMPORTE) > 0 THEN 'A' ELSE 'R' END TIPO
	FROM tCompromisoEncabezado comp 
	INNER JOIN tCompromisoDetalle DET
	ON comp.nFolioCompromiso = DET.nFolioCompromiso
	WHERE caNoCompromiso =  @compromiso
	GROUP BY SUBSTRING(EP,32,5) , cMes, comp.cesCalendario
	 ) AS CONTRATO
	 GROUP BY PARTIDA, cesCalendario, TIPO
END 
ELSE
BEGIN 

SET @contrato = ( SELECT top 1 cIdContrato FROM tCompromisoEncabezado C INNER JOIN tIntegraFoliosCompromiso I ON C.nFolioCompromiso = I.nFolioCompromiso AND I.caNoIntegradaComp = @compromiso )


INSERT INTO #CONTRATO
SELECT  PARTIDA, SUM(TOTAL_ANUAL) TOTAL_ANUAL
, SUM(ENERO) ENERO 
, SUM(FEBRERO) FEBRERO
, SUM(MARZO) MARZO
, SUM(ABRIL) ABRIL
, SUM(MAYO) MAYO
, SUM(JUNIO) JUNIO
, SUM(JULIO) JULIO
, SUM(AGOSTO) AGOSTO
, SUM(SEPTIEMBRE) SEPTIEMBRE
, SUM(OCTUBRE) OCTUBRE
, SUM(NOVIEMBRE) NOVIEMBRE
, SUM(DICIEMBRE) DICIEMBRE
, cesCalendario
, TIPO
FROM
 (
	SELECT SUBSTRING(EP,32,5) PARTIDA
	, SUM(DET.mImporte) TOTAL_ANUAL
	, CASE WHEN CMES = 1 THEN SUM(MIMPORTE) ELSE 0 END ENERO
	, CASE WHEN CMES = 2 THEN SUM(MIMPORTE) ELSE 0 END FEBRERO
	, CASE WHEN CMES = 3 THEN SUM(MIMPORTE) ELSE 0 END MARZO
	, CASE WHEN CMES = 4 THEN SUM(MIMPORTE) ELSE 0 END ABRIL
	, CASE WHEN CMES = 5 THEN SUM(MIMPORTE) ELSE 0 END MAYO
	, CASE WHEN CMES = 6 THEN SUM(MIMPORTE) ELSE 0 END JUNIO
	, CASE WHEN CMES = 7 THEN SUM(MIMPORTE) ELSE 0 END JULIO
	, CASE WHEN CMES = 8 THEN SUM(MIMPORTE) ELSE 0 END AGOSTO
	, CASE WHEN CMES = 9 THEN SUM(MIMPORTE) ELSE 0 END SEPTIEMBRE
	, CASE WHEN CMES = 10 THEN SUM(MIMPORTE) ELSE 0 END OCTUBRE
	, CASE WHEN CMES = 11 THEN SUM(MIMPORTE) ELSE 0 END NOVIEMBRE
	, CASE WHEN CMES = 12 THEN SUM(MIMPORTE) ELSE 0 END DICIEMBRE
	, comp.cesCalendario
	, case WHEN SUM(MIMPORTE) > 0 THEN 'A' ELSE 'R' END TIPO
	FROM tCompromisoEncabezado comp 
	INNER JOIN tCompromisoDetalle DET
	ON comp.nFolioCompromiso = DET.nFolioCompromiso
	INNER JOIN tIntegraFoliosCompromiso Integra
	on comp.nFolioCompromiso = Integra.nFolioCompromiso
	WHERE Integra.caNoIntegradaComp =  @compromiso
	GROUP BY SUBSTRING(EP,32,5) , cMes, comp.cesCalendario
	 ) AS CONTRATO
	 GROUP BY PARTIDA, cesCalendario, TIPO
	  
END
	  

DECLARE @noConvenio varchar(200), @fInicioConv date, @fFinConv date 
select 
                @noConvenio = MIN(cNoConvenio),
                @fInicioConv = MIN(fInicio),
                @fFinConv = MAX(fTermino)
		
from 
(              select 
                               cont.cIdContratoDefinitivo,cont.nConsecutivoModificacion
                               ,cont.nEstado,cont.cNoConvenio,cContratoDefinitivo
                from mContratoModificado cont with(Nolock)
                union 
                select 
                               contCap4.cIdContratoDefinitivo,contCap4.nConsecutivoModificacion
                               ,contCap4.nEstatus nEstado,contCap4.cNoConvenio,cContratoDefinitivo
                from mContratoModificadoCap4 contCap4 with(Nolock)
)cont
inner join  pContratoDiversoConvenio conv with(Nolock)
on cont.cIdContratoDefinitivo=conv.cIdContrato
and cont.nConsecutivoModificacion=conv.nConsecutivoModificacion
and cont.cContratoDefinitivo=conv.cIdModificacion
where cont.nEstado=4
AND cont.cIdContratoDefinitivo LIKE  @contrato
group by cont.cIdContratoDefinitivo




declare @parrafo1 as varchar(max), @proveedor varchar(1000), @vigencia varchar (100), @cnet varchar(100), @parrafoCalendario as varchar(max), @parrafoConvenio as varchar(max)

select @parrafo1 = 'Se solicita la autorización del pedido / contrato ' + cNoContratoCNET + ' correspondiente al concepto de "' + DescripcionPedCont + '", correspondientes a la partida especifica  ' + REPLACE(partida, ';', ',') + ' y adjudicado al proveedor ' 
+ razonsocial + ' durante el presente ejercicio fiscal actual, con el siguiente calendario: ',
@parrafoCalendario = 'Se solicita la autorización del CAMBIO DE CALENDARIO del pedido / contrato ' + cNoContratoCNET + ' correspondiente al concepto de "' + DescripcionPedCont + '", correspondientes a la partida especifica  ' + REPLACE(partida, ';', ',') + ' y adjudicado al proveedor ' 
+ razonsocial + ' durante el presente ejercicio fiscal actual, con el siguiente calendario: ',
@parrafoConvenio = 'Se solicita la autorización del CONTRATO MODIFICATORIO ' + @noConvenio + ' del pedido / contrato ' + cNoContratoCNET + ' correspondiente al concepto de "' + DescripcionPedCont + '", correspondientes a la partida especifica  ' + REPLACE(partida, ';', ',') + ' y adjudicado al proveedor ' 
+ razonsocial + ' durante el presente ejercicio fiscal actual, con el siguiente calendario: ',
@proveedor = RazonSocial,
@vigencia = CONVERT(varchar(20), fechainicio, 103) + ' - ' + CONVERT(varchar(20), fechafin, 103),
@cnet = cNoContratoCnet
from (

SELECT [Contrato CNET] cNoContratoCNET, REPLACE([CONCEPTO DEL CONTRATO], '"', '') DescripcionPedCont, [Partida Presupuestal] partida, [Razón Social] razonsocial, [Fecha Inicio] fechainicio, [Fecha Fin] fechafin
FROM [v_mMontoMaximoContratoPartPresupuestal] 
WHERE  [Contrato SAI]  = @contrato
UNION
select cIdContrato, cConceptoContrato
, isnull((select dbo.fn_mCadenaPartidasContrato(PD.cIdContrato)),'')partida
, ISNULL(BEN.dNombre, '') + ' ' + ISNULL(BEN.dApellidoPaterno, '') + ' '+ ISNULL(BEN.dApellidoMaterno, '') NOMBRE
,  CONVERT(varchar(10), fContratoIni, 103) fContratoIni,  CONVERT(varchar(10), fContratoFin, 103) fContratoFin
from pContratoDiverso PD WITH (NOLOCK)
INNER JOIN tBeneficiario BEN WITH (NOLOCK)
ON PD.cIdRFC = BEN.dRFC
where   cIdContrato = @contrato
) as tbl


SELECT  PARTIDA, ISNULL(ENERO, 0 ) ENERO, ISNULL(FEBRERO,0 ) FEBRERO, ISNULL(MARZO,0) MARZO, ISNULL(ABRIL,0 )ABRIL , ISNULL( MAYO,0) MAYO, ISNULL(JUNIO,0) JUNIO
, ISNULL(JULIO,0) JULIO, ISNULL(AGOSTO, 0) AGOSTO, ISNULL(SEPTIEMBRE,0) SEPTIEMBRE, ISNULL(OCTUBRE,0) OCTUBRE, ISNULL(NOVIEMBRE,0) NOVIEMBRE, ISNULL(DICIEMBRE,0) DICIEMBRE, ISNULL(TOTAL_ANUAL,0) TOTAL_ANUAL
, case when cEsCalendario = 'S' THEN @parrafoCalendario 
WHEN @noConvenio !='' THEN @parrafoConvenio
else @parrafo1  end parrafo1
, @proveedor proveedor, @vigencia vigencia, @cnet cnet
, isnull(@noConvenio, '') folioConvenio
, isnull(@fInicioConv, '') inicioConv
, isnull(@fFinConv, '') finConvenio
FROM #CONTRATO CONTRATO




DROP TABLE #CONTRATO]]>
	</queryString>
