	<import value="net.sf.jasperreports.engine.data.*"/>
	<parameter name="swhere" class="java.lang.String">
		<defaultValueExpression><![CDATA["and canocontrarrecibo ='10CP2021100587'"]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select tre.caNoContrarrecibo,tre.cIdRelacion,trd.EP, sum( trd.mImporteMasIVA) Importe,tre.cnombre,tre.nFolioRELACIONGASTOS,'RG' as tipodoc, sFirmanteVoBo, sPuestoVoBo, sFirmanteAut, sPuestoAut, sFirmanteEla, sPuestoEla
INTO #tmp_anexo_fac
from  tRELACIONGASTOSDetalle trd (NOLOCK)
inner join tRELACIONGASTOSEncabezado tre (NOLOCK)
on trd.nFolioRELACIONGASTOS=tre.nFolioRELACIONGASTOS
where 1 = 1 $P!{swhere}
group by tre.caNoContrarrecibo, tre.cIdRelacion, trd.EP, tre.cnombre, tre.nFolioRELACIONGASTOS, sFirmanteVoBo, sPuestoVoBo, sFirmanteAut, sPuestoAut, sFirmanteEla, sPuestoEla

insert into #tmp_anexo_fac
select tre.caNoContrarrecibo, tre.cIdDocumento, trd.EP, sum(trd.mImporteMasIVA) Importe, isnull(b.dNombre, '') + ' ' + isnull(b.dApellidoPaterno, '') + ' ' + isnull(b.dApellidoMaterno, '') cnombre, tre.nFolioPagoDirecto,'PI' as tipodoc, sFirmanteVoBo, sPuestoVoBo, sFirmanteAut, sPuestoAut, sFirmanteEla, sPuestoEla
from  tPagoDirectoDetalle trd (NOLOCK) inner join tPagoDirectoEncabezado tre (NOLOCK) on trd.nFolioPagoDirecto=tre.nFolioPagoDirecto inner join tbeneficiario b on
tre.cIdRFC = b.drfc
where 1 = 1 $P!{swhere}
group by tre.caNoContrarrecibo, tre.cIdDocumento, trd.EP, isnull(b.dNombre, '') + ' ' + isnull(b.dApellidoPaterno, '') + ' ' + isnull(b.dApellidoMaterno, ''), tre.nFolioPagoDirecto, sFirmanteVoBo, sPuestoVoBo, sFirmanteAut, sPuestoAut, sFirmanteEla, sPuestoEla

insert into #tmp_anexo_fac
select tre.caNoContrarrecibo, tre.cIdRelacion, trd.EP, sum(trd.mImporteMasIVA) Importe, tre.cNombre, tre.nFolioNOMINA, 'NO' as tipodoc,'','','','', '', ''
from  tNOMINADetalle trd (NOLOCK) inner join tNOMINAEncabezado tre (NOLOCK) on trd.nFolioNOMINA=tre.nFolioNOMINA
 where 1 = 1 $P!{swhere}
group by tre.caNoContrarrecibo, tre.cIdRelacion, trd.EP, tre.cNombre, tre.nFolioNOMINA

insert into #tmp_anexo_fac
select tre.caNoContrarrecibo, tre.cFolioContratoObra, trd.EP, sum(trd.mImporteMasIVA) Importe, isnull(b.dNombre, '') + ' ' + isnull(b.dApellidoPaterno, '') + ' ' + isnull(b.dApellidoMaterno, ''), tre.nFolioPAGOOBRA, 'PO' as tipodoc, sFirmanteVoBo, sPuestoVoBo, sFirmanteAut, sPuestoAut, sFirmanteEla, sPuestoEla
from  tPAGOOBRADetalle trd (NOLOCK) inner join tPAGOOBRAEncabezado tre (NOLOCK) on trd.nFolioPAGOOBRA=tre.nFolioPAGOOBRA and left(trd.cEvento, 8) <> 'ANTICIPO' inner join tbeneficiario b on
tre.RFC = b.drfc
where 1 = 1 $P!{swhere}
Group by tre.caNoContrarrecibo, tre.cFolioContratoObra, trd.EP, isnull(b.dNombre, '') + ' ' + isnull(b.dApellidoPaterno, '') + ' ' + isnull(b.dApellidoMaterno, ''), tre.nFolioPAGOOBRA, sFirmanteVoBo, sPuestoVoBo, sFirmanteAut, sPuestoAut, sFirmanteEla, sPuestoEla

insert into #tmp_anexo_fac
select tre.caNoContrarrecibo, tre.cFolioContratoObra, trd.EP, sum(trd.mImporteMasIVA) Importe, isnull(b.dNombre, '') + ' ' + isnull(b.dApellidoPaterno, '') + ' ' + isnull(b.dApellidoMaterno, ''), tre.nFolioPAGOFEDERALIZADO, 'PF' as tipodoc, sFirmanteVoBo, sPuestoVoBo, sFirmanteAut, sPuestoAut, sFirmanteEla, sPuestoEla
from  tPAGOFEDERALIZADODetalle trd (NOLOCK) inner join tPAGOFEDERALIZADOEncabezado tre (NOLOCK) on trd.nFolioPAGOFEDERALIZADO=tre.nFolioPAGOFEDERALIZADO  and left(trd.cEvento, 8) <> 'ANTICIPO' inner join tbeneficiario b on
tre.RFC = b.drfc
where 1 = 1 $P!{swhere}
Group by tre.caNoContrarrecibo, tre.cFolioContratoObra, trd.EP, trd.EP, isnull(b.dNombre, '') + ' ' + isnull(b.dApellidoPaterno, '') + ' ' + isnull(b.dApellidoMaterno, ''), tre.nFolioPAGOFEDERALIZADO, sFirmanteVoBo, sPuestoVoBo, sFirmanteAut, sPuestoAut, sFirmanteEla, sPuestoEla

insert into #tmp_anexo_fac
select tre.caNoContrarrecibo, tre.cFolioPAGODIVERSO, trd.EP, sum(trd.mImporteMasIVA), isnull(b.dNombre, '') + ' ' + isnull(b.dApellidoPaterno, '') + ' ' + isnull(b.dApellidoMaterno, ''),  tre.nFolioPAGODIVERSO, 'PD' as tipodoc, sFirmanteVoBo, sPuestoVoBo, sFirmanteAut, sPuestoAut, sFirmanteEla, sPuestoEla
from  tPAGODIVERSODetalle trd (NOLOCK) inner join tPAGODIVERSOEncabezado tre (NOLOCK) on trd.nFolioPAGODIVERSO=tre.nFolioPAGODIVERSO  and left(trd.cEvento, 8) <> 'ANTICIPO' inner join tbeneficiario b on
rtrim(tre.RFC) = rtrim(b.drfc)
 where 1 = 1 $P!{swhere}
Group by tre.caNoContrarrecibo, tre.cFolioPAGODIVERSO, trd.EP, isnull(b.dNombre, '') + ' ' + isnull(b.dApellidoPaterno, '') + ' ' + isnull(b.dApellidoMaterno, ''), tre.nFolioPAGODIVERSO, sFirmanteVoBo, sPuestoVoBo, sFirmanteAut, sPuestoAut, sFirmanteEla, sPuestoEla

insert into #tmp_anexo_fac
select tre.caNoContrarrecibo, tre.nFolioPAGOOBRA, trd.EP, sum(trd.mImporteMasIVA), isnull(b.dNombre, '') + ' ' + isnull(b.dApellidoPaterno, '') + ' ' + isnull(b.dApellidoMaterno, ''),  tre.nFolioPAGOOBRA, 'PO' as tipodoc, sFirmanteVoBo, sPuestoVoBo, sFirmanteAut, sPuestoAut, sFirmanteEla, sPuestoEla
from  tPAGOobraDetalle trd (NOLOCK) inner join tPAGOobraEncabezado tre (NOLOCK) on trd.nFolioPAGOOBRA=tre.nFolioPAGOOBRA  and left(trd.cEvento, 8) <> 'ANTICIPO' inner join tbeneficiario b on
rtrim(tre.RFC) = rtrim(b.drfc)
 where 1 = 1 $P!{swhere}
Group by tre.caNoContrarrecibo, tre.nFolioPAGOOBRA, trd.EP, isnull(b.dNombre, '') + ' ' + isnull(b.dApellidoPaterno, '') + ' ' + isnull(b.dApellidoMaterno, ''), tre.nFolioPAGOOBRA, sFirmanteVoBo, sPuestoVoBo, sFirmanteAut, sPuestoAut, sFirmanteEla, sPuestoEla

/*select caNoContrarrecibo, cIdRelacion, EP, SUM(Importe) AS Importe, cnombre, nFolioRELACIONGASTOS, tipodoc
from #tmp_anexo_fac
GROUP BY caNoContrarrecibo,cIdRelacion,EP,cnombre,nFolioRELACIONGASTOS,tipodoc*/

DECLARE @tipo NVARCHAR(50) = (SELECT TOP 1 tipodoc FROM #tmp_anexo_fac)
DECLARE @num INT = (SELECT TOP 1 nFolioRELACIONGASTOS FROM #tmp_anexo_fac)
DECLARE @vobo VARCHAR(2000) = (SELECT DISTINCT sFirmanteVoBo nFolioRELACIONGASTOS FROM #tmp_anexo_fac)
DECLARE @puestovobo VARCHAR(2000) = (SELECT DISTINCT sPuestoVoBo nFolioRELACIONGASTOS FROM #tmp_anexo_fac)
DECLARE @autorizo VARCHAR(2000) = (SELECT DISTINCT sFirmanteAut nFolioRELACIONGASTOS FROM #tmp_anexo_fac)
DECLARE @puestoautorizo VARCHAR(2000) = (SELECT DISTINCT sPuestoAut nFolioRELACIONGASTOS FROM #tmp_anexo_fac)
DECLARE @elaboro VARCHAR(2000) = (SELECT DISTINCT sFirmanteEla nFolioRELACIONGASTOS FROM #tmp_anexo_fac)
DECLARE @puestoelaboro VARCHAR(2000) = (SELECT DISTINCT sPuestoEla nFolioRELACIONGASTOS FROM #tmp_anexo_fac)

DECLARE @nFolioPago INT
DECLARE @cTipoPago VARCHAR(64)
DECLARE @sFirmanteDelegatorio VARCHAR(250)
DECLARE @sPuestoFirmanteDelegatorio VARCHAR(70)
DECLARE @sFirmanteAut VARCHAR(250)
DECLARE @sLeyenda VARCHAR(500)
DECLARE @sOficio VARCHAR(128)
DECLARE @sFechaOficio VARCHAR(20)
DECLARE @cTipoSuplencia VARCHAR(20)

SET @cTipoPago = ''

SET	@sFirmanteDelegatorio = ''
SET @sPuestoFirmanteDelegatorio = ''

SET @sFirmanteAut = ''
SET @sLeyenda = ''
SET @sOficio = ''
SET @sFechaOficio = ''



SELECT cfactura, mimporteconiva, @vobo sFirmanteVoBo, @puestovobo sPuestoVoBo, @autorizo sFirmanteAut, @puestoautorizo sPuestoAut, @elaboro sFirmanteEla
, @puestoelaboro sPuestoEla, cTipoPago, dFechaFactura
INTO #tmpTablaSalida
FROM dbo.tPagoFactura (NOLOCK) WHERE nFolioPago=@num AND cTipoPago = CASE @tipo
	WHEN 'PI' THEN 'PAGODIRECTO'
	--WHEN 'NOMINA' THEN ''
	WHEN 'PD' THEN 'PAGODIVERSO'
	WHEN 'RG' THEN 'RELACIONGASTOS'
	WHEN 'PO' THEN 'PAGOOBRA'
	WHEN 'PF' THEN 'PAGOFEDERALIZADO'
	END

	SET @nFolioPago = @num
	SET @cTipoPago =	(	CASE @tipo
							WHEN 'PI' THEN 'PAGODIRECTO'
							WHEN 'PD' THEN 'PAGODIVERSO'
							WHEN 'RG' THEN 'RELACIONGASTOS'
							WHEN 'PO' THEN 'PAGOOBRA'
							WHEN 'PF' THEN 'PAGOFEDERALIZADO'
							END
						)

	IF (SELECT COUNT(*) FROM tPagoFirmanteDelagatorio WITH (NOLOCK) WHERE cTipoPago = @cTipoPago AND nFolioPago = @nFolioPago) > 0
		BEGIN

			SELECT TOP 1 @sFirmanteAut = sFirmanteAut FROM #tmpTablaSalida WITH (NOLOCK)

		SELECT	@sFirmanteDelegatorio = (cNombreTitular + ' ' + cApellidoPaternoTitular + ' ' + cApellidoMaternoTitular)
			, @sPuestoFirmanteDelegatorio = cPuestoTitular
			, @sOficio = cFolioOficio, @sFechaOficio = CONVERT(varchar(10)
			, CONVERT(date, dFechaOficio, 106), 103)
			, @cTipoSuplencia = cTipoSuplencia
		FROM tPagoFirmanteDelagatorio pago WITH (NOLOCK)
			INNER JOIN tCatTipoSuplencia WITH (NOLOCK)
				ON pago.nTipoSuplencia = tCatTipoSuplencia.ntiposuplencia
		WHERE cTipoPago = @cTipoPago AND nFolioPago = @nFolioPago

			SET @sLeyenda = 'Firma ' + @cTipoSuplencia + ' de: ' + @sFirmanteAut + ', con fundamento en el oficio: ' + @sOficio + ' de fecha: ' + @sFechaOficio + '.'
		END

	SELECT *, @sFirmanteDelegatorio AS sFirmanteDelegatorio, @sPuestoFirmanteDelegatorio AS sPuestoFirmanteDelegatorio, @sLeyenda AS sLeyenda
	FROM #tmpTablaSalida WITH (NOLOCK)

IF (SELECT OBJECT_ID('tempdb..#tmpTablaSalida')) IS NOT NULL	DROP TABLE #tmpTablaSalida]]>
	</queryString>
