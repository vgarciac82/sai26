<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="OP_Reporte_Nacional_Proyecto_Presupuestario" pageWidth="792" pageHeight="612" orientation="Landscape" columnWidth="752" leftMargin="20" rightMargin="20" topMargin="10" bottomMargin="10" uuid="34422278-ad34-4fde-9219-9cb227666b9e">
	<property name="ireport.zoom" value="1.0245201830476063"/>
	<property name="ireport.x" value="59"/>
	<property name="ireport.y" value="0"/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="SAI_2021_produccion"/>
	<parameter name="fIni" class="java.lang.String"/>
	<parameter name="fFin" class="java.lang.String">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select 'NADA' tipoArea, Oiginal, case when Modificado = 0 then .0000001 else modificado end Modificado,dProgramaPresupuestario
, isnull (tabContr.mimporte, 0)mimporte ,  Tsal.cProgramaPresupuestario, isnull (tabContr.monto,0) monto
, isnull (tabContr.montoEstimado,0) montoEstimado, isnull (tabContr.montoEjecutado,0) montoEjecutado , isnull (tabContr.TOTAL_MN,0)TOTAL_MN
from (select
catEP.cprogramapresupuestario ,
proy.dProgramaPresupuestario dProgramaPresupuestario
,sum(case when substring(s.nCuenta,1,5) = '81101' then s.mSaldoarrastre else 0 end)/1000.00 Oiginal
,sum(case when substring(s.nCuenta,1,5) = '81102' then s.mSaldoarrastre else 0 end)/1000.00 Modificado
 from tSaldos S with(nolock)
, tcatalogoep catEP  with(nolock)
, tCatalogoCentroContable CC with(nolock)
, tCatUnidadResponsable UResp with(nolock)
, tCatUnidadResponsable UNor with(nolock)
, tCatUnidadResponsable Ueje with(nolock)
 , tCatalogoProgramaPresupuestario Proy with(nolock)
where catep.EP = s.cSubCuenta and  CC.CcENTROcONTABLE = S.cCentroContable
    and catep.cProgramaPresupuestario =Proy.cProgramaPresupuestario
and UResp.cUnidadResponsable = s.cUnidadResponsable
  and unor.cUnidadResponsable = cUnidadNorativa
  and Ueje.cUnidadResponsable = cUnidadEjecutora
    AND (nCuenta like '81101%' or nCuenta like '81102%')
  and cPartida  like '6%'
group by
  catEP.cprogramapresupuestario
  ,proy.dProgramaPresupuestario  ) Tsal left join
(select
sum(isnull(mimporte, 0)) mimporte, contProy.cprogramapresupuestario, sum(isnull(monto, 0)) monto, sum(isnull(montoEstimado, 0)) montoEstimado
, sum(isnull(montoEjecutado, 0)) montoEjecutado, sum(TOTAL_MN) TOTAL_MN
 from (select epscontr.*, cprogramapresupuestario from (select ae.cU_UR, ae.cU_UE, foliosai, ep, sum(mimporte) mimporte from tobrapublicaapartadodetalle ad with(nolock), tobrapublicaapartadoencabezado ae with(nolock) where ae.nFolioOPAHeader = ad.nFolioOPAHeader
 and not exists (select 1 from tobrapublicaprecompromisoencabezado ss where ss.FolioSAI = ae.foliosai)
 group by foliosai, ep, ae.cU_UR, ae.cU_UE
union
select ae.cU_UR, ae.cU_UE, foliosai, ep, sum(mimporte) mimporte from tobrapublicaprecompromisodetalle ad with(nolock), tobrapublicaprecompromisoencabezado ae with(nolock) where ae.nFolioOPPreComHeader = ad.nFolioOPPreComHeader
 and not exists (select 1 from tobrapublicacompromisoencabezado ss where ss.FolioSAI = ae.foliosai)
  group by foliosai, ep, ae.cU_UR, ae.cU_UE
union
select ae.cU_UR, ae.cU_UE, foliosai, ep, sum(mimporte) mimporte from tobrapublicacompromisodetalle ad with(nolock), tobrapublicacompromisoencabezado ae with(nolock) where ae.nFolioOPComHeader = ad.nFolioOPComHeader
 and not exists (select 1 from tobrapublicapagopasivoencabezado ss where ss.FolioSAI = ae.foliosai)
  group by foliosai, ep, ae.cU_UR, ae.cU_UE
union
select ae.cU_UR, ae.cU_UE, foliosai, ep, sum(mimporte) mimporte from tobrapublicapagopasivodetalle ad with(nolock), tobrapublicapagopasivoencabezado ae with(nolock) where ae.nFolioOPPagPasHeader = ad.nFolioOPPagPasHeader
  group by foliosai, ep, ae.cU_UR, ae.cU_UE ) epsContr, tcatalogoep cep with(nolock) where epsContr.EP = cep.ep
) contProy
LEFT JOIN (select
avfEnc.foliosai, (sum(ISNULL(pasEnc.mMontoConIVA,ISNULL(comEnc.nMontoConIVA,ISNULL(preEnc.nMontoConIVA,ISNULL(apaEnc.nMontoConIVA,0)))) +isnull(conmod.mMontoconIva, 0)))/1000.00 monto
, sum(isnull(mmontoestimacion, 0))/1000.00 montoEstimado, sum(isnull(mmontoFisicoEjecutado, 0))/1000.00 montoEjecutado, SUM(ISNULL(TOTAL_MN,0))/1000.00 TOTAL_MN
   from
 tObraPublicaApartadoEncabezado apaEnc with(nolock)
 left join tObraPublicaApartadoEncabezado preEnc with(nolock) on apaEnc.foliosai = preenc.FolioSAI
 left join tObraPublicaCompromisoEncabezado comEnc with(nolock) on apaEnc.foliosai = comEnc.FolioSAI
 left join tObraPublicaPagoPasivoEncabezado pasEnc with(nolock) on apaEnc.foliosai = pasEnc.FolioSAI
 left join ( select af.foliosai,sum(isnull(af.mmontoestimacion,0)) mmontoestimacion, af.efiscalpago
 , sum(isnull(af.nporceavancefisicoejecutado,0)) nporceavancefisicoejecutado
 , sum(isnull(af.nporceavancefisicoestimado,0)) nporceavancefisicoestimado
 , sum(isnull(af.mmontoFisicoEjecutado,0)) mmontoFisicoEjecutado
 , sum(isnull(af.nporceavancefisicoprogramado,0)) nporceavancefisicoprogramado
 , sum(isnull(
 CASE WHEN siaff.FOLIO_CLC = sicop.FOLIO_SIAFF_112 and sicop.FOLIO_SIAFF_112 = pe.nFolioSIAFF and obrae.cDocumentoHaplicado = 'S' and siaff.ESTATUS_CLC = 'Pagada' THEN CAST(SIAFF.TOTAL_MN AS MONEY) ELSE 0 END
 ,0)) TOTAL_MN
  FROM tObraPublicaAvanceFisico AF with(nolock)
							 left join tpagoobraencabezado obrae with(nolock) on AF.noestimacion = obrae.cNoEstimacion and AF.mmontoestimacion = obrae.mImporteMasIva and obrae.cDocumentoHaplicado != 'C'
							 left join tpagoobraencabezado poe with(nolock) on poe.cFolioContratoObra = AF.ccvecontrato and poe.cnoestimacion = AF.noestimacion and poe.cDocumentoHaplicado ='S'
							 left join tpagadoencabezado pe with(nolock) on pe.nFolioPAGO = obrae.nFolioPAGOOBRA and pe.cTipoPago ='PAGOOBRA'
							 left join clc_sicop sicop with(nolock) on sicop.FOLIO_SIAFF_112 = pe.nFolioSIAFF
							 left join CLC_SIAFF_ENC siaff with(nolock) on siaff.FOLIO_CLC = sicop.FOLIO_SIAFF_112
							  group by af.foliosai,af.efiscalpago
) avfEnc on apaEnc.foliosai = avfEnc.FolioSAI and avfEnc.efiscalpago = (SELECT aejerciciofiscal AS cEjercicio
				FROM   tejerciciofiscal WITH(NOLOCK)
				WHERE  cactivo = 1 )
left join (select epe.ccvecontrato, sum(epe.mMontoconIva) mMontoconIva, epe.cU_UR, epe.aEjercicioFiscal
   from tObraPublicaConvModifEncabezado epe with(nolock) where epe.cDocumentoHaplicado = 'S' and epe.aEjercicioFiscal =(SELECT aejerciciofiscal AS cEjercicio
				FROM   tejerciciofiscal WITH(NOLOCK)
				WHERE  cactivo = 1 )
    group by epe.cCveContrato, epe.cU_UR, epe.aEjercicioFiscal ) conMod
      on conmod.cCveContrato = comEnc.cCveContrato
 where apaEnc.cDocumentoHaplicado = 'S'
 and preEnc.cDocumentoHaplicado = 'S'
 and comEnc.cDocumentoHaplicado = 'S'
and comEnc.fFechaOficio >= cast($P{fIni} as datetime)
and comEnc.fFechaOficio <= cast($P{fFin} as datetime)
 and comenc.cCveContrato in (select e.cIdContrato from tCompromisoEncabezado e where e.cDocumentoHaplicado = 'S')
group by avfEnc.foliosai ) openc ON openc.foliosai = contProy.FOLIOSAI
 , tCatalogoProgramaPresupuestario progPres with (nolock)
 where progPres.cprogramapresupuestario = contProy.cprogramapresupuestario
group  BY contProy.cprogramapresupuestario
) tabContr on tabContr.cprogramapresupuestario = Tsal.cprogramapresupuestario
 order by dProgramaPresupuestario]]>
	</queryString>
	<field name="tipoArea" class="java.lang.String"/>
	<field name="Oiginal" class="java.math.BigDecimal"/>
	<field name="Modificado" class="java.math.BigDecimal"/>
	<field name="dProgramaPresupuestario" class="java.lang.String"/>
	<field name="mimporte" class="java.math.BigDecimal"/>
	<field name="cProgramaPresupuestario" class="java.lang.String"/>
	<field name="monto" class="java.math.BigDecimal"/>
	<field name="montoEstimado" class="java.math.BigDecimal"/>
	<field name="montoEjecutado" class="java.math.BigDecimal"/>
	<field name="TOTAL_MN" class="java.math.BigDecimal"/>
	<variable name="porcentajeAdjudicado" class="java.math.BigDecimal">
		<variableExpression><![CDATA[( new BigDecimal(0).compareTo($F{Modificado}) == 0 ? new BigDecimal(0) : $F{monto} .divide($F{Modificado} ))]]></variableExpression>
	</variable>
	<variable name="porcentajeEjecutado" class="java.math.BigDecimal">
		<variableExpression><![CDATA[(  new BigDecimal(0).compareTo($F{monto}) == 0 ? new BigDecimal( 0 ) : $F{montoEjecutado}.divide( $F{monto} ))]]></variableExpression>
	</variable>
	<variable name="porcentajeEstimado" class="java.math.BigDecimal">
		<variableExpression><![CDATA[(  new BigDecimal(0).compareTo($F{monto} )== 0 ? new BigDecimal(0)  : $F{montoEstimado} .divide( $F{monto} ))]]></variableExpression>
	</variable>
	<variable name="porcentajePagado" class="java.math.BigDecimal">
		<variableExpression><![CDATA[(  new BigDecimal(0).compareTo($F{monto}) == 0 ? new BigDecimal(0) : $F{TOTAL_MN}.divide( $F{monto} ))]]></variableExpression>
	</variable>
	<variable name="Oiginal_1" class="java.math.BigDecimal" resetType="Page" calculation="Sum">
		<variableExpression><![CDATA[$F{Oiginal}]]></variableExpression>
	</variable>
	<variable name="Modificado_1" class="java.math.BigDecimal" resetType="Page" calculation="Sum">
		<variableExpression><![CDATA[$F{Modificado}]]></variableExpression>
	</variable>
	<variable name="monto_1" class="java.math.BigDecimal" resetType="Page" calculation="Sum">
		<variableExpression><![CDATA[$F{monto}]]></variableExpression>
	</variable>
	<variable name="totPorcAdj" class="java.math.BigDecimal">
		<variableExpression><![CDATA[( new BigDecimal(0).compareTo( $V{Modificado_1}) == 0 ? new BigDecimal(0) : $V{monto_1} .divide( $V{Modificado_1} ))]]></variableExpression>
	</variable>
	<variable name="montoEjecutado_1" class="java.math.BigDecimal" resetType="Page" calculation="Sum">
		<variableExpression><![CDATA[$F{montoEjecutado}]]></variableExpression>
	</variable>
	<variable name="montoEstimado_1" class="java.math.BigDecimal" resetType="Page" calculation="Sum">
		<variableExpression><![CDATA[$F{montoEstimado}]]></variableExpression>
	</variable>
	<variable name="TOTAL_MN_1" class="java.math.BigDecimal" resetType="Page" calculation="Sum">
		<variableExpression><![CDATA[$F{TOTAL_MN}]]></variableExpression>
	</variable>
	<variable name="totPorcEjec" class="java.math.BigDecimal">
		<variableExpression><![CDATA[( new BigDecimal(0).compareTo( $V{monto_1}) == 0 ? new BigDecimal(0) : $V{montoEjecutado_1} .divide( $V{monto_1} ))]]></variableExpression>
	</variable>
	<variable name="totPorceEstim" class="java.math.BigDecimal">
		<variableExpression><![CDATA[(  new BigDecimal (0).compareTo($V{monto_1})  == 0 ? new BigDecimal(0) : $V{montoEstimado_1} .divide($V{monto_1} ))]]></variableExpression>
	</variable>
	<variable name="totPorcPag" class="java.math.BigDecimal">
		<variableExpression><![CDATA[( new BigDecimal (0).compareTo( $V{monto_1}) == 0 ? new BigDecimal(0) : $V{TOTAL_MN_1} .divide($V{monto_1} ))]]></variableExpression>
	</variable>
	<variable name="lbPeriodo" class="java.lang.String">
		<initialValueExpression><![CDATA[( $P{fIni}.equals("") ? "" : "Reporte del " + $P{fIni} )
+  ( $P{fFin}.equals("") ? "" : " al " + $P{fFin} )]]></initialValueExpression>
	</variable>
