	<queryString>
		<![CDATA[select cDescripcionProyecto, cJustifSolicitud, cFundamentoMotivacion, cEspecificacion, cJustificacionEconomica, cJustificacionPlazo
, mMontoMinimo, mMontoMaximo, mtotalcontrato mMontoTotalContrato, sFirmanteSol, sPuestoSol, folio
from vw_ContratosPlurianualEncabezado cont with(NOLOCK)
where folio =  $P{whereFolio}]]>
	</queryString>
