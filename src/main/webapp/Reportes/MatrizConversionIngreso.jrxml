<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="MatrizConversionDevengado"  pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="808" leftMargin="14" rightMargin="20" topMargin="14" bottomMargin="20">
	<property name="ireport.zoom" value="1.5"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="tipo" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT CRI
	, dCRI
	, cTipoIngreso
	, cMedioRecaudacion

	, SUBSTRING(cPasCargo,1,5) AS cCtaPasCargo
	, ISNULL(ctaspc.dCuenta,'') AS dCtaPasCargo
	, SUBSTRING(cPasAbono,1,5) AS cCtaPasAbono
	, ISNULL(ctaspa.dCuenta,'') as dCtaPasAbono

	, SUBSTRING(cCtaCargo,1,5) AS cCtaCargo
	, ISNULL(ctasc.dCuenta,'') AS dCtaCargo
	, SUBSTRING(cCtaAbono,1,5) AS cCtaAbono
	, ISNULL(ctasa.dCuenta,'') as dCtaAbono

	, CASE WHEN cRetenciones = '0' THEN '' ELSE cRetenciones  END cRetenciones
FROM tMatrizContableIngreso AS m WITH (NOLOCK)
LEFT JOIN tCuentas ctaspc WITH(NOLOCK) ON m.cPasCargo = ctaspc.nCuenta
LEFT JOIN tCuentas ctaspa WITH(NOLOCK) ON m.cPasAbono = ctaspa.nCuenta
JOIN tCuentas ctasc WITH(NOLOCK) ON m.cCtaCargo = ctasc.nCuenta
JOIN tCuentas ctasa WITH(NOLOCK) ON m.cCtaAbono = ctasa.nCuenta
WHERE idTipoMatriz = $P{tipo}
ORDER BY CRI, cPasCargo, cPasAbono, cCtaCargo, cCtaAbono]]>
	</queryString>
	<field name="CRI" class="java.lang.Integer"/>
	<field name="dCRI" class="java.lang.String"/>
	<field name="cTipoIngreso" class="java.lang.String"/>
	<field name="cMedioRecaudacion" class="java.lang.String"/>
	<field name="cCtaPasCargo" class="java.lang.String"/>
