	<field name="cCtaCargo" class="java.lang.String"/>
	<field name="dCtaCargo" class="java.lang.String"/>
	<field name="cCtaAbono" class="java.lang.String"/>
	<field name="dCtaAbono" class="java.lang.String"/>
	<field name="cRetenciones" class="java.lang.String"/>
