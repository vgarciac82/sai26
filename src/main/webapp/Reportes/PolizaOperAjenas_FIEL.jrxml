	<group name="caNoContrarrecibo">
		<groupExpression><![CDATA[$F{caNoContrarrecibo}]]></groupExpression>
		<groupHeader>
			<band height="394" splitType="Stretch">
				<rectangle>
					<reportElement key="rectangle" x="0" y="106" width="551" height="260" uuid="30433e70-32c9-447c-b09a-8bd563e042a6"/>
