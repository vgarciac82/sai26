	<parameter name="clabeInterBancaria" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select c.nFolioRelacionGastos, c.consecutivoFacturaEncabezado,A.cIdUnidadEjecutora, f.D_DESCRIPCION,
'RELACION DE GASTOS N° '+a.cIdDocumento as concepto,
A.cIdRFC,c.cRazonSocial as cnombre,a.cRazonsocial as razonSocialRelacion,  convert(varchar,c.fechaFactura,103)  fechaFactura, REPLACE(c.cIdFactura,'-','') factura, SUBSTRING(d.altaAlmacenaria,0,CHARINDEX('|',d.altaAlmacenaria)) altaAlmacenaria,
RTRIM(d.cIdSubPartida)+'.'+d.EP grupo,
 d.cIdSubPartida ,d.EP , e.cSubPartida, d.mImporteTotalFacturaDetalle ,
 rtrim(d.cIdSubPartida)+'-'+e.cSubPartida as descPartida
  ,(select SUM(mImporteTotalFacturaDetalle) as subTotalPartida from mRelacionGastosFacturasDetalle where nFolioRelacionGastos=a.ConsecutivoRELGASTOS and cIdSubPartida=d.cIdSubPartida
 and Ep=d.EP  group by cIdSubPartida, EP )Total
 ,(select SUM(mImporteTotalFacturaDetalle) as totalDocumento from mRelacionGastosFacturasDetalle where nFolioRelacionGastos=a.ConsecutivoRELGASTOS group by nFolioRelacionGastos) totalDocumento
 , dbo.CantidadConLetraPedido(CONVERT(MONEY,(select SUM(mImporteTotalFacturaDetalle) as totalDocumento from mRelacionGastosFacturasDetalle where nFolioRelacionGastos=a.ConsecutivoRELGASTOS group by nFolioRelacionGastos)),'PESOS') letra,
 x.strClabe as clabeInterBancaria,SUBSTRING(x.strClabe,7,11)as numeroCuenta,x.dBancoAbreviado as nombreBanco
 from mRelacionGastos a WITH(NOLOCK)
INNER JOIN v_PCATALOGORFC B ON a.cIdRFC=B.cIdRFC
inner join mRelacionGastosFacturasEncabezado c on
a.ConsecutivoRELGASTOS=c.nFolioRelacionGastos
inner join mRelacionGastosFacturasDetalle d on
c.nFolioRelacionGastos=d.nFolioRelacionGastos and c.cIdFactura=d.cIdFactura
inner join mCatalogoSubPartida e on
d.cIdSubPartida=e.cIdSubPartida
inner join v_unidadEjecutoraPadre f on a.cIdUnidadEjecutora=f.cUnidadResponsable
inner join (select cb.strCentroContable,cb.strClabe,cb.strUnidadEjecutora,tb.dBancoAbreviado   from tUECuentasBancarias cb ,tBancos tb
where   tb.cBanco =SUBSTRING(cb.strClabe,1,3))x
on x.strUnidadEjecutora=a.cIdUnidadEjecutora
and x.strCentroContable=a.cIdEntidadContable
where cIdDocumento=$P{cIdDocumento}
--and a.cIdUnidadEjecutora='b03'
and x.strClabe=$P{clabeInterBancaria}
order by cIdSubPartida,c.consecutivoFacturaEncabezado]]>
	</queryString>
