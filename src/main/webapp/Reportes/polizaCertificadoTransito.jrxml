	<parameter name="SUBREPORT_DIR" class="java.lang.String">
		<defaultValueExpression><![CDATA["\\Axtel\\Clientes\\CONAFOR\\Workspaces\\sai\\WebContent\\Reportes\\"]]></defaultValueExpression>
	</parameter>
	<parameter name="whereFolio" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[SELECT 'Se crea el presente documento para la comisión con folio:  ' +  cast(comision.nIdComision  as varchar(8)) + ' titulada  "' + cNombreComision + '" para el C. ' +  dbo.fn_mayusc_formato(nombreCompleto ) + ' servidor publico adscrito a la institucion' concepto,
'La comisión es ordenada por la Unidad Administrativa ' + dbo.fn_mayusc_formato(UR.D_DESCRIPCION) 
+ ' y fue autorizada por toda la cadena de mando correspondiente, bajo el siguiente itinerario:' concepto2,
dbo.fn_mayusc_formato(nombreCompleto ) nombreCompleto, cFolioCertificado,
'A ' + cast(day(comision.fAplicacion) as varchar(2)) + ' de ' +  dbo.fn_NombreMeses(month(comision.fAplicacion)) + ' de ' + cast(year(comision.fAplicacion) as varchar(4)) fecha
, dbo.fn_mayusc_formato(UR.D_DESCRIPCION)  UR
, comision.nIdComision, cNombreComision
FROM tComision comision
INNER JOIN v_Empleados EMP
ON emp.nEmpleado = comision.nidEmpleado
INNER JOIN tCatUnidadResponsable UR
ON UR.cUnidadResponsable = comision.cUnidadResponsable
WHERE nIdComision =  $P{whereFolio}]]>
	</queryString>
