	<parameter name="nFolio" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[declare @anio int
set @anio = (select MIN(aejercicio) from tContratosPlurianual_EjercicioMod (NOLOCK) where  nFolioContratoPlurianual = $P{nFolio})
declare @veces int = (select COUNT(*) from tContratosPlurianual_EjercicioMod (NOLOCK) where  nFolioContratoPlurianual = $P{nFolio})

if (@veces = 2)
	begin
		select nFolioContratoPlurianual, cDescripcionProyecto, mMontoTotalContrato,
		(select mimporteEjercicio from tContratosPlurianual_EjercicioMod (NOLOCK) where nFolioContratoPlurianual = enc.nFolioContratoPlurianual
		and aEjercicio = @anio) ImporteA1
		,(select mimporteEjercicio from tContratosPlurianual_EjercicioMod (NOLOCK) where nFolioContratoPlurianual = enc.nFolioContratoPlurianual
		and aEjercicio = @anio + 1) ImporteA2
        , 0 ImporteA3, 0 ImporteA4, 0 ImporteA5, 0 ImporteA6
        , @veces veces, @anio anio
		from tContratosPlurianualEnc_Mod enc (NOLOCK)
		where enc.nFolioContratoPlurianual =$P{nFolio}
	END
ELSE IF @veces = 3
	BEGIN
		select nFolioContratoPlurianual, cDescripcionProyecto, mMontoTotalContrato,
			(select mimporteEjercicio from tContratosPlurianual_EjercicioMod (NOLOCK) where nFolioContratoPlurianual = enc.nFolioContratoPlurianual
			and aEjercicio = @anio) ImporteA1
			,(select mimporteEjercicio from tContratosPlurianual_EjercicioMod (NOLOCK) where nFolioContratoPlurianual = enc.nFolioContratoPlurianual
			and aEjercicio = @anio + 1) ImporteA2
			,(select mimporteEjercicio from tContratosPlurianual_EjercicioMod (NOLOCK) where nFolioContratoPlurianual = enc.nFolioContratoPlurianual
			and aEjercicio = @anio + 2) ImporteA3
            , 0 ImporteA4, 0 ImporteA5, 0 ImporteA6
            , @veces veces, @anio anio
			from tContratosPlurianualEnc_Mod enc (NOLOCK)
			where enc.nFolioContratoPlurianual = $P{nFolio}
	END
ELSE IF @veces =4
	BEGIN
		select nFolioContratoPlurianual, cDescripcionProyecto, mMontoTotalContrato,
			(select mimporteEjercicio from tContratosPlurianual_EjercicioMod (NOLOCK) where nFolioContratoPlurianual = enc.nFolioContratoPlurianual
			and aEjercicio = @anio) ImporteA1
			,(select mimporteEjercicio from tContratosPlurianual_EjercicioMod (NOLOCK) where nFolioContratoPlurianual = enc.nFolioContratoPlurianual
			and aEjercicio = @anio + 1) ImporteA2
			,(select mimporteEjercicio from tContratosPlurianual_EjercicioMod (NOLOCK) where nFolioContratoPlurianual = enc.nFolioContratoPlurianual
			and aEjercicio = @anio + 2) ImporteA3
			,(select mimporteEjercicio from tContratosPlurianual_EjercicioMod (NOLOCK) where nFolioContratoPlurianual = enc.nFolioContratoPlurianual
			and aEjercicio = @anio + 3) ImporteA4
            , 0 ImporteA5, 0 ImporteA6
            , @veces veces, @anio anio
			from tContratosPlurianualEnc_Mod enc (NOLOCK)
			where enc.nFolioContratoPlurianual = $P{nFolio}
	END
ELSE IF @veces =5
	BEGIN
		select nFolioContratoPlurianual, cDescripcionProyecto, mMontoTotalContrato,
			(select mimporteEjercicio from tContratosPlurianual_EjercicioMod (NOLOCK) where nFolioContratoPlurianual = enc.nFolioContratoPlurianual
			and aEjercicio = @anio) ImporteA1
			,(select mimporteEjercicio from tContratosPlurianual_EjercicioMod (NOLOCK) where nFolioContratoPlurianual = enc.nFolioContratoPlurianual
			and aEjercicio = @anio + 1) ImporteA2
			,(select mimporteEjercicio from tContratosPlurianual_EjercicioMod (NOLOCK) where nFolioContratoPlurianual = enc.nFolioContratoPlurianual
			and aEjercicio = @anio + 2) ImporteA3
			,(select mimporteEjercicio from tContratosPlurianual_EjercicioMod (NOLOCK) where nFolioContratoPlurianual = enc.nFolioContratoPlurianual
			and aEjercicio = @anio + 3) ImporteA4
			,(select mimporteEjercicio from tContratosPlurianual_EjercicioMod (NOLOCK) where nFolioContratoPlurianual = enc.nFolioContratoPlurianual
			and aEjercicio = @anio + 4) ImporteA5
            , 0 ImporteA6
            , @veces veces, @anio anio
			from tContratosPlurianualEnc_Mod enc (NOLOCK)
			where enc.nFolioContratoPlurianual = $P{nFolio}
	END
ELSE IF @veces =6
	BEGIN
		select nFolioContratoPlurianual, cDescripcionProyecto, mMontoTotalContrato,
			(select mimporteEjercicio from tContratosPlurianual_EjercicioMod (NOLOCK) where nFolioContratoPlurianual = enc.nFolioContratoPlurianual
			and aEjercicio = @anio) ImporteA1
			,(select mimporteEjercicio from tContratosPlurianual_EjercicioMod (NOLOCK) where nFolioContratoPlurianual = enc.nFolioContratoPlurianual
			and aEjercicio = @anio + 1) ImporteA2
			,(select mimporteEjercicio from tContratosPlurianual_EjercicioMod (NOLOCK) where nFolioContratoPlurianual = enc.nFolioContratoPlurianual
			and aEjercicio = @anio + 2) ImporteA3
			,(select mimporteEjercicio from tContratosPlurianual_EjercicioMod (NOLOCK) where nFolioContratoPlurianual = enc.nFolioContratoPlurianual
			and aEjercicio = @anio + 3) ImporteA4
			,(select mimporteEjercicio from tContratosPlurianual_EjercicioMod (NOLOCK) where nFolioContratoPlurianual = enc.nFolioContratoPlurianual
			and aEjercicio = @anio + 4) ImporteA5
			,(select mimporteEjercicio from tContratosPlurianual_EjercicioMod (NOLOCK) where nFolioContratoPlurianual = enc.nFolioContratoPlurianual
			and aEjercicio = @anio + 5) ImporteA6
            , @veces veces, @anio anio
			from tContratosPlurianualEnc_Mod enc (NOLOCK)
			where enc.nFolioContratoPlurianual = $P{nFolio}
	END]]>
	</queryString>
