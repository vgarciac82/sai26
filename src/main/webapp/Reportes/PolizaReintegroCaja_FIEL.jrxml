	<parameter name="whereFolio" class="java.lang.String">
		<defaultValueExpression><![CDATA["and ce.nFolioReintegrocaja = 44"]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[DECLARE @nFolioPago INT
DECLARE @cTipoPago VARCHAR(64)
DECLARE @sFirmanteDelegatorio VARCHAR(250)
DECLARE @sPuestoFirmanteDelegatorio VARCHAR(70)
DECLARE @sFirmanteAut VARCHAR(250)
DECLARE @sLeyenda VARCHAR(500)
DECLARE @sOficio VARCHAR(128)
DECLARE @sFechaOficio VARCHAR(20)
DECLARE @cTipoSuplencia VARCHAR(20)

DECLARE @sFirmanteDeleVoBo VARCHAR(250)
DECLARE @sPuestoFirmanteDeleVoBo VARCHAR(70)
DECLARE @sFirmanteVoBo VARCHAR(250)
DECLARE @sLeyendaVoBo VARCHAR(500)
DECLARE @sOficioVoBo VARCHAR(128)
DECLARE @sFechaOficioVoBo VARCHAR(20)

SET @cTipoPago = 'REINTEGROCAJA'

SET	@sFirmanteDelegatorio = ''
SET @sPuestoFirmanteDelegatorio = ''

SET @sFirmanteAut = ''
SET @sLeyenda = ''
SET @sOficio = ''
SET @sFechaOficio = ''

SET @sPuestoFirmanteDeleVoBo = ''
SET @sFirmanteVoBo = ''
SET @sLeyendaVoBo = ''
SET @sOficioVoBo = ''
SET @sFechaOficioVoBo = ''

SELECT
	ce.nFolioReintegrocaja
	, cDocumentohAplicado
	,ce.fcreacion
	,ce.faplicacion
	,cd.mimporte
	,ISNULL((SELECT DISTINCT cd.ctab + ' ' + strNombreBeneficiario FROM tuecuentasbancarias WHERE strClabe=cd.CTAB),'No Aplica') AS CTAB
	,ISNULL(cd.rfc,'No Aplica') AS rfc
	,ISNULL(tb.dNombre + ' ' + tb.dApellidoPaterno + ' ' + tb.dApellidoMaterno,'No Aplica') AS nombreRFC
	,'Cuenta: ' + CASE WHEN cd.nCuentaBeneficiario = '' OR cd.nCuentaBeneficiario = ' ' OR cd.nCuentaBeneficiario IS NULL THEN 'N/A' ELSE cd.nCuentaBeneficiario END + '  Banco:  ' + ISNULL(ctabe.dBanco,'N/A') AS CuentaBeneficiario
	,'Clabe: ' + ISNULL(ctabe.subCuentaBancaria,'N/A') AS clabe
	,'Partida: ' + CASE WHEN FFM = 'undefined' OR FFM = '' OR FFM = 'NA' THEN '' ELSE ISNULL(SUBSTRING(FFM,1,5),'') END AS partida
	,CASE WHEN FFM = 'undefined' OR FFM = '' OR FFM = 'NA' THEN '' ELSE ISNULL(SUBSTRING(FFM,6,15),'') END AS Programa
	, sFFM.cDescripcion AS DescripcionFFM
	,ce.cdescripcionpoliza
	,ce.cTipoPoliza
	,(SELECT ISNULL(NOMBREN,'') + ' ' + ISNULL(NOMBREP,'') + ' ' + ISNULL(NOMBREM,'') FROM v_empleados_giro WHERE clave = nnumEmpleadoVobo) AS sFirmanteVoBo
	,(SELECT descripcion_puesto FROM v_empleados_giro WHERE clave = nnumEmpleadoVobo) AS sPuestoVoBo
	,(SELECT ISNULL(NOMBREN,'') + ' ' + ISNULL(NOMBREP,'') + ' ' + ISNULL(NOMBREM,'') FROM v_empleados_giro WHERE clave = nnumEmpleadoAut) AS sFirmanteAut
	,(SELECT descripcion_puesto FROM v_empleados_giro WHERE clave = nnumEmpleadoAut) AS sPuestoAut
	,cd.cevento + ' ' + ev.dEvento AS cevento
	,cd.ceventoDestino + ' ' + evd.dEvento AS ceventoDestino
	,cd.ccentrocontable
	,(SELECT cDescripcion FROM tCatalogoCentroContable AS ccc WITH (NOLOCK) WHERE ccc.cCentroContable=cd.ccentrocontable) AS dCENTROCONTABLE
	,ce.cunidadejecutora + ' ' + ue.D_DESCRIPCION AS cunidadejecutora
	,dbo.fnCantidadLetra(cd.mimporte) AS cantLetras
INTO #tmpTablaSalida
FROM tReintegroCajaEncabezado AS ce WITH (NOLOCK)
INNER JOIN tReintegroCajaDetalle AS cd WITH (NOLOCK) ON ce.nFolioReintegrocaja = cd.nFolioReintegrocaja
INNER JOIN tCatUnidadEjecutora AS ue WITH (NOLOCK) ON ue.cUnidadEjecutora = ce.cunidadejecutora
INNER JOIN tEvento AS ev WITH (NOLOCK) ON cd.cEvento = ev.cEvento
INNER JOIN tEvento AS evd WITH (NOLOCK) ON cd.cEventoDestino = evd.cEvento
LEFT JOIN tBeneficiarioCuentasBancarias AS ctabe WITH (NOLOCK) ON cd.ncuentaBeneficiario = ctabe.dCuentaBancaria
LEFT JOIN tBeneficiario AS tb WITH (NOLOCK) ON cd.rfc = tb.dRFC
LEFT JOIN dbo.tRelacionComprobacionComisiones AS rgc WITH (NOLOCK) ON rgc.nFolioTramite = ce.nFolioReintegrocaja
LEFT JOIN dbo.tViaticosComisiones AS viat WITH (NOLOCK) ON viat.nIdComision = rgc.nIdComision
LEFT JOIN tSubcuentasFFM AS sFFM WITH (NOLOCK) ON cd.FFM = sFFM.cSubcuenta
WHERE 1 = 1
$P!{whereFolio}
--AND ce.nFolioReintegrocaja = 44

SELECT TOP 1 @nFolioPago = nFolioReintegrocaja FROM #tmpTablaSalida WITH (NOLOCK)

	IF (SELECT COUNT(*) FROM tPagoFirmanteDelagatorio WITH (NOLOCK) WHERE cTipoPago = @cTipoPago AND nFolioPago = @nFolioPago) > 0
		BEGIN
			SELECT TOP 1 @sFirmanteAut = sFirmanteAut FROM #tmpTablaSalida WITH (NOLOCK)

			SELECT	@sFirmanteDelegatorio = ISNULL((cNombreTitular + ' ' + cApellidoPaternoTitular + ' ' + cApellidoMaternoTitular)
				, (emp.NOMBREN + ' ' + emp.NOMBREP + ' ' + emp.NOMBREM)  )
				, @sPuestoFirmanteDelegatorio = ISNULL(cPuestoTitular
				, DESCRIPCION_PUESTO)
				, @sOficio = cFolioOficio
				, @sFechaOficio = dFechaOficio
				, @cTipoSuplencia = cTipoSuplencia
			FROM tPagoFirmanteDelagatorio pago WITH (NOLOCK)
			INNER JOIN tCatTipoSuplencia WITH (NOLOCK) ON pago.nTipoSuplencia = tCatTipoSuplencia.ntiposuplencia
			INNER JOIN dbo.v_empleados_giro emp (NOLOCK) ON emp.CLAVE = pago.cNumeroEmpleado
			WHERE cTipoPago = @cTipoPago
				AND nFolioPago = @nFolioPago

			SET @sLeyenda = 'Firma ' + @cTipoSuplencia + ' de: ' + @sFirmanteAut + ', con fundamento en el oficio: ' + @sOficio + ' de fecha: ' + @sFechaOficio + '.'
		END

	IF (SELECT COUNT(*) FROM tPagoFirmanteDelegatorioVoBo WITH (NOLOCK) WHERE cTipoPago = @cTipoPago AND nFolioPago = @nFolioPago) > 0
		BEGIN
			SELECT TOP 1 @sFirmanteVoBo = sFirmanteVoBo FROM #tmpTablaSalida WITH (NOLOCK)

			SELECT	@sFirmanteDeleVoBo = ISNULL((cNombreTitular + ' ' + cApellidoPaternoTitular + ' ' + cApellidoMaternoTitular)
				, (emp.NOMBREN + ' ' + emp.NOMBREP+ ' ' + emp.NOMBREM)  )
				, @sPuestoFirmanteDeleVoBo = ISNULL(cPuestoTitular, DESCRIPCION_PUESTO)
				, @sOficioVoBo = cFolioOficio
				, @sFechaOficio = dFechaOficio
				, @cTipoSuplencia = cTipoSuplencia
			FROM tPagoFirmanteDelegatorioVoBo pago WITH (NOLOCK)
			INNER JOIN tCatTipoSuplencia WITH (NOLOCK) ON pago.nTipoSuplencia = tCatTipoSuplencia.ntiposuplencia
			INNER JOIN dbo.v_empleados_giro emp (NOLOCK) ON emp.CLAVE = pago.cNumeroEmpleado
			WHERE cTipoPago = @cTipoPago
				AND nFolioPago = @nFolioPago

			SET @sLeyendaVoBo = 'Firma ' + @cTipoSuplencia + ' de: '  + @sFirmanteVoBo + ', con fundamento en el oficio: ' + @sOficioVoBo + ', de fecha: ' + @sFechaOficioVoBo
		END

		SELECT *
			, @sFirmanteDelegatorio AS sFirmanteDelegatorio
			, @sPuestoFirmanteDelegatorio AS sPuestoFirmanteDelegatorio
			, @sLeyenda AS sLeyenda
			, @sFirmanteDeleVoBo AS sFirmanteDelegatorioVoBo
			, @sPuestoFirmanteDeleVoBo AS sPuestoFirmanteDelegatorioVoBo
			, @sLeyendaVoBo AS sLeyendaVoBo
		FROM #tmpTablaSalida WITH (NOLOCK)

IF (SELECT OBJECT_ID('tempdb..#tmpTablaSalida')) IS NOT NULL DROP TABLE #tmpTablaSalida]]>
	</queryString>
