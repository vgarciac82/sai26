	<import value="net.sf.jasperreports.engine.*"/>
	<import value="java.util.*"/>
	<import value="net.sf.jasperreports.engine.data.*"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="whereFolio" class="java.lang.String">
		<defaultValueExpression><![CDATA["CR.caNoContrarrecibo = '10OA2021100011'"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[DECLARE @laPoliza varchar(10)
DECLARE @cUnidadResponsable varchar(10)
DECLARE @cTipopoliza varchar(10)
DECLARE @canocontrarrecibo varchar(19)
DECLARE @cuantos smallint
DECLARE @nFolioPago INT
--SET @canocontrarrecibo='10OA2024100021'

SELECT @laPoliza= nFolioPoliza, @cUnidadResponsable = cCentroContable, @cTipopoliza = cTipoPoliza, @nFolioPago = nFolioOperAjenas 
FROM tOperAjenasEncabezado CR WITH(NOLOCK)
where --canocontrarrecibo =@canocontrarrecibo
  $P!{whereFolio} 

SELECT * into #tmp_detalle 
FROM (
		SELECT Ep, count(DISTINCT Ep) numReg  FROM tOperAjenasDetalle WITH(NOLOCK)
		where nFolioOperAjenas in (SELECT nFolioOperAjenas FROM tOperAjenasEncabezado cr WITH(NOLOCK) 
		where $P!{whereFolio} 
) GROUP BY ep
) m


SELECT
rfc.CNOMBRE CNOMBRE2,
 CR.aEjercicioFiscal, CR.cIdEntidadContable, CR.caNoContrarrecibo, m.cIdDocumento, CR.cIdTipoDocumento, '' cIdSubtipoDocumento
, CR.cIdTipoOperacion, '' caNoAP, '' nPolizaAP, CR.cIdRFC, CR.cIdTipoMoneda, CR.nTipoCambio, 
cast(CR.mImporteBruto as decimal(17,2)) mImporteBruto ,
cast(CR.mImporteSancion as decimal(17,2)) mImporteSancion ,
cast(CR.mImporteDevolucion as decimal(17,2)) mImporteDevolucion ,
(cast(mAmortizacionAnticipo as decimal(17,2))/  (1 + (nPorcIva/100))) as mAmortizacionAnticipo,
cast(CR.mImporteIVA as decimal(17,2)) mImporteIVA ,
cast(CR.mImporteRetencion as decimal(17,2)) mImporteRetencion ,
cast(CR.mImportePenalizacion as decimal(17,2)) mImportePenalizacion ,
cast(CR.mImporteNeto as decimal(17,2)) mImporteNeto , convert(varchar(10),CR.fProgramadaPago,103) fProgramadaPago,  
convert(varchar(10), CR.fRegistro, 103) fRegistro,  m.cconcepto
, 'OPERACIONES AJENAS' AS cTipoDocumento, '' as TIPO_OPERACION, cc.cDescripcion
, m.cUnidadResponsable, cnoEstimacion, periodo
, cast(nPorcIva as decimal(10,2)) nPorcIva
, (SELECT min(EP) FROM #tmp_detalle WITH(NOLOCK)) laEP
, (SELECT sum(numReg) FROM #tmp_detalle WITH(NOLOCK)) numReg
,dbo.fnCantidadLetra(CR.mImporteNeto) cantLetras
, m.sFirmanteVoBo, m.sPuestoVoBo, m.sFirmanteAut, m.sPuestoAut
into #tmp_detalle2
FROM  vContrarrecibo CR WITH(NOLOCK)
		left join pCatalogoTipoDocumento ctd on ctd.cIdTipoDocumento = cr.cIdTipoDocumento
		left join tCatalogoCentroContable cc on cc.cCentrocontable = cr.cIdEntidadContable
		, v_PCATALOGORFC RFC, (
				SELECT cnombre cIdDocumento, 0  nPorcIva,0  mImporteRetencion, cconcepto,
				canocontrarrecibo,'OPERACIONES AJENAS' tipoObra,
				cUnidadResponsable,' ' cnoEstimacion, 'Del ' + case when fDesde is null then '' else convert(varchar(10), fDesde, 103)
				 end + ' al ' + case when fHasta is null then '' else convert(varchar(10), fHasta, 103) end Periodo
				, sFirmanteVoBo, sPuestoVoBo, sFirmanteAut, sPuestoAut
				FROM tOperAjenasEncabezado e
		   ) m 
WHERE LTRIM(RTRIM(RFC.cIdRFC)) = LTRIM(RTRIM(CR.cIdRFC))
		and m.canocontrarrecibo = cr.canocontrarrecibo
 --and CR.canocontrarrecibo =@canocontrarrecibo
 AND $P!{whereFolio}


DECLARE @cTipoPago VARCHAR(64)
DECLARE @sFirmanteDelegatorio VARCHAR(250)
DECLARE @sPuestoFirmanteDelegatorio VARCHAR(70)
DECLARE @sFirmanteAut VARCHAR(250)
DECLARE @sLeyenda VARCHAR(500)
DECLARE @sOficio VARCHAR(128)
DECLARE @sFechaOficio VARCHAR(20)
DECLARE @cTipoSuplencia varchar(20)

SET @sFirmanteDelegatorio = ''
SET @sPuestoFirmanteDelegatorio = ''
SET @sFirmanteAut = ''
SET @sLeyenda = ''
SET @sOficio = ''
SET @sFechaOficio = ''


IF (SELECT COUNT(*) FROM tPagoFirmanteDelagatorio WITH (NOLOCK) WHERE cTipoPago = 'OPERAJENAS' AND nFolioPago = @nFolioPago) > 0
		BEGIN

			SELECT TOP 1 @sFirmanteAut = sFirmanteAut FROM #tmp_detalle2 tablafinal WITH (NOLOCK)

			SELECT	@sFirmanteDelegatorio = ISNULL((cNombreTitular + ' ' + cApellidoPaternoTitular + ' ' + cApellidoMaternoTitular),(NOMBREN + ' ' + NOMBREP + ' ' +  NOMBREM)),
			 @sPuestoFirmanteDelegatorio = ISNULL(cPuestoTitular, CARGO)
			, @sOficio = cFolioOficio
			, @sFechaOficio = CONVERT(varchar(10), CONVERT(date, dFechaOficio, 106), 103)
			, @cTipoSuplencia = cTipoSuplencia
			FROM tPagoFirmanteDelagatorio pago WITH (NOLOCK)
			INNER JOIN tCatTipoSuplencia WITH (NOLOCK)
				ON pago.ntipoSuplencia = tCatTipoSuplencia.ntiposuplencia
			LEFT JOIN v_empleados_giro WITH (NOLOCK)
				ON clave = cNumeroEmpleado
			WHERE cTipoPago = 'OPERAJENAS' AND nFolioPago = @nFolioPago

			SET @sLeyenda = 'Firma ' + @cTipoSuplencia + ' de: '  + @sFirmanteAut + ', con fundamento en el oficio: ' + @sOficio + ', de fecha: ' + @sFechaOficio
		END

DECLARE @sFirmanteDeleVoBo VARCHAR(250)
DECLARE @sPuestoFirmanteDeleVoBo VARCHAR(70)
DECLARE @sFirmanteVoBo VARCHAR(250)
DECLARE @sLeyendaVoBo VARCHAR(500)
DECLARE @sOficioVoBo VARCHAR(128)
DECLARE @sFechaOficioVoBo VARCHAR(20)


SET @sFirmanteDeleVoBo = ''
SET @sPuestoFirmanteDeleVoBo = ''
SET @sFirmanteVoBo = ''
SET @sLeyendaVoBo = ''
SET @sOficioVoBo = ''
SET @sFechaOficioVoBo = ''

IF (SELECT COUNT(*) FROM tPagoFirmanteDelegatorioVoBo WITH (NOLOCK) WHERE cTipoPago = 'OPERAJENAS' AND nFolioPago = @nFolioPago) > 0
		BEGIN

		SELECT TOP 1 @sFirmanteVoBo = sFirmanteVoBo FROM #tmp_detalle2 tablafinal WITH (NOLOCK)

		SELECT	@sFirmanteDeleVoBo = ISNULL((cNombreTitular + ' ' + cApellidoPaternoTitular + ' ' + cApellidoMaternoTitular)
		, (NOMBREN + ' ' + NOMBREP + ' ' +  NOMBREM))
		, @sPuestoFirmanteDeleVoBo = ISNULL(cPuestoTitular, CARGO)
		, @sOficioVoBo = cFolioOficio
		, @sFechaOficioVoBo = CONVERT(varchar(10)
		, CONVERT(date, dFechaOficio, 106), 103)
		, @cTipoSuplencia = cTipoSuplencia
			FROM tPagoFirmanteDelegatorioVoBo pagovobo WITH (NOLOCK)
			INNER JOIN tCatTipoSuplencia WITH (NOLOCK)
				ON pagovobo.ntipoSuplencia = tCatTipoSuplencia.ntiposuplencia
			LEFT JOIN v_empleados_giro WITH (NOLOCK)
				ON clave = cNumeroEmpleado
			WHERE cTipoPago = 'OPERAJENAS' AND nFolioPago = @nFolioPago

			SET @sLeyendaVoBo = 'Firma ' + @cTipoSuplencia + ' de: '  + @sFirmanteVoBo + ', con fundamento en el oficio: ' + @sOficioVoBo + ', de fecha: ' + @sFechaOficioVoBo
		END


SELECT MAX(CNOMBRE2) CNOMBRE2, aEjercicioFiscal, cIdEntidadContable, caNoContrarrecibo, cIdDocumento
, cIdTipoDocumento, cIdSubtipoDocumento, cIdTipoOperacion, caNoAP, 
 @laPoliza nPolizaAP, cIdRFC, cIdTipoMoneda, nTipoCambio, mImporteBruto,
 mImporteSancion, mImporteDevolucion, mAmortizacionAnticipo,
 mImporteIVA, mImporteRetencion,
 mImportePenalizacion,
 mImporteNeto, fProgramadaPago, 
 fRegistro, cconcepto, cTipoDocumento, 
 TIPO_OPERACION, 
 cDescripcion, 
 cUnidadResponsable, 
 cnoEstimacion, periodo
,laEP
, max(nPorcIva) nPorcIva
, max(numReg) numReg
, max(cantLetras) cantLetras
, isnull(sFirmanteVoBo,'-') sFirmanteVoBo
, isnull(sPuestoVoBo,'-') sPuestoVoBo
, isnull(sFirmanteAut,'-') sFirmanteAut
, isnull(sPuestoAut,'-') sPuestoAut,
@sFirmanteDelegatorio AS sFirmanteDelegatorio, 
@sPuestoFirmanteDelegatorio AS sPuestoFirmanteDelegatorio, 
@sLeyenda AS Leyenda,
@sFirmanteDeleVoBo AS sFirmanteDeleVoBo, 
@sPuestoFirmanteDeleVoBo AS sPuestoFirmanteDeleVoBo, 
@sLeyendaVoBo AS LeyendaVoBo
 FROM #tmp_detalle2 WITH(NOLOCK)
 GROUP BY aEjercicioFiscal, cIdEntidadContable, caNoContrarrecibo, cIdDocumento, cIdTipoDocumento, cIdSubtipoDocumento, cIdTipoOperacion, 
 caNoAP, nPolizaAP, cIdRFC, cIdTipoMoneda, nTipoCambio, mImporteBruto,
 mImporteSancion, mImporteDevolucion, mAmortizacionAnticipo,
 mImporteIVA, mImporteRetencion, mImportePenalizacion,
 mImporteNeto, fProgramadaPago,  fRegistro, cconcepto, cTipoDocumento, TIPO_OPERACION, cDescripcion, 
 cUnidadResponsable, cnoEstimacion, periodo ,laEP, sFirmanteVoBo, sPuestoVoBo, sFirmanteAut, sPuestoAut


drop table  #tmp_detalle2
drop table  #tmp_detalle]]>
	</queryString>
