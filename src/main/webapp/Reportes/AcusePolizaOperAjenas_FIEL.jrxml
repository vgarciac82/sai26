	<group name="caNoContrarrecibo">
		<groupExpression><![CDATA[$F{caNoContrarrecibo}]]></groupExpression>
		<groupHeader>
			<band height="394" splitType="Stretch">
				<rectangle>
					<reportElement key="rectangle" x="0" y="106" width="551" height="260" uuid="b5934a2a-9d4d-4ee7-994f-948188942066"/>
