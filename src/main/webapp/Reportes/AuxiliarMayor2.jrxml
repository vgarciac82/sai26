	<queryString>
		<![CDATA[DECLARE @mI INT = $P{mIni};
DECLARE @mF INT = $P{mFin};
DECLARE @nC VARCHAR(30) = (SELECT REPLACE($P{nCuenta},'_','%'));
DECLARE @nSC VARCHAR(30) = (SELECT REPLACE($P{nSubCuenta},'_','%'));
DECLARE @mSubTotal INT = $P{subTot};


EXECUTE sp_l_GeneraAuxiliarMayor @nC, @nSC, $P{cCentroContable}, @mI, @mF, @mSubTotal;]]>
	</queryString>
