	</parameter>
	<queryString>
		<![CDATA[declare @cIdContrato varchar(40), @cEjercicio varchar(4);
set @cIdContrato = $P{cIdContrato};
set @cEjercicio = $P{cEjercicio};
--set @cIdContrato = 'PE-B03-15';
--set @cEjercicio = '2012';
--SELECT
--	'' AS EP,
--	'' AS cPeriodo,
--	'' AS mImporte,
--	'' AS mTotal,
--	'' AS nIdPeriodo
--	--'' as len(EP)as tamano
--UNION
SELECT
	tCD.EP,
	mper.cPeriodo,
	'$' + ISNULL(CONVERT(varchar,CONVERT(MONEY,tCD.mImporte), 1), '0.00') AS mImporte,
	'Total: $' + (SELECT ISNULL(CONVERT(varchar,CONVERT(MONEY,SUM(tCD.mImporte)), 1), '0.00') AS mTotal
			FROM mPedido mp
			inner join pContratoDiverso pCD ON
			mp.cIdPedidoDefinitivo = pCD.cIdContrato
			INNER JOIN tpreCompromisoEncabezado tCE ON
			pCD.cIdContrato = tCE.cIdContrato
			INNER JOIN tpreCompromisoDetalle tCD ON
			tCE.nFoliopreCompromiso = tCD.nFoliopreCompromiso
			WHERE mp.cIdPedido = @cIdContrato
			AND mp.cEjercicio = @cEjercicio
			GROUP BY mp.cIdPedido)
		AS mTotal,
		-- simulamos un lastindexof
	substring(tCD.EP,len(tCD.EP) - charindex('.', reverse(tCD.EP))+2,3 )as ue

FROM mPedido mp
	INNER JOIN pContratoDiverso pCD ON
	mp.cIdPedidoDefinitivo = pCD.cIdContrato
	INNER JOIN tpreCompromisoEncabezado tCE ON
	pCD.cIdContrato = tCE.cIdContrato
	INNER JOIN tpreCompromisoDetalle tCD ON
	tCE.nFoliopreCompromiso = tCD.nFoliopreCompromiso
	INNER JOIN mCatalogoPeriodo mPer ON
	tCD.cMes = mPer.nIdPeriodo
WHERE mp.cIdPedido = @cIdContrato
AND mp.cEjercicio = @cEjercicio
AND tCD.cEvento not in ('APTDDISP')
order by ue,nIdPeriodo]]>
	</queryString>
	<field name="EP" class="java.lang.String"/>
	<field name="cPeriodo" class="java.lang.String"/>
	<field name="mImporte" class="java.lang.String"/>
	<field name="mTotal" class="java.lang.String"/>
	<field name="ue" class="java.lang.String"/>
