	<variable name="SALDO_PEDIDO" class="java.math.BigDecimal" resetType="None">
		<variableExpression><![CDATA[$F{tFondenMovimiento_nNetoPedido}.doubleValue() - $V{ACUMULADO_SALDO}.doubleValue()]]></variableExpression>
	</variable>
	<variable name="TOTAL_IMPORTE_FACTURA" class="java.lang.Double" resetType="Group" resetGroup="MOVIMIENTO" calculation="Sum">
		<variableExpression><![CDATA[$F{tFondenFacturacion_nImporteFactura}.multiply( $F{tFondenMovimiento_nTipoCambio} )]]></variableExpression>
	</variable>
	<variable name="SUM_BIENES" class="java.lang.Integer" resetType="Group" resetGroup="MOVIMIENTO" calculation="Sum">
