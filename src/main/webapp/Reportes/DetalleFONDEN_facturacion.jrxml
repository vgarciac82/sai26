	<variable name="ACUMULADO_SALDO" class="java.math.BigDecimal" resetType="Group" resetGroup="MOVIMIENTO" calculation="Sum">
		<variableExpression><![CDATA[$F{tFondenFacturacion_nImporteFactura}.multiply( $F{tFondenMovimiento_nTipoCambio} )]]></variableExpression>
		<initialValueExpression><![CDATA[$F{tFondenFacturacion_nImporteFactura}]]></initialValueExpression>
	</variable>
	<variable name="SUM_IMPORTE_FACTURA" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{tFondenFacturacion_nImporteFactura}.multiply( $F{tFondenMovimiento_nTipoCambio} )]]></variableExpression>
