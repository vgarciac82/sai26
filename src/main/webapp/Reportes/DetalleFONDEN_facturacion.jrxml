<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="DetalleFONDEN_facturacion"  pageWidth="802" pageHeight="555" orientation="Landscape" columnWidth="802" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0">
	<property name="ireport.zoom" value="1.771561000000001"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="cIdFonden" class="java.lang.Integer"/>
	<parameter name="nIdFondenMovimiento" class="java.lang.Integer"/>
	<parameter name="netoPedido" class="java.math.BigDecimal"/>
	<queryString>
		<![CDATA[SELECT
     tFondenFacturacion."cIdFonden" AS tFondenFacturacion_cIdFonden,
     tFondenFacturacion."nIdFondenMovimiento" AS tFondenFacturacion_nIdFondenMovimiento,
     tFondenFacturacion."nIdFondenFacturacion" AS tFondenFacturacion_nIdFondenFacturacion,
     tFondenFacturacion."cNumero" AS tFondenFacturacion_cNumero,
     tFondenFacturacion."nCantidad" AS tFondenFacturacion_nCantidad,
     tFondenFacturacion."nImporteFactura" AS tFondenFacturacion_nImporteFactura,
     tFondenFacturacion."nTipoCambio" AS tFondenFacturacion_nTipoCambio,
     tFondenFacturacion."nIdTipoPago" AS tFondenFacturacion_nIdTipoPago,
     tFondenFacturacion."nIdTipoFactura" AS tFondenFacturacion_nIdTipoFactura,
     tFondenFacturacion."cDescripcionFactura" AS tFondenFacturacion_cDescripcionFactura,
     tFondenTipoFactura."nIdTipoFactura" AS tFondenTipoFactura_nIdTipoFactura,
     tFondenTipoFactura."cDescripcion" AS tFondenTipoFactura_cDescripcion,
     tFondenTipoPago."nIdTipoPago" AS tFondenTipoPago_nIdTipoPago,
     tFondenTipoPago."cDescripcion" AS tFondenTipoPago_cDescripcion,
     tFondenMovimiento."cIdFonden" AS tFondenMovimiento_cIdFonden,
     tFondenMovimiento."nIdFondenMovimiento" AS tFondenMovimiento_nIdFondenMovimiento,
     tFondenMovimiento."cConcepto" AS tFondenMovimiento_cConcepto,
     tFondenMovimiento."nPrecioUnitario" AS tFondenMovimiento_nPrecioUnitario,
     tFondenMovimiento."nCantidad" AS tFondenMovimiento_nCantidad,
     tFondenMovimiento."nImporte" AS tFondenMovimiento_nImporte,
     tFondenMovimiento."cRFC" AS tFondenMovimiento_cRFC,
     tFondenMovimiento."cNumPedido" AS tFondenMovimiento_cNumPedido,
     tFondenMovimiento."nNetoPedido" AS tFondenMovimiento_nNetoPedido,
     tFondenMovimiento."nPrecio" AS tFondenMovimiento_nPrecio,
     tFondenMovimiento."nTotal" AS tFondenMovimiento_nTotal,
     tFondenMovimiento."cProveedor" AS tFondenMovimiento_cProveedor,
     tFondenMovimiento."ACTIVO" AS tFondenMovimiento_ACTIVO,
     tFondenMovimiento."ID_GABINETE" AS tFondenMovimiento_ID_GABINETE,
     tFondenMovimiento."cFolio" AS tFondenMovimiento_cFolio,
     tFondenMovimiento."cCentroContable" AS tFondenMovimiento_cCentroContable,
     tFondenMovimiento."cUnidadResponsable" AS tFondenMovimiento_cUnidadResponsable,
     tFondenMovimiento."nNumCaso" AS tFondenMovimiento_nNumCaso,
     tFondenMovimiento."nCantidadTotal" AS tFondenMovimiento_nCantidadTotal,
     tFondenMovimiento."nTechoDef" AS tFondenMovimiento_nTechoDef,
     tFondenMovimiento."cIdMoneda" AS tFondenMovimiento_cIdMoneda,
     tFondenMovimiento."nTipoCambio" AS tFondenMovimiento_nTipoCambio,
     tFondenMovimiento."nIdFondenMovEstatus" AS tFondenMovimiento_nIdFondenMovEstatus
FROM
     "dbo"."tFondenTipoFactura" tFondenTipoFactura INNER JOIN "dbo"."tFondenFacturacion" tFondenFacturacion ON tFondenTipoFactura."nIdTipoFactura" = tFondenFacturacion."nIdTipoFactura"
     INNER JOIN "dbo"."tFondenTipoPago" tFondenTipoPago ON tFondenFacturacion."nIdTipoPago" = tFondenTipoPago."nIdTipoPago"
     INNER JOIN "dbo"."tFondenMovimiento" tFondenMovimiento ON tFondenFacturacion."cIdFonden" = tFondenMovimiento."cIdFonden"
     AND tFondenMovimiento."nIdFondenMovimiento" = tFondenFacturacion."nIdFondenMovimiento"

WHERE
	 tFondenFacturacion."cIdFonden" = $P{cIdFonden} AND
	 tFondenFacturacion."nIdFondenMovimiento" = $P{nIdFondenMovimiento}]]>
	</queryString>
