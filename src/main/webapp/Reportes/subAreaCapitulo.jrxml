	<queryString>
		<![CDATA[select tblPartidaCapitulo2.descArea,(SELECT sum(tblPartidaCapitulo2.monto ) FROM tblPartidaCapitulo2 where tblPartidaCapitulo2.capitulo='2000.00' and tblPartidaCapitulo2.unidad=$P{cIdUnidadEjecutora} ) AS subtotal2,

