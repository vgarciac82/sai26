(select  sum(tblPartidaCapitulo2.monto)FROM tblPartidaCapitulo2 where tblPartidaCapitulo2.unidad=$P{cIdUnidadEjecutora}) AS total

from tblPartidaCapitulo2
 WHERE tblPartidaCapitulo2.unidad=$P{cIdUnidadEjecutora}]]>
