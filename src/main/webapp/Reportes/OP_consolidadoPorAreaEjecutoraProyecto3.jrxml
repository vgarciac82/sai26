	<field name="montoContratado" class="java.math.BigDecimal"/>
	<field name="por_Contratado" class="java.math.BigDecimal"/>
	<field name="montoEjecutado" class="java.math.BigDecimal"/>
	<field name="por_Ejecutado" class="java.math.BigDecimal"/>
	<field name="montoEstimado" class="java.math.BigDecimal"/>
	<field name="Porc_Estimado" class="java.math.BigDecimal"/>
	<field name="TOTAL_MN" class="java.math.BigDecimal"/>
	<variable name="Modificado_1" class="java.math.BigDecimal" resetType="Group" resetGroup="AreaEjecutora" calculation="Sum">
		<variableExpression><![CDATA[$F{Modificado}]]></variableExpression>
	</variable>
	<variable name="porcPagado" class="java.math.BigDecimal">
		<variableExpression><![CDATA[( new BigDecimal(0).compareTo($F{montoContratado})==0 ? new BigDecimal(0) : $F{TOTAL_MN}.divide($F{montoContratado} ))]]></variableExpression>
		<initialValueExpression><![CDATA[( new BigDecimal(0).compareTo($F{montoContratado})==0 ? new BigDecimal (0) : $F{TOTAL_MN}.divide($F{montoContratado} ))]]></initialValueExpression>
	</variable>
	<variable name="montoContratado_1" class="java.math.BigDecimal" resetType="Group" resetGroup="AreaEjecutora" calculation="Sum">
		<variableExpression><![CDATA[$F{montoContratado}]]></variableExpression>
	</variable>
	<variable name="montoEjecutado_1" class="java.math.BigDecimal" resetType="Group" resetGroup="AreaEjecutora" calculation="Sum">
		<variableExpression><![CDATA[$F{montoEjecutado}]]></variableExpression>
	</variable>
	<variable name="montoEstimado_1" class="java.math.BigDecimal" resetType="Group" resetGroup="AreaEjecutora" calculation="Sum">
		<variableExpression><![CDATA[$F{montoEstimado}]]></variableExpression>
	</variable>
	<variable name="TOTAL_MN_1" class="java.math.BigDecimal" resetType="Group" resetGroup="AreaEjecutora" calculation="Sum">
		<variableExpression><![CDATA[$F{TOTAL_MN}]]></variableExpression>
	</variable>
	<variable name="porcPagado_1" class="java.math.BigDecimal">
		<variableExpression><![CDATA[( new BigDecimal (0).compareTo($V{montoContratado_1})==0 ? new BigDecimal (0): $V{TOTAL_MN_1}.divide($V{montoContratado_1} ))]]></variableExpression>
		<initialValueExpression><![CDATA[]]></initialValueExpression>
	</variable>
	<variable name="porcEstimado_1" class="java.math.BigDecimal">
		<variableExpression><![CDATA[( new BigDecimal(0).compareTo($V{montoContratado_1})==0 ? new BigDecimal (0) : $V{montoEstimado_1}.divide($V{montoContratado_1} ))]]></variableExpression>
		<initialValueExpression><![CDATA[]]></initialValueExpression>
	</variable>
	<variable name="Original_1" class="java.math.BigDecimal" resetType="Group" resetGroup="AreaEjecutora" calculation="Sum">
		<variableExpression><![CDATA[$F{Original}]]></variableExpression>
	</variable>
	<variable name="porcContratado" class="java.math.BigDecimal">
		<variableExpression><![CDATA[( new BigDecimal (0).compareTo($V{Modificado_1})==0 ? new BigDecimal (0) : $V{montoContratado_1}.divide($V{Modificado_1} ))]]></variableExpression>
	</variable>
	<variable name="porcEjecutado" class="java.math.BigDecimal">
		<variableExpression><![CDATA[(new BigDecimal (0).compareTo($V{montoContratado_1})==0 ? new BigDecimal (0) : $V{montoEjecutado_1}.divide($V{montoContratado_1} ))]]></variableExpression>
	</variable>
	<variable name="lbPeriodo" class="java.lang.String">
		<initialValueExpression><![CDATA[( $P{fIni}.equals("") ? "" : "Reporte del " + $P{fIni} )
+  ( $P{fFin}.equals("") ? "" : " al " + $P{fFin} )]]></initialValueExpression>
	</variable>
