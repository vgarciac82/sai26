	<property name="ireport.encoding" value="UTF-8"/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="sai_2022"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<import value="net.sf.jasperreports.engine.*"/>
	<import value="java.util.*"/>
	<import value="net.sf.jasperreports.engine.data.*"/>
	<parameter name="whereFolio" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["  CR.canocontrarrecibo='10CP2023100730'"]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[DECLARE @laPoliza varchar(10)
DECLARE @cUnidadResponsable varchar(10)
DECLARE @cTipopoliza varchar(10)
DECLARE @canocontrarrecibo varchar(19)
DECLARE @cuantos smallint
DECLARE @cTipoObra varchar(10)
DECLARE @noFolio INT
DECLARE @ctaBanc VARCHAR(100)
DECLARE @laPolizaCancelacion varchar(10)
DECLARE @estatus varchar(10)
DECLARE @cTipoSuplencia varchar(20)
--SET @cTipopoliza='EG'
--SET @cUnidadResponsable ='10'
--SET @laPoliza=2900
--SET @canocontrarrecibo='10CP2012000589'

DECLARE @nFolioPago INT
DECLARE @cTipoPago VARCHAR(64)
DECLARE @sFirmanteDelegatorio VARCHAR(250)
DECLARE @sPuestoFirmanteDelegatorio VARCHAR(70)
DECLARE @sFirmanteAut VARCHAR(250)
DECLARE @sLeyenda VARCHAR(500)
DECLARE @sOficio VARCHAR(128)
DECLARE @sFechaOficio VARCHAR(20)
DECLARE @leyenda6 varchar(500) = 'Bajo protesta de decir verdad, declaro que estoy consciente de la obligación y documentación a que se refiere el artículo 15D, tercer párrafo del Código Fiscal de la Federación, ya que mi contratación requiere la prestación de servicios especializados o de la ejecución de obras especializadas, por lo que mantendré en mi expediente de seguimiento al contrato toda la documentación complementaria que sea necesaria para cumplimiento a esta disposición'

SET	@sFirmanteDelegatorio = ''
SET @sPuestoFirmanteDelegatorio = ''

SET @sFirmanteAut = ''
SET @sLeyenda = ''
SET @sOficio = ''
SET @sFechaOficio = ''

DECLARE @cObservaciones VARCHAR(102)

SET @cObservaciones = ''

select @laPoliza= nFolioPoliza, @cUnidadResponsable = cIDEntidadContable, @cTipopoliza = cTipoPoliza, @cTipoObra = tipoObra, @noFolio = nFolioPagoDirecto, @ctaBanc = CR.CTAB, @laPolizaCancelacion = nFolioPolizaCancelacion, @estatus=cDocumentoHaplicado, @cTipoPago = cTipoDePago, @cObservaciones = cObservaciones
		from (
select nFolioPagoDirecto,nFolioPoliza, cconcepto, canocontrarrecibo,'DIRECTO' tipoObra, cUnidadResponsable, cast('' as varchar(5)) cnoEstimacion, '' Periodo, cIdEntidadContable,cTipoPoliza,e.CTAB,e.nFolioPolizaCancelacion,e.cDocumentoHaplicado, 'PAGODIRECTO' as cTipoDePago, '' AS cObservaciones
		    from tpagodirectoencabezado e with(NOLOCK)
		union select nFolioNOMINA,nFolioPoliza, cconcepto, canocontrarrecibo,'NOMINA' tipoObra, cUnidadResponsable, cast('' as varchar(5)) cnoEstimacion, '' Periodo, ccentrocontable cIdEntidadContable,cTipoPoliza,'',e.nFolioPolizaCancelacion,e.cDocumentoHaplicado, 'NOMINA' as cTipoDePago, '' AS cObservaciones
		    from tnominaencabezado e with(NOLOCK)
		union select nFolioPAGODIVERSO,nFolioPoliza, cconcepto, canocontrarrecibo,'DIVERSO' tipoObra, cUnidadResponsable,  cNoEstimacion, '' Periodo,cCentroContable cIdEntidadContable,cTipoPoliza, CASE WHEN cPagoReferenciado = 'S' THEN (e.CTAB + '-' + ISNULL(E.cReferenciaBancaria, '') ) ELSE e.CTAB END AS CTAB,e.nFolioPolizaCancelacion,e.cDocumentoHaplicado, 'PAGODIVERSO' as cTipoDePago, cObservaciones
		 from tPAGODIVERSOEncabezado e with(NOLOCK)
		union select nFolioRELACIONGASTOS,nFolioPoliza, cconcepto, canocontrarrecibo,'RELGASTO' tipoObra, cUnidadResponsable, cast('' as varchar(5)) cnoEstimacion, '' Periodo, cCentroContable cIdEntidadContable,cTipoPoliza, CASE WHEN cPagoReferenciado = 'S' THEN (e.CTAB + '-' + ISNULL(E.cReferenciaBancaria, '') ) ELSE e.CTAB END AS CTAB,e.nFolioPolizaCancelacion,e.cDocumentoHaplicado, 'RELACIONGASTOS' as cTipoDePago, '' AS cObservaciones
		   from trelaciongastosencabezado e with(NOLOCK)
		union select nFolioPAGOOBRA,nFolioPoliza, cconcepto, canocontrarrecibo,'OBRA' tipoObra, cUnidadResponsable, cnoEstimacion, 'Del ' + case when fperiodode is null then '' else convert(varchar(10), fperiodode, 103) end + ' al ' + case when fperiodohasta is null then '' else convert(varchar(10), fperiodohasta, 103) end Periodo
		, cCentroContable cIdEntidadContable,cTipoPoliza,CTAB,e.nFolioPolizaCancelacion,e.cDocumentoHaplicado, 'PAGOOBRA' as cTipoDePago, '' AS cObservaciones
		   from tPAGOOBRAEncabezado e with(NOLOCK)
		union select nFolioPAGOFEDERALIZADO,nFolioPoliza, cconcepto, canocontrarrecibo,'FEDERALIZADO' tipoObra, cUnidadResponsable, cnoEstimacion, 'Del ' + case when fperiodode is null then '' else convert(varchar(10), fperiodode, 103) end + ' al ' + case when fperiodohasta is null then '' else convert(varchar(10), fperiodohasta, 103) end Periodo
		, cCentroContable cIdEntidadContable,cTipoPoliza,e.CTAB,e.nFolioPolizaCancelacion,e.cDocumentoHaplicado, 'PAGOFEDERALIZADO' as cTipoDePago, '' AS cObservaciones
		   from tPAGOFEDERALIZADOEncabezado e with(NOLOCK)
		    ) CR where
--		   canocontrarrecibo =@canocontrarrecibo
  $P!{whereFolio} AND 1 = 1
--las de mayor
IF (SELECT OBJECT_ID('tempdb..#tmp_detalle')) IS NOT NULL	DROP TABLE #tmp_detalle
IF (SELECT OBJECT_ID('tempdb..#tmp_polizapagos')) IS NOT NULL	DROP TABLE #tmp_polizapagos
IF (SELECT OBJECT_ID('tempdb..#tmp_detalle2')) IS NOT NULL	DROP TABLE #tmp_detalle2
SET @nFolioPago = @noFolio

select * into #tmp_detalle from (


select ep, count(DISTINCT ep) numReg from tPAGODIVERSODetalle with(NOLOCK) where nFolioPAGODIVERSO in (select nFolioPAGODIVERSO from tPAGODIVERSOEncabezado  cr with(NOLOCK) where
-- canocontrarrecibo =@canocontrarrecibo
$P!{whereFolio} AND 1 = 1
) group by ep
union
select ep, count(DISTINCT ep) numReg from tpagodirectodetalle with(NOLOCK) where nfoliopagodirecto in (select nfoliopagodirecto from tpagodirectoencabezado cr with(NOLOCK) where
-- CR.canocontrarrecibo =@canocontrarrecibo
 $P!{whereFolio} AND 1 = 1
) group by ep
union
select ep, count(DISTINCT ep) numReg  from trelaciongastosdetalle with(NOLOCK) where nfoliorelaciongastos in (select nfoliorelaciongastos from trelaciongastosencabezado cr with(NOLOCK) where
 --CR.canocontrarrecibo =@canocontrarrecibo
 $P!{whereFolio} AND 1 = 1
) group by ep

union
select ep, count(DISTINCT ep) numReg  from tNOMINADetalle with(NOLOCK) where nFolioNOMINA in (select nFolioNOMINA from tNOMINAEncabezado cr with(NOLOCK) where
 --CR.canocontrarrecibo =@canocontrarrecibo
 $P!{whereFolio} AND 1 = 1
) group by ep

union
select ep, count(DISTINCT ep) numReg  from tPAGOOBRADetalle with(NOLOCK) where nFolioPAGOOBRA in (select nFolioPAGOOBRA from tPAGOOBRAEncabezado cr with(NOLOCK) where
--CR.canocontrarrecibo =@canocontrarrecibo
 $P!{whereFolio} AND 1 = 1
) group by ep

union
select ep, count(DISTINCT ep) numReg  from tPAGOFEDERALIZADODetalle with(NOLOCK) where nFolioPAGOFEDERALIZADO in (select nFolioPAGOFEDERALIZADO from tPAGOFEDERALIZADOEncabezado cr with(NOLOCK) where
--CR.canocontrarrecibo =@canocontrarrecibo
 $P!{whereFolio} AND 1 = 1
) group by ep


) m

select * into #tmp_polizapagos from (select substring(m.nCuenta, 1,5) Cuenta,'' subCuenta,'' subSubCuenta
,calmacen, dCuenta cnombre
,dCuenta descripcion
,dCuenta, m.ctipomovimiento, m.nCuenta/*,  m.**/, sum(mMovimiento) mMovimiento2
   from tcuentas c with(NOLOCK), tmovimiento m with(NOLOCK)
   left join cat_almacen a with(NOLOCK) on cast(a.nidalmacen as varchar(10))=nsubcuenta and a.ccentrocontable = m.ccentrocontable
   --left join v_pcatalogorfc rfc with(NOLOCK) on cidrfc=nsubcuenta
   where /*m.ncuenta = c.ncuenta */ substring(m.ncuenta,1,5)+'-00000-00000-00000'= c.ncuenta  and nFolioPoliza = @laPoliza AND m.cCentroContable = @cUnidadResponsable and cTipopoliza =@cTipopoliza and mmovimiento != 0 AND not(c.TipoBalance='P' and c.TipoCuenta='P')
group by substring(m.nCuenta, 1,5) ,calmacen, dCuenta
,dCuenta
,dCuenta, m.ctipomovimiento, m.nCuenta
--order by m.ncuenta, ctipomovimiento desc
union
--2o nivel
select '' Cuenta,substring(m.nCuenta, 7,5)  subCuenta,'' subSubCuenta
,calmacen, dcuenta cnombre
,'  ' + dCuenta descripcion
,dCuenta, m.ctipomovimiento, m.nCuenta/*, m.**/, 0 mMovimiento2
   from tcuentas c with(NOLOCK), tmovimiento m with(NOLOCK)
   left join cat_almacen a with(NOLOCK) on cast(a.nidalmacen as varchar(10))=nsubcuenta and a.ccentrocontable = m.ccentrocontable
   --left join v_pcatalogorfc rfc with(NOLOCK) on cidrfc=nsubcuenta
   where /*m.ncuenta*/  substring(m.ncuenta,1,11)+'-00000-00000'= c.ncuenta and nFolioPoliza = @laPoliza AND m.cCentroContable = @cUnidadResponsable and cTipoPoliza =@cTipopoliza and mmovimiento != 0 and substring(m.nCuenta, 7,5) != '00000' AND not(c.TipoBalance='P' and c.TipoCuenta='P')
group by substring(m.nCuenta, 7,5)
,calmacen, dcuenta
,'  ' + dCuenta
,dCuenta, m.ctipomovimiento, m.nCuenta
--order by m.ncuenta, ctipomovimiento desc
union
--3er nivel
select '' Cuenta,''  subCuenta,substring(m.nCuenta, 13,5) subSubCuenta
,calmacen, dCuenta cnombre
,'    ' + dCuenta descripcion
,dCuenta, m.ctipomovimiento, m.nCuenta/*, m.**/, 0 mMovimiento2
   from tcuentas c with(NOLOCK), tmovimiento m with(NOLOCK)
   left join cat_almacen a with(NOLOCK) on cast(a.nidalmacen as varchar(10))=nsubcuenta and a.ccentrocontable = m.ccentrocontable
  -- left join v_pcatalogorfc rfc with(NOLOCK) on cidrfc=nsubcuenta
   where /*m.ncuenta*/  substring(m.ncuenta,1,17)+'-00000'= c.ncuenta and nFolioPoliza = @laPoliza AND m.cCentroContable = @cUnidadResponsable and cTipoPoliza=@cTipopoliza and mmovimiento != 0 and substring(m.nCuenta, 13,5) != '00000' AND not(c.TipoBalance='P' and c.TipoCuenta='P')
group by substring(m.nCuenta, 13,5)
,calmacen, dCuenta
,'    ' + dCuenta
,dCuenta, m.ctipomovimiento, m.nCuenta
--order by m.ncuenta, ctipomovimiento desc
union
select '' Cuenta, ''subCuenta, case when nSubCuenta = ''
then substring(m.nCuenta, 13,5) else case when cnombre is null then calmacen else nSubCuenta end end subSubCuenta
,calmacen, cnombre
,'      ' + case when nSubCuenta = ''
then substring(m.nCuenta, 13,5) else case when cnombre is null then calmacen else '[' + nSubCuenta+']'+cNombre end end descripcion
,dCuenta, m.ctipomovimiento, m.nCuenta/*, m.**/, 0 mMovimiento2
   from tcuentas c with(NOLOCK),  tmovimiento m with(NOLOCK)
   left join cat_almacen a with(NOLOCK) on cast(a.nidalmacen as varchar(10))=nsubcuenta and a.ccentrocontable = m.ccentrocontable
   left join v_pcatalogorfc rfc with(NOLOCK) on cidrfc=nsubcuenta
   where m.nSubcuenta != '' and m.ncuenta = c.ncuenta and nFolioPoliza = @laPoliza AND m.cCentroContable = @cUnidadResponsable and cTipoPoliza =@cTipopoliza and mmovimiento != 0 AND not(c.TipoBalance='P' and c.TipoCuenta='P')
group by case when nSubCuenta = ''
then substring(m.nCuenta, 13,5) else case when cnombre is null then calmacen else nSubCuenta end end
,calmacen, cnombre
,'      ' + case when nSubCuenta = ''
then substring(m.nCuenta, 13,5) else case when cnombre is null then calmacen else '[' + nSubCuenta+']'+cNombre end end
,dCuenta, m.ctipomovimiento, m.nCuenta

   )kk
--order by m.ncuenta, cuenta desc, subcuenta desc, subsubcuenta, ctipomovimiento desc
order by ncuenta, cuenta desc, subcuenta desc, subsubcuenta, ctipomovimiento desc

set @cuantos = 0
select @cuantos = Count(*) from #tmp_polizapagos

if @cuantos = 0
begin
insert into #tmp_polizapagos
select * from (select substring(m.nCuenta, 1,5) Cuenta,'' subCuenta,'' subSubCuenta
,calmacen, dCuenta cnombre
,dCuenta descripcion
,dCuenta, m.ctipomovimiento, m.nCuenta/*,  m.**/, sum(mMovimiento) mMovimiento2
   from tcuentas c with(NOLOCK), tmovimiento m with(NOLOCK)
   left join cat_almacen a with(NOLOCK) on cast(a.nidalmacen as varchar(10))=nsubcuenta and a.ccentrocontable = m.ccentrocontable
   --left join v_pcatalogorfc rfc with(NOLOCK)  on cidrfc=nsubcuenta
   where /*m.ncuenta = c.ncuenta */ substring(m.ncuenta,1,5)+'-00000-00000-00000'= c.ncuenta  and nFolioPoliza = @laPoliza AND m.cCentroContable = @cUnidadResponsable and cTipopoliza =@cTipopoliza and mmovimiento != 0  AND (c.TipoBalance='P' and c.TipoCuenta='P')
group by substring(m.nCuenta, 1,5) ,calmacen, dCuenta
,dCuenta
,dCuenta, m.ctipomovimiento, m.nCuenta
--order by m.ncuenta, ctipomovimiento desc
union
--2o nivel
select '' Cuenta,substring(m.nCuenta, 7,5)  subCuenta,'' subSubCuenta
,calmacen, dcuenta cnombre
,'  ' + dCuenta descripcion
,dCuenta, m.ctipomovimiento, m.nCuenta/*, m.**/, 0 mMovimiento2
   from tcuentas c with(NOLOCK), tmovimiento m with(NOLOCK)
   left join cat_almacen a with(NOLOCK) on cast(a.nidalmacen as varchar(10))=nsubcuenta and a.ccentrocontable = m.ccentrocontable
   --left join v_pcatalogorfc rfc with(NOLOCK)  on cidrfc=nsubcuenta
   where /*m.ncuenta*/  substring(m.ncuenta,1,11)+'-00000-00000'= c.ncuenta and nFolioPoliza = @laPoliza AND m.cCentroContable = @cUnidadResponsable and cTipoPoliza =@cTipopoliza and mmovimiento != 0 and substring(m.nCuenta, 7,5) != '00000' AND (c.TipoBalance='P' and c.TipoCuenta='P')
group by substring(m.nCuenta, 7,5)
,calmacen, dcuenta
,'  ' + dCuenta
,dCuenta, m.ctipomovimiento, m.nCuenta
--order by m.ncuenta, ctipomovimiento desc
union
--3er nivel
select '' Cuenta,''  subCuenta,substring(m.nCuenta, 13,5) subSubCuenta
,calmacen, dCuenta cnombre
,'    ' + dCuenta descripcion
,dCuenta, m.ctipomovimiento, m.nCuenta/*, m.**/, 0 mMovimiento2
   from tcuentas c with(NOLOCK), tmovimiento m with(NOLOCK)
   left join cat_almacen a with(NOLOCK) on cast(a.nidalmacen as varchar(10))=nsubcuenta and a.ccentrocontable = m.ccentrocontable
  -- left join v_pcatalogorfc rfc with(NOLOCK) on cidrfc=nsubcuenta
   where /*m.ncuenta*/  substring(m.ncuenta,1,17)+'-00000'= c.ncuenta and nFolioPoliza = @laPoliza AND m.cCentroContable = @cUnidadResponsable and cTipoPoliza=@cTipopoliza and mmovimiento != 0 and substring(m.nCuenta, 13,5) != '00000' AND (c.TipoBalance='P' and c.TipoCuenta='P')
group by substring(m.nCuenta, 13,5)
,calmacen, dCuenta
,'    ' + dCuenta
,dCuenta, m.ctipomovimiento, m.nCuenta
--order by m.ncuenta, ctipomovimiento desc
union
select '' Cuenta, ''subCuenta, case when nSubCuenta = ''
then substring(m.nCuenta, 13,5) else case when cnombre is null then calmacen else nSubCuenta end end subSubCuenta
,calmacen, cnombre
,'      ' + case when nSubCuenta = ''
then substring(m.nCuenta, 13,5) else case when cnombre is null then calmacen else '[' + nSubCuenta+']'+cNombre end end descripcion
,dCuenta, m.ctipomovimiento, m.nCuenta/*, m.**/, 0 mMovimiento2
   from tcuentas c with(NOLOCK),  tmovimiento m with(NOLOCK)
   left join cat_almacen a with(NOLOCK) on cast(a.nidalmacen as varchar(10))=nsubcuenta and a.ccentrocontable = m.ccentrocontable
   left join v_pcatalogorfc rfc with(NOLOCK)  on cidrfc=nsubcuenta
   where m.nSubcuenta != '' and m.ncuenta = c.ncuenta and nFolioPoliza = @laPoliza AND m.cCentroContable = @cUnidadResponsable and cTipoPoliza =@cTipopoliza and mmovimiento != 0 AND (c.TipoBalance='P' and c.TipoCuenta='P')
group by case when nSubCuenta = ''
then substring(m.nCuenta, 13,5) else case when cnombre is null then calmacen else nSubCuenta end end
,calmacen, cnombre
,'      ' + case when nSubCuenta = ''
then substring(m.nCuenta, 13,5) else case when cnombre is null then calmacen else '[' + nSubCuenta+']'+cNombre end end
,dCuenta, m.ctipomovimiento, m.nCuenta

   )kk
order by ncuenta, cuenta desc, subcuenta desc, subsubcuenta, ctipomovimiento desc
end

select
CASE WHEN ( CR.cIdRFC = 'CRM6702109K6' AND @cTipoObra = 'NOMINA') THEN 'CRUZ ROJA MEXICANA IAP' ELSE rfc.CNOMBRE END AS CNOMBRE2,
----rfc.CNOMBRE CNOMBRE2,
 CR.aEjercicioFiscal, CR.cIdEntidadContable, CR.caNoContrarrecibo, m.cIdDocumento, CR.cIdTipoDocumento
, CR.cIdTipoOperacion, CR.cIdRFC, CR.cIdTipoMoneda, CR.nTipoCambio, cast(CR.mImporteBruto as decimal(17,2)) mImporteBruto ,
cast((isnull(CR.mImporteSancion,0)) as decimal(17,2)) mImporteSancion ,
cast((isnull(CR.mImportePenalizacion,0)) as decimal(17,2)) mImportePena ,
cast(CR.mImporteDevolucion as decimal(17,2)) mImporteDevolucion ,
((cast(mAmortizacionAnticipo as decimal(17,2)))) as mAmortizacionAnticipo,
cast(CR.mImporteIVA as decimal(17,2)) mImporteIVA ,
cast(CR.mImporteRetencion as decimal(17,2)) mImporteRetencion ,
cast(CR.mImportePenalizacion as decimal(17,2)) mImportePenalizacion ,
cast(CR.mImporteNeto as decimal(17,2)) mImporteNeto , convert(varchar(10),CR.fProgramadaPago,103) fProgramadaPago, m.cconcepto
, ctd.cTipoDocumento, TIPO_OPERACION, cc.cDescripcion, m.cUnidadResponsable, cnoEstimacion, periodo
, pp.*, case when cTipoMovimiento = 'C' then mMovimiento2 else 0 end Debe, case when cTipoMovimiento = 'A' then mMovimiento2 else 0 end Haber
, cast(nPorcIva as decimal(10,2)) nPorcIva
, (SELECT min(EP) FROM #tmp_detalle with(NOLOCK)) laEP
, (SELECT sum(numReg) FROM #tmp_detalle with(NOLOCK)) numReg
,dbo.fnCantidadLetra(CR.mImporteNeto) cantLetras, ID_DESTINO_GASTO
, m.sFirmanteVoBo, m.sPuestoVoBo, m.sFirmanteAut, m.sPuestoAut
, m.sFirmanteEla, m.sPuestoEla
,ISNULL(cr.mOtrosImpuestos,0)mOtrosImpuestos, fRegistro
into #tmp_detalle2
from  vContrarrecibo CR with(NOLOCK)
		left join pCatalogoTipoDocumento ctd with(NOLOCK) on ctd.cIdTipoDocumento = cr.cIdTipoDocumento
		left join cat_tipo_operacion o with(NOLOCK) on o.id_tipo_oper  = cr.cidtipooperacion
		left join tCatalogoCentroContable cc with(NOLOCK) on cc.cCentrocontable = cr.cIdEntidadContable
		, v_PCATALOGORFC RFC (nolock), (

	 		select cIdDocumento cIdDocumento, nPorcIva,mImporteRetencion , CASE WHEN cxp IS NOT NULL THEN e.cconcepto + ' Ver póliza manual modificatoria con el número: ' + CONVERT(VARCHAR(10),d.nFolioPoliza) + ' de Diario.' ELSE e.cConcepto END cconcepto, canocontrarrecibo,'DIRECTO' tipoObra, e.cUnidadResponsable, cast('' as varchar(5)) cnoEstimacion, '' Periodo, ID_DESTINO_GASTO, sFirmanteVoBo, sPuestoVoBo, e.sFirmanteAut, e.sPuestoAut, sFirmanteEla, sPuestoEla
		    from tpagodirectoencabezado e with(NOLOCK)
		    LEFT JOIN dbo.tDocPolizaEncabezado d with(NOLOCK) ON caNoContrarrecibo = cxp
		    WHERE caNoContrarrecibo <> ''
		union
			select cIdRelacion cIdDocumento ,0.0 nPorcIva,0 mImporteRetencion , CASE WHEN cxp IS NOT NULL THEN e.cconcepto + ' Ver póliza manual modificatoria con el número: ' + CONVERT(VARCHAR(10),d.nFolioPoliza) + ' de Diario.' ELSE e.cConcepto END cconcepto, canocontrarrecibo, 'NOMINA' tipoObra, e.cUnidadResponsable, cast('' as varchar(5)) cnoEstimacion, '' Periodo, ID_DESTINO_GASTO, e.sFirmanteRev, e.sPuestoRev, e.sFirmanteAut, e.sPuestoAut, sFirmanteEla, sPuestoEla
		    from tnominaencabezado e with(NOLOCK)
		    LEFT JOIN dbo.tDocPolizaEncabezado d with(NOLOCK) ON caNoContrarrecibo = cxp
		union
			select cFolioPAGODIVERSO cIdDocumento, mImporteIVA nPorcIva,mImporteRetencion ,CASE WHEN cxp IS NOT NULL THEN e.cconcepto + ' Ver póliza manual modificatoria con el número: ' + CONVERT(VARCHAR(10),d.nFolioPoliza) + ' de Diario.' ELSE e.cConcepto END cconcepto, canocontrarrecibo,'DIVERSO' tipoObra, e.cUnidadResponsable,  cnoEstimacion, '' Periodo, ID_DESTINO_GASTO, sFirmanteVoBo, sPuestoVoBo, e.sFirmanteAut, e.sPuestoAut, sFirmanteEla, sPuestoEla
			from tPAGODIVERSOEncabezado e with(NOLOCK)
			LEFT JOIN dbo.tDocPolizaEncabezado d with(NOLOCK) ON caNoContrarrecibo = cxp
		union
			select cIdRelacion cIdDocumento, 0 nPorcIva,0 mImporteRetencion, CASE WHEN cxp IS NOT NULL THEN e.cconcepto + ' Ver póliza manual modificatoria con el número: ' + CONVERT(VARCHAR(10),d.nFolioPoliza) + ' de Diario.' ELSE e.cConcepto END cconcepto, canocontrarrecibo,'RELGASTO' tipoObra, e.cUnidadResponsable, cast('' as varchar(5)) cnoEstimacion, '' Periodo, ID_DESTINO_GASTO, sFirmanteVoBo, sPuestoVoBo, e.sFirmanteAut, e.sPuestoAut, sFirmanteEla, sPuestoEla
			from trelaciongastosencabezado e with(NOLOCK)
			LEFT JOIN dbo.tDocPolizaEncabezado d with(NOLOCK) ON caNoContrarrecibo = cxp
		union
			select cFolioContratoObra  cIdDocumento, mImporteIVA AS nPorcIva, mImporteRetencion, CASE WHEN cxp IS NOT NULL THEN e.cconcepto + ' Ver póliza manual modificatoria con el número: ' + CONVERT(VARCHAR(10),d.nFolioPoliza) + ' de Diario.' ELSE e.cConcepto END cconcepto, canocontrarrecibo,'OBRA' tipoObra, e.cUnidadResponsable,cnoEstimacion, 'Del ' + case when fperiodode is null then '' else convert(varchar(10), fperiodode, 103) end + ' al ' + case when fperiodohasta is null then '' else convert(varchar(10), fperiodohasta, 103) end Periodo, ID_DESTINO_GASTO, sFirmanteVoBo, sPuestoVoBo,  e.sFirmanteAut, e.sPuestoAut, sFirmanteEla, sPuestoEla
			from tPAGOOBRAEncabezado e with(NOLOCK)
			LEFT JOIN dbo.tDocPolizaEncabezado d with(NOLOCK) ON caNoContrarrecibo = cxp
		union
			select cFolioContratoObra  cIdDocumento, mImporteIVA nPorcIva, mImporteRetencion, CASE WHEN cxp IS NOT NULL THEN e.cconcepto + ' Ver póliza manual modificatoria con el número: ' + CONVERT(VARCHAR(10),d.nFolioPoliza) + ' de Diario.' ELSE e.cConcepto END cconcepto, canocontrarrecibo,'FEDERALIZADO' tipoObra, e.cUnidadResponsable,cnoEstimacion, 'Del ' + case when fperiodode is null then '' else convert(varchar(10), fperiodode, 103) end + ' al ' + case when fperiodohasta is null then '' else convert(varchar(10), fperiodohasta, 103) end Periodo, ID_DESTINO_GASTO, sFirmanteVoBo, sPuestoVoBo, e.sFirmanteAut, e.sPuestoAut, sFirmanteEla, sPuestoEla
			from tPAGOFEDERALIZADOEncabezado e with(NOLOCK)
			LEFT JOIN dbo.tDocPolizaEncabezado d with(NOLOCK) ON caNoContrarrecibo = cxp

) m, #tmp_polizapagos pp WHERE o.to_tipo_docto = tipoObra and LTRIM(RTRIM(RFC.cIdRFC)) = LTRIM(RTRIM(CR.cIdRFC))
		and m.canocontrarrecibo = cr.canocontrarrecibo
-- and CR.canocontrarrecibo =@canocontrarrecibo
  AND $P!{whereFolio}

DECLARE @strFacturas VARCHAR(500) = ''
DECLARE @fact VARCHAR(50)
DECLARE @imp VARCHAR(500)
DECLARE facturas CURSOR FOR SELECT cfactura,mImporteBruto FROM tPagoFactura with(NOLOCK) WHERE cTipoPago LIKE '%'+@cTipoObra+'%' AND nFolioPago=@noFolio
OPEN facturas
	FETCH NEXT FROM facturas INTO @fact,@imp
	WHILE @@FETCH_STATUS = 0
	BEGIN
		SET @strFacturas +=@fact+' $'+@imp+ '   '
		FETCH NEXT FROM facturas INTO @fact,@imp
	END
CLOSE facturas
DEALLOCATE facturas

select v.* Into #tmp_TablaFinal from(
select MAX(CNOMBRE2) CNOMBRE2, aEjercicioFiscal, cIdEntidadContable, caNoContrarrecibo, cIdDocumento, cIdTipoDocumento, cIdTipoOperacion, @laPoliza nPolizaAP, cIdRFC, cIdTipoMoneda, nTipoCambio, mImporteBruto,
 mImporteSancion, mImporteDevolucion, mImportePena,
(mAmortizacionAnticipo/1.16) as mAmortizacionAnticipo,
 Convert(decimal(10,3), ( ((mAmortizacionAnticipo/1.16)) / (mImporteBruto - mImporteSancion + mImporteDevolucion) ) * 100.00) nPorcAmort,
 mImporteIVA, mImporteRetencion,
 mImportePenalizacion,
 mImporteNeto, fProgramadaPago, cconcepto, cTipoDocumento, TIPO_OPERACION, cDescripcion, (select cUnidadEjecutora + ' - '+D_DESCRIPCION from tCatUnidadEjecutora with(NOLOCK) where cUnidadEjecutora=cUnidadResponsable)cUnidadResponsable, cnoEstimacion, periodo
,laEP
, Cuenta
, subCuenta
, isnull(subSubCuenta, '') subSubCuenta
, ctipomovimiento
, calmacen
, dCuenta
, nCuenta
, max(ISNULL(cnombre,'')) CNOMBRE
, max(isnull(descripcion, '')) descripcion
, max(mMovimiento2) mMovimiento2
, max(Debe) Debe
, max(Haber) Haber
, max(nPorcIva) nPorcIva
, max(numReg) numReg
, max(cantLetras) cantLetras
, CAT_DESTINO_GASTO.ID_DESTINO_GASTO, DESTINO_GASTO, @cTipoPoliza AS cTipoPoliza
, isnull(sFirmanteVoBo,'-') sFirmanteVoBo, isnull(sPuestoVoBo,'-') sPuestoVoBo, isnull(sFirmanteAut,'-') sFirmanteAut, isnull(sPuestoAut,'-') sPuestoAut, isnull(sFirmanteEla,'-') sFirmanteEla, isnull(sPuestoEla,'-') sPuestoEla,
 @strFacturas Facturas
, @ctaBanc CtaBanc
,ISNULL((SELECT TOP 1 dBanco FROM dbo.tBeneficiarioCuentasBancarias with(NOLOCK) WHERE subCuentaBancaria = @ctaBanc),'') Banco
,@cTipoObra cTipoObra
,@noFolio noFolio
,mOtrosImpuestos
,(select dbo.fn_tipoConceptoPago(@cTipoObra,@noFolio))tipoConcepto
,CASE WHEN (select dbo.fn_tipoConceptoPago(@cTipoObra,@noFolio))='NOMINA' THEN 'NOMINA' ELSE (SELECT TIPO_CONCEPTO FROM dbo.CAT_TIPO_CONCEPTO with(NOLOCK) WHERE ID_TIPO_CONCEPTO =(select dbo.fn_tipoConceptoPago(@cTipoObra,@noFolio))) END conceptoDescripcion
,CASE WHEN ISNULL(@laPolizaCancelacion,'')<>'' THEN 'Cancelada con la poliza #'+@laPolizaCancelacion ELSE '' END polizaCancelacion
,CASE WHEN @estatus IS NULL OR @estatus = '' THEN 'SIN APLICAR' WHEN @estatus IN ('C','N') THEN 'CANCELADA' ELSE '' END estatus, fRegistro
 from #tmp_detalle2 with(NOLOCK), CAT_DESTINO_GASTO
WHERE #tmp_detalle2.ID_DESTINO_GASTO = CAT_DESTINO_GASTO.ID_DESTINO_GASTO
 group by aEjercicioFiscal, cIdEntidadContable, caNoContrarrecibo, cIdDocumento, cIdTipoDocumento,  cIdTipoOperacion,  cIdRFC, cIdTipoMoneda, nTipoCambio, mImporteBruto,
 mImporteSancion, mImporteDevolucion, mAmortizacionAnticipo, mImportePena,
 mImporteIVA, mImporteRetencion,fRegistro,
 mImportePenalizacion,
 mImporteNeto, fProgramadaPago,  cconcepto, cTipoDocumento, TIPO_OPERACION, cDescripcion, cUnidadResponsable, cnoEstimacion, periodo
 ,laEP
, Cuenta
, subCuenta
, subSubCuenta
, ctipomovimiento
 ,calmacen
, dCuenta
, nCuenta
, CAT_DESTINO_GASTO.ID_DESTINO_GASTO, DESTINO_GASTO
, sFirmanteVoBo, sPuestoVoBo, sFirmanteAut, sPuestoAut, sFirmanteEla, sPuestoEla, mOtrosImpuestos
HAVING SUM(debe)<>0 OR SUM(haber)<>0 OR MAX(ISNULL(cnombre,''))<>'' OR MAX(ISNULL(descripcion, ''))<>''
) as v

LEFT join tCuentaOrden odn WITH ( NOLOCK ) on v.nCuenta like odn.CUENTA+'%' AND v.cTipoMovimiento=odn.MOVIMIENTO AND

odn.DOCUMENTO=(
case
when v.cTipoDocumento='OPERACIONES AJENAS' OR v.cTipoDocumento='RELACION DE GASTOS' OR v.cTipoDocumento='PAGO DIRECTO'
  OR v.cTipoDocumento='RECURSOS FEDERALIZADOS' OR v.cTipoDocumento='CONTRATO DE DIVERSOS' OR v.cTipoDocumento='CONTRATO DE OBRA'
THEN 'DEVENGADO'
ELSE v.cTipoDocumento
END
)
ORDER BY ORDEN,nCuenta,v.cuenta desc,subcuenta desc, subsubcuenta,cTipoMovimiento desc

IF (SELECT COUNT(*) FROM tPagoFirmanteDelagatorio WITH (NOLOCK) WHERE cTipoPago = @cTipoPago AND nFolioPago = @nFolioPago) > 0
		BEGIN

			SELECT TOP 1 @sFirmanteAut = sFirmanteAut FROM #tmp_TablaFinal tablafinal WITH (NOLOCK)

			SELECT	@sFirmanteDelegatorio = ISNULL((cNombreTitular + ' ' + cApellidoPaternoTitular + ' ' + cApellidoMaternoTitular)
													, (NOMBREN + ' ' + NOMBREP + ' ' +  NOMBREM))
			, @sPuestoFirmanteDelegatorio = ISNULL(cPuestoTitular, CARGO)
			, @sOficio = cFolioOficio
			, @sFechaOficio = CONVERT(varchar(10), CONVERT(date, dFechaOficio, 106), 103)
			, @cTipoSuplencia = cTipoSuplencia
			FROM tPagoFirmanteDelagatorio pago WITH (NOLOCK)
			INNER JOIN tCatTipoSuplencia WITH (NOLOCK)
				ON pago.ntipoSuplencia = tCatTipoSuplencia.ntiposuplencia
			LEFT JOIN v_empleados_giro WITH (NOLOCK)
					ON clave = cNumeroEmpleado
			WHERE cTipoPago = @cTipoPago AND nFolioPago = @nFolioPago

			SET @sLeyenda = 'Firma ' + @cTipoSuplencia + ' de: '  + @sFirmanteAut + ', con fundamento en el oficio: ' + @sOficio + ', de fecha: ' + @sFechaOficio
		END

DECLARE @sFirmanteDeleVoBo VARCHAR(250)
DECLARE @sPuestoFirmanteDeleVoBo VARCHAR(70)
DECLARE @sFirmanteVoBo VARCHAR(250)
DECLARE @sLeyendaVoBo VARCHAR(500)
DECLARE @sOficioVoBo VARCHAR(128)
DECLARE @sFechaOficioVoBo VARCHAR(20)

SET @sFirmanteDeleVoBo = ''
SET @sPuestoFirmanteDeleVoBo = ''
SET @sFirmanteVoBo = ''
SET @sLeyendaVoBo = ''
SET @sOficioVoBo = ''
SET @sFechaOficioVoBo = ''

IF (SELECT COUNT(*) FROM tPagoFirmanteDelegatorioVoBo WITH (NOLOCK) WHERE cTipoPago = @cTipoPago AND nFolioPago = @nFolioPago) > 0
		BEGIN

		SELECT TOP 1 @sFirmanteVoBo = sFirmanteVoBo FROM #tmp_TablaFinal tablafinal WITH (NOLOCK)

		SELECT	@sFirmanteDeleVoBo = ISNULL((cNombreTitular + ' ' + cApellidoPaternoTitular + ' ' + cApellidoMaternoTitular)
													, (NOMBREN + ' ' + NOMBREP + ' ' +  NOMBREM))
		, @sPuestoFirmanteDeleVoBo = ISNULL(cPuestoTitular, CARGO)
		, @sOficioVoBo = cFolioOficio
		, @sFechaOficioVoBo = CONVERT(varchar(10)
		, CONVERT(date, dFechaOficio, 106), 103)
		, @cTipoSuplencia = cTipoSuplencia
			FROM tPagoFirmanteDelegatorioVoBo pagovobo WITH (NOLOCK)
			INNER JOIN tCatTipoSuplencia WITH (NOLOCK)
				ON pagovobo.ntipoSuplencia = tCatTipoSuplencia.ntiposuplencia
			LEFT JOIN v_empleados_giro WITH (NOLOCK)
					ON clave = cNumeroEmpleado
			WHERE cTipoPago = @cTipoPago AND nFolioPago = @nFolioPago

			SET @sLeyendaVoBo = 'Firma ' + @cTipoSuplencia + ' de: '  + @sFirmanteVoBo + ', con fundamento en el oficio: ' + @sOficioVoBo + ', de fecha: ' + @sFechaOficioVoBo
		END

DECLARE @cInformeActividad VARCHAR(600)
DECLARE @cTipoDePagoSol VARCHAR(20)
DECLARE @cLugarFecha VARCHAR(140)

	SET @cInformeActividad = ''
	SET @cTipoDePagoSol = ''
	SET @cLugarFecha = ''
	SET @cTipoDePagoSol = (SELECT TOP 1 cTipoObra FROM #tmp_TablaFinal WITH (NOLOCK) )

	IF (@cTipoDePagoSol = 'RELGASTO' OR @cTipoDePagoSol = 'DIRECTO' OR @cTipoDePagoSol = 'DIVERSO')
		BEGIN
			SET @cInformeActividad = ISNULL((SELECT CASE WHEN COUNT(*) > 0 THEN cconcepto ELSE '' END  			FROM #tmp_TablaFinal WITH (NOLOCK) WHERE SUBSTRING(laEP, 32, 5) = '38501'
			GROUP BY cconcepto ), '')
IF (@cTipoDePagoSol = 'RELGASTO')
			SET @cLugarFecha =
				(SELECT DISTINCT MPO_NOMBRE + ', ' + EDO_NOMBRE + ', '+ UPPER(cPais)
				+ ' DEL ' +CONVERT( VARCHAR(12),fInicio,103)
				+ ' AL ' + CONVERT(VARCHAR(12), fFin ,103 )
				FROM #tmp_TablaFinal TF
				INNER JOIN dbo.tRELACIONGASTOSEncabezado RG with(NOLOCK)
					ON TF.caNoContrarrecibo = RG.caNoContrarrecibo
				INNER JOIN dbo.tViaticosComisiones COMISION with(NOLOCK)
					ON RG.nIdComision = COMISION.nIdComision
				INNER JOIN dbo.tCatalogoPaises PAIS with(NOLOCK)
					ON COMISION.nIdPais = PAIS.nIdPais
				INNER JOIN CAT_ESTADOS ESTADO with(NOLOCK)
					ON ESTADO.ID_ESTADO = COMISION.ID_ESTADO
				INNER JOIN dbo.CAT_MUNICIPIO MPIO with(NOLOCK)
					ON COMISION.ID_MUNICIPIO = MPIO.ID_MUNICIPIO
				)
		END

    --Actualizar leyenda del 15D
	alter table  #tmp_TablaFinal add cAplica15D varchar(1)

	update tbl set cAplica15D = cont.cAplica15D
	from pContratoDiverso cont inner join #tmp_TablaFinal  tbl
	on cont.cIdContrato = tbl.cIdDocumento
	
	DECLARE @esSaiAmbiental varchar(10)

	SET @esSaiAmbiental = (SELECT GP_VALOR FROM  CG_GRUPO_PROPIEDADES WHERE GP_NOMBRE LIKE '%SAI_AMBIENTAL%')

SELECT *, mimporteBruto - mImporteSancion mSubtotal,
	CASE WHEN (cTipoDocumento = 'RECURSOS FEDERALIZADOS' AND cIdRFC = 'BMN930209927')
		THEN ISNULL((	SELECT CASE WHEN pagofederalizado.nidprograma IS NOT NULL THEN 'Programa: ' + pagofederalizado.nidprograma + ' - ' + fideicomiso.cprograma ELSE '' END AS Programa
				FROM tPAGOFEDERALIZADOEncabezado pagofederalizado WITH (NOLOCK)
				INNER JOIN tfideicomiso fideicomiso WITH (NOLOCK) ON (fideicomiso.id = pagofederalizado.nidprograma AND fideicomiso.nidprograma = pagofederalizado.cUnidadResponsable)
				WHERE pagofederalizado.nFolioPAGOFEDERALIZADO = noFolio), '')
		ELSE '' END AS Programa,
	CASE WHEN (cTipoDocumento = 'RECURSOS FEDERALIZADOS' AND cIdRFC = 'BMN930209927')
		THEN ISNULL((	SELECT CASE WHEN pagofederalizado.cSubPrograma IS NOT NULL THEN 'SubPrograma: ' + pagofederalizado.cSubPrograma + ' - ' + programafideicomiso.cdescsubprograma ELSE '' END AS SubPrograma
				FROM tPAGOFEDERALIZADOEncabezado pagofederalizado WITH (NOLOCK)
				INNER JOIN tprogramafideicomiso programafideicomiso WITH (NOLOCK)
					ON ( programafideicomiso.id = pagofederalizado.nidprograma AND programafideicomiso.csubprograma = pagofederalizado.cSubPrograma)
				WHERE pagofederalizado.nFolioPAGOFEDERALIZADO = noFolio), '')
		ELSE '' END AS SubPrograma,
	@sFirmanteDelegatorio AS sFirmanteDelegatorio, @sPuestoFirmanteDelegatorio AS sPuestoFirmanteDelegatorio, @sLeyenda AS Leyenda, @cObservaciones AS cObservaciones, @cInformeActividad AS cInformeActividad
    , @sFirmanteDeleVoBo AS sFirmanteDeleVoBo, @sPuestoFirmanteDeleVoBo AS sPuestoFirmanteDeleVoBo, @sLeyendaVoBo AS LeyendaVoBo
    , @cLugarFecha AS cLugarFecha
    , case when cAplica15D = 'S' then  @leyenda6 ELSE  '' end leyenda15D
    , @esSaiAmbiental as saiAmbiental
	FROM #tmp_TablaFinal tablafinal WITH (NOLOCK)
	ORDER BY tablafinal.nCuenta, tablafinal.cuenta desc, tablafinal.subcuenta desc, tablafinal.subsubcuenta, tablafinal.cTipoMovimiento desc


IF (SELECT OBJECT_ID('tempdb..#tmp_detalle')) IS NOT NULL	DROP TABLE #tmp_detalle
IF (SELECT OBJECT_ID('tempdb..#tmp_polizapagos')) IS NOT NULL	DROP TABLE #tmp_polizapagos
IF (SELECT OBJECT_ID('tempdb..#tmp_detalle2')) IS NOT NULL	DROP TABLE #tmp_detalle2
IF (SELECT OBJECT_ID('tempdb..#tmp_TablaFinal')) IS NOT NULL	DROP TABLE #tmp_TablaFinal]]>
	</queryString>
