	<subDataset name="Table Dataset 1"/>
	<parameter name="cIdProcedimiento" class="java.lang.String"/>
	<parameter name="cIdRFC" class="java.lang.String"/>
	<parameter name="cRazonSocial" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT  *
FROM    (
        SELECT  DISTINCT Observaciones
        FROM mProcedimientoCompleto WITH(NOLOCK) WHERE evaluacionTec = 0 AND cIdProcedimiento = $P{cIdProcedimiento} AND cIdRFC=$P{cIdRFC} AND mMontoMinimo<>0
        ) qo
CROSS APPLY
        (
        SELECT  CASE ROW_NUMBER() OVER(ORDER BY nIdLineaConsolidado) WHEN 1 THEN '' ELSE ', ' END + CONVERT(VARCHAR,qi.nIdLineaConsolidado)
        FROM    mProcedimientoCompleto qi WITH(NOLOCK)
        WHERE   qi.Observaciones = qo.Observaciones AND qi.evaluacionTec = 0 AND qi.cIdProcedimiento = $P{cIdProcedimiento} AND qi.cIdRFC=$P{cIdRFC} AND qi.mMontoMinimo<>0
        ORDER BY nIdLineaConsolidado
        FOR XML PATH ('')
        ) qi(nIdLineaConsolidado) ORDER BY nIdLineaConsolidado]]>
	</queryString>
	<field name="Observaciones" class="java.lang.String"/>
	<field name="nIdLineaConsolidado" class="java.lang.String"/>
