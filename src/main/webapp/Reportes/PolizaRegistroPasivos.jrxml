	<parameter name="NumPagoAMF" class="java.lang.String"/>
	<queryString>
		<![CDATA[select tbn.dNombre  + ' ' + isnull(tbn.dApellidoPaterno, '') + ' ' + isnull(tbn.dApellidoMaterno, '') as dnombre, tpa.ClavePasivo numPagoAMF, tpa.referenciaAMF, tpa.rfcAMF, tpa.cUnidadResponsable, tpa.fechaCaptura, tpa.fechaPago, tpa.importePago, tpd.EP, tpd.importePago as iportedetalle,dbo.fnCantidadLetra(tpa.importePago) cantLetras
from tRegistroPasivoEncabezado tpa , tRegistroPasivoDetalle tpd ,tBeneficiario tbn
where tpa.ClavePasivo = tpd.ClavePasivo and
tbn.dRFC = tpa.rfcAMF
and tpa.ClavePasivo = $P{NumPagoAMF}]]>
	</queryString>
