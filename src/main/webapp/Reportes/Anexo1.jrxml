	<queryString>
		<![CDATA[select tre.caNoContrarrecibo,tre.cIdRelacion,trd.EP, sum( trd.mImporteMasIVA) Importe,tre.cnombre,tre.nFolioRELACIONGASTOS,'RG' as tipodoc,
SPACE(150) AS Programa, SPACE(150) AS SubPrograma,
(SELECT COUNT(CFACTURA) FROM tPagoFactura WITH (NOLOCK) WHERE nFolioPago = TRE.nFolioRELACIONGASTOS AND cTipoPago = 'RELACIONGASTOS') tieneFactura
INTO #tmp_anexo
from  tRELACIONGASTOSDetalle trd with(NOLOCK)
inner join tRELACIONGASTOSEncabezado tre with(NOLOCK)
on trd.nFolioRELACIONGASTOS=tre.nFolioRELACIONGASTOS
where 1 = 1 $P!{swhere}
group by tre.caNoContrarrecibo, tre.cIdRelacion, trd.EP, tre.cnombre, tre.nFolioRELACIONGASTOS

insert into #tmp_anexo
select tre.caNoContrarrecibo, tre.cIdDocumento, trd.EP, sum(trd.mImporteMasIVA) Importe, isnull(b.dNombre, '') + ' ' + isnull(b.dApellidoPaterno, '') + ' ' + isnull(b.dApellidoMaterno, ''), tre.nFolioPagoDirecto,'PI' as tipodoc
, '' AS Programa, '' AS SubPrograma,
(SELECT COUNT(CFACTURA) FROM tPagoFactura WITH (NOLOCK) WHERE nFolioPago = TRE.nFolioPagoDirecto AND cTipoPago = 'pagodirecto') tieneFactura
from  tPagoDirectoDetalle trd with(NOLOCK) inner join tPagoDirectoEncabezado tre with(NOLOCK) on trd.nFolioPagoDirecto=tre.nFolioPagoDirecto inner join tbeneficiario b on
tre.cIdRFC = b.drfc
where 1 = 1 $P!{swhere}
group by tre.caNoContrarrecibo, tre.cIdDocumento, trd.EP, isnull(b.dNombre, '') + ' ' + isnull(b.dApellidoPaterno, '') + ' ' + isnull(b.dApellidoMaterno, ''), tre.nFolioPagoDirecto

insert into #tmp_anexo
select tre.caNoContrarrecibo, tre.cIdRelacion, trd.EP, sum(trd.mImporteMasIVA) Importe, tre.cNombre, tre.nFolioNOMINA, 'NO' as tipodoc
, '' AS Programa, '' AS SubPrograma,
(SELECT COUNT(CFACTURA) FROM tPagoFactura WITH (NOLOCK) WHERE nFolioPago = TRE.nFolioNOMINA AND cTipoPago = 'NOMINA') tieneFactura
from  tNOMINADetalle trd with(NOLOCK) inner join tNOMINAEncabezado tre with(NOLOCK) on trd.nFolioNOMINA=tre.nFolioNOMINA
 where 1 = 1 $P!{swhere}
group by tre.caNoContrarrecibo, tre.cIdRelacion, trd.EP, tre.cNombre, tre.nFolioNOMINA

insert into #tmp_anexo
select tre.caNoContrarrecibo, tre.cFolioContratoObra, trd.EP, sum(trd.mImporteMasIVA) Importe, isnull(b.dNombre, '') + ' ' + isnull(b.dApellidoPaterno, '') + ' ' + isnull(b.dApellidoMaterno, ''), tre.nFolioPAGOOBRA, 'PO' as tipodoc
, '' AS Programa, '' AS SubPrograma,
(SELECT COUNT(CFACTURA) FROM tPagoFactura WITH (NOLOCK) WHERE nFolioPago = TRE.nFolioPAGOOBRA AND cTipoPago = 'PAGOOBRA') tieneFactura
from  tPAGOOBRADetalle trd with(NOLOCK) inner join tPAGOOBRAEncabezado tre with(NOLOCK) on trd.nFolioPAGOOBRA=tre.nFolioPAGOOBRA and left(trd.cEvento, 8) <> 'ANTICIPO' inner join tbeneficiario b on
tre.RFC = b.drfc
where 1 = 1 $P!{swhere}
Group by tre.caNoContrarrecibo, tre.cFolioContratoObra, trd.EP, isnull(b.dNombre, '') + ' ' + isnull(b.dApellidoPaterno, '') + ' ' + isnull(b.dApellidoMaterno, ''), tre.nFolioPAGOOBRA

insert into #tmp_anexo
select tre.caNoContrarrecibo, tre.cFolioContratoObra, trd.EP, sum(trd.mImporteMasIVA) Importe, isnull(b.dNombre, '') + ' ' + isnull(b.dApellidoPaterno, '') + ' ' + isnull(b.dApellidoMaterno, ''), tre.nFolioPAGOFEDERALIZADO, 'PF' as tipodoc,
CASE WHEN (tre.RFC = 'BMN930209927' AND tre.nidprograma IS NOT NULL)
		THEN 'Programa: ' + (SELECT fideicomiso.cprograma FROM tfideicomiso fideicomiso WITH (NOLOCK) WHERE fideicomiso.id = tre.nidprograma AND fideicomiso.nidprograma = tre.cUnidadResponsable)
		ELSE '' END AS Programa,
CASE WHEN (tre.RFC = 'BMN930209927' AND tre.cSubPrograma IS NOT NULL)
	THEN 'SubPrograma: ' + (	SELECT programafideicomiso.cdescsubprograma	FROM tprogramafideicomiso programafideicomiso WITH (NOLOCK)
			WHERE programafideicomiso.id = tre.nidprograma AND programafideicomiso.csubprograma = tre.cSubPrograma)
	ELSE '' END AS SubPrograma,
	(SELECT COUNT(CFACTURA) FROM tPagoFactura WITH (NOLOCK) WHERE nFolioPago = TRE.nFolioPAGOFEDERALIZADO AND cTipoPago = 'PAGOFEDERALIZADO') tieneFactura
from  tPAGOFEDERALIZADODetalle trd with(NOLOCK) inner join tPAGOFEDERALIZADOEncabezado tre with(NOLOCK) on trd.nFolioPAGOFEDERALIZADO=tre.nFolioPAGOFEDERALIZADO  and left(trd.cEvento, 8) <> 'ANTICIPO' inner join tbeneficiario b on
tre.RFC = b.drfc
where 1 = 1 $P!{swhere}
Group by tre.caNoContrarrecibo, tre.cFolioContratoObra, trd.EP, trd.EP, isnull(b.dNombre, '') + ' ' + isnull(b.dApellidoPaterno, '') + ' ' + isnull(b.dApellidoMaterno, ''), tre.nFolioPAGOFEDERALIZADO, tre.RFC, tre.nidprograma, tre.cSubPrograma, tre.cUnidadResponsable


insert into #tmp_anexo
select tre.caNoContrarrecibo, tre.cFolioPAGODIVERSO, trd.EP, sum(trd.mImporteMasIVA), isnull(b.dNombre, '') + ' ' + isnull(b.dApellidoPaterno, '') + ' ' + isnull(b.dApellidoMaterno, ''),  tre.nFolioPAGODIVERSO, 'PD' as tipodoc
, '' AS Programa, '' AS SubPrograma,
(SELECT COUNT(CFACTURA) FROM tPagoFactura WITH (NOLOCK) WHERE nFolioPago = TRE.nFolioPAGODIVERSO AND cTipoPago = 'PAGODIVERSO') tieneFactura
from  tPAGODIVERSODetalle trd with(NOLOCK) inner join tPAGODIVERSOEncabezado tre with(NOLOCK) on trd.nFolioPAGODIVERSO=tre.nFolioPAGODIVERSO  and left(trd.cEvento, 8) <> 'ANTICIPO' inner join tbeneficiario b on
rtrim(tre.RFC) = rtrim(b.drfc)
 where 1 = 1 $P!{swhere}
Group by tre.caNoContrarrecibo, tre.cFolioPAGODIVERSO, trd.EP, isnull(b.dNombre, '') + ' ' + isnull(b.dApellidoPaterno, '') + ' ' + isnull(b.dApellidoMaterno, ''), tre.nFolioPAGODIVERSO

select caNoContrarrecibo, cIdRelacion, EP, SUM(Importe) AS Importe, cnombre, nFolioRELACIONGASTOS, tipodoc, Programa, SubPrograma, tieneFactura
from #tmp_anexo
GROUP BY caNoContrarrecibo,cIdRelacion,EP,cnombre,nFolioRELACIONGASTOS,tipodoc, Programa, SubPrograma, tieneFactura]]>
	</queryString>
