	<field name="cInformeActividad" class="java.lang.String"/>
	<field name="sFirmanteDeleVoBo" class="java.lang.String"/>
	<field name="sPuestoFirmanteDeleVoBo" class="java.lang.String"/>
	<field name="LeyendaVoBo" class="java.lang.String"/>
	<field name="cLugarFecha" class="java.lang.String"/>
	<field name="cEsFirmaElectronica" class="java.lang.String"/>
	<field name="cInformeComision" class="java.lang.String"/>
	<variable name="nPorcIva" class="java.lang.String">
