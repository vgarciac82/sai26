<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="ReporteComsoc"  pageWidth="1007" pageHeight="623" orientation="Landscape" columnWidth="1007" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="220"/>
	<property name="ireport.y" value="0"/>
	<parameter name="Unormativa" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="nPartida" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="mes" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT DISTINCT (CA.nFolioPago),ca.cFolioSai,
ca.nPatida as partida,
     ( SELECT isnull(FolioSIAFF,'') FROM "vReintegrosCLCSICOP" WITH(NOLOCK)  WHERE caNoContrarrecibo = vc.caNoContrarrecibo ) as cheque ,
     ( SELECT dmedio FROM "tCatalogoMediosDifusion" WHERE cMedio = ca.cMedio ) as Medio,
    isnull(ca.cEspacio, '') as cEspacio,ca.nCantidad,
    ca.nTarifaUnitaria,ca.nTarifaUnitaria,ca.nTarifaTotal,txtNombre + ' ' +txtRfc as txtRfc ,ca.cEspacio,vc.fpago,
    ca.cClaveCampaña,ca.cServidor,ca.cConcepto,vc.txtFolioPago,vc.partida,ca.nIva,
    ('clave decampaña: '+ca.CclaveCampaña+ +', Numero de autorizacion : '+ca.cCveAtorizacion +
      +
     ( CASE ca.cTipoOrden
         WHEN 'Ins' THEN ', Orden de Insercion: '
         WHEN 'Tras' THEN ', Orden de Trasmision: '
         WHEN 'Ser' THEN ',Orden de Servicio: '
         ELSE ''
      END)+ ca.cClave) as Observaciones,
    (select CASE WHEN IsNumeric(SUBSTRING(vc.txtRFC,4,6)) = 1 THEN 'Moral' else 'Fisica' end) as persona
FROM
     "vComsocEncabezado" vc INNER JOIN "TComsocAutorizacion" ca ON vc."txtFolioPago" = ca."nFolioPago"
       INNER JOIN  tPagadoEncabezado pe on  vc.txtFolioPago = pe.nfolioPAGO
where (ca.cUnidadResponsable =$P{Unormativa} OR '0'=$P{Unormativa} )
AND   (vc.partida = $P{nPartida} OR '0'= $P{nPartida}
and   datepart(MONTH,  convert(date,vc.txtFechaAplicacion, 103)) =$P{mes})
and   ca.bAutoriza = '1' and pe.cDocumentoHaplicado = 'S'
order by ca.nPatida]]>
	</queryString>
