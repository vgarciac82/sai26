	<queryString>
		<![CDATA[DECLARE  @cEjercicio varchar(4), @cIdTipoPedido varchar(2), @cIdUnidadEjecutora varchar(3), @nIdConsecutivo int
--SET @cEjercicio = '2012';
--SET @cIdUnidadEjecutora = 'B56';
--SET @nIdConsecutivo = 15;
--SET @cIdTipoPedido = 'PE';
SET @cEjercicio = $P{cEjercicio};
SET @cIdUnidadEjecutora = $P{cIdUnidadEjecutora};
SET @nIdConsecutivo = $P{nIdConsecutivo};
SET @cIdTipoPedido = $P{cIdTipoPedido};
EXEC rpt_mPedidoDetalle @cEjercicio,@cIdTipoPedido,@cIdUnidadEjecutora,@nIdConsecutivo]]>
	</queryString>
