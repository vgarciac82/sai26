	<parameter name="nFolioCompromiso" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[DECLARE @nFolio INT
DECLARE @cTipoPago VARCHAR(64) = 'COMPROMISO'
DECLARE @sFirmanteDelegatorio VARCHAR(250)
DECLARE @sPuestoFirmanteDelegatorio VARCHAR(70)
DECLARE @sFirmanteAut VARCHAR(250)
DECLARE @sLeyenda VARCHAR(500)
DECLARE @sOficio VARCHAR(128)
DECLARE @sFechaOficio VARCHAR(20)
DECLARE @cTipoSuplencia VARCHAR(20)

SET @nFolio = cast ($P{nFolioCompromiso} as int)
SET @sFirmanteDelegatorio = ''
SET @sPuestoFirmanteDelegatorio = ''

SET @sFirmanteAut = ''
SET @sLeyenda = ''
SET @sOficio = ''
SET @sFechaOficio = ''

DECLARE @sFirmanteDeleVoBo VARCHAR(250)
DECLARE @sPuestoFirmanteDeleVoBo VARCHAR(70)
DECLARE @sFirmanteVoBo VARCHAR(250)
DECLARE @sLeyendaVoBo VARCHAR(500)
DECLARE @sOficioVoBo VARCHAR(128)
DECLARE @sFechaOficioVoBo VARCHAR(20)

SET @sFirmanteDeleVoBo = ''
SET @sPuestoFirmanteDeleVoBo = ''
SET @sFirmanteVoBo = ''
SET @sLeyendaVoBo = ''
SET @sOficioVoBo = ''
SET @sFechaOficioVoBo = ''

SELECT T.*
INTO #tmp_TablaFinal
FROM
(
SELECT nFolioCompromiso AS Folio,
		contrato.cIdContrato,
		compromiso.caNoCompromiso,
		contrato.cIdUnidadAdministrativa AS cUnidadEjecutora,
		cCentroContable,
		'Descripción: ' + cDescripcionPoliza cDescripcionPoliza,
		fCarga,
		'Autorización de Compromiso de Subsidio' cTipoSolicitud,
		cat.D_DESCRIPCION UR,
		CASE WHEN cDocumentoHaplicado = 'S' THEN 'Aplicado'
		WHEN cDocumentoHaplicado = 'N' THEN 'Cancelado'
		WHEN cDocumentoHaplicado = 'C' THEN 'Cancelado'
		WHEN cDocumentoHaplicado IS NULL THEN 'En tramite'
		END cEstado
		, fInicio, fTermino, fAplicacion, fAdjudicacion, fFirmaContrato
		, mImporte, mIVA, mTotal, mEjercicio, mOtrosImpuestos
		, CASE WHEN lEsPlurianual = 0 THEN 'NO' ELSE 'SI' END esPlurianual
		,claseobra.cClaseContratoObra
		, tipoContrato.cTipoContratoObra
		, fondo.cTipoFondo
		, ISNULL(Firmante.cNombreElaboro + ' ' + Firmante.cApellidoPaternoElaboro + ' ' + Firmante.cApellidoMaternoElaboro,'') AS cElaboro
		, Firmante.cNombreVoBo + ' ' + Firmante.cApellidoPaternoVoBo + ' ' + Firmante.cApellidoMaternoVoBo AS cVobo
		, Firmante.cNombreAutoriza + ' ' + Firmante.cApellidoPaternoAutoriza + ' ' + Firmante.cApellidoMaternoAutoriza AS cAutoriza
		, ISNULL(Firmante.cPuestoElaboro, '') cPuestoElaboro
		, Firmante.cPuestoVoBo
		, Firmante.cPuestoAutoriza
		, ep
		, ep.cIdEntidadContable
		, ep.cTipoContrato
		, ben.dNombre + ' ' + ben.dApellidoPaterno + ' ' + ben.dApellidoMaterno Nombre
, 'Autorizo se registre en el SICOP el compromiso de este “contrato federalizado ' + compromiso.caNoCompromiso + '  ya que se cuenta con los documentos que avalan su formalización' cObservacion
, 'COMPROMISO ORIGINAL' Tipo
, (SELECT SUM(mimporte) FROM dbo.tCompromisoDetalle
WHERE nFolioCompromiso = compromiso.nfoliocompromiso) totalCompromiso
FROM dbo.pContratoFederalizado contrato
INNER JOIN dbo.tCompromisoEncabezado compromiso
	ON contrato.cIdContrato = compromiso.cIdContrato
INNER JOIN dbo.tCatUnidadResponsable cat
	ON contrato.cIdUnidadAdministrativa = cat.cUnidadResponsable
INNER JOIN pCatalogoClaseContratoObra claseobra
	ON claseobra.cIdClaseContratoObra = contrato.cIdClaseContratoObra
INNER JOIN pCatalogoTipoContratoObra tipoContrato
	ON contrato.cIdTipoContratoObra = tipoContrato.cIdTipoContratoObra
INNER JOIN pCatalogoTipoFondo fondo
	ON contrato.cIdTipoFondo = fondo.cIdTipoFondo
INNER JOIN dbo.tFirmanteModulo Firmante
	ON compromiso.cUnidadResponsable = Firmante.cUnidadResponsable AND Firmante.cModulo = @cTipoPago
INNER JOIN dbo.tContratoEP ep
	ON ep.cIdContrato = compromiso.cIdContrato
INNER JOIN dbo.tBeneficiario ben
	ON ben.dRFC = contrato.cIdRFC
WHERE nFolioCompromiso = @nFolio
) AS T

UPDATE #tmp_TablaFinal SET Tipo = 'MODIFICADO'
WHERE cIdContrato IN (
	SELECT cIdContrato
	FROM dbo.tCompromisoEncabezado
	GROUP BY cIdContrato
	HAVING COUNT(cIdContrato) > 1)

IF (SELECT COUNT(*) FROM tPagoFirmanteDelagatorio WITH (NOLOCK) WHERE cTipoPago = @cTipoPago AND nFolioPago = @nFolio) > 0
BEGIN

	SELECT TOP 1 @sFirmanteAut = cAutoriza FROM #tmp_TablaFinal tablafinal WITH (NOLOCK)

	SELECT	@sFirmanteDelegatorio = (cNombreTitular + ' ' + cApellidoPaternoTitular + ' ' + cApellidoMaternoTitular)
	, @sPuestoFirmanteDelegatorio = cPuestoTitular
	, @sOficio = cFolioOficio
	, @sFechaOficio = CONVERT(varchar(10)
	, CONVERT(date, dFechaOficio, 106), 103)
	, @cTipoSuplencia = cTipoSuplencia
	FROM tPagoFirmanteDelagatorio pago WITH (NOLOCK)
	INNER JOIN tCatTipoSuplencia WITH (NOLOCK)
		ON pago.nTipoSuplencia = tCatTipoSuplencia.ntiposuplencia
		WHERE cTipoPago = @cTipoPago AND nFolioPago = @nFolio

	SET @sLeyenda = 'Firma ' + @cTipoSuplencia + ' de: ' + @sFirmanteAut + ', con fundamento en el oficio: ' + @sOficio + ', de fecha: ' + @sFechaOficio
END

IF (SELECT COUNT(*) FROM tPagoFirmanteDelegatorioVoBo WITH (NOLOCK) WHERE cTipoPago = @cTipoPago AND nFolioPago = @nFolio) > 0
BEGIN

	SELECT TOP 1 @sFirmanteVoBo = cVobo FROM #tmp_TablaFinal tablafinal WITH (NOLOCK)

	SELECT	@sFirmanteDeleVoBo = (cNombreTitular + ' ' + cApellidoPaternoTitular + ' ' + cApellidoMaternoTitular)
	, @sPuestoFirmanteDeleVoBo = cPuestoTitular
	, @sOficioVoBo = cFolioOficio
	, @sFechaOficioVoBo = CONVERT(varchar(10)
	, CONVERT(date, dFechaOficio, 106), 103)
	, @cTipoSuplencia = cTipoSuplencia
	FROM tPagoFirmanteDelegatorioVoBo WITH (NOLOCK)
	INNER JOIN tCatTipoSuplencia WITH (NOLOCK)
		ON tPagoFirmanteDelegatorioVoBo.ntipoSuplencia = tCatTipoSuplencia.ntiposuplencia
	WHERE cTipoPago = @cTipoPago AND nFolioPago = @nFolio

	SET @sLeyendaVoBo =  'Firma ' + @cTipoSuplencia + ' de: ' + @sFirmanteVoBo + ', con fundamento en el oficio: ' + @sOficioVoBo + ', de fecha: ' + @sFechaOficioVoBo
END


SELECT *,
@sFirmanteDelegatorio AS sFirmanteDelegatorio, @sPuestoFirmanteDelegatorio AS sPuestoFirmanteDelegatorio, @sLeyenda AS Leyenda,
@sFirmanteDeleVoBo AS sFirmanteDeleVoBo, @sPuestoFirmanteDeleVoBo AS sPuestoFirmanteDeleVoBo, @sLeyendaVoBo AS LeyendaVoBo
FROM #tmp_TablaFinal tablafinal WITH (NOLOCK)

IF (SELECT OBJECT_ID('tempdb..#tmp_TablaFinal')) IS NOT NULL	DROP TABLE #tmp_TablaFinal]]>
	</queryString>
