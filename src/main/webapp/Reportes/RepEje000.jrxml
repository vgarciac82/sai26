	<queryString>
		<![CDATA[declare @Salida varchar(100);
print($P{USUARIO});
EXECUTE sp_pMultiReporte_syc ' AND aEjercicioFiscal_1 = ''2014'' AND cUnidadResponsable_16=''A02'' AND cUnidadResponsable_15=''B30''', '''81101'',''81102'',''81103'',''81104'',''81105'',''81106'',''81107'',''81108'',''81109'',''81110'',''82101'',''82102'',''82103'',''82104'',''82105'',''82106'',''82107'',''82108''', 'cPartida_10', 'cSubCuenta', 'mSaldo12', 'GENERAL', 'EMULGADO', @Salida OUTPUT,'select cPartida_10 PARTIDA, isnull(sum(ORIGINAL),0) ORIGINAL, isnull(sum(MODIFICADO),0) MODIFICADO, isnull(sum(AMPLIACION_AUTORIZADA),0) AMPLIACION_AUTORIZADA, isnull(sum(REDUCCION_AUTORIZADA),0) REDUCCION_AUTORIZADA, isnull(sum(AMPLIACION_EN_TRAMITE),0) AMPLIACION_EN_TRAMITE, isnull(sum(REDUCCION_EN_TRAMITE),0) REDUCCION_EN_TRAMITE, isnull(sum(REINTEGRO_EN_TRAMITE),0) REINTEGRO_EN_TRAMITE, isnull(sum(RECTIFICACION),0) RECTIFICACION, isnull(sum(REDUCCION_SHCP_EN_TRAMITE),0) REDUCCION_SHCP_EN_TRAMITE, isnull(sum(REDUCCION_SHCP_APLICADA),0) REDUCCION_SHCP_APLICADA, isnull(sum(APARTADO),0) APARTADO, isnull(sum(PRECOMPROMETIDO),0) PRECOMPROMETIDO, isnull(sum(COMPROMETIDO),0) COMPROMETIDO, isnull(sum(DEVENGADO),0) DEVENGADO, isnull(sum(EJERCIDO_NO_PAGADO),0) EJERCIDO_NO_PAGADO, isnull(sum(DISPONIBLE_NETO),0) DISPONIBLE_NETO, isnull(sum(DISPONIBLE_BRUTO),0) DISPONIBLE_BRUTO, isnull(sum(EJERCIDO_PAGADO),0) EJERCIDO_PAGADO from tSaldosPresupuesto WITH (NOLOCK) where Usuario=''EMULGADO'' group by  cPartida_10 order by cPartida_10;';
print (@Salida);]]>
	</queryString>
