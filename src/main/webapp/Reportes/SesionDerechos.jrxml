<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="CesionDerechos"  pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="822" leftMargin="10" rightMargin="10" topMargin="10" bottomMargin="10">
	<property name="ireport.zoom" value="1.5"/>
	<property name="ireport.x" value="209"/>
	<property name="ireport.y" value="0"/>
	<property name="ireport.scriptlethandling" value="0"/>
	<property name="ireport.encoding" value="UTF-8"/>
	<import value="net.sf.jasperreports.engine.*"/>
	<import value="java.util.*"/>
	<import value="net.sf.jasperreports.engine.data.*"/>
	<parameter name="sUA" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="sTipo" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT caNoContrarrecibo, fAplicacion, mImporteNeto, RFC, NOMBRE, cNoFactura, cEjercicio, cIdEntidadContable, cIdContrato, cIdRFCSesion, cNumOficioJuridico, fSesionVigencia, U_LOGIN, TIPO, UA
FROM  (SELECT PO.caNoContrarrecibo, PO.fAplicacion, PO.mImporteNeto, PO.RFC, PO.NOMBRE, PO.cNoFactura, SO.cEjercicio, SO.cIdEntidadContable, SO.cIdContrato, SO.cIdRFCSesion, SO.cNumOficioJuridico, SO.fSesionVigencia, SO.U_LOGIN, 'OBRA' AS TIPO,
              CO.cIdUnidadAdministrativa AS UA
       FROM dbo.pContratoObra AS CO
			INNER JOIN dbo.tPAGOOBRAEncabezado AS PO ON PO.cFolioContratoObra = CO.cIdContrato and PO.cDocumentoHaplicado = 'S'
			INNER JOIN dbo.pContratoObraSesion AS SO ON SO.cIdContrato = CO.cIdContrato  AND SO.FSESIONVIGENCIA <= PO.fAplicacion
    UNION
      SELECT PF.caNoContrarrecibo, PF.fAplicacion, PF.mImporteNeto, PF.RFC, PF.NOMBRE, PF.cNoFactura, SF.cEjercicio, SF.cIdEntidadContable, SF.cIdContrato, SF.cIdRFCSesion, SF.cNumOficioJuridico, SF.fSesionVigencia, SF.U_LOGIN, 'FEDERALIZADO',
             CO.cIdUnidadAdministrativa AS UA
     FROM  dbo.pContratoObra AS CO
			INNER JOIN dbo.tPAGOFEDERALIZADOEncabezado AS PF ON PF.cFolioContratoObra = CO.cIdContrato and PF.cDocumentoHaplicado = 'S'
			INNER JOIN dbo.pContratoFederalizadoSesion AS SF ON SF.cIdContrato = CO.cIdContrato AND SF.FSESIONVIGENCIA <= PF.FAPLICACION
       UNION
     SELECT PD.caNoContrarrecibo, PD.fAplicacion, PD.mImporteNeto, PD.RFC, PD.NOMBRE, PD.cNoFactura, SD.cEjercicio, SD.cIdEntidadContable, SD.cIdContrato, SD.cIdRFCSesion, SD.cNumOficioJuridico, SD.fSesionVigencia, SD.U_LOGIN, 'DIVERSO',
                                 CD.cIdUnidadAdministrativa
     FROM dbo.pContratoDiverso AS CD
			INNER JOIN dbo.tPAGODIVERSOEncabezado AS PD ON PD.cFolioPAGODIVERSO = CD.cIdContrato and PD.cDocumentoHaplicado = 'S'
			INNER JOIN dbo.pContratoDiversoSesion AS SD ON SD.cIdContrato = CD.cIdContrato AND SD.FSESIONVIGENCIA <= PD.FAPLICACION
	) as S
WHERE (UA = $P{sUA} OR $P{sUA} = 'RHQ' ) AND (TIPO = $P{sTipo} OR $P{sTipo} = 'TODOS')]]>
	</queryString>
	<field name="caNoContrarrecibo" class="java.lang.String"/>
	<field name="fAplicacion" class="java.sql.Timestamp"/>
	<field name="mImporteNeto" class="java.math.BigDecimal"/>
	<field name="RFC" class="java.lang.String"/>
	<field name="NOMBRE" class="java.lang.String"/>
	<field name="cNoFactura" class="java.lang.String"/>
	<field name="cEjercicio" class="java.lang.String"/>
	<field name="cIdEntidadContable" class="java.lang.String"/>
	<field name="cIdContrato" class="java.lang.String"/>
	<field name="cIdRFCSesion" class="java.lang.String"/>
	<field name="cNumOficioJuridico" class="java.lang.String"/>
	<field name="fSesionVigencia" class="java.sql.Timestamp"/>
	<field name="U_LOGIN" class="java.lang.String"/>
	<field name="TIPO" class="java.lang.String"/>
	<field name="UA" class="java.lang.String"/>
