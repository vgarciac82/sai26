<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="pagoDirectoReporte"  pageWidth="612" pageHeight="792" columnWidth="572" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<property name="ireport.zoom" value="1.2396694214876032"/>
	<property name="ireport.x" value="24"/>
	<property name="ireport.y" value="0"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="cIdDocumento" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select c.nFolioPago, consecutivo,A.cIdUnidadEjecutora, f.D_DESCRIPCION,
'Pago directo N° '+a.cIdDocumento+' '+convert(varchar(500),A.cConcepto) as concepto,
A.cIdRFC,b.cnombre,  convert(varchar,c.fechaFactura,103)  fechaFactura, REPLACE(c.cIdFactura,'-','') factura,  case when a.ID_DESTINO_GASTO='AL' THEN
  SUBSTRING(ALTAALMACENARIA,0,CHARINDEX('|',altaAlmacenaria))
   ELSE
  '' END altaAlmacenaria,
RTRIM(d.cIdPartida)+'.'+d.claveEp grupo,
 d.cIdPartida ,d.claveEp , e.cSubPartida, d.montoBruto ,
 rtrim(d.cIdPartida)+'-'+e.cSubPartida as descPartida
 ,(select SUM(montoBruto) as subTotalPartida from mPagoDirectoFacturaDetalle where nFolioPago=a.C_CONSECUTIVO_PAGODIRECTO and cIdPartida=d.cIdPartida
 and claveEp=d.claveEp  group by cIdPartida, claveEp ) subTotal
  ,(select /*SUM(montoBruto)*(1+a.nPorcentajeIVA)*/SUM(montoNeto) as subTotalPartida from mPagoDirectoFacturaDetalle where nFolioPago=a.C_CONSECUTIVO_PAGODIRECTO and cIdPartida=d.cIdPartida
 and claveEp=d.claveEp  group by cIdPartida, claveEp ) subTotalIva
,(select SUM(montoBruto) as totalDocumento from mPagoDirectoFacturaDetalle where nFolioPago=a.C_CONSECUTIVO_PAGODIRECTO group by nFolioPago) totalDocumento
 , dbo.CantidadConLetraPedido(CONVERT(MONEY,(select SUM(montoBruto) as totalDocumento from mPagoDirectoFacturaDetalle where nFolioPago=a.C_CONSECUTIVO_PAGODIRECTO group by nFolioPago)),'PESOS') letra
, (select /*SUM(mpdf.montoBruto)*(1+mpdm.nPorcentajeIVA) */ SUM(montoNeto) from mPagoDirectoFacturaDetalle mpdf inner join mPagoDirectoMateriales mpdm on
mpdf.nFolioPago=mpdm.C_CONSECUTIVO_PAGODIRECTO where nFolioPago=a.C_CONSECUTIVO_PAGODIRECTO group by nFolioPago,nPorcentajeIVA) totalNeto
 , dbo.CantidadConLetraPedido(CONVERT(MONEY,
 (select /*SUM(mpdf.montoBruto)*(1+mpdm.nPorcentajeIVA)*/ SUM(mpdf.montoNeto) from mPagoDirectoFacturaDetalle mpdf inner join mPagoDirectoMateriales mpdm on
mpdf.nFolioPago=mpdm.C_CONSECUTIVO_PAGODIRECTO where nFolioPago=a.C_CONSECUTIVO_PAGODIRECTO group by nFolioPago,nPorcentajeIVA)),'PESOS') letraNeto


 from mPagoDirectoMateriales a WITH(NOLOCK)
INNER JOIN v_PCATALOGORFC B ON a.cIdRFC=B.cIdRFC
inner join mPagoDirectoFacturaEncabezado c on
a.C_CONSECUTIVO_PAGODIRECTO=c.nFolioPago
inner join mPagoDirectoFacturaDetalle d on
c.nFolioPago=d.nFolioPago and c.cIdFactura=d.cIdFactura
inner join mCatalogoSubPartida e on
d.cIdPartida=e.cIdSubPartida
inner join v_unidadEjecutoraPadre f on a.cIdUnidadEjecutora=f.cUnidadResponsable
where cIdDocumento=$P{cIdDocumento}
order by cIdPartida]]>
	</queryString>
