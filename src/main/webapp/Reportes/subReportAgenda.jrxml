	<parameter name="SUBREPORT_DIR" class="java.lang.String">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="whereFolio" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString language="SQL">
		<![CDATA[
SELECT nIdComision, AGENDA.nidAgenda, convert(varchar(12),fInicio ,103) fInicio,  convert(varchar(12),ffin ,103 ) fFin,  cPais, dbo.fn_mayusc_formato(EDO_NOMBRE) EDO_NOMBRE, 
dbo.fn_mayusc_formato(MPO_NOMBRE) MPO_NOMBRE, cLocalidad, cMotivoComision, cActividades, ROW_NUMBER () OVER (ORDER BY DATEPART(MONTH, finicio),  DATEPART(day, finicio)) consecutivo
FROM tAgenda AGENDA
INNER JOIN tViaticos VIAT WITH (NOLOCK)ON AGENDA.nidAgenda = VIAT.nidAgenda
INNER JOIN CAT_ESTADOS estado WITH (NOLOCK) ON (estado.ID_ESTADO = AGENDA.nidEstado)
INNER JOIN CAT_MUNICIPIO municipio WITH (NOLOCK) ON (municipio.ID_ESTADO = AGENDA.nidEstado AND municipio.ID_MUNICIPIO = AGENDA.nidMunicipio)
INNER JOIN tCatalogoPaises paises WITH (NOLOCK) ON (paises.nIdPais = AGENDA.nIdPais)
WHERE nIdComision =  $P{whereFolio} 
AND VIAT.cTienePaquete = 1 AND VIAT.nIdPaquete IN (
SELECT nIdPaquete FROM tCatPaquetesComision WITH (NOLOCK) WHERE cNombre LIKE '%CERTIF%')
ORDER BY DATEPART(MONTH, finicio),  DATEPART(day, finicio)
]]>
	</queryString>
