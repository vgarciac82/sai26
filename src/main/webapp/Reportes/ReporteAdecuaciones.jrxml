	<subDataset name="Table Dataset 1"/>
	<parameter name="folio" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["C:\\SyC\\Clientes\\CONAFOR\\Desarrollo\\Workspace\\sai_conafor\\WebContent\\Reportes\\"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[DECLARE @nFolioAdecuacion INT = $P{folio}
SELECT encabezado.nFolioAdecuacion
	, fCarga
	, encabezado.cTipoAdecuacion
	, encabezado.nNivel
	, encabezado.cJustificacion
	, ROW_NUMBER() OVER(ORDER BY SUBSTRING(detalle.cEvento,1,1)DESC,ep) AS nDocRenglon
	, detalle.EP
	, SUBSTRING(detalle.cEvento,1,1) AS movto
	, SUM (mImporte) mImporte
	, SUM( CASE WHEN detalle.cMes = 1 THEN mImporte ELSE 0  END ) AS mImporteEnero
	, SUM( CASE WHEN detalle.cMes = 2 THEN mImporte ELSE 0  END ) AS mImporteFebrero
	, SUM( CASE WHEN detalle.cMes = 3 THEN mImporte ELSE 0  END ) AS mImporteMarzo
	, SUM( CASE WHEN detalle.cMes = 4 THEN mImporte ELSE 0  END ) AS mImporteAbril
	, SUM( CASE WHEN detalle.cMes = 5 THEN mImporte ELSE 0  END ) AS mImporteMayo
	, SUM( CASE WHEN detalle.cMes = 6 THEN mImporte ELSE 0  END ) AS mImporteJunio
	, SUM( CASE WHEN detalle.cMes = 7 THEN mImporte ELSE 0  END ) AS mImporteJulio
	, SUM( CASE WHEN detalle.cMes = 8 THEN mImporte ELSE 0  END ) AS mImporteAgosto
	, SUM( CASE WHEN detalle.cMes = 9 THEN mImporte ELSE 0  END ) AS mImporteSeptiembre
	, SUM( CASE WHEN detalle.cMes = 10 THEN mImporte ELSE 0  END ) AS mImporteOctubre
	, SUM( CASE WHEN detalle.cMes = 11 THEN mImporte ELSE 0  END ) AS mImporteNoviembre
	, SUM( CASE WHEN detalle.cMes = 12 THEN mImporte ELSE 0  END ) AS mImporteDiciembre
FROM dbo.tAdecuacionEncabezado encabezado WITH( NOLOCK )
LEFT OUTER JOIN tAdecuacionDetalle detalle WITH (NOLOCK)
	ON encabezado.nFolioAdecuacion = detalle.nFolioAdecuacion
WHERE detalle.nFolioAdecuacion = @nFolioAdecuacion
GROUP BY encabezado.nFolioAdecuacion, fCarga, encabezado.cTipoAdecuacion, encabezado.nNivel, encabezado.cJustificacion, detalle.EP, cEvento]]>
	</queryString>
