	<parameter name="SUBREPORT_DIR" class="java.lang.String">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT nIdComision
	, cNombre
	, cPuesto
	, CASE cAutorizado 
		WHEN 'S' THEN 'Si' 
		WHEN 'N' THEN 'No' 
		WHEN 'C' THEN 'Cancelado' 
		ELSE '' END cAutorizado
	, dfechaAutoriza
FROM tfirmantesviaticos AS FIRMANTE WITH (NOLOCK) 
JOIN tComision AS COMISION WITH (NOLOCK) ON FIRMANTE.nFolio = COMISION.nIdComision
WHERE nIdComision = $P{idComision}]]>
	</queryString>
