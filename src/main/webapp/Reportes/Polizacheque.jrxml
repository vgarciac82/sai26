<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="PolizaPago" pageWidth="612" pageHeight="792" whenNoDataType="AllSectionsNoDetail" columnWidth="612" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="80">
	<property name="ireport.zoom" value="1.5"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="401"/>
	<property name="ireport.scriptlethandling" value="0"/>
	<property name="ireport.encoding" value="UTF-8"/>
	<import value="net.sf.jasperreports.engine.*"/>
	<import value="java.util.*"/>
	<import value="net.sf.jasperreports.engine.data.*"/>
	<parameter name="whereFolio" class="java.lang.String">
		<defaultValueExpression><![CDATA["14"]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[DECLARE @laPoliza varchar(10)
DECLARE @cUnidadResponsable varchar(10)
DECLARE @cTipoPoliza varchar(10)
DECLARE @cTipoObra varchar(10)
DECLARE @cIdTipoPago varchar(1)

select @laPoliza= nFolioPoliza, @cTipoPoliza = cTipoPoliza, @cTipoObra = tipoObra, @cUnidadResponsable = cCentroContable
		from (select nFolioPoliza, cTipoPoliza, 'CHEQUE' tipoObra, nFolioCheque,  cCentroContable from tChequeEncabezado e with(NOLOCK) ) CR where nFolioCheque = $P!{whereFolio}


select * into #tmp_polizapagos from (select substring(m.nCuenta, 1,5) Cuenta,'' subCuenta,'' subSubCuenta
,calmacen, dCuenta cnombre
,dCuenta descripcion
,dCuenta, m.ctipomovimiento, m.nCuenta/*,  m.**/, sum(mMovimiento) mMovimiento2
   from tcuentas c with(NOLOCK), tmovimiento m with(NOLOCK)
   left join cat_almacen a on cast(a.nidalmacen as varchar(10))=nsubcuenta and a.ccentrocontable = m.ccentrocontable
   --left join v_pcatalogorfc rfc on cidrfc=nsubcuenta
   where /*m.ncuenta = c.ncuenta */ substring(m.ncuenta,1,5)+'-00000-00000-00000'= c.ncuenta  and nFolioPoliza = @laPoliza AND m.cCentroContable = @cUnidadResponsable and cTipopoliza =@cTipoPoliza and mmovimiento != 0 and m.ncuenta not like '8%'
group by substring(m.nCuenta, 1,5) ,calmacen, dCuenta
,dCuenta
,dCuenta, m.ctipomovimiento, m.nCuenta
--order by m.ncuenta, ctipomovimiento desc
union
--2o nivel
select '' Cuenta,substring(m.nCuenta, 7,5)  subCuenta,'' subSubCuenta
,calmacen, dcuenta cnombre
,'  ' + dCuenta descripcion
,dCuenta, m.ctipomovimiento, m.nCuenta/*, m.**/, 0 mMovimiento2
   from tcuentas c with(NOLOCK), tmovimiento m with(NOLOCK)
   left join cat_almacen a on cast(a.nidalmacen as varchar(10))=nsubcuenta and a.ccentrocontable = m.ccentrocontable
   --left join v_pcatalogorfc rfc on cidrfc=nsubcuenta
   where /*m.ncuenta*/  substring(m.ncuenta,1,11)+'-00000-00000'= c.ncuenta and nFolioPoliza = @laPoliza AND m.cCentroContable = @cUnidadResponsable and cTipopoliza =@cTipoPoliza and mmovimiento != 0 and m.ncuenta not like '8%'
   and substring(m.nCuenta, 7,5) != '00000'
group by substring(m.nCuenta, 7,5)
,calmacen, dcuenta
,'  ' + dCuenta
,dCuenta, m.ctipomovimiento, m.nCuenta
--order by m.ncuenta, ctipomovimiento desc
union
--3er nivel
select '' Cuenta,''  subCuenta,substring(m.nCuenta, 13,5) subSubCuenta
,calmacen, dCuenta cnombre
,'    ' + dCuenta descripcion
,dCuenta, m.ctipomovimiento, m.nCuenta/*, m.**/, 0 mMovimiento2
   from tcuentas c with(NOLOCK), tmovimiento m with(NOLOCK)
   left join cat_almacen a on cast(a.nidalmacen as varchar(10))=nsubcuenta and a.ccentrocontable = m.ccentrocontable
  -- left join v_pcatalogorfc rfc on cidrfc=nsubcuenta
   where /*m.ncuenta*/  substring(m.ncuenta,1,17)+'-00000'= c.ncuenta and nFolioPoliza = @laPoliza AND m.cCentroContable = @cUnidadResponsable and cTipopoliza =@cTipoPoliza and mmovimiento != 0 and m.ncuenta not like '8%'
   and substring(m.nCuenta, 13,5) != '00000'
group by substring(m.nCuenta, 13,5)
,calmacen, dCuenta
,'    ' + dCuenta
,dCuenta, m.ctipomovimiento, m.nCuenta
--order by m.ncuenta, ctipomovimiento desc
union
select '' Cuenta, ''subCuenta, case when nSubCuenta = ''
then substring(m.nCuenta, 13,5) else case when cnombre is null then calmacen else nSubCuenta end end subSubCuenta
,calmacen, cnombre
,'      ' + case when nSubCuenta = ''
then substring(m.nCuenta, 13,5) else case when cnombre is null then calmacen else '[' + nSubCuenta+']'+cNombre end end descripcion
,dCuenta, m.ctipomovimiento, m.nCuenta/*, m.**/, 0 mMovimiento2
   from tcuentas c,  tmovimiento m
   left join cat_almacen a on cast(a.nidalmacen as varchar(10))=nsubcuenta and a.ccentrocontable = m.ccentrocontable
   left join v_pcatalogorfc rfc on cidrfc=nsubcuenta
   where m.nSubcuenta != '' and m.ncuenta = c.ncuenta and nFolioPoliza = @laPoliza AND m.cCentroContable = @cUnidadResponsable and cTipopoliza =@cTipoPoliza and mmovimiento != 0 and m.ncuenta not like '8%'
group by case when nSubCuenta = ''
then substring(m.nCuenta, 13,5) else case when cnombre is null then calmacen else nSubCuenta end end
,calmacen, cnombre
,'      ' + case when nSubCuenta = ''
then substring(m.nCuenta, 13,5) else case when cnombre is null then calmacen else '[' + nSubCuenta+']'+cNombre end end
,dCuenta, m.ctipomovimiento, m.nCuenta

   )kk
order by ncuenta, cuenta desc, subcuenta desc, subsubcuenta, ctipomovimiento desc


select c.mImporteCheque,
       c.cCuentaBancaria,
	   c.cConcepto,
	   b.dNombre  + ' ' + isnull(b.dApellidoPaterno, '') + ' ' + isnull(b.dApellidoMaterno, '') as cBeneficiario,
	   c.fElaboracion,
	   c.nFolioPoliza,
	   c.cTipoPoliza,
	   dbo.fnCantidadLetra(c.mImporteCheque) cantLetras,
	   c.caNOcontrarrecibo,
	   e.u_nombre as nombre_ela,
	   r.u_nombre as nombre_rev,
	   a.u_nombre as nombre_aut,
	   pp.*
into #tmp_detalle2
from  tChequeEncabezado c, tBeneficiario b, cg_usuario e, cg_usuario r, cg_usuario a, #tmp_polizapagos pp
WHERE LTRIM(RTRIM(c.cIdRFC)) = LTRIM(RTRIM(b.dRFC))  and
      c.u_login_captura = e.u_login and
      c.u_login_revisa = r.u_login and
      c.u_login_autoriza = a.u_login and
      nFolioCheque = $P!{whereFolio}


select mImporteCheque
, cConcepto
, cbeneficiario
, fElaboracion
, nFolioPoliza
,cTipoPoliza
,Cuenta
, subCuenta
, isnull(subSubCuenta, cCuentaBancaria) subSubCuenta
, ctipomovimiento
, calmacen
, dCuenta
, nCuenta
, cnombre
, isnull(descripcion, cCuentaBancaria) descripcion
, case when ctipomovimiento = 'C' then mMovimiento2 else 0 end as debe
, case when ctipomovimiento = 'A' then mMovimiento2 else 0 end as haber
, '(' + cantLetras + ')' cantLetras
, caNoContrarrecibo
, nombre_ela
, nombre_rev
, nombre_aut
 from #tmp_detalle2
 order by ncuenta, cuenta desc, subcuenta desc, subsubcuenta, ctipomovimiento desc

if exists(select 1 from sysobjects where name = 'tmp_detalle2') drop table  tmp_detalle2
if exists(select 1 from sysobjects where name = 'tmp_polizapagos') drop table  tmp_polizapagos]]>
	</queryString>
	<field name="mImporteCheque" class="java.math.BigDecimal"/>
	<field name="cConcepto" class="java.lang.String"/>
	<field name="cbeneficiario" class="java.lang.String"/>
	<field name="fElaboracion" class="java.sql.Timestamp"/>
	<field name="nFolioPoliza" class="java.lang.Integer"/>
	<field name="cTipoPoliza" class="java.lang.String"/>
	<field name="Cuenta" class="java.lang.String"/>
	<field name="subCuenta" class="java.lang.String"/>
	<field name="subSubCuenta" class="java.lang.String"/>
	<field name="ctipomovimiento" class="java.lang.String"/>
	<field name="calmacen" class="java.lang.String"/>
	<field name="dCuenta" class="java.lang.String"/>
	<field name="nCuenta" class="java.lang.String"/>
	<field name="cnombre" class="java.lang.String"/>
	<field name="descripcion" class="java.lang.String"/>
	<field name="debe" class="java.math.BigDecimal"/>
	<field name="haber" class="java.math.BigDecimal"/>
	<field name="cantLetras" class="java.lang.String"/>
	<field name="caNoContrarrecibo" class="java.lang.String"/>
	<field name="nombre_ela" class="java.lang.String"/>
	<field name="nombre_rev" class="java.lang.String"/>
	<field name="nombre_aut" class="java.lang.String"/>
	<variable name="Debe_1" class="java.math.BigDecimal" resetType="Group" resetGroup="caNoContrarrecibo" calculation="Sum">
		<variableExpression><![CDATA[$F{debe}]]></variableExpression>
	</variable>
	<variable name="Haber_1" class="java.math.BigDecimal" resetType="Group" resetGroup="caNoContrarrecibo" calculation="Sum">
		<variableExpression><![CDATA[$F{haber}]]></variableExpression>
	</variable>
	<variable name="noPoliza" class="java.lang.String">
		<initialValueExpression><![CDATA[$F{cTipoPoliza} + "-" + $F{nFolioPoliza}.toString()]]></initialValueExpression>
	</variable>
	<group name="caNoContrarrecibo">
		<groupExpression><![CDATA[$F{caNoContrarrecibo}]]></groupExpression>
		<groupHeader>
			<band height="380" splitType="Stretch">
				<textField pattern="¤ #,##0.00">
					<reportElement x="465" y="84" width="119" height="20"/>
					<textElement textAlignment="Right"/>
					<textFieldExpression class="java.math.BigDecimal"><![CDATA[$F{mImporteCheque}]]></textFieldExpression>
				</textField>
				<textField>
					<reportElement x="46" y="279" width="387" height="63"/>
					<textElement>
						<font size="8"/>
					</textElement>
					<textFieldExpression class="java.lang.String"><![CDATA[$F{cConcepto}]]></textFieldExpression>
				</textField>
				<textField>
					<reportElement x="120" y="82" width="330" height="20"/>
					<textElement>
						<font size="8"/>
					</textElement>
					<textFieldExpression class="java.lang.String"><![CDATA[$F{cbeneficiario}]]></textFieldExpression>
				</textField>
				<textField pattern="dd/MM/yyyy">
					<reportElement x="450" y="45" width="100" height="16"/>
					<textElement>
						<font size="8"/>
					</textElement>
					<textFieldExpression class="java.sql.Timestamp"><![CDATA[$F{fElaboracion}]]></textFieldExpression>
				</textField>
				<textField>
					<reportElement x="31" y="126" width="539" height="20"/>
					<textElement>
						<font size="8"/>
					</textElement>
					<textFieldExpression class="java.lang.String"><![CDATA[$F{cantLetras}]]></textFieldExpression>
				</textField>
				<staticText>
					<reportElement key="staticText" x="127" y="28" width="256" height="21"/>
					<textElement textAlignment="Center" verticalAlignment="Middle">
						<font fontName="Times New Roman" size="14" isBold="true"/>
					</textElement>
					<text><![CDATA[NO NEGOCIABLE]]></text>
				</staticText>
			</band>
		</groupHeader>
		<groupFooter>
			<band height="36" splitType="Stretch"/>
		</groupFooter>
	</group>
	<background>
		<band splitType="Stretch"/>
	</background>
	<title>
		<band splitType="Stretch"/>
	</title>
	<pageHeader>
		<band splitType="Stretch"/>
	</pageHeader>
	<columnHeader>
		<band splitType="Stretch"/>
	</columnHeader>
	<detail>
		<band height="16" splitType="Stretch">
			<textField isBlankWhenNull="false">
				<reportElement key="textField" x="46" y="0" width="36" height="9"/>
				<textElement textAlignment="Center">
					<font size="7"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{Cuenta}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="false">
				<reportElement key="textField" x="82" y="0" width="39" height="9"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font size="7"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{subCuenta}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="false">
				<reportElement key="textField" x="123" y="0" width="72" height="9"/>
				<textElement textAlignment="Center">
					<font size="7"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{subSubCuenta}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="false">
				<reportElement key="textField" x="195" y="0" width="178" height="9"/>
				<textElement>
					<font size="7"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{descripcion}]]></textFieldExpression>
			</textField>
			<textField pattern="#,##0.00;-#,##0.00" isBlankWhenNull="true">
				<reportElement key="textField" x="422" y="0" width="76" height="9"/>
				<textElement textAlignment="Right">
					<font size="7"/>
				</textElement>
				<textFieldExpression class="java.math.BigDecimal"><![CDATA[$F{debe}]]></textFieldExpression>
			</textField>
			<textField pattern="#,##0.00;-#,##0.00" isBlankWhenNull="false">
				<reportElement key="textField" x="515" y="0" width="73" height="9"/>
				<textElement textAlignment="Right">
					<font size="7"/>
				</textElement>
				<textFieldExpression class="java.math.BigDecimal"><![CDATA[$F{haber}]]></textFieldExpression>
			</textField>
		</band>
	</detail>
	<columnFooter>
		<band splitType="Stretch"/>
	</columnFooter>
	<pageFooter>
		<band height="31" splitType="Stretch">
			<textField>
				<reportElement x="6" y="7" width="100" height="20" forecolor="#FFFFFF"/>
				<textElement>
					<font fontName="Arial" size="6"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{nombre_ela}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="120" y="7" width="100" height="20" forecolor="#FFFFFF"/>
				<textElement>
					<font fontName="Arial" size="6"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{nombre_rev}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="233" y="7" width="100" height="20" forecolor="#FFFFFF"/>
				<textElement>
					<font fontName="Arial" size="6"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{nombre_aut}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="433" y="5" width="46" height="20" forecolor="#FFFFFF"/>
				<textElement>
					<font size="6"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{cTipoPoliza} + "-" + $F{nFolioPoliza}.toString()]]></textFieldExpression>
			</textField>
			<textField pattern="#,##0.00;-#,##0.00" isBlankWhenNull="false">
				<reportElement key="textField" x="409" y="3" width="89" height="15"/>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font size="8"/>
				</textElement>
				<textFieldExpression class="java.math.BigDecimal"><![CDATA[$V{Debe_1}]]></textFieldExpression>
			</textField>
			<textField pattern="#,##0.00;-#,##0.00" isBlankWhenNull="false">
				<reportElement key="textField" x="517" y="3" width="71" height="15"/>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font size="8"/>
				</textElement>
				<textFieldExpression class="java.math.BigDecimal"><![CDATA[$V{Haber_1}]]></textFieldExpression>
			</textField>
		</band>
	</pageFooter>
	<summary>
		<band splitType="Stretch"/>
	</summary>
</jasperReport>
