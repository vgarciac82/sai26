	<parameter name="whereFolio" class="java.lang.String">
		<defaultValueExpression><![CDATA["and Ce.nfoliocaja=2"]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[DECLARE @laPoliza varchar(10)
DECLARE @cUnidadResponsable varchar(10)
DECLARE @cTipoPoliza varchar(10)
DECLARE @cTipoObra varchar(10)
DECLARE @cIdTipoPago varchar(1)
declare @cuantos smallint
DECLARE @noFolio INT

--set @laPoliza=2
--set @cUnidadResponsable=10
--set @cTipoPoliza='EG'

select @noFolio = nFolioCaja, @laPoliza= nFolioPoliza, @cTipoPoliza = cTipoPoliza
, @cUnidadResponsable = cIDEntidadContable, @cTipoObra = tipoObra, @cIdTipoPago = cIdTipoPagoDirecto
from (select nfoliocaja, nFolioPoliza, cTipoPoliza, cdescripcionpoliza, ''canocontrarrecibo,'DIRECTO' tipoObra, cunidadresponsablecontable, cast('' as varchar(5)) cnoEstimacion, '' Periodo,cCentrocontable cIdEntidadContable, ''cIdTipoPagoDirecto
   from tcajaencabezado e with(NOLOCK)-- where e.cdocumentohaplicado='S'
--union select nFolioRELACIONGASTOS,nFolioPoliza, cTipoPoliza, cconcepto, canocontrarrecibo,'RELGASTO' tipoObra, --cUnidadResponsable, cast('' as varchar(5)) cnoEstimacion, '' Periodo, cCentroContable cIdEntidadContable, --TIPO_OPERACION
 -- from trelaciongastosencabezado ee with(NOLOCK)  --where ee.cDocumentoHaplicado='S'
  ) Ce where 1 = 1
 -- and Ce.nfoliocaja=2
  $P!{whereFolio}

--select @laPoliza,@cUnidadResponsable,@cTipoPoliza

if object_id('tempdb..#tmp_polizapagos') is not null drop table #tmp_polizapagos;

-----------------------Poliza Contabl----------------------
select * into #tmp_polizapagos from (
		select substring(m.nCuenta, 1,5) Cuenta,'' subCuenta,'' subSubCuenta,
''dSubCuenta,calmacen, dCuenta cnombre,dCuenta descripcion,dCuenta, m.ctipomovimiento, m.nCuenta, sum(mMovimiento) mMovimiento2
   from tcuentas c with(NOLOCK), tmovimiento m with(NOLOCK)
   left join cat_almacen a on cast(a.nidalmacen as varchar(10))=nsubcuenta and a.ccentrocontable = m.ccentrocontable
   --left join v_pcatalogorfc rfc on cidrfc=nsubcuenta
   where /*m.ncuenta = c.ncuenta */ substring(m.ncuenta,1,5)+'-00000-00000-00000'= c.ncuenta  and nFolioPoliza = @laPoliza AND m.cCentroContable = @cUnidadResponsable and cTipopoliza =@cTipoPoliza and mmovimiento != 0  AND not(c.TipoBalance='P' and c.TipoCuenta='P')
group by substring(m.nCuenta, 1,5) ,calmacen, dCuenta
,dCuenta
,dCuenta, m.ctipomovimiento, m.nCuenta
--order by m.ncuenta, ctipomovimiento desc
union
--2o nivel
 select '' Cuenta,substring(m.nCuenta, 7,5)  subCuenta,'' subSubCuenta,' ' dSubCuenta,calmacen, dcuenta cnombre,'  ' + dCuenta descripcion,dCuenta, m.ctipomovimiento, m.nCuenta, ' ' mMovimiento2
   from tcuentas c with(NOLOCK), tmovimiento m with(NOLOCK)
   left join cat_almacen a on cast(a.nidalmacen as varchar(10))=nsubcuenta and a.ccentrocontable = m.ccentrocontable
   --left join v_pcatalogorfc rfc on cidrfc=nsubcuenta
   where /*m.ncuenta*/  substring(m.ncuenta,1,11)+'-00000-00000'= c.ncuenta and nFolioPoliza = @laPoliza AND m.cCentroContable = @cUnidadResponsable and cTipopoliza =@cTipoPoliza and mmovimiento != 0
   and substring(m.nCuenta, 7,5) != '00000' AND not(c.TipoBalance='P' and c.TipoCuenta='P')
group by substring(m.nCuenta, 7,5)
,calmacen, dcuenta
,'  ' + dCuenta
,dCuenta, m.ctipomovimiento, m.nCuenta
--order by m.ncuenta, ctipomovimiento desc
union
--3er nivel
	  select '' Cuenta,''  subCuenta,substring(m.nCuenta, 13,5) subSubCuenta,' 'dSubCuenta,calmacen, dCuenta cnombre,'    ' + dCuenta descripcion,dCuenta, m.ctipomovimiento, m.nCuenta, '' mMovimiento2
  from tcuentas c with(NOLOCK), tmovimiento m with(NOLOCK)
   left join cat_almacen a on cast(a.nidalmacen as varchar(10))=nsubcuenta and a.ccentrocontable = m.ccentrocontable
  -- left join v_pcatalogorfc rfc on cidrfc=nsubcuenta
   where /*m.ncuenta*/  substring(m.ncuenta,1,17)+'-00000'= c.ncuenta and nFolioPoliza = @laPoliza AND m.cCentroContable = @cUnidadResponsable and cTipopoliza =@cTipoPoliza and mmovimiento != 0 and substring(m.nCuenta, 13,5) != '00000' AND not(c.TipoBalance='P' and c.TipoCuenta='P')
group by substring(m.nCuenta, 13,5)
,calmacen, dCuenta
,'    ' + dCuenta
,dCuenta, m.ctipomovimiento, m.nCuenta
--order by m.ncuenta, ctipomovimiento desc

union

select '' Cuenta, ''subCuenta,' ' subSubCuenta, case when nSubCuenta = '' then substring(m.nCuenta, 13,5) else nSubCuenta  end dSubCuenta
,calmacen,cnombre,'      ' +ISNULL(' ', case when nSubCuenta = ''then substring(m.nCuenta, 13,5) else case when cnombre is null then calmacen else '[' + nSubCuenta+']'+cNombre end end) descripcion,dCuenta, m.ctipomovimiento, m.nCuenta, '' mMovimiento2
  from tcuentas c,  tmovimiento m
   left join cat_almacen a on cast(a.nidalmacen as varchar(10))=nsubcuenta and a.ccentrocontable = m.ccentrocontable
   left join v_pcatalogorfc rfc on cidrfc=nsubcuenta
   where m.nSubcuenta != '' and m.ncuenta = c.ncuenta and nFolioPoliza = @laPoliza AND m.cCentroContable = @cUnidadResponsable and cTipopoliza =@cTipoPoliza and mmovimiento != 0 AND not(c.TipoBalance='P' and c.TipoCuenta='P')
group by case when nSubCuenta = ''
then substring(m.nCuenta, 13,5) else case when cnombre is null then calmacen else nSubCuenta end end
,calmacen, cnombre
,'      ' + case when nSubCuenta = ''
then substring(m.nCuenta, 13,5) else case when cnombre is null then calmacen else '[' + nSubCuenta+']'+cNombre end end
,dCuenta, m.ctipomovimiento, m.nCuenta,nSubCuenta


   )kk
--order by m.ncuenta, cuenta desc, subcuenta desc,subsubcuenta, ctipomovimiento desc
order by  ctipomovimiento DESC,ncuenta, cuenta desc, subcuenta desc, subsubcuenta desc


set @cuantos = 0
select @cuantos = count(*) from #tmp_polizapagos


if @cuantos = 0
begin
insert into #tmp_polizapagos
select * from (
select substring(m.nCuenta, 1,5) Cuenta,'' subCuenta,'' subSubCuenta,''dSubCuenta ,calmacen, dCuenta cnombre,dCuenta descripcion,dCuenta, m.ctipomovimiento, m.nCuenta, sum(mMovimiento) mMovimiento2
   from tcuentas c with(NOLOCK), tmovimiento m with(NOLOCK)
   left join cat_almacen a on cast(a.nidalmacen as varchar(10))=nsubcuenta and a.ccentrocontable = m.ccentrocontable
   --left join v_pcatalogorfc rfc on cidrfc=nsubcuenta
   where /*m.ncuenta = c.ncuenta */ substring(m.ncuenta,1,5)+'-00000-00000-00000'= c.ncuenta  and nFolioPoliza = @laPoliza AND m.cCentroContable = @cUnidadResponsable and cTipopoliza =@cTipoPoliza and mmovimiento != 0
group by substring(m.nCuenta, 1,5) ,calmacen, dCuenta
,dCuenta
,dCuenta, m.ctipomovimiento, m.nCuenta,m.nsubcuenta
--order by m.ncuenta, ctipomovimiento desc
union
--2o nivel
	  select '' Cuenta,substring(m.nCuenta, 7,5)  subCuenta,'' subSubCuenta,' ' dSubCuenta,calmacen, dcuenta cnombre,'  ' + dCuenta descripcion,dCuenta, m.ctipomovimiento, m.nCuenta, ' ' mMovimiento2
  from tcuentas c with(NOLOCK), tmovimiento m with(NOLOCK)
   left join cat_almacen a on cast(a.nidalmacen as varchar(10))=nsubcuenta and a.ccentrocontable = m.ccentrocontable
   --left join v_pcatalogorfc rfc on cidrfc=nsubcuenta
   where /*m.ncuenta*/  substring(m.ncuenta,1,11)+'-00000-00000'= c.ncuenta and nFolioPoliza = @laPoliza AND m.cCentroContable = @cUnidadResponsable and cTipopoliza =@cTipoPoliza and mmovimiento != 0 and substring(m.nCuenta, 7,5) != '00000'
group by substring(m.nCuenta, 7,5)
,calmacen, dcuenta
,'  ' + dCuenta
,dCuenta, m.ctipomovimiento, m.nCuenta
--order by m.ncuenta, ctipomovimiento desc
union
--3er nivel
 select '' Cuenta,''  subCuenta,substring(m.nCuenta, 13,5) subSubCuenta,' 'dSubCuenta,calmacen, dCuenta cnombre,'    ' + dCuenta descripcion,dCuenta, m.ctipomovimiento, m.nCuenta, '' mMovimiento2
   from tcuentas c with(NOLOCK), tmovimiento m with(NOLOCK)
   left join cat_almacen a on cast(a.nidalmacen as varchar(10))=nsubcuenta and a.ccentrocontable = m.ccentrocontable
  -- left join v_pcatalogorfc rfc on cidrfc=nsubcuenta
   where /*m.ncuenta*/  substring(m.ncuenta,1,17)+'-00000'= c.ncuenta and nFolioPoliza = @laPoliza AND m.cCentroContable = @cUnidadResponsable and cTipopoliza =@cTipoPoliza and mmovimiento != 0 and substring(m.nCuenta, 13,5) != '00000'
group by substring(m.nCuenta, 13,5)
,calmacen, dCuenta
,'    ' + dCuenta
,dCuenta, m.ctipomovimiento, m.nCuenta
--order by m.ncuenta, ctipomovimiento desc
union
select '' Cuenta, ''subCuenta,' ' subSubCuenta, case when nSubCuenta = '' then substring(m.nCuenta, 13,5) else nSubCuenta  end dSubCuenta,calmacen,cnombre,'      ' +ISNULL(' ', case when nSubCuenta = ''then substring(m.nCuenta, 13,5) else case when cnombre is null then calmacen else '[' + nSubCuenta+']'+cNombre end end) descripcion,dCuenta, m.ctipomovimiento, m.nCuenta, '' mMovimiento2
 from tcuentas c,  tmovimiento m
   left join cat_almacen a on cast(a.nidalmacen as varchar(10))=nsubcuenta and a.ccentrocontable = m.ccentrocontable
   left join v_pcatalogorfc rfc on cidrfc=nsubcuenta
   where m.nSubcuenta != '' and m.ncuenta = c.ncuenta and nFolioPoliza = @laPoliza AND m.cCentroContable = @cUnidadResponsable and cTipopoliza =@cTipoPoliza and mmovimiento != 0
group by case when nSubCuenta = ''
then substring(m.nCuenta, 13,5) else case when cnombre is null then calmacen else nSubCuenta end end
,calmacen, cnombre
,'      ' + case when nSubCuenta = ''
then substring(m.nCuenta, 13,5) else case when cnombre is null then calmacen else '[' + nSubCuenta+']'+cNombre end end
,dCuenta, m.ctipomovimiento, m.nCuenta,nSubCuenta


   )kk
--order by m.ncuenta, cuenta desc, subcuenta desc, subsubcuenta, ctipomovimiento desc
order by  ctipomovimiento DESC,ncuenta, cuenta desc, subcuenta desc, subsubcuenta desc
end


select @cTipoPoliza+'-'+@laPoliza as Poliza,*
,case when cTipoMovimiento = 'C' then mMovimiento2 else 0 end Debe, case when cTipoMovimiento = 'A' then mMovimiento2 else 0 end Haber
 from #tmp_polizapagos
if object_id('tempdb..#tmp_polizapagos') is not null drop table #tmp_polizapagos;]]>
	</queryString>
