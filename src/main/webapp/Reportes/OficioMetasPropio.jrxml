	<summary>
		<band height="29">
			<staticText>
				<reportElement x="112" y="20" width="105" height="9" forecolor="#595959" uuid="6b03d5b6-3426-4625-a4db-516407165c70"/>
				<textElement verticalAlignment="Bottom">
					<font fontName="Montserrat" size="7"/>
				</textElement>
				<text><![CDATA[*No incluye Servicios Personales.]]></text>
			</staticText>
			<staticText>
				<reportElement mode="Transparent" x="112" y="-2" width="118" height="21" forecolor="#595959" backcolor="#B5B3B3" uuid="241c6e8f-28dd-4f74-9eba-51b4a2efb0da"/>
				<box>
					<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<bottomPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
