<!-- Created with Jaspersoft Studio version 6.17.0.final using JasperReports Library version 6.17.0-6d93193241dd8cc42629e188b94f9e0bc5722efd  -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="OficioMetasFiscal" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="e685704a-a3ae-49cb-9b2a-6dd7b55cda9c">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="localhost"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<parameter name="whereUE" class="java.lang.String">
		<defaultValueExpression><![CDATA["AND CU.cCoordinacion = 'P00'"]]></defaultValueExpression>
	</parameter>
	<parameter name="mes" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[3]]></defaultValueExpression>
	</parameter>
	<parameter name="coordinacion" class="java.lang.String">
		<defaultValueExpression><![CDATA["P00"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[DECLARE @coordinacion VARCHAR(3) = '$P!{coordinacion} '

IF  (@coordinacion) = 'I00'
BEGIN
	SELECT '' AS cUnidadEjecutora
			, CASE WHEN SUBSTRING(CU.Descripcion,1,33) = 'PROMOTORIA DE DESARROLLO FORESTAL' THEN 'PROMOTORIAS DE DESARROLLO FORESTAL' ELSE CU.Descripcion END AS Descripcion
			, Adscripcion
			, SUM(ISNULL(E014_ORGIP,0)) AS E014_ORGIP
			, SUM(ISNULL(E014_MODIP,0)) AS E014_MODIP
			, SUM(ISNULL(E014_MODIP,0)) - SUM(ISNULL(E014_ORGIP,0)) AS E014_VAR		
		FROM v_coordinacionUnidad CU
		JOIN v_coordinacionesTitular C ON CU.cCoordinacion = C.Unidad
		LEFT JOIN (SELECT Unidad, ISNULL(E014,0) E014_ORGIP
			FROM
			(SELECT SUBSTRING(ORG.cSubCuenta,57,3) AS Unidad
				, SUBSTRING(cSubCuenta,27,4) AS Programa
				, CASE $P!{mes}
					WHEN 1 THEN SUM(mSaldo1)
					WHEN 2 THEN SUM(mSaldo2)
					WHEN 3 THEN SUM(mSaldo3)
					WHEN 4 THEN SUM(mSaldo4)
					WHEN 5 THEN SUM(mSaldo5)
					WHEN 6 THEN SUM(mSaldo6)
					WHEN 7 THEN SUM(mSaldo7)
					WHEN 8 THEN SUM(mSaldo8)
					WHEN 9 THEN SUM(mSaldo9)
					WHEN 10 THEN SUM(mSaldo10)
					WHEN 11 THEN SUM(mSaldo11)
					WHEN 12 THEN SUM(mSaldo12)
				END OriginalIP
			 FROM tSaldos ORG WITH(NOLOCK) 
			WHERE nCuenta LIKE '81101%' --ORIGINAL
				AND SUBSTRING(cSubCuenta,27,4) IN ('E014') --PROGRAMA PRESUPUESTARIO			
				AND SUBSTRING(cSubCuenta,40,1) = 4 --FUENTE FINANCIAMIENTO
				AND SUBSTRING(cSubCuenta,32,1) <> 1 --CAPITULO
			GROUP BY SUBSTRING(ORG.cSubCuenta,57,3), SUBSTRING(cSubCuenta,27,4)
			)sub
			PIVOT(
				SUM(OriginalIP)
			FOR Programa IN ([E014])
			)AS PivotORG) ORG_IP ON CU.cUnidadEjecutora = ORG_IP.Unidad AND ORG_IP.Unidad = CU.cUnidadEjecutora --UNIDAD EJECUTORA
		LEFT JOIN (SELECT Unidad, ISNULL(E014,0) E014_MODIP
			FROM
			(SELECT SUBSTRING(MODI.cSubCuenta,57,3) AS Unidad
				, SUBSTRING(MODI.cSubCuenta,27,4) AS Programa
				, SUM(ModEnero) + SUM(ModFebrero) + SUM(ModMarzo) + SUM(ModAbril) + SUM(ModMayo) + SUM(ModJunio) + 
				  SUM(ModJulio) + SUM(ModAgosto) + SUM(ModSeptiembre) + SUM(ModOctubre) + SUM(ModNoviembre) + SUM(ModDiciembre) AS ModificadoIP
			FROM tModificadoSAI MODI
			WHERE SUBSTRING(MODI.cSubCuenta,27,4) IN ('E014') --PROGRAMA PRESUPUESTARIO			
				AND SUBSTRING(MODI.cSubCuenta,40,1) = 4 --FUENTE FINANCIAMIENTO
				AND SUBSTRING(MODI.cSubCuenta,32,1) <> 1 --CAPITULO	
				AND nMes = $P!{mes}
			GROUP BY SUBSTRING(MODI.cSubCuenta,57,3), SUBSTRING(MODI.cSubCuenta,27,4)
			)sub
			PIVOT(
				SUM(ModificadoIP)
			FOR Programa IN ([E014])
			)AS PivotMODIF) MOD_IP ON  CU.cUnidadEjecutora = MOD_IP.Unidad AND MOD_IP.Unidad = CU.cUnidadEjecutora --UNIDAD EJECUTORA
		WHERE 1 = 1
		 $P!{whereUE}
		 GROUP BY CASE WHEN SUBSTRING(CU.Descripcion,1,33) = 'PROMOTORIA DE DESARROLLO FORESTAL' THEN 'PROMOTORIAS DE DESARROLLO FORESTAL' ELSE CU.Descripcion END, Adscripcion
END

ELSE
BEGIN
		SELECT cUnidadEjecutora
			, CASE WHEN SUBSTRING(CU.Descripcion,1,33) = 'PROMOTORIA DE DESARROLLO FORESTAL' THEN 'PROMOTORIAS DE DESARROLLO FORESTAL' ELSE CU.Descripcion END AS Descripcion
			, Adscripcion
			, SUM(ISNULL(E014_ORGIP,0)) AS E014_ORGIP
			, SUM(ISNULL(E014_MODIP,0)) AS E014_MODIP
			, SUM(ISNULL(E014_MODIP,0)) - SUM(ISNULL(E014_ORGIP,0)) AS E014_VAR		
		FROM v_coordinacionUnidad CU
		JOIN v_coordinacionesTitular C ON CU.cCoordinacion = C.Unidad
		LEFT JOIN (SELECT Unidad, ISNULL(E014,0) E014_ORGIP
			FROM
			(SELECT SUBSTRING(ORG.cSubCuenta,57,3) AS Unidad
				, SUBSTRING(cSubCuenta,27,4) AS Programa
				, CASE $P!{mes}
					WHEN 1 THEN SUM(mSaldo1)
					WHEN 2 THEN SUM(mSaldo2)
					WHEN 3 THEN SUM(mSaldo3)
					WHEN 4 THEN SUM(mSaldo4)
					WHEN 5 THEN SUM(mSaldo5)
					WHEN 6 THEN SUM(mSaldo6)
					WHEN 7 THEN SUM(mSaldo7)
					WHEN 8 THEN SUM(mSaldo8)
					WHEN 9 THEN SUM(mSaldo9)
					WHEN 10 THEN SUM(mSaldo10)
					WHEN 11 THEN SUM(mSaldo11)
					WHEN 12 THEN SUM(mSaldo12)
				END OriginalIP
			 FROM tSaldos ORG WITH(NOLOCK) 
			WHERE nCuenta LIKE '81101%' --ORIGINAL
				AND SUBSTRING(cSubCuenta,27,4) IN ('E014') --PROGRAMA PRESUPUESTARIO			
				AND SUBSTRING(cSubCuenta,40,1) = 4 --FUENTE FINANCIAMIENTO
				AND SUBSTRING(cSubCuenta,32,1) <> 1 --CAPITULO
			GROUP BY SUBSTRING(ORG.cSubCuenta,57,3), SUBSTRING(cSubCuenta,27,4)
			)sub
			PIVOT(
				SUM(OriginalIP)
			FOR Programa IN ([E014])
			)AS PivotORG) ORG_IP ON CU.cUnidadEjecutora = ORG_IP.Unidad AND ORG_IP.Unidad = CU.cUnidadEjecutora --UNIDAD EJECUTORA
		LEFT JOIN (SELECT Unidad, ISNULL(E014,0) E014_MODIP
			FROM
			(SELECT SUBSTRING(MODI.cSubCuenta,57,3) AS Unidad
				, SUBSTRING(MODI.cSubCuenta,27,4) AS Programa
				, SUM(ModEnero) + SUM(ModFebrero) + SUM(ModMarzo) + SUM(ModAbril) + SUM(ModMayo) + SUM(ModJunio) + 
				  SUM(ModJulio) + SUM(ModAgosto) + SUM(ModSeptiembre) + SUM(ModOctubre) + SUM(ModNoviembre) + SUM(ModDiciembre) AS ModificadoIP
			FROM tModificadoSAI MODI
			WHERE SUBSTRING(MODI.cSubCuenta,27,4) IN ('E014') --PROGRAMA PRESUPUESTARIO			
				AND SUBSTRING(MODI.cSubCuenta,40,1) = 4 --FUENTE FINANCIAMIENTO
				AND SUBSTRING(MODI.cSubCuenta,32,1) <> 1 --CAPITULO	
				AND nMes = $P!{mes}
			GROUP BY SUBSTRING(MODI.cSubCuenta,57,3), SUBSTRING(MODI.cSubCuenta,27,4)
			)sub
			PIVOT(
				SUM(ModificadoIP)
			FOR Programa IN ([E014])
			)AS PivotMODIF) MOD_IP ON  CU.cUnidadEjecutora = MOD_IP.Unidad AND MOD_IP.Unidad = CU.cUnidadEjecutora --UNIDAD EJECUTORA
		WHERE 1 = 1
		 $P!{whereUE}
		 GROUP BY cUnidadEjecutora, CASE WHEN SUBSTRING(CU.Descripcion,1,33) = 'PROMOTORIA DE DESARROLLO FORESTAL' THEN 'PROMOTORIAS DE DESARROLLO FORESTAL' ELSE CU.Descripcion END, Adscripcion
END]]>
	</queryString>
	<field name="cUnidadEjecutora" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="cUnidadEjecutora"/>
		<property name="com.jaspersoft.studio.field.label" value="cUnidadEjecutora"/>
	</field>
	<field name="Descripcion" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="Descripcion"/>
		<property name="com.jaspersoft.studio.field.label" value="Descripcion"/>
	</field>
	<field name="Adscripcion" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="Adscripcion"/>
		<property name="com.jaspersoft.studio.field.label" value="Adscripcion"/>
	</field>
	<field name="E014_ORGIP" class="java.math.BigDecimal">
		<property name="com.jaspersoft.studio.field.name" value="E014_ORGIP"/>
		<property name="com.jaspersoft.studio.field.label" value="E014_ORGIP"/>
	</field>
	<field name="E014_MODIP" class="java.math.BigDecimal">
		<property name="com.jaspersoft.studio.field.name" value="E014_MODIP"/>
		<property name="com.jaspersoft.studio.field.label" value="E014_MODIP"/>
	</field>
	<field name="E014_VAR" class="java.math.BigDecimal">
		<property name="com.jaspersoft.studio.field.name" value="E014_VAR"/>
		<property name="com.jaspersoft.studio.field.label" value="E014_VAR"/>
	</field>
	<variable name="E014_ORGIP_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{E014_ORGIP}]]></variableExpression>
	</variable>
	<variable name="E014_MODIP_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{E014_MODIP}]]></variableExpression>
	</variable>
	<variable name="E014_VAR_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{E014_VAR}]]></variableExpression>
	</variable>
