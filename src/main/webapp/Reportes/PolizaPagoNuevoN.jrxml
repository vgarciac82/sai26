	<field name="fRegistro" class="java.lang.String"/>
	<field name="TIPO_OPERACION" class="java.lang.String"/>
	<field name="laEP" class="java.lang.String"/>
	<field name="numReg" class="java.lang.Integer"/>
	<field name="cantLetras" class="java.lang.String"/>
	<field name="mImporteBruto" class="java.math.BigDecimal"/>
	<field name="mImporteIVA" class="java.math.BigDecimal"/>
	<field name="mImporteSancion" class="java.math.BigDecimal"/>
	<field name="mOtrosImpuestos" class="java.math.BigDecimal"/>
	<field name="mImporteNeto" class="java.math.BigDecimal"/>
	<field name="cTipoDocumento" class="java.lang.String"/>
	<field name="DESTINO_GASTO" class="java.lang.String"/>
	<field name="mAmortizacionAnticipo" class="java.math.BigDecimal"/>
	<field name="nPorcAmort" class="java.math.BigDecimal"/>
	<field name="Programa" class="java.lang.String"/>
	<field name="SubPrograma" class="java.lang.String"/>
	<field name="sFirmanteDelegatorio" class="java.lang.String"/>
	<field name="sPuestoFirmanteDelegatorio" class="java.lang.String"/>
	<field name="Leyenda" class="java.lang.String"/>
	<field name="cObservaciones" class="java.lang.String"/>
	<field name="cInformeActividad" class="java.lang.String"/>
	<field name="sFirmanteDeleVoBo" class="java.lang.String"/>
	<field name="sPuestoFirmanteDeleVoBo" class="java.lang.String"/>
	<field name="LeyendaVoBo" class="java.lang.String"/>
	<field name="cLugarFecha" class="java.lang.String"/>
	<variable name="nPorcIva" class="java.lang.String">
		<initialValueExpression><![CDATA["IVA (" + $F{nPorcIva}.toString() +  "%)"]]></initialValueExpression>
	</variable>
	<variable name="laEP" class="java.lang.String">
		<initialValueExpression><![CDATA["VARIAS"]]></initialValueExpression>
	</variable>
	<variable name="Debe_1" class="java.math.BigDecimal" resetType="Group" resetGroup="caNoContrarrecibo" calculation="Sum">
		<variableExpression><![CDATA[$F{Debe}]]></variableExpression>
	</variable>
	<variable name="Haber_1" class="java.math.BigDecimal" resetType="Group" resetGroup="caNoContrarrecibo" calculation="Sum">
		<variableExpression><![CDATA[$F{Haber}]]></variableExpression>
	</variable>
	<variable name="noPoliza" class="java.lang.String">
		<initialValueExpression><![CDATA[$F{cTipoPoliza} + "-" + $F{nPolizaAP}.toString()]]></initialValueExpression>
	</variable>
	<variable name="mImporteRetencion" class="java.lang.String"/>
	<variable name="cnoEstimacion" class="java.lang.String"/>
	<variable name="FirmanteAutoriza" class="java.lang.String"/>
	<variable name="PuestoFirmanteAutoriza" class="java.lang.String"/>
