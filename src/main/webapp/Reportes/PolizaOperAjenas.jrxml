<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="PolizaPago" pageWidth="612" pageHeight="792" whenNoDataType="AllSectionsNoDetail" columnWidth="552" leftMargin="30" rightMargin="30" topMargin="20" bottomMargin="20">
	<property name="ireport.zoom" value="2.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<property name="ireport.scriptlethandling" value="0"/>
	<property name="ireport.encoding" value="UTF-8"/>
	<import value="net.sf.jasperreports.engine.*"/>
	<import value="java.util.*"/>
	<import value="net.sf.jasperreports.engine.data.*"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="whereFolio" class="java.lang.String">
		<defaultValueExpression><![CDATA["CR.caNoContrarrecibo = '10OA2021100006'"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[DECLARE @laPoliza varchar(10)
DECLARE @cUnidadResponsable varchar(10)
DECLARE @cTipopoliza varchar(10)
DECLARE @canocontrarrecibo varchar(19)
DECLARE @cuantos smallint

DECLARE @nFolioPago INT
--SET @cTipopoliza='EG'
--SET @cUnidadResponsable ='10'
--SET @laPoliza=2900
--SET @canocontrarrecibo='10CP2012000589'

select @laPoliza= nFolioPoliza, @cUnidadResponsable = cCentroContable, @cTipopoliza = cTipoPoliza, @nFolioPago = nFolioOperAjenas from tOperAjenasEncabezado CR with(NOLOCK)
where
  $P!{whereFolio}
if exists(select 1 from sysobjects where name = 'tmp_detalle2') drop table  tmp_detalle2
if exists(select 1 from sysobjects where name = 'tmp_polizapagos') drop table  tmp_polizapagos
if exists(select 1 from sysobjects where name = 'tmp_detalle') drop table  tmp_detalle

select * into #tmp_detalle from (
select Ep, count(DISTINCT Ep) numReg  from tOperAjenasDetalle with(NOLOCK)
where nFolioOperAjenas in (select nFolioOperAjenas from tOperAjenasEncabezado cr with(NOLOCK) where $P!{whereFolio} AND 1 = 1
) group by ep
) m

set @cuantos = 2

if @cuantos = 0
begin
insert into #tmp_polizapagos
select * from (select substring(m.nCuenta, 1,5) Cuenta,'' subCuenta,'' subSubCuenta
,calmacen, dCuenta cnombre
,dCuenta descripcion
,dCuenta, m.ctipomovimiento, m.nCuenta/*,  m.**/, sum(mMovimiento) mMovimiento2
   from tcuentas c with(NOLOCK), tmovimiento m with(NOLOCK)
   left join cat_almacen a  with(NOLOCK) on cast(a.nidalmacen as varchar(10))=nsubcuenta and a.ccentrocontable = m.ccentrocontable

   where /*m.ncuenta = c.ncuenta */ substring(m.ncuenta,1,5)+'-00000-00000-00000'= c.ncuenta  and nFolioPoliza = @laPoliza AND m.cCentroContable = @cUnidadResponsable and cTipopoliza =@cTipopoliza and mmovimiento != 0  AND (c.TipoBalance='P' and c.TipoCuenta='P')
group by substring(m.nCuenta, 1,5) ,calmacen, dCuenta, dCuenta, dCuenta, m.ctipomovimiento, m.nCuenta

union
--2o nivel
select '' Cuenta,substring(m.nCuenta, 7,5)  subCuenta,'' subSubCuenta
,calmacen, dcuenta cnombre
,'  ' + dCuenta descripcion
,dCuenta, m.ctipomovimiento, m.nCuenta/*, m.**/, 0 mMovimiento2
   from tcuentas c with(NOLOCK), tmovimiento m with(NOLOCK)
   left join cat_almacen a  with(NOLOCK) on cast(a.nidalmacen as varchar(10))=nsubcuenta and a.ccentrocontable = m.ccentrocontable
   --left join v_pcatalogorfc rfc on cidrfc=nsubcuenta
   where /*m.ncuenta*/  substring(m.ncuenta,1,11)+'-00000-00000' = c.ncuenta and nFolioPoliza = @laPoliza AND m.cCentroContable = @cUnidadResponsable and cTipoPoliza = @cTipopoliza and mmovimiento != 0 and substring(m.nCuenta, 7,5) != '00000' AND (c.TipoBalance='P' and c.TipoCuenta='P')
group by substring(m.nCuenta, 7,5)
,calmacen, dcuenta
,'  ' + dCuenta
,dCuenta, m.ctipomovimiento, m.nCuenta

union
--3er nivel
select '' Cuenta,''  subCuenta,substring(m.nCuenta, 13,5) subSubCuenta
,calmacen, dCuenta cnombre
,'    ' + dCuenta descripcion
,dCuenta, m.ctipomovimiento, m.nCuenta/*, m.**/, 0 mMovimiento2
   from tcuentas c with(NOLOCK), tmovimiento m with(NOLOCK)
   left join cat_almacen a  with(NOLOCK) on cast(a.nidalmacen as varchar(10))=nsubcuenta and a.ccentrocontable = m.ccentrocontable
  -- left join v_pcatalogorfc rfc on cidrfc=nsubcuenta
   where /*m.ncuenta*/  substring(m.ncuenta,1,17)+'-00000'= c.ncuenta and nFolioPoliza = @laPoliza AND m.cCentroContable = @cUnidadResponsable and cTipoPoliza=@cTipopoliza and mmovimiento != 0 and substring(m.nCuenta, 13,5) != '00000' AND (c.TipoBalance='P' and c.TipoCuenta='P')
group by substring(m.nCuenta, 13,5)
,calmacen, dCuenta
,'    ' + dCuenta
,dCuenta, m.ctipomovimiento, m.nCuenta

union
select '' Cuenta, ''subCuenta, case when nSubCuenta = ''
then substring(m.nCuenta, 13,5) else case when cnombre is null then calmacen else nSubCuenta end end subSubCuenta
,calmacen, cnombre
,'      ' + case when nSubCuenta = ''
then substring(m.nCuenta, 13,5) else case when cnombre is null then calmacen else '[' + nSubCuenta+']'+cNombre end end descripcion
,dCuenta, m.ctipomovimiento, m.nCuenta/*, m.**/, 0 mMovimiento2
   from tcuentas c  with(NOLOCK),  tmovimiento m  with(NOLOCK)
   left join cat_almacen a with(NOLOCK) on cast(a.nidalmacen as varchar(10))=nsubcuenta and a.ccentrocontable = m.ccentrocontable
   left join v_pcatalogorfc rfc on cidrfc=nsubcuenta
   where m.nSubcuenta != '' and m.ncuenta = c.ncuenta and nFolioPoliza = @laPoliza AND m.cCentroContable = @cUnidadResponsable and cTipoPoliza =@cTipopoliza and mmovimiento != 0  AND (c.TipoBalance='P' and c.TipoCuenta='P')
group by case when nSubCuenta = ''
then substring(m.nCuenta, 13,5) else case when cnombre is null then calmacen else nSubCuenta end end
,calmacen, cnombre
,'      ' + case when nSubCuenta = ''
then substring(m.nCuenta, 13,5) else case when cnombre is null then calmacen else '[' + nSubCuenta+']'+cNombre end end
,dCuenta, m.ctipomovimiento, m.nCuenta
   )kk
order by ncuenta, cuenta desc, subcuenta desc, subsubcuenta, ctipomovimiento desc
end


select
rfc.CNOMBRE CNOMBRE2,
 CR.aEjercicioFiscal, CR.cIdEntidadContable, CR.caNoContrarrecibo, m.cIdDocumento, CR.cIdTipoDocumento, CR.cIdSubtipoDocumento
, CR.cIdTipoOperacion, CR.caNoAP, CR.nPolizaAP, CR.cIdRFC, CR.cIdTipoMoneda, CR.nTipoCambio, cast(CR.mImporteBruto as decimal(17,2)) mImporteBruto ,
cast(CR.mImporteSancion as decimal(17,2)) mImporteSancion ,
cast(CR.mImporteDevolucion as decimal(17,2)) mImporteDevolucion ,
(cast(mAmortizacionAnticipo as decimal(17,2))/  (1 + (nPorcIva/100))) as mAmortizacionAnticipo,
cast(CR.mImporteIVA as decimal(17,2)) mImporteIVA ,
cast(CR.mImporteRetencion as decimal(17,2)) mImporteRetencion ,
cast(CR.mImportePenalizacion as decimal(17,2)) mImportePenalizacion ,
cast(CR.mImporteNeto as decimal(17,2)) mImporteNeto , convert(varchar(10),CR.fProgramadaPago,103) fProgramadaPago, convert(varchar(10), CR.fValidacionDisponible, 103) fValidacionDisponible, CR.lEsCandidatoCP, CR.lHaySubpartidaExcluidaCP, CR.cIdTipoCLCSiaff, CR.cIdLeyendaSiaff, CR.cReferencia1, CR.nEsSubsidio, convert(varchar(10), CR.fRegistro, 103) fRegistro, CR.cIdEstadoReintegro, CR.cIdTipoReclasificacion, CR.fAplicacionSiaff, CR.fPagoSiaff, CR.cIdEstadoContrarrecibo, m.cconcepto
, ctd.cTipoDocumento, '' as TIPO_OPERACION, cc.cDescripcion, m.cUnidadResponsable, cnoEstimacion, periodo
, cast(nPorcIva as decimal(10,2)) nPorcIva
, (SELECT min(EP) FROM #tmp_detalle with(NOLOCK)) laEP
, (SELECT sum(numReg) FROM #tmp_detalle with(NOLOCK)) numReg
,dbo.fnCantidadLetra(CR.mImporteNeto) cantLetras
, m.sFirmanteVoBo, m.sPuestoVoBo, m.sFirmanteAut, m.sPuestoAut
into #tmp_detalle2
from  tcontrarrecibo CR with(NOLOCK)
		left join pCatalogoTipoDocumento ctd  with(NOLOCK) on ctd.cIdTipoDocumento = cr.cIdTipoDocumento
		left join tCatalogoCentroContable cc  with(NOLOCK)on cc.cCentrocontable = cr.cIdEntidadContable
		, v_PCATALOGORFC RFC, (


select cnombre cIdDocumento, 0  nPorcIva,0  mImporteRetencion, cconcepto,
canocontrarrecibo,'OPERACIONES AJENAS' tipoObra,
cUnidadResponsable,' ' cnoEstimacion, 'Del ' + case when fDesde is null then '' else convert(varchar(10), fDesde, 103)
 end + ' al ' + case when fHasta is null then '' else convert(varchar(10), fHasta, 103) end Periodo
 , isnull(e.sFirmanteVoBo, (select NOMBREN + ' ' + NOMBREP+ ' ' + NOMBREM from v_empleados_giro  (nolock) where CLAVE = e.nNumEmpleadoVoBo)) sFirmanteVoBo
	, isnull(e.sPuestoVoBo, (select DESCRIPCION_PUESTO from v_empleados_giro  (nolock) where CLAVE = e.nNumEmpleadoVoBo)) sPuestoVoBo
	, isnull(e.sFirmanteAut, (select NOMBREN + ' ' + NOMBREP+ ' ' + NOMBREM from v_empleados_giro  (nolock) where CLAVE = e.nNumEmpleadoAut)) sFirmanteAut
	, isnull(e.sPuestoAut, (select DESCRIPCION_PUESTO from v_empleados_giro  (nolock) where CLAVE = e.nNumEmpleadoAut)) sPuestoAut
from tOperAjenasEncabezado e  with(NOLOCK)
		   ) m --, #tmp_polizapagos pp
WHERE LTRIM(RTRIM(RFC.cIdRFC)) = LTRIM(RTRIM(CR.cIdRFC))
		and m.canocontrarrecibo = cr.canocontrarrecibo
  AND $P!{whereFolio}


DECLARE @cTipoPago VARCHAR(64)
DECLARE @sFirmanteDelegatorio VARCHAR(250)
DECLARE @sPuestoFirmanteDelegatorio VARCHAR(70)
DECLARE @sFirmanteAut VARCHAR(250)
DECLARE @sLeyenda VARCHAR(500)
DECLARE @sOficio VARCHAR(128)
DECLARE @sFechaOficio VARCHAR(20)
DECLARE @cTipoSuplencia varchar(20)

SET @sFirmanteDelegatorio = ''
SET @sPuestoFirmanteDelegatorio = ''
SET @sFirmanteAut = ''
SET @sLeyenda = ''
SET @sOficio = ''
SET @sFechaOficio = ''


IF (SELECT COUNT(*) FROM tPagoFirmanteDelagatorio WITH (NOLOCK) WHERE cTipoPago = 'OPERAJENAS' AND nFolioPago = @nFolioPago) > 0
		BEGIN

			SELECT TOP 1 @sFirmanteAut = sFirmanteAut FROM #tmp_detalle2 tablafinal WITH (NOLOCK)

			SELECT	@sFirmanteDelegatorio = ISNULL((cNombreTitular + ' ' + cApellidoPaternoTitular + ' ' + cApellidoMaternoTitular),(NOMBREN + ' ' + NOMBREP + ' ' +  NOMBREM)),
			 @sPuestoFirmanteDelegatorio = ISNULL(cPuestoTitular, CARGO)
			, @sOficio = cFolioOficio
			, @sFechaOficio = CONVERT(varchar(10), CONVERT(date, dFechaOficio, 106), 103)
			, @cTipoSuplencia = cTipoSuplencia
			FROM tPagoFirmanteDelagatorio pago WITH (NOLOCK)
			INNER JOIN tCatTipoSuplencia WITH (NOLOCK)
				ON pago.ntipoSuplencia = tCatTipoSuplencia.ntiposuplencia
			LEFT JOIN v_empleados_giro WITH (NOLOCK)
				ON clave = cNumeroEmpleado
			WHERE cTipoPago = 'OPERAJENAS' AND nFolioPago = @nFolioPago

			SET @sLeyenda = 'Firma ' + @cTipoSuplencia + ' de: '  + @sFirmanteAut + ', con fundamento en el oficio: ' + @sOficio + ', de fecha: ' + @sFechaOficio
		END

DECLARE @sFirmanteDeleVoBo VARCHAR(250)
DECLARE @sPuestoFirmanteDeleVoBo VARCHAR(70)
DECLARE @sFirmanteVoBo VARCHAR(250)
DECLARE @sLeyendaVoBo VARCHAR(500)
DECLARE @sOficioVoBo VARCHAR(128)
DECLARE @sFechaOficioVoBo VARCHAR(20)


SET @sFirmanteDeleVoBo = ''
SET @sPuestoFirmanteDeleVoBo = ''
SET @sFirmanteVoBo = ''
SET @sLeyendaVoBo = ''
SET @sOficioVoBo = ''
SET @sFechaOficioVoBo = ''

IF (SELECT COUNT(*) FROM tPagoFirmanteDelegatorioVoBo WITH (NOLOCK) WHERE cTipoPago = 'OPERAJENAS' AND nFolioPago = @nFolioPago) > 0
		BEGIN

		SELECT TOP 1 @sFirmanteVoBo = sFirmanteVoBo FROM #tmp_detalle2 tablafinal WITH (NOLOCK)

		SELECT	@sFirmanteDeleVoBo = ISNULL((cNombreTitular + ' ' + cApellidoPaternoTitular + ' ' + cApellidoMaternoTitular),(NOMBREN + ' ' + NOMBREP + ' ' +  NOMBREM)),
		@sPuestoFirmanteDeleVoBo = ISNULL(cPuestoTitular, CARGO)
		, @sOficioVoBo = cFolioOficio
		, @sFechaOficioVoBo = CONVERT(varchar(10)
		, CONVERT(date, dFechaOficio, 106), 103)
		, @cTipoSuplencia = cTipoSuplencia
			FROM tPagoFirmanteDelegatorioVoBo pagovobo WITH (NOLOCK)
			INNER JOIN tCatTipoSuplencia WITH (NOLOCK)
				ON pagovobo.ntipoSuplencia = tCatTipoSuplencia.ntiposuplencia
			LEFT JOIN v_empleados_giro WITH (NOLOCK)
				ON clave = cNumeroEmpleado
			WHERE cTipoPago = 'OPERAJENAS' AND nFolioPago = @nFolioPago

			SET @sLeyendaVoBo = 'Firma ' + @cTipoSuplencia + ' de: '  + @sFirmanteVoBo + ', con fundamento en el oficio: ' + @sOficioVoBo + ', de fecha: ' + @sFechaOficioVoBo
		END


select MAX(CNOMBRE2) CNOMBRE2, aEjercicioFiscal, cIdEntidadContable, caNoContrarrecibo, cIdDocumento, cIdTipoDocumento, cIdSubtipoDocumento, cIdTipoOperacion, caNoAP, @laPoliza nPolizaAP, cIdRFC, cIdTipoMoneda, nTipoCambio, mImporteBruto,
 mImporteSancion, mImporteDevolucion, mAmortizacionAnticipo,
 mImporteIVA, mImporteRetencion,
 mImportePenalizacion,
 mImporteNeto, fProgramadaPago, fValidacionDisponible, lEsCandidatoCP, lHaySubpartidaExcluidaCP, cIdTipoCLCSiaff, cIdLeyendaSiaff, cReferencia1, nEsSubsidio, fRegistro, cIdEstadoReintegro, cIdTipoReclasificacion, fAplicacionSiaff, fPagoSiaff, cIdEstadoContrarrecibo, cconcepto, cTipoDocumento, TIPO_OPERACION, cDescripcion, cUnidadResponsable, cnoEstimacion, periodo
,laEP
, max(nPorcIva) nPorcIva
, max(numReg) numReg
, max(cantLetras) cantLetras
, isnull(sFirmanteVoBo,'-') sFirmanteVoBo, isnull(sPuestoVoBo,'-') sPuestoVoBo, isnull(sFirmanteAut,'-') sFirmanteAut, isnull(sPuestoAut,'-') sPuestoAut,
@sFirmanteDelegatorio AS sFirmanteDelegatorio, @sPuestoFirmanteDelegatorio AS sPuestoFirmanteDelegatorio, @sLeyenda AS Leyenda,
@sFirmanteDeleVoBo AS sFirmanteDeleVoBo, @sPuestoFirmanteDeleVoBo AS sPuestoFirmanteDeleVoBo, @sLeyendaVoBo AS LeyendaVoBo
 from #tmp_detalle2 with(NOLOCK)
group by aEjercicioFiscal, cIdEntidadContable, caNoContrarrecibo, cIdDocumento, cIdTipoDocumento, cIdSubtipoDocumento, cIdTipoOperacion, caNoAP, nPolizaAP, cIdRFC, cIdTipoMoneda, nTipoCambio, mImporteBruto,
 mImporteSancion, mImporteDevolucion, mAmortizacionAnticipo,
 mImporteIVA, mImporteRetencion,
 mImportePenalizacion,
 mImporteNeto, fProgramadaPago, fValidacionDisponible, lEsCandidatoCP, lHaySubpartidaExcluidaCP, cIdTipoCLCSiaff, cIdLeyendaSiaff, cReferencia1, nEsSubsidio, fRegistro, cIdEstadoReintegro, cIdTipoReclasificacion, fAplicacionSiaff, fPagoSiaff, cIdEstadoContrarrecibo, cconcepto, cTipoDocumento, TIPO_OPERACION, cDescripcion, cUnidadResponsable, cnoEstimacion, periodo
 ,laEP
, sFirmanteVoBo, sPuestoVoBo, sFirmanteAut, sPuestoAut


if exists(select 1 from sysobjects where name = 'tmp_detalle2') drop table  tmp_detalle2
if exists(select 1 from sysobjects where name = 'tmp_polizapagos') drop table  tmp_polizapagos
if exists(select 1 from sysobjects where name = 'tmp_detalle') drop table  tmp_detalle]]>
	</queryString>
	<field name="CNOMBRE2" class="java.lang.String"/>
	<field name="aEjercicioFiscal" class="java.lang.String"/>
	<field name="cIdEntidadContable" class="java.lang.String"/>
	<field name="caNoContrarrecibo" class="java.lang.String"/>
	<field name="cIdDocumento" class="java.lang.String"/>
	<field name="cIdTipoDocumento" class="java.lang.String"/>
	<field name="cIdSubtipoDocumento" class="java.lang.String"/>
	<field name="cIdTipoOperacion" class="java.lang.String"/>
	<field name="caNoAP" class="java.lang.String"/>
	<field name="nPolizaAP" class="java.lang.String"/>
	<field name="cIdRFC" class="java.lang.String"/>
	<field name="cIdTipoMoneda" class="java.lang.String"/>
	<field name="nTipoCambio" class="java.math.BigDecimal"/>
	<field name="mImporteBruto" class="java.math.BigDecimal"/>
	<field name="mImporteSancion" class="java.math.BigDecimal"/>
	<field name="mImporteDevolucion" class="java.math.BigDecimal"/>
	<field name="mAmortizacionAnticipo" class="java.math.BigDecimal"/>
	<field name="mImporteIVA" class="java.math.BigDecimal"/>
	<field name="mImporteRetencion" class="java.math.BigDecimal"/>
	<field name="mImportePenalizacion" class="java.math.BigDecimal"/>
	<field name="mImporteNeto" class="java.math.BigDecimal"/>
	<field name="fProgramadaPago" class="java.lang.String"/>
	<field name="fValidacionDisponible" class="java.lang.String"/>
	<field name="lEsCandidatoCP" class="java.lang.Boolean"/>
	<field name="lHaySubpartidaExcluidaCP" class="java.lang.Boolean"/>
	<field name="cIdTipoCLCSiaff" class="java.lang.String"/>
	<field name="cIdLeyendaSiaff" class="java.lang.String"/>
	<field name="cReferencia1" class="java.lang.String"/>
	<field name="nEsSubsidio" class="java.lang.Integer"/>
	<field name="fRegistro" class="java.lang.String"/>
	<field name="cIdEstadoReintegro" class="java.lang.String"/>
	<field name="cIdTipoReclasificacion" class="java.lang.String"/>
	<field name="fAplicacionSiaff" class="java.sql.Timestamp"/>
	<field name="fPagoSiaff" class="java.sql.Timestamp"/>
	<field name="cIdEstadoContrarrecibo" class="java.lang.String"/>
	<field name="cconcepto" class="java.lang.String"/>
	<field name="cTipoDocumento" class="java.lang.String"/>
	<field name="TIPO_OPERACION" class="java.lang.String"/>
	<field name="cDescripcion" class="java.lang.String"/>
	<field name="cUnidadResponsable" class="java.lang.String"/>
	<field name="cnoEstimacion" class="java.lang.String"/>
	<field name="periodo" class="java.lang.String"/>
	<field name="laEP" class="java.lang.String"/>
	<field name="nPorcIva" class="java.math.BigDecimal"/>
	<field name="numReg" class="java.lang.Integer"/>
	<field name="cantLetras" class="java.lang.String"/>
	<field name="sFirmanteVoBo" class="java.lang.String"/>
	<field name="sPuestoVoBo" class="java.lang.String"/>
	<field name="sFirmanteAut" class="java.lang.String"/>
	<field name="sPuestoAut" class="java.lang.String"/>
	<field name="sFirmanteDelegatorio" class="java.lang.String"/>
	<field name="sPuestoFirmanteDelegatorio" class="java.lang.String"/>
	<field name="Leyenda" class="java.lang.String"/>
	<field name="sFirmanteDeleVoBo" class="java.lang.String"/>
	<field name="sPuestoFirmanteDeleVoBo" class="java.lang.String"/>
	<field name="LeyendaVoBo" class="java.lang.String"/>
	<variable name="nPorcIva" class="java.lang.String">
		<initialValueExpression><![CDATA["IVA (" + $F{nPorcIva}.toString() +  "%)"]]></initialValueExpression>
	</variable>
	<variable name="laEP" class="java.lang.String">
		<initialValueExpression><![CDATA["VARIAS"]]></initialValueExpression>
	</variable>
	<variable name="noPoliza" class="java.lang.String">
		<initialValueExpression><![CDATA["CH-" + $F{nPolizaAP}.toString()]]></initialValueExpression>
	</variable>
	<variable name="mImporteRetencion" class="java.lang.String"/>
	<variable name="cnoEstimacion" class="java.lang.String"/>
	<group name="caNoContrarrecibo">
		<groupExpression><![CDATA[$F{caNoContrarrecibo}]]></groupExpression>
		<groupHeader>
			<band height="394" splitType="Stretch">
				<rectangle>
					<reportElement key="rectangle" x="0" y="106" width="551" height="260"/>
				</rectangle>
				<staticText>
					<reportElement key="staticText" x="345" y="164" width="133" height="11"/>
					<textElement textAlignment="Center" verticalAlignment="Middle">
						<font size="8"/>
					</textElement>
					<text><![CDATA[Periodo : ]]></text>
				</staticText>
				<staticText>
					<reportElement key="staticText" x="6" y="230" width="100" height="20"/>
					<textElement>
						<font size="8"/>
					</textElement>
					<text><![CDATA[Por concepto de:]]></text>
				</staticText>
				<line>
					<reportElement key="line" x="281" y="331" width="270" height="1"/>
				</line>
				<line>
					<reportElement key="line" x="282" y="313" width="270" height="1"/>
				</line>
				<staticText>
					<reportElement key="staticText" x="285" y="114" width="119" height="20"/>
					<textElement textAlignment="Center">
						<font size="8"/>
					</textElement>
					<text><![CDATA[Tipo Operación]]></text>
				</staticText>
				<staticText>
					<reportElement key="staticText" x="6" y="109" width="100" height="16"/>
					<textElement verticalAlignment="Middle">
						<font size="8"/>
					</textElement>
					<text><![CDATA[Importe a Pagar:]]></text>
				</staticText>
				<line>
					<reportElement key="line" x="281" y="188" width="270" height="1"/>
				</line>
				<line>
