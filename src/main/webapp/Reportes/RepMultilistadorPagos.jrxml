	<queryString>
		<![CDATA[select	docto,
	ID_DESTINO_GASTO,
	nFolioPago  ,
	cUnidadResponsable,
	cIdDocumento,
	caNoContrarrecibo,
	ISNULL(nFolioSICOP, 0) AS nFolioSICOP,
	ISNULL(nFolioSIAFF, 0) AS nFolioSIAFF,
	ISNULL(SolicitudPago, 0) AS SolicitudPago,
	ISNULL(NumeroProceso, 0) AS NumeroProceso,
	ISNULL(FechaPagado, '') AS FechaPagado,
	cIdRFC,
	cnombre,
	mImporteTotal,
	mImporteRetencion,
	mImporteNeto,
	fAplicacion,
	Estatus
from vMultilistadorPagos
where $P!{cWhereList}]]>
	</queryString>
