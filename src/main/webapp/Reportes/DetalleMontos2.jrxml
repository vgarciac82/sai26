<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="DetalleMontos"  pageWidth="802" pageHeight="555" orientation="Landscape" columnWidth="802" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0">
	<property name="ireport.zoom" value="1.5"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="FolioPlu" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
    CD."nFolioContratoPlurianual" AS folio,
     CD."aEjercicioFiscal" AS Anio,
     CE."lAbierto" AS tipo,
      CD."nMonto" AS monto,
     CD."nMontoMinimo" AS montoMinimo,
     CD."nMontoMaximo" AS montoMaximo,
     isnull(CD."nAvance",0) AS AvanceFisico
FROM
     "tContratoPlurianualDetalle" CD,
     "tContratoPlurianualEncabezado" CE
WHERE
     CE.nFolioContratoPlurianual = CD.nFolioContratoPlurianual
      and CD.nFolioContratoPlurianual = $P{FolioPlu}

ORDER BY
     CD.nFolioContratoPlurianual ASC,
     cd.nConsecutivo ASC]]>
	</queryString>
	<field name="folio" class="java.lang.String"/>
	<field name="Anio" class="java.lang.String"/>
	<field name="tipo" class="java.lang.String"/>
	<field name="monto" class="java.math.BigDecimal"/>
	<field name="montoMinimo" class="java.math.BigDecimal"/>
	<field name="montoMaximo" class="java.math.BigDecimal"/>
	<field name="AvanceFisico" class="java.lang.Integer"/>
	<variable name="montoMaximo_1" class="java.math.BigDecimal" resetType="Column" calculation="Sum">
		<variableExpression><![CDATA[$F{montoMaximo}]]></variableExpression>
	</variable>
	<variable name="montoMinimo_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{montoMinimo}]]></variableExpression>
	</variable>
	<variable name="monto_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{monto}]]></variableExpression>
	</variable>
	<variable name="Anio_1" class="java.lang.Integer" calculation="Count">
		<variableExpression><![CDATA[$F{Anio}]]></variableExpression>
	</variable>
	<variable name="SUMAAVANCE" class="java.lang.String">
		<variableExpression><![CDATA[($F{AvanceFisico} == 0 ? "No aplica" : $V{AvanceFisico_1})]]></variableExpression>
	</variable>
	<variable name="Avance" class="java.lang.String">
		<variableExpression><![CDATA[($F{AvanceFisico} ==0 ? "No aplica" : $F{AvanceFisico})]]></variableExpression>
	</variable>
	<variable name="AvanceFisico_1" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA[$F{AvanceFisico} ]]></variableExpression>
	</variable>
	<background>
		<band splitType="Stretch"/>
	</background>
	<title>
		<band splitType="Stretch"/>
	</title>
	<pageHeader>
		<band splitType="Stretch"/>
	</pageHeader>
	<columnHeader>
		<band height="47" splitType="Stretch">
			<staticText>
				<reportElement x="1" y="23" width="65" height="23"/>
				<box>
					<pen lineWidth="1.0"/>
					<rightPen lineWidth="0.0"/>
				</box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font isBold="true"/>
				</textElement>
				<text><![CDATA[Año]]></text>
			</staticText>
			<staticText>
				<reportElement x="182" y="23" width="120" height="23"/>
				<box>
					<pen lineWidth="1.0"/>
					<rightPen lineWidth="1.0"/>
				</box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font isBold="true"/>
				</textElement>
				<text><![CDATA[Monto Maximo]]></text>
			</staticText>
			<staticText>
				<reportElement x="302" y="23" width="77" height="23"/>
				<box>
					<topPen lineWidth="1.0"/>
					<bottomPen lineWidth="1.0"/>
					<rightPen lineWidth="1.0"/>
				</box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font isBold="true"/>
				</textElement>
				<text><![CDATA[Avance Físico %]]></text>
			</staticText>
			<staticText>
				<reportElement x="1" y="2" width="378" height="21"/>
				<box>
					<topPen lineWidth="0.0"/>
					<leftPen lineWidth="1.0"/>
					<bottomPen lineWidth="0.0"/>
					<rightPen lineWidth="1.0"/>
				</box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font isBold="false"/>
				</textElement>
				<text><![CDATA[RECURSOS A EJERCER EN MILES DE PESOS]]></text>
			</staticText>
			<staticText>
				<reportElement x="65" y="23" width="117" height="23"/>
				<box>
					<pen lineWidth="1.0"/>
					<rightPen lineWidth="0.0"/>
				</box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font isBold="true"/>
				</textElement>
				<text><![CDATA[Monto Mínimo]]></text>
			</staticText>
		</band>
	</columnHeader>
	<detail>
		<band height="22" splitType="Stretch">
			<textField>
				<reportElement x="1" y="1" width="64" height="20"/>
				<box>
					<leftPen lineWidth="1.0"/>
					<bottomPen lineWidth="1.0"/>
					<rightPen lineWidth="1.0"/>
				</box>
				<textElement textAlignment="Center" verticalAlignment="Middle"/>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{Anio}]]></textFieldExpression>
			</textField>
			<textField pattern="¤ #,##0.00">
				<reportElement x="182" y="1" width="120" height="20">
					<printWhenExpression><![CDATA[$F{tipo}.equals( "A" )]]></printWhenExpression>
				</reportElement>
				<box>
					<leftPen lineWidth="0.0"/>
					<bottomPen lineWidth="1.0"/>
					<rightPen lineWidth="1.0"/>
				</box>
				<textElement textAlignment="Right"/>
				<textFieldExpression class="java.math.BigDecimal"><![CDATA[$F{montoMaximo}]]></textFieldExpression>
			</textField>
			<textField pattern="¤ #,##0.00">
				<reportElement x="65" y="1" width="117" height="20">
					<printWhenExpression><![CDATA[$F{tipo}.equals( "A" )]]></printWhenExpression>
				</reportElement>
				<box>
					<leftPen lineWidth="0.0"/>
					<bottomPen lineWidth="1.0"/>
					<rightPen lineWidth="1.0"/>
				</box>
				<textElement textAlignment="Right"/>
				<textFieldExpression class="java.math.BigDecimal"><![CDATA[$F{montoMinimo}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="302" y="1" width="77" height="20"/>
				<box>
					<bottomPen lineWidth="1.0"/>
					<rightPen lineWidth="1.0"/>
				</box>
				<textElement textAlignment="Center"/>
				<textFieldExpression class="java.lang.String"><![CDATA[$V{Avance}]]></textFieldExpression>
			</textField>
		</band>
	</detail>
	<summary>
		<band height="118" splitType="Stretch">
			<textField pattern="¤ #,##0.00">
				<reportElement x="182" y="1" width="120" height="20" backcolor="#CCCCFF">
					<printWhenExpression><![CDATA[$F{tipo}.equals( "A" )]]></printWhenExpression>
				</reportElement>
				<box>
					<bottomPen lineWidth="1.0"/>
					<rightPen lineWidth="1.0"/>
				</box>
				<textElement textAlignment="Right"/>
				<textFieldExpression class="java.math.BigDecimal"><![CDATA[$V{montoMaximo_1}]]></textFieldExpression>
			</textField>
			<textField pattern="¤ #,##0.00">
				<reportElement x="65" y="1" width="117" height="20" backcolor="#CCCCFF">
					<printWhenExpression><![CDATA[$F{tipo}.equals( "A" )]]></printWhenExpression>
				</reportElement>
				<box>
					<bottomPen lineWidth="1.0"/>
					<rightPen lineWidth="1.0"/>
				</box>
				<textElement textAlignment="Right"/>
				<textFieldExpression class="java.math.BigDecimal"><![CDATA[$V{montoMinimo_1}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="1" y="1" width="64" height="20" backcolor="#CCCCFF"/>
				<box>
					<leftPen lineWidth="1.0"/>
					<bottomPen lineWidth="1.0"/>
					<rightPen lineWidth="1.0"/>
				</box>
				<textElement textAlignment="Justified" verticalAlignment="Middle"/>
				<text><![CDATA[Costo Total]]></text>
			</staticText>
			<textField>
				<reportElement x="302" y="1" width="77" height="20"/>
				<box>
					<bottomPen lineWidth="1.0"/>
					<rightPen lineWidth="1.0"/>
				</box>
				<textElement textAlignment="Center"/>
				<textFieldExpression class="java.lang.String"><![CDATA[$V{SUMAAVANCE}]]></textFieldExpression>
			</textField>
		</band>
	</summary>
</jasperReport>
