	<import value="net.sf.jasperreports.engine.data.*"/>
	<parameter name="whereFolio" class="java.lang.String">
		<defaultValueExpression><![CDATA["AND Ce.nFolioReintegrocaja = 56"]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[DECLARE @laPoliza varchar(10)
DECLARE @cUnidadResponsable varchar(10)
DECLARE @cTipoPoliza varchar(10)
DECLARE @cTipoObra varchar(10)
DECLARE @cIdTipoPago varchar(1)
declare @cuantos smallint
DECLARE @noFolio INT

SELECT @noFolio = Ce.nFolioReintegroCaja
	, @laPoliza= nFolioPoliza
	, @cTipoPoliza = cTipoPoliza
	, @cUnidadResponsable = cIDEntidadContable
	, @cTipoObra = tipoObra
	, @cIdTipoPago = cIdTipoPagoDirecto
FROM (SELECT e.nFolioReintegroCajaAut AS nFolioReintegroCaja, nFolioPoliza, cTipoPoliza, cdescripcionpoliza, ''canocontrarrecibo,'DIRECTO' tipoObra, cunidadresponsablecontable, CAST('' AS VARCHAR(5)) cnoEstimacion, '' Periodo, cCentrocontable cIdEntidadContable, ''cIdTipoPagoDirecto
		FROM tReintegroCajaAutEncabezado AS e WITH (NOLOCK)
		JOIN tReintegroCajaAutDetalle AS d WITH (NOLOCK) ON e.nFolioReintegroCajaAut = d.nFolioReintegroCajaAut
		) Ce
WHERE 1 = 1
	$P!{whereFolio}
	--AND Ce.nFolioReintegroCaja = 56

IF OBJECT_ID('tempdb..#tmp_polizapagos') IS NOT NULL DROP TABLE #tmp_polizapagos;

---------------------Poliza Contabl----------------------
SELECT *
INTO #tmp_polizapagos
FROM ( SELECT SUBSTRING(m.nCuenta, 1,5) AS Cuenta, '' AS subCuenta, '' AS subSubCuenta, ''AS dSubCuenta, calmacen, dCuenta AS cnombre, dCuenta AS descripcion, dCuenta, m.ctipomovimiento, m.nCuenta, sum(mMovimiento) AS mMovimiento2
		FROM tcuentas AS c WITH (NOLOCK), tmovimiento AS m WITH (NOLOCK)
		LEFT JOIN cat_almacen AS a on CAST(a.nidalmacen AS VARCHAR(10)) = nsubcuenta AND a.ccentrocontable = m.ccentrocontable
		WHERE SUBSTRING(m.ncuenta,1,5) + '-00000-00000-00000' = c.ncuenta
			AND nFolioPoliza = @laPoliza AND m.cCentroContable = @cUnidadResponsable AND cTipopoliza = @cTipoPoliza
			AND mmovimiento != 0 AND NOT(c.TipoBalance='P' AND c.TipoCuenta='P')
		GROUP BY SUBSTRING(m.nCuenta, 1,5) ,calmacen, dCuenta ,dCuenta ,dCuenta, m.ctipomovimiento, m.nCuenta

		UNION
		--2o nivel
		SELECT '' AS Cuenta, SUBSTRING(m.nCuenta, 7,5) AS subCuenta, '' AS subSubCuenta, ' ' AS dSubCuenta, calmacen, dcuenta AS cnombre, '  ' + dCuenta AS descripcion, dCuenta, m.ctipomovimiento, m.nCuenta, ' ' AS mMovimiento2
		FROM tcuentas AS c WITH (NOLOCK), tmovimiento AS m WITH (NOLOCK)
		LEFT JOIN cat_almacen AS a ON CAST(a.nidalmacen AS VARCHAR(10)) = nsubcuenta AND a.ccentrocontable = m.ccentrocontable
		WHERE SUBSTRING(m.ncuenta,1,11) + '-00000-00000' = c.ncuenta AND nFolioPoliza = @laPoliza AND m.cCentroContable = @cUnidadResponsable
			AND cTipopoliza =@cTipoPoliza AND mmovimiento != 0 AND SUBSTRING(m.nCuenta, 7,5) != '00000'
			AND NOT(c.TipoBalance='P' AND c.TipoCuenta='P')
		GROUP BY SUBSTRING(m.nCuenta, 7,5), calmacen, dcuenta, '  ' + dCuenta, dCuenta, m.ctipomovimiento, m.nCuenta

		UNION
		--3er nivel
		SELECT '' AS Cuenta, '' AS subCuenta, SUBSTRING(m.nCuenta, 13,5) AS subSubCuenta, ' ' AS dSubCuenta, calmacen, dCuenta AS cnombre, '    ' + dCuenta AS descripcion, dCuenta, m.ctipomovimiento, m.nCuenta, '' AS mMovimiento2
		FROM tcuentas AS c WITH (NOLOCK), tmovimiento AS m WITH (NOLOCK)
		LEFT JOIN cat_almacen AS a ON CAST(a.nidalmacen AS VARCHAR(10)) = nsubcuenta AND a.ccentrocontable = m.ccentrocontable
		WHERE SUBSTRING(m.ncuenta,1,17) + '-00000'= c.ncuenta
			AND nFolioPoliza = @laPoliza AND m.cCentroContable = @cUnidadResponsable AND cTipopoliza = @cTipoPoliza
			AND mmovimiento != 0 AND SUBSTRING(m.nCuenta, 13,5) != '00000' AND not(c.TipoBalance='P' and c.TipoCuenta='P')
		GROUP BY SUBSTRING(m.nCuenta, 13,5), calmacen, dCuenta, '    ' + dCuenta, dCuenta, m.ctipomovimiento, m.nCuenta

		UNION

		SELECT '' AS Cuenta, '' AS subCuenta, ' ' AS subSubCuenta, CASE WHEN nSubCuenta = '' THEN SUBSTRING(m.nCuenta, 13,5) ELSE nSubCuenta END dSubCuenta, calmacen, cnombre
			, '      ' + ISNULL(' ', CASE WHEN nSubCuenta = '' THEN SUBSTRING(m.nCuenta, 13,5) ELSE CASE WHEN cnombre IS NULL THEN calmacen ELSE '[' + nSubCuenta+']' + cNombre END END) AS descripcion
			, dCuenta, m.ctipomovimiento, m.nCuenta, '' AS mMovimiento2
		FROM tcuentas AS c,  tmovimiento AS m
		LEFT JOIN cat_almacen AS a ON CAST(a.nidalmacen AS VARCHAR(10))=nsubcuenta AND a.ccentrocontable = m.ccentrocontable
		LEFT JOIN v_pcatalogorfc AS rfc ON cidrfc=nsubcuenta
		WHERE m.nSubcuenta != '' AND m.ncuenta = c.ncuenta AND nFolioPoliza = @laPoliza
			AND m.cCentroContable = @cUnidadResponsable AND cTipopoliza = @cTipoPoliza
			AND mmovimiento != 0 AND NOT(c.TipoBalance='P' AND c.TipoCuenta='P')
		GROUP BY CASE WHEN nSubCuenta = '' THEN SUBSTRING(m.nCuenta, 13,5) ELSE CASE WHEN cnombre IS NULL THEN calmacen ELSE nSubCuenta END END,calmacen,
				cnombre, '      ' + CASE WHEN nSubCuenta = '' THEN SUBSTRING(m.nCuenta, 13,5) ELSE CASE WHEN cnombre IS NULL THEN calmacen ELSE '[' + nSubCuenta+']' + cNombre END END, dCuenta, m.ctipomovimiento, m.nCuenta,nSubCuenta
	) AS kk
ORDER BY ctipomovimiento DESC,ncuenta, cuenta DESC, subcuenta DESC, subsubcuenta DESC

SET @cuantos = 0
SELECT @cuantos = COUNT(*) FROM #tmp_polizapagos

IF @cuantos = 0
BEGIN
	INSERT INTO #tmp_polizapagos
	SELECT *
	FROM (SELECT SUBSTRING(m.nCuenta, 1,5) AS Cuenta, '' AS subCuenta, '' AS subSubCuenta, '' AS dSubCuenta, calmacen, dCuenta AS cnombre, dCuenta AS descripcion, dCuenta, m.ctipomovimiento, m.nCuenta, sum(mMovimiento) AS mMovimiento2
			FROM tcuentas c with(NOLOCK), tmovimiento m with(NOLOCK)
			LEFT JOIN cat_almacen AS a ON CAST(a.nidalmacen AS VARCHAR(10)) = nsubcuenta AND a.ccentrocontable = m.ccentrocontable
			WHERE SUBSTRING(m.ncuenta,1,5) + '-00000-00000-00000' = c.ncuenta
				AND nFolioPoliza = @laPoliza AND m.cCentroContable = @cUnidadResponsable
				AND cTipopoliza =@cTipoPoliza AND mmovimiento != 0
			GROUP BY SUBSTRING(m.nCuenta, 1,5), calmacen, dCuenta, dCuenta, dCuenta, m.ctipomovimiento, m.nCuenta,m.nsubcuenta

			UNION
			--2o nivel
			SELECT '' AS Cuenta, SUBSTRING(m.nCuenta, 7,5) AS subCuenta, '' AS subSubCuenta, ' ' AS dSubCuenta, calmacen, dcuenta AS cnombre, '  ' + dCuenta AS descripcion, dCuenta, m.ctipomovimiento, m.nCuenta, ' ' AS mMovimiento2
			FROM tcuentas AS c WITH (NOLOCK), tmovimiento AS m WITH (NOLOCK)
			LEFT JOIN cat_almacen AS a ON CAST(a.nidalmacen AS VARCHAR(10)) = nsubcuenta AND a.ccentrocontable = m.ccentrocontable
			WHERE SUBSTRING(m.ncuenta,1,11) + '-00000-00000'= c.ncuenta AND nFolioPoliza = @laPoliza
				AND m.cCentroContable = @cUnidadResponsable and cTipopoliza =@cTipoPoliza and mmovimiento != 0 and substring(m.nCuenta, 7,5) != '00000'
			GROUP BY SUBSTRING(m.nCuenta, 7,5), calmacen, dcuenta, '  ' + dCuenta, dCuenta, m.ctipomovimiento, m.nCuenta

			UNION
			--3er nivel
			SELECT '' AS Cuenta, '' AS subCuenta, SUBSTRING(m.nCuenta, 13,5) AS subSubCuenta, ' ' AS dSubCuenta, calmacen, dCuenta AS cnombre, '    ' + dCuenta AS descripcion, dCuenta, m.ctipomovimiento, m.nCuenta, '' AS mMovimiento2
			FROM tcuentas AS c WITH (NOLOCK), tmovimiento AS m WITH (NOLOCK)
			LEFT JOIN cat_almacen AS a ON CAST(a.nidalmacen AS VARCHAR(10)) = nsubcuenta AND a.ccentrocontable = m.ccentrocontable
			WHERE SUBSTRING(m.ncuenta,1,17) + '-00000' = c.ncuenta AND nFolioPoliza = @laPoliza AND m.cCentroContable = @cUnidadResponsable
				AND cTipopoliza =@cTipoPoliza AND mmovimiento != 0 AND SUBSTRING(m.nCuenta, 13,5) != '00000'
			GROUP BY SUBSTRING(m.nCuenta, 13,5), calmacen, dCuenta, '    ' + dCuenta, dCuenta, m.ctipomovimiento, m.nCuenta

			UNION

			SELECT '' AS Cuenta, '' AS subCuenta, ' ' AS subSubCuenta, CASE WHEN nSubCuenta = '' THEN SUBSTRING(m.nCuenta, 13,5) ELSE nSubCuenta END AS dSubCuenta, calmacen, cnombre
				, '      ' + ISNULL(' ', CASE WHEN nSubCuenta = '' THEN SUBSTRING(m.nCuenta, 13,5) ELSE CASE WHEN cnombre IS NULL THEN calmacen ELSE '[' + nSubCuenta+']' + cNombre END END) AS descripcion, dCuenta, m.ctipomovimiento, m.nCuenta, '' AS mMovimiento2
			FROM tcuentas AS c, tmovimiento AS m
			LEFT JOIN cat_almacen AS a ON CAST(a.nidalmacen AS VARCHAR(10)) = nsubcuenta AND a.ccentrocontable = m.ccentrocontable
			LEFT JOIN v_pcatalogorfc AS rfc ON cidrfc=nsubcuenta
			WHERE m.nSubcuenta != '' AND m.ncuenta = c.ncuenta AND nFolioPoliza = @laPoliza AND m.cCentroContable = @cUnidadResponsable
				AND cTipopoliza = @cTipoPoliza AND mmovimiento != 0
			GROUP BY CASE WHEN nSubCuenta = '' THEN SUBSTRING(m.nCuenta, 13,5) ELSE CASE WHEN cnombre IS NULL THEN calmacen ELSE nSubCuenta END END, calmacen, cnombre
			, '      ' + CASE WHEN nSubCuenta = '' THEN SUBSTRING(m.nCuenta, 13,5) ELSE CASE WHEN cnombre IS NULL THEN calmacen ELSE '[' + nSubCuenta+']' + cNombre END END
			, dCuenta, m.ctipomovimiento, m.nCuenta,nSubCuenta
		)kk
	ORDER BY ctipomovimiento DESC, ncuenta, cuenta DESC, subcuenta DESC, subsubcuenta DESC
END

SELECT @cTipoPoliza + '-' + @laPoliza AS Poliza, *
	, CASE WHEN cTipoMovimiento = 'C' THEN mMovimiento2 ELSE 0 END Debe, CASE WHEN cTipoMovimiento = 'A' THEN mMovimiento2 ELSE 0 END Haber
FROM #tmp_polizapagos
IF OBJECT_ID('tempdb..#tmp_polizapagos') IS NOT NULL DROP TABLE #tmp_polizapagos;]]>
	</queryString>
