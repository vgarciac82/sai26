		<property name="com.jaspersoft.studio.field.label" value="dFechaFactura"/>
	</field>
	<field name="totalFacturas" class="java.lang.Integer">
		<property name="com.jaspersoft.studio.field.name" value="totalFacturas"/>
		<property name="com.jaspersoft.studio.field.label" value="totalFacturas"/>
	</field>
