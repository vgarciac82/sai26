	<parameter name="nFolioPago" class="java.lang.Integer"/>
	<parameter name="tipoPago" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[/*subReportFacturas.jasper*/

DECLARE @tipoPago NVARCHAR(50)=''

SELECT @tipoPago =
       CASE $P{tipoPago}
              WHEN 'DIRECTO' THEN 'PAGODIRECTO'
                     --WHEN 'NOMINA' THEN ''
              WHEN 'DIVERSO' THEN 'PAGODIVERSO'
              WHEN 'RELGASTO' THEN 'RELACIONGASTOS'
              WHEN 'OBRA' THEN 'PAGOOBRA'
              WHEN 'FEDERALIZA' THEN 'PAGOFEDERALIZADO'
       END
       SELECT cfactura ,
       CONVERT(VARCHAR, mimporteconiva, 1) AS mImporteBruto ,
       CONVERT ( date, dFechaFactura, 113) dFechaFactura,
       (
              SELECT Count(*)
              FROM   dbo.tPagoFactura  with(nolock)
              WHERE  cTipoPago=@tipoPago
              AND    nFolioPago=$P{nFolioPago})totalFacturas
FROM   dbo.tPagoFactura with(nolock)
WHERE  cTipoPago=@tipoPago
AND    nFolioPago=$P{nFolioPago}]]>
	</queryString>
	<field name="cfactura" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="cfactura"/>
		<property name="com.jaspersoft.studio.field.label" value="cfactura"/>
	</field>
	<field name="mImporteBruto" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="mImporteBruto"/>
		<property name="com.jaspersoft.studio.field.label" value="mImporteBruto"/>
	</field>
	<field name="dFechaFactura" class="java.lang.String">
