	<parameter name="cCondiciones" class="java.lang.String">
		<defaultValueExpression><![CDATA["( m23IVA > 0 OR mImporteFlete23 > 0 OR mISRHonorarios > 0 OR mISRArrenda > 0 OR mImporteFlete4 > 0 OR mImporteIvaHonorarios > 0)"]]></defaultValueExpression>
	</parameter>
	<parameter name="cRetenciones" class="java.lang.String">
		<defaultValueExpression><![CDATA["SUM(mImporteFlete23+m23IVA) mImporteFlete23,SUM(mISRHonorarios) mISRHonorarios,SUM(mISRArrenda)mISRArrenda,SUM(mImporteFlete4) mImporteFlete4,SUM(mImporteIvaHonorarios) mImporteIvaHonorarios,SUM(mImporteIvaArrenda) mImporteIvaArrenda,SUM(mImporteIvaProv) mImporteIvaProv,SUM(mImporteObra) mImporteObra, 0 mCNIC,0 mIMDT ,0 mObra5,0 mTesofe,0 mRetImpuestoCedular"]]></defaultValueExpression>
	</parameter>
	<parameter name="cNumPagoAMF" class="java.lang.String">
