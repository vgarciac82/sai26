<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="AnexoBoletos"  pageWidth="555" pageHeight="802" columnWidth="555" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0">
	<property name="ireport.zoom" value="2.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<property name="ireport.scriptlethandling" value="0"/>
	<property name="ireport.encoding" value="UTF-8"/>
	<import value="net.sf.jasperreports.engine.*"/>
	<import value="java.util.*"/>
	<import value="net.sf.jasperreports.engine.data.*"/>
	<parameter name="swhere" class="java.lang.String">
		<defaultValueExpression><![CDATA["and canocontrarrecibo ='18CP2019100587'"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT relGastosEnc.nFolioRELACIONGASTOS, InfoBoleto.cNumeroBoleto, InfoBoleto.mImporteBoleto, (SELECT COUNT(*) FROM tInfoBoleto WITH (NOLOCK) WHERE nFolioRELACIONGASTOS = InfoBoleto.nFolioRELACIONGASTOS) AS TotalReg
	INTO #tmpAnexoBoletos
FROM  tRELACIONGASTOSEncabezado relGastosEnc WITH (NOLOCK)
	INNER JOIN tInfoBoleto InfoBoleto WITH (NOLOCK)
		ON ( InfoBoleto.nFolioRELACIONGASTOS = relGastosEnc.nFolioRELACIONGASTOS )
WHERE 1 = 1 $P!{swhere}

SELECT * FROM #tmpAnexoBoletos WITH (NOLOCK)

IF (SELECT OBJECT_ID('tempdb..#tmpAnexoBoletos')) IS NOT NULL	DROP TABLE #tmpAnexoBoletos]]>
	</queryString>
	<field name="nFolioRELACIONGASTOS" class="java.lang.Integer"/>
	<field name="cNumeroBoleto" class="java.lang.String"/>
	<field name="mImporteBoleto" class="java.math.BigDecimal"/>
	<field name="TotalReg" class="java.lang.Integer"/>
	<variable name="TotalImporte" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{mImporteBoleto}]]></variableExpression>
		<initialValueExpression><![CDATA[0]]></initialValueExpression>
	</variable>
	<columnHeader>
		<band height="16">
			<printWhenExpression><![CDATA[$F{TotalReg}> 1]]></printWhenExpression>
			<staticText>
				<reportElement x="396" y="0" width="88" height="15"/>
				<box>
					<topPen lineWidth="1.0"/>
					<leftPen lineWidth="1.0"/>
					<bottomPen lineWidth="1.0"/>
					<rightPen lineWidth="1.0"/>
				</box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font size="8" isBold="true"/>
				</textElement>
				<text><![CDATA[Importe]]></text>
			</staticText>
			<staticText>
				<reportElement x="74" y="0" width="322" height="15"/>
				<box>
					<topPen lineWidth="1.0"/>
					<leftPen lineWidth="1.0"/>
					<bottomPen lineWidth="1.0"/>
					<rightPen lineWidth="1.0"/>
				</box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font size="8" isBold="true"/>
				</textElement>
				<text><![CDATA[Núm. Boleto/Reservación.]]></text>
			</staticText>
		</band>
	</columnHeader>
	<detail>
		<band height="11">
			<printWhenExpression><![CDATA[$F{TotalReg}> 1]]></printWhenExpression>
			<textField>
				<reportElement x="74" y="-1" width="322" height="12"/>
				<box>
					<leftPen lineWidth="0.0" lineStyle="Solid"/>
					<rightPen lineWidth="0.0" lineStyle="Solid"/>
				</box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font size="8"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{cNumeroBoleto}]]></textFieldExpression>
			</textField>
			<textField pattern="#,##0.00;-#,##0.00">
				<reportElement x="396" y="-1" width="78" height="12"/>
				<box>
					<leftPen lineWidth="0.0"/>
					<rightPen lineWidth="0.0"/>
				</box>
				<textElement textAlignment="Right">
					<font size="8"/>
				</textElement>
				<textFieldExpression class="java.math.BigDecimal"><![CDATA[$F{mImporteBoleto}]]></textFieldExpression>
			</textField>
		</band>
	</detail>
	<columnFooter>
		<band height="14">
			<printWhenExpression><![CDATA[$F{TotalReg}> 1]]></printWhenExpression>
			<textField pattern="#,##0.00;-#,##0.00">
				<reportElement x="396" y="1" width="78" height="12"/>
				<box>
					<topPen lineWidth="0.0"/>
					<leftPen lineWidth="0.0"/>
					<bottomPen lineWidth="0.0"/>
					<rightPen lineWidth="0.0"/>
				</box>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font size="8"/>
				</textElement>
				<textFieldExpression class="java.math.BigDecimal"><![CDATA[$V{TotalImporte}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="334" y="1" width="62" height="12"/>
				<box>
					<topPen lineWidth="0.0"/>
					<leftPen lineWidth="0.0"/>
					<bottomPen lineWidth="0.0"/>
					<rightPen lineWidth="0.0"/>
				</box>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font size="8" isBold="true"/>
				</textElement>
				<text><![CDATA[TOTAL   $ ]]></text>
			</staticText>
		</band>
	</columnFooter>
	<lastPageFooter>
		<band height="2"/>
	</lastPageFooter>
</jasperReport>
