<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="FalloPunto_B"  pageWidth="572" pageHeight="752" columnWidth="555" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0">
	<property name="ireport.zoom" value="1.771561000000001"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="cIdProcedimiento" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT  cRazonSocial, nIdLineaConsolidado+', de '+cDescripcion as cDescripcion
FROM (
        SELECT DISTINCT cIdRFC, cRazonSocial, cDescripcion
        FROM (
        SELECT pc.nIdLineaConsolidado, pc.cIdRFC, cp.cRazonSocial, p.cDescripcion
		FROM mProcedimientoCompleto pc WITH(NOLOCK), mCatalogoProveedor cp WITH(NOLOCK), mConsolidadoLineas cl WITH(NOLOCK), mProcedimiento p WITH(NOLOCK)
		WHERE pc.cIdRFC=cp.cIdRFC AND pc.nIdLineaConsolidado=cl.nIdLineaConsolidado AND pc.cIdConsolidado=cl.cIdConsolidado AND p.cIdProcedimiento=pc.cIdProcedimiento AND pc.cIdProcedimiento=$P{cIdProcedimiento} AND pc.evaluacionTec=1  AND mMontoMinimo<>0
		) AS tab
        ) qo
CROSS APPLY
        (
        SELECT  CASE ROW_NUMBER() OVER(ORDER BY qi.nIdLineaConsolidado) WHEN 1 THEN '' ELSE ', ' END + CONVERT(VARCHAR,qi.nIdLineaConsolidado)
        FROM  (
        SELECT pc.nIdLineaConsolidado, pc.cIdRFC, cp.cRazonSocial, p.cDescripcion
		FROM mProcedimientoCompleto pc WITH(NOLOCK), mCatalogoProveedor cp WITH(NOLOCK), mConsolidadoLineas cl WITH(NOLOCK), mProcedimiento p WITH(NOLOCK)
		WHERE pc.cIdRFC=cp.cIdRFC AND pc.nIdLineaConsolidado=cl.nIdLineaConsolidado AND pc.cIdConsolidado=cl.cIdConsolidado AND p.cIdProcedimiento=pc.cIdProcedimiento AND pc.cIdProcedimiento=$P{cIdProcedimiento} AND pc.evaluacionTec=1  AND pc.mMontoMinimo<>0
		) qi
        WHERE  qi.cIdRFC=qo.cIdRFC
        ORDER BY qi.nIdLineaConsolidado
        FOR XML PATH ('')
        ) qi(nIdLineaConsolidado)]]>
	</queryString>
	<field name="cRazonSocial" class="java.lang.String"/>
	<field name="cDescripcion" class="java.lang.String"/>
	<background>
		<band splitType="Stretch"/>
	</background>
	<columnHeader>
		<band height="33" splitType="Stretch">
			<staticText>
				<reportElement x="2" y="19" width="198" height="14"/>
				<box>
					<pen lineWidth="0.5"/>
					<topPen lineWidth="0.5"/>
					<leftPen lineWidth="0.5"/>
					<bottomPen lineWidth="0.5"/>
					<rightPen lineWidth="0.5"/>
				</box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Arial" size="12" isBold="true"/>
				</textElement>
				<text><![CDATA[Nombre del Licitante]]></text>
			</staticText>
			<staticText>
				<reportElement x="200" y="19" width="364" height="14"/>
				<box>
					<pen lineWidth="0.5"/>
					<topPen lineWidth="0.5"/>
					<leftPen lineWidth="0.5"/>
					<bottomPen lineWidth="0.5"/>
					<rightPen lineWidth="0.5"/>
				</box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Arial" size="12" isBold="true"/>
				</textElement>
				<text><![CDATA[Partidas ofertadas y descripción del bien.]]></text>
			</staticText>
		</band>
	</columnHeader>
	<detail>
		<band height="14" splitType="Stretch">
			<textField isStretchWithOverflow="true">
				<reportElement stretchType="RelativeToBandHeight" x="2" y="0" width="198" height="14"/>
				<box>
					<pen lineWidth="0.5"/>
					<topPen lineWidth="0.5"/>
					<leftPen lineWidth="0.5"/>
					<bottomPen lineWidth="0.5"/>
					<rightPen lineWidth="0.5"/>
				</box>
				<textElement>
					<font fontName="Arial" size="12"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{cRazonSocial}]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true">
				<reportElement stretchType="RelativeToBandHeight" x="200" y="0" width="364" height="14"/>
				<box>
					<pen lineWidth="0.5"/>
					<topPen lineWidth="0.5"/>
					<leftPen lineWidth="0.5"/>
					<bottomPen lineWidth="0.5"/>
					<rightPen lineWidth="0.5"/>
				</box>
				<textElement>
					<font fontName="Arial" size="12"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{cDescripcion}]]></textFieldExpression>
			</textField>
		</band>
	</detail>
</jasperReport>
