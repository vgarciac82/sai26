<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="MatrizConversionDevengado"  pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="808" leftMargin="14" rightMargin="20" topMargin="14" bottomMargin="20">
	<property name="ireport.zoom" value="1.502629601803158"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="tipo" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT m.ID_TIPO_CONCEPTO
	, TIPO_CONCEPTO
	, cPartida
	, cTipoGasto
	, cFuenteFinanciamiento
	, cEvento
	, SUBSTRING(cCtaCargo,1,5) AS cCtaCargo
	, ctasc.dCuenta AS dCtaCargo
	, SUBSTRING(cCtaAbono,1,5) AS cCtaAbono
	, ctasa.dCuenta as dCtaAbono
	, CASE WHEN cRetenciones = '0' THEN '' ELSE cRetenciones  END cRetenciones
	, m.ID_DESTINO_GASTO
	, (SELECT DESTINO_GASTO FROM CAT_DESTINO_GASTO AS dg WITH (NOLOCK) WHERE m.ID_DESTINO_GASTO = dg.ID_DESTINO_GASTO AND m.cFuenteFinanciamiento = dg.FuenteFinanciamiento ) AS DESTINO_GASTO
	, ISNULL(MODULO,'RELACIONGASTOS') AS MODULO
FROM tMatrizContable AS m WITH (NOLOCK)
JOIN CAT_TIPO_CONCEPTO AS tc WITH (NOLOCK) ON m.ID_TIPO_CONCEPTO = tc.ID_TIPO_CONCEPTO
LEFT OUTER JOIN tDestinoGastoModulo AS dgm WITH (NOLOCK) ON m.ID_DESTINO_GASTO = dgm.ID_DESTINO_GASTO
JOIN tCuentas ctasc WITH(NOLOCK) ON m.cCtaCargo = ctasc.nCuenta
JOIN tCuentas ctasa WITH(NOLOCK) ON m.cCtaAbono = ctasa.nCuenta
WHERE idTipoMatriz = $P{tipo}
ORDER BY MODULO, m.ID_TIPO_CONCEPTO, cPartida, cEvento, cCtaCargo, cCtaAbono]]>
	</queryString>
	<field name="ID_TIPO_CONCEPTO" class="java.lang.String"/>
	<field name="TIPO_CONCEPTO" class="java.lang.String"/>
	<field name="cPartida" class="java.lang.String"/>
