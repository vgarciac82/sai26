<div class="col-12">

	<div class="card">
		<div class="card-header">Suficiencia</div>
		<div class="card-body">
			<h5 class="card-title">Compromisos Disponibles</h5>
			<p class="card-text">Seleccione la suficiencia (compromiso) para
				realizar el pago. Si no ve una suficiencia, por favor revise el
				estatus.</p>
			<div class="table-responsive">
				<table id="tblSuficiencias" class="table table-striped">
					<thead>
						<tr>
							<th>Referencia</th>
							<th>Compromiso</th>
							<th>RFC</th>
							<th>Nombre</th>
							<th>Importe</th>
							<th>IVA</th>
							<th>Total</th>
						</tr>
					</thead>
				</table>
			</div>

			<div class="col-12 mt-3">
				<div class="text-center mt-3">
					<button id="btnSeleccionarSuficiencia" class="btn btn-primary" type="button">
						Seleccionar
					</button>

				</div>
			</div>

		</div>
	</div>

</div>